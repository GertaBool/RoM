digraph ROM {
  graph [rankdir=LR,bgcolor="#f8fafc",pad="0.35",nodesep="0.45",ranksep="0.8",fontname="DejaVu Sans",label="Rise of Mankind — source architecture at 1ab4f99",labelloc=t,fontsize=22];
  node [shape=box,style="rounded,filled",fillcolor="#ffffff",color="#94a3b8",fontname="DejaVu Sans",fontsize=12,margin="0.16,0.12"];
  edge [fontname="DejaVu Sans",fontsize=10,color="#64748b",arrowsize=0.7];
  XML [label="Rule XML + modules\ntechs · civics · units · buildings\nevents · victory · defines",fillcolor="#dbeafe"];
  Loader [label="CvXMLLoadUtility* + CvInfos\nMLF order · dependencies\ncopyNonDefaults · multiple passes",fillcolor="#dbeafe"];
  Registry [label="CvGlobals / GC\nresolved info tables + live defines",fillcolor="#dbeafe"];
  Host [label="BTS executable\nupdate slices · Python host\nA* service · I/O · UI",fillcolor="#fee2e2"];
  Scheduler [label="CvGame / CvPlayer / CvTeam\nmode-sensitive turn scheduler",fillcolor="#dcfce7"];
  World [label="CvMap / CvPlot / CvCity / CvUnit\nworld state + legal mutations\nproduction · combat · research",fillcolor="#dcfce7"];
  AI [label="Cv*AI + 13 policy headers\nstrategic context → agenda\noperations / governors → missions",fillcolor="#dcfce7"];
  Bridge [label="Cy* Boost.Python bindings\nCvPythonExtensions",fillcolor="#fef3c7"];
  Events [label="CvEventReporter\n→ CvDllPythonEvents\n→ CvEventInterface / BUG",fillcolor="#fef3c7"];
  Config [label="Assets/Config/init.xml\nBUG load / events / gameutils / export\nUserSettings + RoM INI",fillcolor="#ede9fe"];
  Python [label="RoMEventManager / RoMGameUtils\nRevolution / TechConquest / RevDCM\nCvRandomEventInterface",fillcolor="#fef3c7"];
  Maps [label="39 PrivateMaps scripts\n+ 44 scenario files",fillcolor="#ede9fe"];
  UI [label="Screens / advisors / alerts\ninput → messages and commands",fillcolor="#ede9fe"];
  Save [label="Native read/write + RNG state\nBUG/SdToolKit script data\nRevolution state",fillcolor="#e2e8f0"];
  Tests [label="Tools: 14 regression programs\ncompiled policies + source contracts\nXML checks · victory model",fillcolor="#e2e8f0"];
  Telemetry [label="AugustusAIProfiler\nSettlementTrainingProfiler v4\nCSV combiner → pairwise trainer",fillcolor="#e2e8f0"];
  XML -> Loader -> Registry;
  Registry -> World [label="parameters / legality"];
  Registry -> AI [label="weights / options"];
  Host -> Scheduler [label="update()"];
  Host -> World [label="path / engine interfaces"];
  Scheduler -> World [label="ordered phases"];
  Scheduler -> AI [label="planning / movement"];
  AI -> World [label="legal commands"];
  World -> Events [label="synchronous hooks"];
  Config -> Events [label="handler registration"];
  Config -> Python [label="load + export callbacks"];
  Events -> Python [label="ordered dispatch"];
  World -> Python [label="query / veto callbacks"];
  Python -> Bridge -> World [label="state changes"];
  Python -> Registry [label="RevDCM live defines"];
  Maps -> Bridge [label="world generation"];
  UI -> Bridge [label="queries / command requests"];
  World -> Save [dir=both];
  Python -> Save [dir=both];
  AI -> Tests [style=dashed,label="portable policy seams"];
  XML -> Tests [style=dashed,label="data contracts"];
  Python -> Telemetry [label="turn / city-built hooks"];
}
