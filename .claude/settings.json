{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/precommit.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nohup bash \"${CLAUDE_PROJECT_DIR}/toolchain/analysis/setup.sh\" >/dev/null 2>&1 &"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"${CLAUDE_PROJECT_DIR}\" config core.hooksPath .githooks"
          }
        ]
      }
    ]
  }
}
