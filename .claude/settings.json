{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/method/hooks/claude_precommit.py\""
          }
        ]
      },
      {
        "matcher": "mcp__.*gitlab.*__add_commit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/method/hooks/claude_external.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "nohup bash \"${CLAUDE_PROJECT_DIR}/toolchain/analysis/setup.sh\" >/dev/null 2>&1 &"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/method/setup.sh\""
          }
        ]
      }
    ]
  }
}
