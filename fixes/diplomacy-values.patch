+// Diplomacy switch 2: what a resource does in our cities each turn, in gold-equivalents x100. Food
+// and production count 2, commerce 1 times what a point of commerce yields in the city after its
+// commerce modifiers (a market's, a library's). Gaining: happiness lets angry citizens work (half a
+// citizen in a growing city at its limit), health removes the food lost to unhealthiness (half a
+// point in a growing city at its limit), and the city's buildings apply their BonusYieldModifiers
+// to its base yields (Town Essentials with Coffee, a Forge with Gold). Losing (bLosing): the
+// citizens and food the city would lose, and the same yields.
+int CvPlayerAI::AI_bonusCityValue(BonusTypes eBonus, bool bLosing) const
+{
+	if (GET_TEAM(getTeam()).isBonusObsolete(eBonus))
+	{
+		return 0;
+	}
+
+	const CvBonusInfo& kBonus = GC.getBonusInfo(eBonus);
+	std::vector<BuildingTypes> aeBuildings;
+	for (int iB = 0; iB < GC.getNumBuildingInfos(); iB++)
+	{
+		const CvBuildingInfo& kBuilding = GC.getBuildingInfo((BuildingTypes)iB);
+		bool bActs = (kBuilding.getBonusHappinessChanges(eBonus) > 0) || (kBuilding.getBonusHealthChanges(eBonus) > 0);
+		for (int iY = 0; !bActs && iY < NUM_YIELD_TYPES; iY++)
+		{
+			bActs = (kBuilding.getBonusYieldModifier(eBonus, iY) != 0);
+		}
+		if (bActs)
+		{
+			aeBuildings.push_back((BuildingTypes)iB);
+		}
+	}
+
+	static const int aiYieldWeight[NUM_YIELD_TYPES] = {2, 2, 1};
+	int iTotal100 = 0;
+	int iLoop;
+	for (CvCity* pLoopCity = firstCity(&iLoop); pLoopCity != NULL; pLoopCity = nextCity(&iLoop))
+	{
+		int iHappy = std::max(0, kBonus.getHappiness());
+		int iHealth = std::max(0, kBonus.getHealth());
+		int aiModifier[NUM_YIELD_TYPES] = {0, 0, 0};
+		for (size_t iK = 0; iK < aeBuildings.size(); iK++)
+		{
+			const int iNum = pLoopCity->getNumActiveBuilding(aeBuildings[iK]);
+			if (iNum > 0)
+			{
+				const CvBuildingInfo& kBuilding = GC.getBuildingInfo(aeBuildings[iK]);
+				iHappy += iNum * std::max(0, kBuilding.getBonusHappinessChanges(eBonus));
+				iHealth += iNum * std::max(0, kBuilding.getBonusHealthChanges(eBonus));
+				for (int iY = 0; iY < NUM_YIELD_TYPES; iY++)
+				{
+					aiModifier[iY] += iNum * kBuilding.getBonusYieldModifier(eBonus, iY);
+				}
+			}
+		}
+
+		// commerce output per point of commerce yield, x100
+		int iCommerceOutput = 0;
+		for (int iC = 0; iC < NUM_COMMERCE_TYPES; iC++)
+		{
+			iCommerceOutput += pLoopCity->getCommerceRate((CommerceTypes)iC);
+		}
+		const int iCommerceYield = pLoopCity->getYieldRate(YIELD_COMMERCE);
+		const int iCommerceFactor100 = (iCommerceYield > 0) ? std::max(100, (100 * iCommerceOutput) / iCommerceYield) : 100;
+
+		// one working citizen: the city's weighted base yield per citizen, x100
+		int iCitizen100 = 0;
+		for (int iY = 0; iY < NUM_YIELD_TYPES; iY++)
+		{
+			iCitizen100 += aiYieldWeight[iY] * pLoopCity->getBaseYieldRate((YieldTypes)iY) * ((iY == YIELD_COMMERCE) ? iCommerceFactor100 : 100);
+		}
+		iCitizen100 /= std::max(1, pLoopCity->getPopulation());
+
+		const bool bGrowing = (pLoopCity->foodDifference() > 0);
+		const int iHappySurplus = pLoopCity->happyLevel() - pLoopCity->unhappyLevel();
+		const int iHealthSurplus = pLoopCity->goodHealth() - pLoopCity->badHealth();
+		const int iFood100 = aiYieldWeight[YIELD_FOOD] * 100;
+		if (iHappy > 0)
+		{
+			if (bLosing)
+			{
+				iTotal100 += std::max(0, iHappy - std::max(0, iHappySurplus)) * iCitizen100;
+			}
+			else
+			{
+				iTotal100 += std::min(iHappy, std::max(0, -iHappySurplus)) * iCitizen100;
+				if (iHappySurplus == 0 && bGrowing)
+				{
+					iTotal100 += iCitizen100 / 2;
+				}
+			}
+		}
+		if (iHealth > 0)
+		{
+			if (bLosing)
+			{
+				iTotal100 += std::max(0, iHealth - std::max(0, iHealthSurplus)) * iFood100;
+			}
+			else
+			{
+				iTotal100 += std::min(iHealth, std::max(0, -iHealthSurplus)) * iFood100;
+				if (iHealthSurplus == 0 && bGrowing)
+				{
+					iTotal100 += iFood100 / 2;
+				}
+			}
+		}
+		for (int iY = 0; iY < NUM_YIELD_TYPES; iY++)
+		{
+			if (aiModifier[iY] != 0)
+			{
+				// base yield times the modifier percent: the yield gained, x100
+				iTotal100 += (aiYieldWeight[iY] * pLoopCity->getBaseYieldRate((YieldTypes)iY) * aiModifier[iY] * ((iY == YIELD_COMMERCE) ? iCommerceFactor100 : 100)) / 100;
+			}
+		}
+	}
+
+	return std::max(0, iTotal100);
+}
+
+// Diplomacy switch 2 (AI_bonusUnlockVal): a known prerequisite tech doubles a unit's or building's
+// weight, as being able to train or build it does in AI_baseBonusVal, and the era distance of that
+// tech divides it (the same era multiplies it by 3/2).
+static int bonusUnlockTechWeight(const CvTeam& kTeam, EraTypes eCurrentEra, TechTypes eTech, int iValue)
+{
+	if (eTech == NO_TECH)
+	{
+		return iValue * 2;
+	}
+	if (kTeam.isHasTech(eTech))
+	{
+		iValue *= 2;
+	}
+	const int iDiff = abs(GC.getTechInfo(eTech).getEra() - eCurrentEra);
+	return (iDiff == 0) ? ((iValue * 3) / 2) : (iValue / iDiff);
+}
+
+// Diplomacy switch 2: the units, buildings and routes that need the resource, weighted as
+// AI_baseBonusVal weights them (prerequisites, production modifiers, power, era distance), with a
+// known tech in place of canTrain and canConstruct, so that it costs little and needs no cache.
+int CvPlayerAI::AI_bonusUnlockVal(BonusTypes eBonus) const
+{
+	const CvTeam& kTeam = GET_TEAM(getTeam());
+	if (kTeam.isBonusObsolete(eBonus))
+	{
+		return 0;
+	}
+
+	const EraTypes eEra = getCurrentEra();
+	int iValue = 0;
+	for (int iI = 0; iI < GC.getNumUnitClassInfos(); iI++)
+	{
+		const UnitTypes eLoopUnit = (UnitTypes)GC.getCivilizationInfo(getCivilizationType()).getCivilizationUnits(iI);
+		if (eLoopUnit == NO_UNIT)
+		{
+			continue;
+		}
+		const CvUnitInfo& kLoopUnit = GC.getUnitInfo(eLoopUnit);
+		int iTempValue = 0;
+		if (kLoopUnit.getPrereqAndBonus() == eBonus)
+		{
+			iTempValue += 50;
+		}
+		for (int iJ = 0; iJ < GC.getNUM_UNIT_PREREQ_OR_BONUSES(); iJ++)
+		{
+			if (kLoopUnit.getPrereqOrBonuses(iJ) == eBonus)
+			{
+				iTempValue += 40;
+			}
+		}
+		iTempValue += kLoopUnit.getBonusProductionModifier(eBonus) / 10;
+		if (iTempValue > 0)
+		{
+			iValue += bonusUnlockTechWeight(kTeam, eEra, (TechTypes)kLoopUnit.getPrereqAndTech(), iTempValue);
+		}
+	}
+
+	for (int iI = 0; iI < GC.getNumBuildingClassInfos(); iI++)
+	{
+		const BuildingTypes eLoopBuilding = (BuildingTypes)GC.getCivilizationInfo(getCivilizationType()).getCivilizationBuildings(iI);
+		if (eLoopBuilding == NO_BUILDING)
+		{
+			continue;
+		}
+		const CvBuildingInfo& kLoopBuilding = GC.getBuildingInfo(eLoopBuilding);
+		int iTempValue = 0;
+		if (kLoopBuilding.getPrereqAndBonus() == eBonus)
+		{
+			iTempValue += 30;
+		}
+		for (int iJ = 0; iJ < GC.getNUM_BUILDING_PREREQ_OR_BONUSES(); iJ++)
+		{
+			if (kLoopBuilding.getPrereqOrBonuses(iJ) == eBonus)
+			{
+				iTempValue += 20;
+			}
+		}
+		iTempValue += kLoopBuilding.getBonusProductionModifier(eBonus) / 10;
+		if (kLoopBuilding.getPowerBonus() == eBonus)
+		{
+			iTempValue += 60;
+			for (int iY = 0; iY < NUM_YIELD_TYPES; iY++)
+			{
+				iTempValue += kLoopBuilding.getPowerYieldModifier(iY);
+			}
+		}
+		if (iTempValue > 0)
+		{
+			iValue += bonusUnlockTechWeight(kTeam, eEra, (TechTypes)kLoopBuilding.getPrereqAndTech(), iTempValue);
+		}
+	}
+
+	const RouteTypes eBestRoute = getBestRoute();
+	for (int iI = 0; iI < GC.getNumBuildInfos(); iI++)
+	{
+		const RouteTypes eRoute = (RouteTypes)(GC.getBuildInfo((BuildTypes)iI).getRoute());
+		if (eRoute == NO_ROUTE)
+		{
+			continue;
+		}
+		int iTempValue = 0;
+		if (GC.getRouteInfo(eRoute).getPrereqBonus() == eBonus)
+		{
+			iTempValue += 80;
+		}
+		for (int iJ = 0; iJ < GC.getNUM_ROUTE_PREREQ_OR_BONUSES(); iJ++)
+		{
+			if (GC.getRouteInfo(eRoute).getPrereqOrBonus(iJ) == eBonus)
+			{
+				iTempValue += 40;
+			}
+		}
+		if ((eBestRoute != NO_ROUTE) && (GC.getRouteInfo(eBestRoute).getValue() <= GC.getRouteInfo(eRoute).getValue()))
+		{
+			iValue += iTempValue;
+		}
+		else
+		{
+			iValue += iTempValue / 2;
+		}
+	}
+
+	return iValue / 10;
+}
+
+// Diplomacy switch 4: how much we want a tech another team could give us: its trade value to us,
+// four times over if we are researching it or have queued it, twice if we could research it now.
+int CvPlayerAI::AI_techOfferValue(TechTypes eTech, TeamTypes eFromTeam) const
+{
+	int iValue = GET_TEAM(getTeam()).AI_techTradeVal(eTech, eFromTeam);
+	if (getCurrentResearch() == eTech || getQueuePosition(eTech) > 0)
+	{
+		iValue *= 4;
+	}
+	else if (canResearch(eTech))
+	{
+		iValue *= 2;
+	}
+	return std::max(1, iValue);
+}
