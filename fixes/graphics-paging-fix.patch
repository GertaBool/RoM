--- a/Assets/CvGameCoreDLL/CvPlot.cpp
+++ b/Assets/CvGameCoreDLL/CvPlot.cpp
@@ -223,6 +223,9 @@ void CvPlot::reset(int iX, int iY, bool bConstructorCall)
 	m_bPlotLayoutDirty = false;
 	m_bLayoutStateWorked = false;
 	m_bGraphicsPagedOut = false;
+	m_bPagedPlots = false;
+	m_bPagedBuilder = false;
+	m_bPagedSymbols = false;
 	
 	m_eOwner = NO_PLAYER;
 	m_ePlotType = PLOT_OCEAN;
@@ -274,6 +277,9 @@ void CvPlot::setupGraphical()
 	}
 
 	m_bGraphicsPagedOut = false;
+	m_bPagedPlots = false;
+	m_bPagedBuilder = false;
