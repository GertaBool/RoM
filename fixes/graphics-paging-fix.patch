 Assets/CvGameCoreDLL/CvGame.cpp              | 25 ++++++-
 Assets/CvGameCoreDLL/CvGame.h                |  6 ++
 Assets/CvGameCoreDLL/CvPlot.cpp              | 71 ++++++++++++++------
 Assets/CvGameCoreDLL/CvPlot.h                |  3 +
 Assets/CvGameCoreDLL/CvUnit.cpp              |  2 +-
 Assets/Python/EntryPoints/CvGameInterface.py |  2 +-
 Assets/XML/GlobalDefinesAlt.xml              | 20 ++++++
 8 files changed, 106 insertions(+), 25 deletions(-)

diff --git a/Assets/CvGameCoreDLL/CvCity.cpp b/Assets/CvGameCoreDLL/CvCity.cpp
index 749fdcb..46cd124 100644
--- a/Assets/CvGameCoreDLL/CvCity.cpp
+++ b/Assets/CvGameCoreDLL/CvCity.cpp
@@ -742,7 +742,7 @@ void CvCity::setupGraphical()
 	}
 
 	// Graphics paging: far from the camera the city keeps a bare entity until the camera comes near.
-	if (GC.getGameINLINE().isGraphicsPaging() && canPageGraphicsOut() && !GC.getGameINLINE().isInGraphicsWindow(getX_INLINE(), getY_INLINE(), true))
+	if (GC.getGameINLINE().isGraphicsPaging() && GC.getDefineINT("GRAPHICS_PAGING_CITIES") > 0 && canPageGraphicsOut() && !GC.getGameINLINE().isInGraphicsWindow(getX_INLINE(), getY_INLINE(), true))
 	{
 		pageGraphics(false);
 		return;
