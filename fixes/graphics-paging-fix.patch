 	updateSymbols();
 	updateFeatureSymbol();
@@ -283,8 +289,10 @@ void CvPlot::setupGraphical()
 	updateVisibility();
 }
 
-// Out: the feature and route symbols and the plot builder (bonuses, improvements) are destroyed, as uninit does,
-// and with GRAPHICS_PAGING_SYMBOLS the yield symbols and unit flags. In: they are made again. Rivers and the terrain stay.
+// Out: with GRAPHICS_PAGING_PLOTS the feature and route symbols are destroyed, with GRAPHICS_PAGING_PLOT_BUILDERS
+// the plot builder (bonuses, improvements), as uninit does, and with GRAPHICS_PAGING_SYMBOLS the yield symbols
+// and unit flags. In: they are made again. Rivers and the terrain stay. Vanilla destroys a plot builder only in
+// uninit, so GRAPHICS_PAGING_PLOT_BUILDERS is 0 unless the executable is shown to take it.
 bool CvPlot::pageGraphics(bool bIn)
 {
 	if (!GC.IsGraphicsInitialized())
@@ -300,11 +308,21 @@ bool CvPlot::pageGraphics(bool bIn)
 		}
 
 		m_bGraphicsPagedOut = false;
-		updateFeatureSymbol(true);
-		updateRouteSymbol(true, false);
-		setLayoutDirty(true);
-		updateSymbols();
-		setFlagDirty(true);
+		if (m_bPagedPlots)
+		{
+			updateFeatureSymbol(true);
+			updateRouteSymbol(true, false);
+		}
+		if (m_bPagedBuilder)
+		{
+			setLayoutDirty(true);
+		}
+		if (m_bPagedSymbols)
+		{
+			updateSymbols();
+			setFlagDirty(true);
+		}
+		m_bPagedPlots = m_bPagedBuilder = m_bPagedSymbols = false;
 		return true;
 	}
 
@@ -313,14 +331,29 @@ bool CvPlot::pageGraphics(bool bIn)
 		return false;
 	}
 
-	gDLL->getFeatureIFace()->destroy(m_pFeatureSymbol);
-	gDLL->getRouteIFace()->destroy(m_pRouteSymbol);
-	if (m_pPlotBuilder != NULL)
+	CvGame& kGame = GC.getGameINLINE();
+	m_bPagedPlots = kGame.isGraphicsPagingPlots();
+	m_bPagedBuilder = kGame.isGraphicsPagingBuilders();
+	m_bPagedSymbols = kGame.isGraphicsPagingSymbols();
+	if (!m_bPagedPlots && !m_bPagedBuilder && !m_bPagedSymbols)
 	{
-		gDLL->getPlotBuilderIFace()->destroy(m_pPlotBuilder);
+		return false;
 	}
-	m_bPlotLayoutDirty = false;
-	if (GC.getGameINLINE().isGraphicsPagingSymbols())
+
+	if (m_bPagedPlots)
+	{
+		gDLL->getFeatureIFace()->destroy(m_pFeatureSymbol);
+		gDLL->getRouteIFace()->destroy(m_pRouteSymbol);
+	}
+	if (m_bPagedBuilder)
+	{
+		if (m_pPlotBuilder != NULL)
+		{
+			gDLL->getPlotBuilderIFace()->destroy(m_pPlotBuilder);
+		}
+		m_bPlotLayoutDirty = false;
+	}
+	if (m_bPagedSymbols)
 	{
 		// G4: the yield symbols and unit flags go too; page-in rebuilds them (updateSymbols, setFlagDirty)
 		deleteAllSymbols();
@@ -747,7 +780,7 @@ void CvPlot::updateSymbols()
 {
 	//PROFILE_FUNC();
 
-	if (!GC.IsGraphicsInitialized() || (m_bGraphicsPagedOut && GC.getGameINLINE().isGraphicsPagingSymbols()))
+	if (!GC.IsGraphicsInitialized() || (m_bGraphicsPagedOut && m_bPagedSymbols))
