 	{
 		return;
 	}
@@ -8047,7 +8080,7 @@ void CvPlot::updateRouteSymbol(bool bForce, bool bAdjacent)
 		}
 	}
 
-	if (m_bGraphicsPagedOut)
+	if (m_bGraphicsPagedOut && m_bPagedPlots)
 	{
 		return;
 	}
@@ -8191,7 +8224,7 @@ void CvPlot::updateFlagSymbol()
 {
 	//PROFILE_FUNC();
 
-	if (!GC.IsGraphicsInitialized() || (m_bGraphicsPagedOut && GC.getGameINLINE().isGraphicsPagingSymbols()))
+	if (!GC.IsGraphicsInitialized() || (m_bGraphicsPagedOut && m_bPagedSymbols))
 	{
 		return;
 	}
@@ -9544,7 +9577,7 @@ void CvPlot::write(FDataStreamBase* pStream)
 
 void CvPlot::setLayoutDirty(bool bDirty)
 {
-	if (!GC.IsGraphicsInitialized() || m_bGraphicsPagedOut)
+	if (!GC.IsGraphicsInitialized() || (m_bGraphicsPagedOut && m_bPagedBuilder))
 	{
 		return;
 	}
