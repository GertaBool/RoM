+}
+
+bool CvGame::isGraphicsPagingBuilders() const
+{
+	return m_bGraphicsPagingBuilders;
+}
+
 bool CvGame::isInGraphicsWindow(int iX, int iY, bool bMargin) const
 {
 	if (!m_bGraphicsPaging)
@@ -2332,6 +2346,10 @@ void CvGame::updateGraphicsPaging()
 
 	m_bGraphicsPaging = true;
 	m_bGraphicsPagingSymbols = (GC.getDefineINT("GRAPHICS_PAGING_SYMBOLS") > 0);
+	m_bGraphicsPagingUnits = (GC.getDefineINT("GRAPHICS_PAGING_UNITS") > 0);
+	m_bGraphicsPagingCities = (GC.getDefineINT("GRAPHICS_PAGING_CITIES") > 0);
+	m_bGraphicsPagingPlots = (GC.getDefineINT("GRAPHICS_PAGING_PLOTS") > 0);
+	m_bGraphicsPagingBuilders = (GC.getDefineINT("GRAPHICS_PAGING_PLOT_BUILDERS") > 0);
 	if (bMoved)
 	{
 		m_iPagingX = pLookAt->getX_INLINE();
@@ -2391,7 +2409,8 @@ void CvGame::pageGraphics(bool bAllIn)
 		if (iWant != 0)
 		{
 			bool bIn = (iWant > 0);
-			if (pPlot->pageGraphics(bIn))
+			bool bPlotPart = (m_bGraphicsPagingPlots || m_bGraphicsPagingBuilders || m_bGraphicsPagingSymbols);
+			if ((bIn || bPlotPart) && pPlot->pageGraphics(bIn))
 			{
 				(bIn ? aiIn : aiOut)[0]++;
 			}
@@ -2402,14 +2421,14 @@ void CvGame::pageGraphics(bool bAllIn)
 				CvUnit* pLoopUnit = ::getUnit(pUnitNode->m_data);
 				pUnitNode = pPlot->nextUnitNode(pUnitNode);
 
-				if (pLoopUnit != NULL && pLoopUnit->pageGraphics(bIn))
+				if (pLoopUnit != NULL && (bIn || m_bGraphicsPagingUnits) && pLoopUnit->pageGraphics(bIn))
 				{
 					(bIn ? aiIn : aiOut)[1]++;
 				}
 			}
 
 			CvCity* pCity = pPlot->getPlotCity();
-			if (pCity != NULL && pCity->pageGraphics(bIn))
+			if (pCity != NULL && (bIn || m_bGraphicsPagingCities) && pCity->pageGraphics(bIn))
 			{
 				(bIn ? aiIn : aiOut)[2]++;
 			}
