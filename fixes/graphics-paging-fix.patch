 bool CvPlot::updatePlotBuilder()
 {
-	if (GC.IsGraphicsInitialized() && !m_bGraphicsPagedOut && shouldUsePlotBuilder())
+	if (GC.IsGraphicsInitialized() && !(m_bGraphicsPagedOut && m_bPagedBuilder) && shouldUsePlotBuilder())
 	{
 		if (m_pPlotBuilder == NULL) // we need a plot builder... but it doesn't exist
 		{
