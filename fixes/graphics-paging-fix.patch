 # Rise of Mankind: the camera zoom for graphics paging (CvGame::updateGraphicsPaging), in thousandths.
-def getCameraZoom():
+def getCameraZoom(argsList=None):
 	return int(CyCamera().GetZoom() * 1000)
 
diff --git a/Assets/XML/GlobalDefinesAlt.xml b/Assets/XML/GlobalDefinesAlt.xml
index 1c1ba2d..fd46b3c 100644
--- a/Assets/XML/GlobalDefinesAlt.xml
+++ b/Assets/XML/GlobalDefinesAlt.xml
@@ -938,6 +938,26 @@
 		<DefineName>GRAPHICS_PAGING_ZOOM_MIN_PERCENT</DefineName>
 		<iDefineIntVal>35</iDefineIntVal>
 	</Define>
+	<!-- 1: units of other players far from the camera keep a bare entity; 0: they keep theirs -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING_UNITS</DefineName>
+		<iDefineIntVal>1</iDefineIntVal>
+	</Define>
+	<!-- 1: cities of other players far from the camera keep a bare entity; 0: they keep theirs -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING_CITIES</DefineName>
+		<iDefineIntVal>1</iDefineIntVal>
+	</Define>
+	<!-- 1: plots far from the camera drop their feature and route symbols; 0: they keep them -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING_PLOTS</DefineName>
+		<iDefineIntVal>1</iDefineIntVal>
+	</Define>
+	<!-- 1: plots far from the camera also drop their plot builder (bonus and improvement art). 0 by default: vanilla destroys a plot builder only when the game ends, and the build that destroyed them froze at the first city founded -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING_PLOT_BUILDERS</DefineName>
+		<iDefineIntVal>0</iDefineIntVal>
+	</Define>
 	<!-- 1: paged-out plots also drop their yield symbols and unit flags (rebuilt when the camera comes near); 0: they keep them -->
 	<Define>
 		<DefineName>GRAPHICS_PAGING_SYMBOLS</DefineName>
