+#!/usr/bin/env python3
+"""Execute production fragments with narrow adapters; no BTS/DLL run is claimed.
+
+--source can point at an exported baseline to verify these tests detect the bugs.
+"""
+import argparse
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+import textwrap
+import types
+import unittest
+
+parser = argparse.ArgumentParser(add_help=False)
+parser.add_argument('--source', type=Path, default=Path(__file__).resolve().parents[1])
+args, remaining = parser.parse_known_args()
+ROOT = args.source
+DLL = ROOT / 'Assets/CvGameCoreDLL'
+
+
+def block(text, signature):
+    start = text.index(signature)
+    clean = re.sub(r'"(?:\\.|[^"\\])*"|/\*[\s\S]*?\*/|//[^\n]*',
+                   lambda m: re.sub(r'[^\n]', ' ', m[0]), text)
+    begin = clean.index('{', start)
+    depth, end = 1, begin + 1
+    while depth:
+        depth += (clean[end] == '{') - (clean[end] == '}')
+        end += 1
+    return text[start:end]
+
+
+def body(text, signature):
+    result = block(text, signature)
+    return result[result.index('{') + 1:-1]
+
+
+def compile_run(program):
+    with tempfile.TemporaryDirectory(prefix='rom-correctness-') as folder:
+        cpp, exe = Path(folder) / 'test.cpp', Path(folder) / 'test'
+        cpp.write_text(program)
+        subprocess.run(['g++', '-std=c++03', '-Wall', '-Wextra', '-Werror',
+                        '-fsanitize=undefined', '-fno-sanitize-recover=undefined',
+                        '-I', str(DLL), str(cpp), '-o', str(exe)], check=True)
+        subprocess.run([str(exe)], check=True)
+
+
+class NativeTests(unittest.TestCase):
+    def test_canal_value_and_existing_guards(self):
+        method = block((DLL / 'CvPlayerAI.cpp').read_text(),
+                       'int CvPlayerAI::AI_getPlotCanalValue(')
+        compile_run(r'''
+#include <algorithm>
+#include <cassert>
+#include <cstddef>
+#define PROFILE_FUNC() ((void)0)
+#define FAssert(x) assert(x)
+typedef int DirectionTypes;
+enum {NO_BUILD=-1, NO_IMPROVEMENT=-1, NUM_DIRECTION_TYPES=8};
+struct CvArea {int tiles; int getNumTiles()const{return tiles;}};
+struct CvPlot;
+struct CvCity {int build; int AI_getBestBuild(int)const{return build;}
+ int getCityPlotIndex(CvPlot*)const{return 0;}};
+struct CvImprovementInfo {bool city; bool isActsAsCity()const{return city;}};
+struct Globals {CvImprovementInfo info;
+ CvImprovementInfo& getImprovementInfo(int){return info;}} GC;
+struct CvPlot {
+ bool owned,radius,city; int team,improvement; CvArea* water; CvCity* working;
