index 3780dd5..353f100 100644
--- a/Assets/CvGameCoreDLL/AIMissionTargetIndex.h
+++ b/Assets/CvGameCoreDLL/AIMissionTargetIndex.h
@@ -170,6 +170,126 @@ namespace AIMissionTargetIndex
 		std::vector<int> m_aiStamp;
 		std::vector<Entry> m_aEntries;
 	};
+
+	// Exact index for CvPlayerAI::AI_unitTargetMissionAIs: the groups whose
+	// mission targets a unit, bucketed by that unit's owner and ID. AI_group asks
+	// it once per candidate group, so walking every group made one AI_group call
+	// O(candidates x groups). Same invalidation contract as Index.
+	//
+	// The first query of an epoch is answered by the caller's own walk (no
+	// build); a second query in the same epoch builds the index in O(groups).
+	// One query per epoch therefore costs what it did before, and loops pay for
+	// one walk and one build instead of one walk per query.
+	struct UnitEntry
+	{
+		void* pGroup;
+		int iTargetOwner;
+		int iTargetID;
+		int iMissionAI;
+		int iUnits;
+		int iNext;
+	};
+
+	class UnitIndex
+	{
+	public:
+		enum { NUM_BUCKETS = 1024 };
+
+		UnitIndex() : m_iOwner(-1), m_uiEpoch(0), m_iQueries(0), m_bBuilt(false), m_iStamp(1),
+			m_aiHead(NUM_BUCKETS, -1), m_aiStamp(NUM_BUCKETS, 0) {}
+
+		// Records a query; true when the index should answer it.
+		bool noteQuery(const int iOwner, const unsigned int uiEpoch)
+		{
+			if (m_iOwner != iOwner || m_uiEpoch != uiEpoch)
+			{
+				m_iOwner = iOwner;
+				m_uiEpoch = uiEpoch;
+				m_iQueries = 0;
+				m_bBuilt = false;
+			}
+			++m_iQueries;
+			return m_iQueries > 1;
+		}
+
+		bool isBuilt() const
+		{
+			return m_bBuilt;
+		}
+
+		void begin()
+		{
+			m_aEntries.clear();
+			if (m_iStamp == INT_MAX)
+			{
+				m_aiStamp.assign(NUM_BUCKETS, 0);
+				m_iStamp = 0;
+			}
+			++m_iStamp;
+			m_bBuilt = true;
+		}
+
+		void invalidate()
+		{
+			m_iOwner = -1;
+			m_bBuilt = false;
+		}
+
+		void add(const int iTargetOwner, const int iTargetID, const int iMissionAI, const int iUnits, void* pGroup)
+		{
+			const int iBucket = bucket(iTargetOwner, iTargetID);
+			UnitEntry kEntry;
+			kEntry.pGroup = pGroup;
+			kEntry.iTargetOwner = iTargetOwner;
+			kEntry.iTargetID = iTargetID;
+			kEntry.iMissionAI = iMissionAI;
+			kEntry.iUnits = iUnits;
+			kEntry.iNext = head(iBucket);
+			m_aiStamp[iBucket] = m_iStamp;
+			m_aiHead[iBucket] = (int)m_aEntries.size();
+			m_aEntries.push_back(kEntry);
+		}
+
+		int numEntries() const
+		{
+			return (int)m_aEntries.size();
+		}
+
+		// Calls kVisitor(const UnitEntry&) for every group aimed at the unit.
+		template <class Visitor>
+		void visit(const int iTargetOwner, const int iTargetID, Visitor& kVisitor) const
+		{
+			for (int iEntry = head(bucket(iTargetOwner, iTargetID)); iEntry != -1; iEntry = m_aEntries[iEntry].iNext)
+			{
+				const UnitEntry& kEntry = m_aEntries[iEntry];
+				if (kEntry.iTargetOwner == iTargetOwner && kEntry.iTargetID == iTargetID)
+				{
+					kVisitor(kEntry);
+				}
+			}
+		}
+
+	private:
+		static int bucket(const int iTargetOwner, const int iTargetID)
+		{
+			const unsigned int uiKey = (unsigned int)iTargetID * 2654435761u + (unsigned int)iTargetOwner * 40503u;
+			return (int)((uiKey >> 16) % NUM_BUCKETS);
+		}
+
+		int head(const int iBucket) const
+		{
+			return (m_aiStamp[iBucket] == m_iStamp) ? m_aiHead[iBucket] : -1;
+		}
+
+		int m_iOwner;
+		unsigned int m_uiEpoch;
+		int m_iQueries;
+		bool m_bBuilt;
+		int m_iStamp;
+		std::vector<int> m_aiHead;
+		std::vector<int> m_aiStamp;
+		std::vector<UnitEntry> m_aEntries;
+	};
 }
 
 #endif
diff --git a/Assets/CvGameCoreDLL/AIPathReuse.h b/Assets/CvGameCoreDLL/AIPathReuse.h
new file mode 100644
index 0000000..ba9594d
--- /dev/null
+++ b/Assets/CvGameCoreDLL/AIPathReuse.h
@@ -0,0 +1,64 @@
+#ifndef AI_PATH_REUSE_H
+#define AI_PATH_REUSE_H
+
+// Who may continue a path finder's previous search.
+//
+// The engine's A* (FAStar) continues its last search tree when asked to reuse
+// and the start plot and flags are unchanged. That tree, including the moves
+// the group had when it was started, describes one group in one state. Reusing
+// it for another group, for the same group after its membership changed, after
+// it spent moves without moving (pillage, fortify) or on a later turn gives
+// stale turn counts. Owner admits reuse only when all of that is unchanged.
+//
+// Each finder has its own Owner. Queries made on behalf of a group other than
+// the one that is planning go to a second finder, so the planner's incremental
+// search survives them (CvSelectionGroup::generatePathSecondary).
+namespace AIPathReuse
+{
+	struct Key
+	{
+		const void* pGroup;
+		unsigned int uiGroupsEpoch;	// bumped on any group membership or mission change
+		int iTurn;
+		int iMovesLeft;			// least moves left in the group: the start node's moves
+	};
+
+	inline bool sameKey(const Key& kA, const Key& kB)
+	{
+		return kA.pGroup == kB.pGroup && kA.uiGroupsEpoch == kB.uiGroupsEpoch &&
+			kA.iTurn == kB.iTurn && kA.iMovesLeft == kB.iMovesLeft;
+	}
+
+	class Owner
+	{
+	public:
+		Owner() : m_bValid(false)
+		{
+			m_kLast.pGroup = 0;
+			m_kLast.uiGroupsEpoch = 0;
+			m_kLast.iTurn = 0;
+			m_kLast.iMovesLeft = 0;
+		}
+
+		// Whether the caller's reuse request may be passed to the engine. The
+		// finder will hold kKey's search afterwards, so it becomes the owner.
+		bool admit(const Key& kKey, const bool bReuse)
+		{
+			const bool bAdmit = bReuse && m_bValid && sameKey(m_kLast, kKey);
+			m_kLast = kKey;
+			m_bValid = true;
+			return bAdmit;
+		}
+
+		void invalidate()
+		{
+			m_bValid = false;
+		}
+
+	private:
+		Key m_kLast;
+		bool m_bValid;
+	};
+}
+
+#endif
