+#!/usr/bin/env python3
+"""Path finder reuse ownership and the second finder for other groups' queries.
+
+The engine's A* continues its previous search when asked to reuse and the start
+plot and flags match; it cannot know which group or which unit state the stored
+tree describes. The production generatePath code from CvSelectionGroup.cpp is
+compiled against a mock engine with exactly that rule. The mock answers a reused
+query from the stored tree, so a tree reused for the wrong group or state shows
+up as a wrong turn count. The tests check that:
+
+* reuse is admitted only for the same group, membership epoch, turn and moves;
+* every answer equals a fresh search for the querying group;
+* queries for other groups no longer discard the planner's reusable search
+  (the AI_pickTargetCity pattern: one search per city before, one in total now);
+* the call sites that query other groups use the second finder, and the second
+  finder is created with the others and released before the engine shuts down.
+"""
+from pathlib import Path
+import re
+import unittest
+from test_review_correctness import DLL, block, compile_run
+
+GROUP_CPP = (DLL / "CvSelectionGroup.cpp").read_text(errors="replace")
+PLAYER_CPP = (DLL / "CvPlayerAI.cpp").read_text(errors="replace")
+UNIT_CPP = (DLL / "CvUnitAI.cpp").read_text(errors="replace")
+
+
+def code(text):
+    return re.sub(r"/\*.*?\*/|//[^\n]*", "", text, flags=re.S)
+
+
+def production():
+    names = block(GROUP_CPP, "namespace\n{\n\tunsigned int s_uiMissionTargetsEpoch = 0;")
+    parts = [names]
+    for signature in ("void CvSelectionGroup::noteMissionTargetsChanged()",
+                      "unsigned int CvSelectionGroup::getMissionTargetsEpoch()",
+                      "bool CvSelectionGroup::generatePath(",
+                      "bool CvSelectionGroup::generatePathSecondary(",
+                      "void CvSelectionGroup::initSecondaryPathFinder(",
+                      "void CvSelectionGroup::releaseSecondaryPathFinder()"):
+        parts.append(block(GROUP_CPP, signature))
+    return "\n".join(parts)
+
+
+HOST = r'''
+#include <algorithm>
+#include <cassert>
+#include <climits>
+#include <cstddef>
+#include <vector>
+#include "AIPathReuse.h"
+#define PROFILE(x) ;	/* the engine macro is a statement; the source omits the semicolon */
+#define FAssertMsg(x, m) assert(x)
+const int MAX_INT = INT_MAX;
+
+struct IDInfo { int iID; };
+template <class T> struct CLLNode { T m_data; CLLNode* next; };
+struct CvUnit { int iMoves; int movesLeft() const { return iMoves; } };
+std::vector<CvUnit*> g_units;
+CvUnit* getUnit(const IDInfo& kInfo) { return g_units[kInfo.iID]; }
+
+struct CvPlot { int x, y; int getX_INLINE() const { return x; } int getY_INLINE() const { return y; } };
+struct FAStarNode { int m_iData1, m_iData2; };
+
+class CvSelectionGroup;
+// Engine model: a group's turns to a destination are distance / speed, where the
+// speed is fixed when a search is started (the start node's moves).
+struct FAStar
+{
+	bool bTree; int iStartX, iStartY, iFlags; int iTreeSpeed; FAStarNode kLast;
+	const void* pData; int iFresh, iReused;
+	FAStar() : bTree(false), iStartX(0), iStartY(0), iFlags(0), iTreeSpeed(1), pData(NULL), iFresh(0), iReused(0) {}
+};
+int speedOf(const void* pGroup);
+struct FAStarIFace
+{
+	void SetData(FAStar* p, const void* pData) { p->pData = pData; }
+	bool GeneratePath(FAStar* p, int x1, int y1, int x2, int y2, bool, int iFlags, bool bReuse)
+	{
+		if (bReuse && p->bTree && p->iStartX == x1 && p->iStartY == y1 && p->iFlags == iFlags)
+		{
+			++p->iReused;		// continue the stored tree: its speed is whatever it was
+		}
+		else
+		{
+			++p->iFresh;
+			p->bTree = true; p->iStartX = x1; p->iStartY = y1; p->iFlags = iFlags;
+			p->iTreeSpeed = speedOf(p->pData);
+		}
+		const int iDistance = std::max(std::abs(x2 - x1), std::abs(y2 - y1));
+		p->kLast.m_iData1 = 0;
+		p->kLast.m_iData2 = (iDistance + p->iTreeSpeed - 1) / p->iTreeSpeed;
+		return true;
+	}
+	FAStarNode* GetLastNode(FAStar* p) { return &p->kLast; }
+	FAStar* create() { return new FAStar(); }
+	void destroy(FAStar*& p, bool = true) { delete p; p = NULL; }
+	void Initialize(FAStar* p, int, int, bool, bool, void*, void*, void*, void*, void*, void*, void*) { p->bTree = false; }
+};
+struct DLL { FAStarIFace kStar; FAStarIFace* getFAStarIFace() { return &kStar; } } g_dll;
+DLL* gDLL = &g_dll;
+struct Game { int iTurn; int getGameTurn() const { return iTurn; } };
+struct Globals
+{
+	Game kGame; FAStar kPathFinder;
+	Game& getGameINLINE() { return kGame; }
+	FAStar& getPathFinder() { return kPathFinder; }
+} GC;
+void* pathDestValid = 0; void* pathHeuristic = 0; void* pathCost = 0; void* pathValid = 0; void* pathAdd = 0;
+
+class CvSelectionGroup
+{
+public:
+	std::vector<CLLNode<IDInfo> > aNodes;
+	CLLNode<IDInfo>* headUnitNode() const { return aNodes.empty() ? NULL : const_cast<CLLNode<IDInfo>*>(&aNodes[0]); }
+	CLLNode<IDInfo>* nextUnitNode(CLLNode<IDInfo>* p) const { return p->next; }
+	void setUnits(const std::vector<int>& aiUnits)
+	{
+		aNodes.resize(aiUnits.size());
+		for (size_t i = 0; i < aiUnits.size(); ++i)
+		{
+			aNodes[i].m_data.iID = aiUnits[i];
+			aNodes[i].next = (i + 1 < aiUnits.size()) ? &aNodes[i + 1] : NULL;
+		}
+	}
+	static void noteMissionTargetsChanged();
+	static unsigned int getMissionTargetsEpoch();
+	bool generatePath(const CvPlot*, const CvPlot*, int iFlags = 0, bool bReuse = false, int* piPathTurns = NULL) const;
+	bool generatePathSecondary(const CvPlot*, const CvPlot*, int iFlags = 0, bool bReuse = false, int* piPathTurns = NULL) const;
+	static void initSecondaryPathFinder(int, int, bool, bool);
+	static void releaseSecondaryPathFinder();
+};
+int speedOf(const void* pGroup)
+{
+	const CvSelectionGroup* g = static_cast<const CvSelectionGroup*>(pGroup);
+	int iSpeed = INT_MAX;
+	for (CLLNode<IDInfo>* p = g->headUnitNode(); p != NULL; p = g->nextUnitNode(p)) iSpeed = std::min(iSpeed, ::getUnit(p->m_data)->iMoves);
+	return std::max(1, iSpeed);
+}
+'''
+
+
+def program(main):
+    return HOST + production() + "\n" + main
+
