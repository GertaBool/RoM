+#!/usr/bin/env python3
+"""Execute corrected unit AI decisions with explicit host adapters.
+
+* AI_choke: a siege stack keeps the best choke plot (formerly the last reachable
+  plot in scan order) and scores every plot with one reusable path search.
+* AI_assaultSeaReinforce: a synchronized landing is joined only when the cargo
+  can fight there (the check was computed and ignored); an empty city is not
+  rejected for lacking defenders.
+* AI_bestCityBuild: plots are compared by value per turn of travel.
+* AI_settleMove: a settler standing on its accepted site founds even when its
+  escort is gone, instead of walking home; the danger and escort rules still
+  apply everywhere else.
+"""
+import unittest
+from test_review_correctness import DLL, remaining, block, compile_run
+
+UNIT_CPP = (DLL / "CvUnitAI.cpp").read_text(errors="replace")
+
+COMMON = r'''
+#include <algorithm>
+#include <cassert>
+#include <climits>
+#include <cstdlib>
+#include <cstddef>
+#include <vector>
+#define PROFILE_FUNC() ((void)0)
+#define FAssert(x) assert(x)
+#define FAssertMsg(x, m) assert(x)
