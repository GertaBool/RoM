new file mode 100644
index 0000000..b43cfb6
--- /dev/null
+++ b/Tools/test_group_queries.py
@@ -0,0 +1,295 @@
+#!/usr/bin/env python3
+"""Group queries used by escort grouping, transport waiting and threat checks.
+
+* CvPlayerAI::AI_unitTargetMissionAIs (asked once per candidate group by
+  AI_group) is compared with the original walk over randomized group sets,
+  mission types, skip groups, wildcard requests and path limits, with the world
+  mutating between queries. The index must answer repeated queries of an epoch
+  after one walk and one build. A group with no path that cannot all move this
+  turn used to overflow MAX_INT + 1 and count as arriving; it must not count.
+* CvPlayerAI::AI_isPlotThreatened is compared with the original per-unit loop;
+  each enemy group may be searched only once per call.
+
+The production functions are compiled from CvPlayerAI.cpp against host adapters.
+"""
+import re
+import unittest
+from test_review_correctness import DLL, remaining, block, compile_run
+
+PLAYER_CPP = (DLL / "CvPlayerAI.cpp").read_text(errors="replace")
+
+
+def unit_target_source():
+    parts = []
+    if "int unitTargetGroupCount(" in PLAYER_CPP:
+        parts.append(block(PLAYER_CPP, "namespace\n{\n\tAIMissionTargetIndex::UnitIndex s_kUnitTargetIndex;"))
+    parts.append(block(PLAYER_CPP, "int CvPlayerAI::AI_unitTargetMissionAIs(CvUnit* pUnit, MissionAITypes* aeMissionAI, "
+                                   "int iMissionAICount, CvSelectionGroup* pSkipSelectionGroup, int iMaxPathTurns) const"))
+    return "\n".join(parts)
+
+
+HOST = r'''
+#include <algorithm>
+#include <cassert>
+#include <climits>
+#include <cstdlib>
+#include <cstddef>
+#include <utility>
+#include <vector>
+#include "AIMissionTargetIndex.h"
+#define PROFILE_FUNC() ((void)0)
+const int MAX_INT = INT_MAX;
+enum MissionAITypes { NO_MISSIONAI = -1, MISSIONAI_A, MISSIONAI_B, MISSIONAI_C };
+enum { MOVE_MAX_MOVES = 1, MOVE_IGNORE_DANGER = 2, DANGER_RANGE = 4 };
+unsigned int g_epoch = 0;
+long g_pathQueries = 0;
+struct CvPlot { int x, y; int area; int getX_INLINE() const { return x; } int getY_INLINE() const { return y; } int area_() const { return area; } };
+struct CvUnit;
+struct CvSelectionGroup
+{
+	int id; CvPlot* pAt; CvUnit* pTarget; MissionAITypes eAI; int iUnits; bool bAllMove; int iTurns;	// iTurns < 0: no path
+	CvUnit* AI_getMissionAIUnit() const { return pTarget; }
+	MissionAITypes AI_getMissionAIType() const { return eAI; }
+	int getNumUnits() const { return iUnits; }
+	CvPlot* plot() const { return pAt; }
+	bool canAllMove() const { return bAllMove; }
+	bool query(int* piTurns) const { ++g_pathQueries; *piTurns = iTurns < 0 ? MAX_INT : iTurns; return iTurns >= 0; }
+	bool generatePath(const CvPlot*, const CvPlot*, int, bool, int* piTurns) const { return query(piTurns); }
+	bool generatePathSecondary(const CvPlot*, const CvPlot*, int, bool, int* piTurns) const { return query(piTurns); }
+	static unsigned int getMissionTargetsEpoch() { return g_epoch; }
+};
+struct CvUnit
+{
+	int owner, id; CvPlot* pAt; CvSelectionGroup* pGroup; bool enemy, attack, invisible, canEnter;
+	int getOwnerINLINE() const { return owner; } int getID() const { return id; }
+	CvPlot* plot() const { return pAt; }
+	CvSelectionGroup* getGroup() const { return pGroup; }
+};
+std::vector<CvSelectionGroup*> g_groups;
+struct CvPlayerAI
+{
+	int getID() const { return 0; }
+	CvSelectionGroup* firstSelectionGroup(int* p) const { *p = 0; return g_groups.empty() ? NULL : g_groups[0]; }
+	CvSelectionGroup* nextSelectionGroup(int* p) const { ++*p; return (size_t)*p < g_groups.size() ? g_groups[*p] : NULL; }
+	int AI_unitTargetMissionAIs(CvUnit* pUnit, MissionAITypes* aeMissionAI, int iMissionAICount, CvSelectionGroup* pSkipSelectionGroup, int iMaxPathTurns) const;
+};
+'''
+
+REFERENCE = r'''
+// The original walk, with the overflow removed (no path keeps MAX_INT).
+int reference(CvUnit* pUnit, MissionAITypes* ae, int n, CvSelectionGroup* pSkip, int iMax)
+{
+	int iCount = 0;
+	for (size_t g = 0; g < g_groups.size(); ++g)
+	{
+		CvSelectionGroup* p = g_groups[g];
+		if (p == pSkip || p->AI_getMissionAIUnit() != pUnit) continue;
+		long long iTurns = MAX_INT;
+		if (iMax >= 0 && pUnit->plot() != NULL && p->plot() != NULL)
+		{
+			if (p->iTurns >= 0) iTurns = p->iTurns + (p->bAllMove ? 0 : 1);
+		}
+		if (iMax == -1 || iTurns <= iMax)
+			for (int i = 0; i < n; ++i)
+				if (p->eAI == ae[i] || ae[i] == NO_MISSIONAI) iCount += p->iUnits;
+	}
+	return iCount;
+}
+unsigned int seed = 31337u;
+int rnd(int n) { seed = seed * 1664525u + 1013904223u; return (int)((seed >> 8) % (unsigned int)n); }
+'''
+
+
+class GroupQueryTests(unittest.TestCase):
+    def test_unit_target_counts_match_the_original_walk(self):
+        compile_run(HOST + unit_target_source() + REFERENCE + r'''
+int main()
+{
+	CvPlot here = { 0, 0, 0 };
+	std::vector<CvUnit> units(30);
+	for (int i = 0; i < 30; ++i) { CvUnit u = { i % 3, 100 + i * 7, &here, NULL, false, false, false, false }; units[i] = u; }
+	std::vector<CvSelectionGroup> pool(60);
+	CvPlayerAI player;
+	long queries = 0;
+	for (int round = 0; round < 400; ++round)
+	{
+		g_groups.clear();
+		const int n = rnd(60);
+		for (int g = 0; g < n; ++g)
+		{
+			CvSelectionGroup k = { g, rnd(5) ? &here : NULL, rnd(4) ? &units[rnd(30)] : NULL,
+				(MissionAITypes)(rnd(4) - 1), 1 + rnd(5), rnd(2) == 0, rnd(4) - 1 };
+			pool[g] = k; g_groups.push_back(&pool[g]);
+		}
+		++g_epoch;
+		for (int q = 0; q < 25; ++q)
+		{
+			if (rnd(6) == 0 && n > 0) { pool[rnd(n)].pTarget = rnd(3) ? &units[rnd(30)] : NULL; ++g_epoch; }
+			MissionAITypes ae[3]; const int count = 1 + rnd(3);
+			for (int i = 0; i < count; ++i) ae[i] = (MissionAITypes)(rnd(4) - 1);
+			CvUnit* pUnit = &units[rnd(30)];
+			CvSelectionGroup* pSkip = (n > 0 && rnd(3) == 0) ? g_groups[rnd(n)] : NULL;
+			const int iMax = rnd(3) == 0 ? -1 : rnd(4);
+			const long before = g_pathQueries;
+			assert(player.AI_unitTargetMissionAIs(pUnit, ae, count, pSkip, iMax) == reference(pUnit, ae, count, pSkip, iMax));
+			// Path queries are only made for groups aimed at the unit.
+			int aimed = 0;
+			for (int g = 0; g < n; ++g) if (g_groups[g] != pSkip && g_groups[g]->pTarget == pUnit) ++aimed;
+			assert(g_pathQueries - before <= (iMax >= 0 ? aimed : 0));
+			++queries;
+		}
+	}
+	assert(queries == 400 * 25);
+
+	// The overflow case: no path, cannot all move, a path limit.
+	g_groups.clear();
+	CvSelectionGroup stuck = { 0, &here, &units[0], MISSIONAI_A, 4, false, -1 };
+	g_groups.push_back(&stuck);
+	MissionAITypes any = NO_MISSIONAI;
+	++g_epoch;
+	assert(player.AI_unitTargetMissionAIs(&units[0], &any, 1, NULL, 3) == 0);
+}
+''')
+
+    def test_repeated_queries_build_the_index_once(self):
+        if "int unitTargetGroupCount(" not in PLAYER_CPP:
+            self.fail("AI_unitTargetMissionAIs walks every group on every query")
+        compile_run(HOST + unit_target_source() + r'''
+int main()
+{
+	CvPlot here = { 0, 0, 0 };
+	std::vector<CvUnit> units(10);
+	for (int i = 0; i < 10; ++i) { CvUnit u = { 0, i, &here, NULL, false, false, false, false }; units[i] = u; }
+	std::vector<CvSelectionGroup> pool(500);
+	for (int g = 0; g < 500; ++g) { CvSelectionGroup k = { g, &here, &units[g % 10], MISSIONAI_A, 1, true, 1 }; pool[g] = k; g_groups.push_back(&pool[g]); }
+	CvPlayerAI player;
+	MissionAITypes a = MISSIONAI_A;
+	++g_epoch;
+	for (int i = 0; i < 10; ++i) assert(player.AI_unitTargetMissionAIs(&units[i], &a, 1, NULL, -1) == 50);
+	assert(s_kUnitTargetIndex.isBuilt() && s_kUnitTargetIndex.numEntries() == 500);
+	++g_epoch;	// a change: the next first query walks, the second rebuilds
+	assert(player.AI_unitTargetMissionAIs(&units[0], &a, 1, NULL, -1) == 50 && !s_kUnitTargetIndex.isBuilt());
+	assert(player.AI_unitTargetMissionAIs(&units[1], &a, 1, NULL, -1) == 50 && s_kUnitTargetIndex.isBuilt());
+}
+''')
+
+    def test_threat_check_searches_each_enemy_group_once(self):
+        method = block(PLAYER_CPP, "bool CvPlayerAI::AI_isPlotThreatened(CvPlot* pPlot, int iRange, bool bTestMoves) const")
+        compile_run(r'''
+#include <algorithm>
+#include <cassert>
+#include <climits>
+#include <cstddef>
+#include <utility>
+#include <vector>
+#define PROFILE_FUNC() ((void)0)
+const int MAX_INT = INT_MAX;
+enum { MOVE_MAX_MOVES = 1, MOVE_IGNORE_DANGER = 2, DANGER_RANGE = 4 };
+long g_pathQueries = 0;
+struct CvArea { int id; };
+CvArea areas[2] = { {0}, {1} };
+struct CvUnit;
+template <class T> struct CLLNode { T m_data; CLLNode* next; };
