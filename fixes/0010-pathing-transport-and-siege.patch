+	CvSelectionGroup groups[4];
+	for (int g = 0; g < 4; ++g) { std::vector<int> a; a.push_back(3 * g); a.push_back(3 * g + 1); groups[g].setUnits(a); }
+	CvPlot plots[6] = { {0, 0}, {5, 5}, {9, 2}, {3, 8}, {7, 7}, {1, 6} };
+	// What may validly be continued, per finder: same group, start, flags, epoch, turn and moves.
+	struct Last { const void* g; int x, y, flags; unsigned int epoch; int turn, speed; bool set; } last[2];
+	last[0].set = last[1].set = false;
