+#!/usr/bin/env python3
+"""Exercise transport ownership before the legacy unit-role switch.
+
+Uses actual entry/dispatch functions with synthetic engine/group/path adapters;
+ship emergency-retreat logic and the engine scheduler remain outside this test.
+"""
+import unittest
+from test_review_correctness import DLL, remaining, block, compile_run
+from test_ai_settler_dispatch import HOST
+
+
+class EntryTests(unittest.TestCase):
+    def test_manual_boarding_and_update_order(self):
+        source = (DLL / 'CvUnitAI.cpp').read_text()
+        host = HOST.replace('bool defense,movable;', 'bool defense,movable,human;')
+        host = host.replace('defense(false),movable(true)', 'defense(false),movable(true),human(false)')
+        host = host.replace('bool canDefend(){', 'bool isHuman(){return human;}bool canDefend(){')
+        host = host.replace('void AI_setUnitAIType(int r){role=r;}', 'void AI_setUnitAIType(int r){if(role!=r){role=r;joinGroup(NULL);}}')
+        host = host.replace('activeGroup=g?g:&group;if(!g)group.count=1;',
+                            'if(g)activeGroup=g;else{group=CvSelectionGroup();activeGroup=&group;}')
+        host = host.replace('void AI_clearSettlerSeaLoads();', '''void AI_separateSettlerTransports();
+ bool AI_handleSettlerTransport();
+ void AI_settlerSeaMove(){AI_settlerSeaTransport();}
+ void AI_clearSettlerSeaLoads();''')
+        host = host.replace('CvUnit settler,escort;', 'CvUnitAI settler,escort;')
+        host = host.replace('settler.role=UNITAI_SETTLE;',
+                            'settler.domain=escort.domain=DOMAIN_LAND;escort.role=UNITAI_ATTACK;settler.role=UNITAI_SETTLE;')
+        methods = '\n'.join(block(source, sig) for sig in [
+            'void CvUnitAI::AI_separateSettlerTransports()',
+            'bool CvUnitAI::AI_handleSettlerTransport()',
+            'bool CvUnitAI::AI_settlerSeaPath(',
+            'void CvUnitAI::AI_clearSettlerSeaLoads()',
+            'bool CvUnitAI::AI_settlerSeaTransport()'])
+        compile_run(host + methods + r'''
+int main(){
+ for(int order=0;order<2;++order){Fixture f;f.boat.role=UNITAI_ASSAULT_SEA;f.escort.transport=&f.boat;
+  // Manual arrangement has no FOUND mission. Both passenger roles must wait
+  // for the boat, regardless of whether passengers or boat update first.
+  assert(f.boat.group.job==NO_MISSIONAI);
+  if(order==0){assert(f.settler.AI_handleSettlerTransport());assert(f.escort.AI_handleSettlerTransport());}
+  assert(f.boat.AI_handleSettlerTransport());
+  if(order==1){assert(f.settler.AI_handleSettlerTransport());assert(f.escort.AI_handleSettlerTransport());}
+  assert(f.boat.role==UNITAI_SETTLER_SEA&&f.boat.group.job==MISSIONAI_FOUND);
+  assert(f.boat.group.mission==MISSION_MOVE_TO&&f.boat.group.target==&f.site);
+  assert(f.settler.transport==&f.boat&&f.escort.transport==&f.boat);
+ }
+ {Fixture f;f.boat.role=UNITAI_ASSAULT_SEA;f.boat.group.job=MISSIONAI_FOUND;f.boat.group.target=&f.site;
+  f.escort.transport=&f.boat;assert(f.boat.AI_handleSettlerTransport());
+  assert(f.boat.group.target==&f.site); // role mutation did not lose the destination
+ }
+ {Fixture f;f.boat.human=true;assert(!f.boat.AI_handleSettlerTransport());
+  f.settler.human=true;assert(!f.settler.AI_handleSettlerTransport());
+ }
+ {Fixture f;f.settler.transport=NULL;assert(!f.boat.AI_handleSettlerTransport());
+  assert(!f.escort.AI_handleSettlerTransport()); // ordinary troop cargo remains legacy controlled
+ }
+ {Fixture f;f.boat.role=UNITAI_ASSAULT_SEA;f.donor.role=UNITAI_ASSAULT_SEA;
+  CLLNode<IDInfo> follower={&f.boat,NULL},head={&f.donor,&follower};
+  f.donor.group.head=&head;f.donor.group.count=2;f.boat.activeGroup=&f.donor.group;
+  assert(!f.donor.AI_handleSettlerTransport()); // ordinary assault head keeps its role
+  assert(f.boat.getGroup()!=f.donor.getGroup()&&f.boat.role==UNITAI_SETTLER_SEA);
+  assert(f.boat.AI_handleSettlerTransport());assert(f.boat.group.job==MISSIONAI_FOUND);
+ }
+}
+''')
+
+    def test_entry_precedes_passenger_and_role_decisions(self):
+        source = (DLL / 'CvUnitAI.cpp').read_text()
+        update = block(source, 'bool CvUnitAI::AI_update()')
+        self.assertLess(update.index('AI_handleSettlerTransport()'), update.index('if (getDomainType() == DOMAIN_LAND)'))
+        self.assertLess(update.index('AI_handleSettlerTransport()'), update.index('AI_afterAttack()'))
+        self.assertLess(update.index('AI_handleSettlerTransport()'), update.index('case UNITAI_ASSAULT_SEA:'))
+
+
+if __name__ == '__main__':
+    unittest.main(argv=[__file__] + remaining, verbosity=2)
