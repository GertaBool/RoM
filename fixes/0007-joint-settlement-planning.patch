+#!/usr/bin/env python3
+"""Execute production destination search against independent route tables/oracles.
+
+The engine's A*, movement execution, and full city economy are not simulated.
+"""
+import unittest
+from test_review_correctness import DLL, remaining, block, compile_run
+from test_ai_settler_dispatch import HOST
+
+
+def shore_host():
+    host = HOST.replace('MISSION_MOVE_TO,MISSION_SKIP,', 'MISSION_MOVE_TO,MISSION_SKIP,MISSION_FOUND,')
+    host = host.replace('bool isCity(){', 'int getArea(){return 0;}bool isCity(){')
+    host = host.replace('CvPlot* plots[64];', 'int pathQueries=0,seaQueries=0;CvPlot* plots[64];')
+    host = host.replace('int AI_getMissionAIType(){', 'bool canDefend(){return true;}int AI_getMissionAIType(){')
+    host = host.replace('CvPlot* plot(){', 'int getArea(){return 0;}bool canMoveAllTerrain(){return false;}CvPlot* plot(){')
+    host = host.replace('*turns=domain==DOMAIN_SEA?', '++pathQueries;*turns=domain==DOMAIN_SEA?')
+    host = host.replace('CvPlot*,int,CvSelectionGroup*,int)', 'CvPlot*,int,CvSelectionGroup* = NULL,int = 0)')
+    host = host.replace('int pickups;CvUnitAI()', 'int pickups;bool AI_found();\n' + r'''
+ bool AI_findSettlementTransport(CvPlot* p,int& turns,CvUnit*& ship,CvPlot*& approach){
+  ++seaQueries;ship=this;approach=p;turns=p->seaTurns;
+  return plot()->city && p->coastal && turns>=0 && turns<=player.horizon;}
+ bool AI_loadForSettlement(CvPlot* p,int land){
+  if(!plot()->city || !p->coastal || p->seaTurns<0 || p->seaTurns>=land || p->seaTurns>player.horizon)return false;
+  group.target=p;group.job=MISSIONAI_FOUND;transport=this;return true;}
+ CvUnitAI()''')
+    return host
+
+
+class SearchTests(unittest.TestCase):
+    def test_shore_choices_match_exhaustive_route_oracle(self):
+        method = block((DLL / 'CvUnitAI.cpp').read_text(), 'bool CvUnitAI::AI_found()')
+        compile_run(shore_host() + method + r'''
+// Independently specified oracle: enumerate all feasible routes, including
+// transfer time already supplied by the route table; maximize value/(1+.18*t).
+int payoff(int value,int turns){return value*100/(100+18*turns);}
+void sortSites(){for(size_t i=0;i<player.sites.size();++i)for(size_t j=i+1;j<player.sites.size();++j)
+ if(player.sites[j]->found>player.sites[i]->found)std::swap(player.sites[i],player.sites[j]);}
+int main(){
+ for(int seed=0;seed<1000;++seed){
+  Fixture f;f.boat.domain=DOMAIN_LAND;f.boat.role=UNITAI_SETTLE;player.sites.clear();CvPlot sites[24];
+  for(int i=0;i<24;++i){CvPlot& p=sites[i];p.x=i+1;p.found=80+((seed*17+i*59)%1200);
+   p.landTurns=((seed*7+i*11)%28)-3;p.seaTurns=((seed*13+i*5)%28)-3;p.coastal=(i%3!=0);
+   p.legal=(i+seed)%7!=0;p.enemy=(i+seed)%11==0;player.sites.push_back(&p);}
+  sortSites();CvPlot* expected=NULL;int value=0;bool sea=false;
+  for(size_t i=0;i<player.sites.size();++i){CvPlot* p=player.sites[i];if(!p->legal||p->enemy)continue;
+   if(p->landTurns>=0&&p->landTurns<=20&&payoff(p->found,p->landTurns)>value){
+    value=payoff(p->found,p->landTurns);expected=p;sea=false;}
+   if(p->coastal&&p->seaTurns>=0&&p->seaTurns<=20&&payoff(p->found,p->seaTurns)>value){
+    value=payoff(p->found,p->seaTurns);expected=p;sea=true;}}
+  bool chosen=f.boat.AI_found();assert(chosen==(expected!=NULL));
+  assert(f.boat.group.target==expected);assert((f.boat.transport!=NULL)==sea);
+ }
+ // More than the old six sites are unreachable. The seventh, lower raw score
+ // must remain eligible. A fixed path budget/top-K cannot satisfy this case.
+ {Fixture f;f.boat.domain=DOMAIN_LAND;player.sites.clear();CvPlot bad[12],good;
+  for(int i=0;i<12;++i){bad[i].found=1000-i;player.sites.push_back(&bad[i]);}
+  good.found=700;good.landTurns=1;player.sites.push_back(&good);
+  assert(f.boat.AI_found()&&f.boat.group.target==&good);}
+ // Better island delivery beats the best walking destination, even though
+ // the island is unreachable on foot and has a lower undiscounted score.
+ {Fixture f;f.boat.domain=DOMAIN_LAND;CvPlot inland,island;inland.found=1000;inland.landTurns=15;
+  island.found=900;island.coastal=true;island.seaTurns=3;
+  player.sites.clear();player.sites.push_back(&inland);player.sites.push_back(&island);
+  assert(f.boat.AI_found()&&f.boat.transport!=NULL&&f.boat.group.target==&island);}
+ // A nearby walking site wins despite an available boat. The rest can be
+ // pruned only AFTER this feasible incumbent is established.
+ {Fixture f;f.boat.domain=DOMAIN_LAND;CvPlot nearby,weak;nearby.found=1000;nearby.landTurns=1;
+  nearby.coastal=true;nearby.seaTurns=4;weak.found=100;weak.landTurns=0;
+  player.sites.clear();player.sites.push_back(&nearby);player.sites.push_back(&weak);
+  pathQueries=seaQueries=0;assert(f.boat.AI_found());assert(f.boat.transport==NULL);
+  assert(f.boat.group.target==&nearby&&pathQueries==1&&seaQueries==1);
+  // A valid commitment is preserved without rescanning the candidate pool.
+  nearby.landTurns=2;weak.found=5000;pathQueries=seaQueries=0;
+  assert(f.boat.AI_found()&&f.boat.group.target==&nearby&&pathQueries==1&&seaQueries==0);
+  nearby.legal=false;assert(f.boat.AI_found()&&f.boat.group.target==&weak);}
+}
+''')
+
+    def test_loaded_search_reaches_candidates_outside_old_portfolio(self):
+        source = (DLL / 'CvUnitAI.cpp').read_text()
+        methods = '\n'.join(block(source, sig) for sig in (
+            'void CvUnitAI::AI_clearSettlerSeaLoads()', 'bool CvUnitAI::AI_settlerSeaPath(',
+            'bool CvUnitAI::AI_settlerSeaTransport()'))
+        compile_run(HOST + methods + r'''
+int main(){
+ {Fixture f;f.escort.transport=&f.boat;CvPlot bad[12];player.sites.clear();
+  for(int i=0;i<12;++i){bad[i].found=1000-i;player.sites.push_back(&bad[i]);}
+  player.sites.push_back(&f.site);
+  assert(f.boat.AI_settlerSeaTransport());assert(f.boat.group.target==&f.site&&f.boat.unloads==0);}
+ {Fixture f;f.escort.transport=&f.boat;CvPlot inland;inland.found=110;inland.landTurns=15;
+  player.sites.insert(player.sites.begin(),&inland);
+  assert(f.boat.AI_settlerSeaTransport());assert(f.boat.group.target==&f.site&&f.boat.unloads==0);}
+ {Fixture f;f.escort.transport=&f.boat;CvPlot inland;inland.found=110;inland.landTurns=0;
+  player.sites.insert(player.sites.begin(),&inland);
+  assert(f.boat.AI_settlerSeaTransport());assert(f.boat.unloads==1&&f.settler.group.target==&inland);}
+}
+''')
+
+    def test_snapshot_precedes_hypothetical_overlap_and_survives_it(self):
+        source = (DLL / 'CvPlayerAI.cpp').read_text()
+        update = block(source, 'void CvPlayerAI::AI_updateFoundValues(')
+        start = update.index('\t\tconst int iMinimum =')
+        end = update.index('\n\t\tif (!isBarbarian())', start)
+        capture = update[start:end]
+        self.assertLess(update.index('m_aSettlementCandidates.push_back'), update.index('AI_updateCitySites('))
+        getter = block(source, 'CvPlot* CvPlayerAI::AI_getSettlementCandidate(')
+        compile_run(r'''
+#include <cassert>
+#include <vector>
+#include <algorithm>
+#include "AISettlementPolicy.h"
+#define FAssert(x) assert(x)
+struct CvPlot {int found;bool revealed;int getFoundValue(int){return found;}bool isRevealed(int,bool){return revealed;}} plots[5];
+struct Map {int numPlotsINLINE(){return 5;}CvPlot* plotByIndexINLINE(int i){return &plots[i];}CvPlot* plotByIndex(int i){return &plots[i];}} map;
+struct Globals {Map& getMapINLINE(){return map;}} GC;
+struct CvPlayerAI {std::vector<AISettlementPolicy::Candidate> m_aSettlementCandidates;
+ int getID(){return 0;}int getTeam(){return 0;}int AI_getMinFoundValue(){return 100;}
+ CvPlot* AI_getSettlementCandidate(int,int&)const;
+ void capture(){CAPTURE}
+};
+GETTER
+int main(){CvPlayerAI p;for(int i=0;i<5;++i){plots[i].found=200+i*100;plots[i].revealed=true;}
+ plots[4].revealed=false;plots[0].found=50;p.capture();assert(p.m_aSettlementCandidates.size()==3);
+ for(int i=0;i<5;++i)plots[i].found=0; // hypothetical portfolio erased nearby alternatives
+ int value;assert(p.AI_getSettlementCandidate(0,value)==&plots[3]&&value==500);
+ assert(p.AI_getSettlementCandidate(2,value)==&plots[1]&&value==300);
+}
+'''.replace('CAPTURE', capture).replace('GETTER', getter))
+        read = block(source, 'void CvPlayerAI::read(')
+        self.assertIn('m_aSettlementCandidates.clear()', read)
+        self.assertNotIn('m_aSettlementCandidates', block(source, 'void CvPlayerAI::write('))
+        settle = block((DLL / 'CvUnitAI.cpp').read_text(), 'void CvUnitAI::AI_settleMove()')
+        self.assertNotIn('AI_getNumCitySites', settle)
+        self.assertNotIn('scrap()', settle)
+        self.assertNotIn('preferSeaSettlement', settle)
+
+
+if __name__ == '__main__':
+    unittest.main(argv=[__file__] + remaining, verbosity=2)
