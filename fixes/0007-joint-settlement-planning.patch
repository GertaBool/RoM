+// A loaded party must enter the civilian controller even after manual boarding
+// or a role change. Passenger decisions cannot race the ship's first update.
+bool CvUnitAI::AI_handleSettlerTransport()
+{
+	if (isHuman()) return false;
+	if (getDomainType() == DOMAIN_LAND && isCargo())
+	{
+		CvUnit* pShip = getTransportUnit();
+		if (pShip->getUnitAICargo(UNITAI_SETTLE) > 0)
+		{
+			if (gUnitLogLevel >= 2) logBBAI("    Passenger %d: WAIT_TRANSPORT %d, ship role %d, mission %d",
+				getID(), pShip->getID(), pShip->AI_getUnitAIType(), pShip->getGroup()->AI_getMissionAIType());
+			getGroup()->pushMission(MISSION_SKIP);
+			return true;
+		}
+	}
+	if (getDomainType() == DOMAIN_SEA)
+	{
+		AI_separateSettlerTransports();
+		if (getUnitAICargo(UNITAI_SETTLE) > 0)
+		{
+			// Changing role creates a new selection group. Carry the destination
+			// across that mutation instead of retaining a stale group pointer.
+			const MissionAITypes eJob = getGroup()->AI_getMissionAIType();
+			CvPlot* pTarget = getGroup()->AI_getMissionAIPlot();
+			if (AI_getUnitAIType() != UNITAI_SETTLER_SEA)
+			{
+				if (gUnitLogLevel >= 2) logBBAI("    Ship %d: ADOPT_SETTLER_TRANSPORT from role %d", getID(), AI_getUnitAIType());
+				AI_setUnitAIType(UNITAI_SETTLER_SEA);
+				if (eJob == MISSIONAI_FOUND) getGroup()->AI_setMissionAI(eJob, pTarget, NULL);
+			}
+			AI_settlerSeaMove();
+			return true;
+		}
+	}
+	return false;
+}
