--- a/Assets/CvGameCoreDLL/AICivicPolicy.h
+++ b/Assets/CvGameCoreDLL/AICivicPolicy.h
@@ -76,6 +76,85 @@ namespace AICivicPolicy
 		const long long iReserve = (iBaseline * iHorizon * iThreshold) / 100;
 		return iGain > iSwitchCost + iReserve;
 	}
+
+	// Exploit-free fractional improvement upgrade step preserving exact save-format
+	// compatibility on short CvPlot::m_iUpgradeProgress.
+	// For r = 100 + mod >= 100 (all RoM XML modifiers: +10%..+200%), advances each
+	// plot deterministically along its own worked-turn lattice p_k = floor(k*r/100)
+	// via k(p) = floor((100*(p+1)-1)/r), eliminating both turn-parity micro-exploits
+	// and UI hover flicker while snapping legacy/mid-upgrade off-lattice values cleanly.
+	// For hypothetical modded negative modifiers (0 < r < 100), falls back to
+	// turn-keyed Bresenham so fractional rates below 1.0 never stall permanently.
+	inline int improvementUpgradeStep(const int iCurrentProgress, const int iGameTurn,
+		const int iUpgradeRateModifier)
+	{
+		const int iRate100 = std::max(0, 100 + iUpgradeRateModifier);
+		if (iRate100 <= 0)
+		{
+			return 0;
+		}
+		if (iRate100 >= 100)
+		{
+			const long long iProg = iCurrentProgress > 0 ? (long long)iCurrentProgress : 0LL;
+			const long long iK = (100LL * (iProg + 1LL) - 1LL) / iRate100;
+			const long long iNext = ((iK + 1LL) * iRate100) / 100LL;
+			const long long iStep = iNext - iProg;
+			return iStep < 1LL ? 1 : (iStep > INT_MAX ? INT_MAX : (int)iStep);
+		}
+		const long long iTurn = iGameTurn > 0 ? (long long)iGameTurn : 0LL;
+		const long long iPrev = (iTurn * iRate100) / 100LL;
+		const long long iNext = ((iTurn + 1LL) * iRate100) / 100LL;
+		return (int)(iNext - iPrev);
+	}
+
+	// Exact O(1) closed-form turns remaining matching improvementUpgradeStep()
+	// turn-for-turn with zero UI hover flicker and zero off-by-one drift.
+	inline int improvementUpgradeTurnsLeft(const int iCurrentProgress, const int iUpgradeTime,
+		const int iGameTurn, const int iUpgradeRateModifier)
+	{
+		const long long iProg = iCurrentProgress > 0 ? (long long)iCurrentProgress : 0LL;
+		const long long iTarget = iUpgradeTime > 0 ? (long long)iUpgradeTime : 0LL;
+		if (iProg >= iTarget)
+		{
+			return 1;
+		}
+		const int iRate100 = std::max(0, 100 + iUpgradeRateModifier);
+		if (iRate100 <= 0)
+		{
+			const long long iRem = iTarget - iProg;
+			return iRem < 1LL ? 1 : (iRem > INT_MAX ? INT_MAX : (int)iRem);
+		}
+		if (iRate100 >= 100)
+		{
+			const long long iK = (100LL * (iProg + 1LL) - 1LL) / iRate100;
+			const long long iKEnd = (100LL * iTarget + iRate100 - 1LL) / iRate100;
+			const long long iTurns = iKEnd - iK;
+			return iTurns < 1LL ? 1 : (iTurns > INT_MAX ? INT_MAX : (int)iTurns);
+		}
+		const long long iRem = iTarget - iProg;
+		const long long iTurn = iGameTurn > 0 ? (long long)iGameTurn : 0LL;
+		const long long iTargetFloor = (iTurn * iRate100) / 100LL + iRem;
+		const long long iEndTurn = (iTargetFloor * 100LL + iRate100 - 1LL) / iRate100;
+		const long long iTurns = iEndTurn - iTurn;
+		return iTurns < 1LL ? 1 : (iTurns > INT_MAX ? INT_MAX : (int)iTurns);
+	}
+
+	// Floors stacked negative worker-speed modifiers at 10% (and at least 1 work
+	// unit when base rate > 0) so workers cannot stall permanently at 0 progress/turn.
+	inline int scaledWorkRate(const int iBaseRate, const int iWorkerSpeedModifier,
+		const int iAIWorkRateModifier, const bool bApplyAIModifier)
+	{
+		if (iBaseRate <= 0)
+		{
+			return 0;
+		}
+		int iRate = (iBaseRate * std::max(10, iWorkerSpeedModifier + 100)) / 100;
+		if (bApplyAIModifier)
+		{
+			iRate = (iRate * std::max(10, iAIWorkRateModifier + 100)) / 100;
+		}
+		return std::max(1, iRate);
+	}
 }
 
