 }
 
 // The plots the screen shows, from the camera: its eye and target (CvScreensInterface.getCameraView, which reads
@@ -2545,10 +2554,15 @@ int CvGame::graphicsWindowFromCamera(const CvPlot* pLookAt, int* aiRange)
 
 // bAllIn: set everything up again and stop paging. Otherwise page in what is inside the window
 // and page out what is outside the window and its margin; what is in the margin stays as it is.
-void CvGame::pageGraphics(bool bAllIn)
+// At most GRAPHICS_PAGING_MAX_IN plots, units and cities are paged in by one pass (0: no limit), so a
+// zoom that uncovers much of the map spreads its set-up over several updates; returns true when the
+// pass stopped there and the next update must go on. Page-outs are not limited.
+bool CvGame::pageGraphics(bool bAllIn)
 {
 	PROFILE_FUNC();
 
+	const int iMaxIn = bAllIn ? 0 : std::max(0, GC.getDefineINT("GRAPHICS_PAGING_MAX_IN"));
+	bool bMore = false;
 	int aiIn[3] = {0, 0, 0};
 	int aiOut[3] = {0, 0, 0};
 	int aiPagedOut[3] = {0, 0, 0};
@@ -2557,6 +2571,7 @@ void CvGame::pageGraphics(bool bAllIn)
 	if (bAllIn)
 	{
 		m_bGraphicsPaging = false;
+		m_bPagingPending = false;
 	}
 
 	for (int iI = 0; iI < kMap.numPlotsINLINE(); iI++)
@@ -2575,6 +2590,22 @@ void CvGame::pageGraphics(bool bAllIn)
 			iWant = -1;
 		}
 
+		if (iWant > 0 && iMaxIn > 0 && (aiIn[0] + aiIn[1] + aiIn[2]) >= iMaxIn)
+		{
+			// The limit is reached: this plot waits for the next update if it or anything on it is paged out.
+			bool bWaiting = pPlot->isGraphicsPagedOut() || (pPlot->getPlotCity() != NULL && pPlot->getPlotCity()->isGraphicsPagedOut());
+			for (CLLNode<IDInfo>* pNode = pPlot->headUnitNode(); pNode != NULL && !bWaiting; pNode = pPlot->nextUnitNode(pNode))
+			{
+				CvUnit* pLoopUnit = ::getUnit(pNode->m_data);
+				bWaiting = (pLoopUnit != NULL && pLoopUnit->isGraphicsPagedOut());
+			}
+			if (bWaiting)
+			{
+				bMore = true;
+				iWant = 0;
+			}
+		}
+
 		if (iWant != 0)
 		{
 			bool bIn = (iWant > 0);
@@ -2657,10 +2688,12 @@ void CvGame::pageGraphics(bool bAllIn)
 	{
 		CvString szLine;
 		szLine.Format("turn %d look (%d,%d) %s: in plots %d units %d cities %d, out plots %d units %d cities %d; paged out plots %d units %d cities %d",
-			getGameTurn(), m_iPagingX, m_iPagingY, bAllIn ? "all in" : "pass",
+			getGameTurn(), m_iPagingX, m_iPagingY, bAllIn ? "all in" : (bMore ? "pass, more next update" : "pass"),
 			aiIn[0], aiIn[1], aiIn[2], aiOut[0], aiOut[1], aiOut[2], aiPagedOut[0], aiPagedOut[1], aiPagedOut[2]);
 		gDLL->logMsg("GraphicsPaging.log", szLine.c_str(), false, true);
 	}
+
+	return bMore;
 }
 
