+// Refresh linked group membership before running the actual groupMove/Amphib methods.
+CLLNode<IDInfo> nodePool[128];int nextNode=0;
+void linkGroup(CvSelectionGroup* group){
+ CLLNode<IDInfo>* tail=NULL;group->head=NULL;
+ for(size_t i=0;i<units.size();++i)if(units[i]->getGroup()==group){
+  assert(nextNode<128);CLLNode<IDInfo>* n=&nodePool[nextNode++];n->m_data=units[i];n->next=NULL;
