+    def test_gold_trade_reserve_matches_integer_oracle(self):
+        low,high=-(2**31),2**31-1
+        cases=list(itertools.product(
+            (low,-5,0,1,50,200,2000000000,high),
+            (low,-250000000,-100,-1,0,1,high),
+            (-1,0,1,3,12,high),(-1,0,1,50,100,300,high)))
+        rng=random.Random(20261011)
+        cases.extend((rng.randrange(1,high+1),-rng.randrange(1,high+2),
+                      rng.choice((1,3,12,10000,high)),rng.choice((1,25,50,100,300,high)))
+                     for _ in range(2000))
+        # Python integers give an independent exact reference, including products
+        # too large for signed 64-bit arithmetic before the final clamp.
+        expected=[gold if gold<=0 or rate>=0 or turns<=0 or percent<=0 else
+                  max(0,gold-((-rate)*turns*percent//100))
+                  for gold,rate,turns,percent in cases]
+        program='''
+#include "AIDecisionPolicy.h"
+#include <iostream>
+int main(){int gold,rate,turns,percent;
+    while(std::cin>>gold>>rate>>turns>>percent)
+        std::cout<<AIDecisionPolicy::goldAfterDeficitReserve(gold,rate,turns,percent)<<"\\n";
+}
+'''
+        with tempfile.TemporaryDirectory() as tmp:
+            path,exe=Path(tmp)/'reserve.cpp',Path(tmp)/'reserve'
+            path.write_text(program)
+            subprocess.run(['g++','-std=c++03','-Wall','-Wextra','-Werror',
+                            '-fsanitize=undefined','-fno-sanitize-recover=undefined',
+                            '-I'+str(DLL),str(path),'-o',str(exe)],check=True)
+            data=''.join(' '.join(map(str,case))+'\n' for case in cases)
+            ran=subprocess.run([str(exe)],input=data,text=True,capture_output=True,check=True)
+            actual=[int(line) for line in ran.stdout.splitlines()]
+        self.assertEqual(len(actual),len(cases))
+        for case,want,got in zip(cases,expected,actual):
+            self.assertEqual(got,want,case)
+        print('Verified %d gold-reserve cases against exact integer arithmetic.'%len(cases))
+
 
 if __name__ == "__main__":
