+#!/usr/bin/env python3
+"""Settlers are trained for, and sent to, sites a party can actually reach.
+
+CvPlayerAI::AI_updateSettleReach and the delivery checks built on it are
+compiled from the DLL source with a small grid map. Land regions grow from our
+cities through land that is ours or unclaimed (the MOVE_SAFE_TERRITORY rule);
+sea regions grow from our ports over water a transport we have or can train
+may enter. Before this, a civilization whose only site lay behind a
+neighbour's borders kept training settlers for it and the settlers waited in
+their cities for 40+ turns (seen on a real save replayed in the GertaBool/RoM
+toolchain/harness).
+"""
+import unittest
+from test_review_correctness import DLL, remaining, block, compile_run
+
+HOST = r'''
+#include <cassert>
+#include <cstddef>
+#include <vector>
+#include <utility>
+#include <algorithm>
+#define PROFILE_FUNC()
+enum TeamTypes { NO_TEAM = -1 };
+enum DirectionTypes { NO_DIRECTION = -1 };
+enum UnitTypes { NO_UNIT = -1 };
+enum UnitClassTypes { NO_UNITCLASS = -1 };
+enum TechTypes { NO_TECH = -1 };
+enum FeatureTypes { NO_FEATURE = -1 };
+enum DomainTypes { DOMAIN_SEA = 0, DOMAIN_LAND = 2 };
+enum UnitAITypes { UNITAI_SETTLER_SEA = 7 };
+enum CivilizationTypes { CIV = 0 };
+const int NUM_DIRECTION_TYPES = 8;
+const int W = 8, H = 5;
+const int OCEAN = 1, COAST = 0;
+
+struct CvPlot
+{
+	int x, y; bool water, impassable, revealed; int owner, terrain;
+	CvPlot(): x(0), y(0), water(false), impassable(false), revealed(true), owner(-1), terrain(COAST) {}
+	int getX_INLINE() const { return x; } int getY_INLINE() const { return y; }
+	bool isWater() const { return water; } bool isImpassable() const { return impassable; }
+	bool isRevealed(TeamTypes, bool) const { return revealed; }
+	bool isOwned() const { return owner >= 0; } TeamTypes getTeam() const { return (TeamTypes)owner; }
+	int getTerrainType() const { return terrain; } int getFeatureType() const { return NO_FEATURE; }
+};
+struct CvMap
+{
+	CvPlot plots[W * H];
+	CvMap() { for (int i = 0; i < W * H; ++i) { plots[i].x = i % W; plots[i].y = i / W; } }
+	int numPlotsINLINE() const { return W * H; }
+	CvPlot* plotByIndexINLINE(int i) { return &plots[i]; }
+	int plotNumINLINE(int x, int y) const { return y * W + x; }
+	CvPlot* at(int x, int y) { return &plots[y * W + x]; }
+} theMap;
+CvPlot* plotDirection(int x, int y, DirectionTypes d)
+{
+	static const int dx[8] = { 0, 1, 1, 1, 0, -1, -1, -1 }, dy[8] = { 1, 1, 0, -1, -1, -1, 0, 1 };
+	const int nx = x + dx[d], ny = y + dy[d];
+	return (nx < 0 || ny < 0 || nx >= W || ny >= H) ? NULL : theMap.at(nx, ny);
+}
+struct CvUnitInfo
+{
+	bool impassableOcean; int oceanTech;
+	int getDomainType() const { return DOMAIN_SEA; } int getCargoSpace() const { return 2; }
+	bool getUnitAIType(int) const { return true; }
+	int getTerrainPassableTech(int t) const { return t == OCEAN ? oceanTech : NO_TECH; }
