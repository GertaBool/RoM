+} GC;
+struct CvTeam { bool tech; bool isHasTech(TechTypes) const { return tech; } } theTeam;
+CvTeam& GET_TEAM(TeamTypes) { return theTeam; }
+bool atWar(TeamTypes, TeamTypes) { return false; }
+struct CvCity
+{
+	int x, y; bool canBuildBoat;
+	int getX_INLINE() const { return x; } int getY_INLINE() const { return y; }
+	bool isCoastal(int) const { return true; } bool canTrain(UnitTypes) const { return canBuildBoat; }
+};
+struct Candidate { int plot, value; };
+struct CvPlayerAI
+{
+	std::vector<CvCity> cities; std::vector<Candidate> candidates; int boats;
+	mutable std::vector<int> m_aiSettleLandRegion;
+	mutable std::vector<int> m_aiSettleSeaRegion;
+	mutable std::vector<std::pair<int, int> > m_aSettlePortLinks;
+	CvPlayerAI(): boats(0) {}
+	TeamTypes getTeam() const { return (TeamTypes)0; }
+	CivilizationTypes getCivilizationType() const { return CIV; }
+	int getUnitClassCount(UnitClassTypes) const { return boats; }
+	CvCity* firstCity(int* i) const { *i = 0; return cities.empty() ? NULL : const_cast<CvCity*>(&cities[0]); }
+	CvCity* nextCity(int* i) const { ++*i; return *i < (int)cities.size() ? const_cast<CvCity*>(&cities[*i]) : NULL; }
+	int AI_getNumSettlementCandidates() const { return (int)candidates.size(); }
+	CvPlot* AI_getSettlementCandidate(int i, int& v) const { v = candidates[i].value; return theMap.plotByIndexINLINE(candidates[i].plot); }
+	void AI_updateSettleReach() const;
+	bool AI_canDeliverSettler(const CvPlot* pFrom, const CvPlot* pSite, bool* pbByLand = NULL) const;
+	bool AI_isSettleSiteDeliverable(const CvPlot* pSite) const;
+	bool AI_hasDeliverableSettlementSite(const CvPlot* pFrom) const;
+	int AI_countSeaOnlySettlementSites(const CvPlot* pFrom) const;
