+// A lower bound on generatePath's turn count, for skipping candidates a search
+// cannot pick without changing its result. Every step costs at least the
+// cheapest step, and a unit may still step while any move is left, so it takes
+// at most ceil(moves / cheapest step) steps per turn; a target iDist plots away
+// needs at least ceil(iDist / that) turns. The cheapest step is the lowest cost
+// any route now on the map could give this team, or half a move (double-move
+// terrain).
+int CvUnitAI::AI_minPathStepsPerTurn() const
+{
+	int iMaxMoves = 0;
+	int iMinBaseMoves = MAX_INT;
+	CLLNode<IDInfo>* pUnitNode = getGroup()->headUnitNode();
+	while (pUnitNode != NULL)
+	{
+		const CvUnit* pLoopUnit = ::getUnit(pUnitNode->m_data);
+		pUnitNode = getGroup()->nextUnitNode(pUnitNode);
+		if (pLoopUnit != NULL)
+		{
+			iMaxMoves = std::max(iMaxMoves, pLoopUnit->maxMoves());
+			iMinBaseMoves = std::min(iMinBaseMoves, pLoopUnit->baseMoves());
+		}
+	}
+	if (iMaxMoves <= 0 || iMinBaseMoves == MAX_INT)
+	{
+		return MAX_INT;
+	}
+
+	std::vector<bool> abRoutePresent(GC.getNumRouteInfos(), false);
+	CvMap& kMap = GC.getMapINLINE();
+	for (int iI = 0; iI < kMap.numPlotsINLINE(); iI++)
+	{
+		const RouteTypes eRoute = kMap.plotByIndexINLINE(iI)->getRouteType();
+		if (eRoute != NO_ROUTE)
+		{
+			abRoutePresent[eRoute] = true;
+		}
+	}
+	int iMinStep = std::max(1, GC.getMOVE_DENOMINATOR() / 2);
+	const CvTeam& kTeam = GET_TEAM(getTeam());
+	for (int iI = 0; iI < GC.getNumRouteInfos(); iI++)
+	{
+		if (abRoutePresent[iI])
+		{
+			const CvRouteInfo& kRoute = GC.getRouteInfo((RouteTypes)iI);
+			const int iRouteStep = std::min(kRoute.getMovementCost() + kTeam.getRouteChange((RouteTypes)iI),
+				kRoute.getFlatMovementCost() * std::max(0, iMinBaseMoves));
+			iMinStep = std::min(iMinStep, std::max(1, iRouteStep));
+		}
+	}
+	return (iMaxMoves + iMinStep - 1) / iMinStep;
+}
+
+int CvUnitAI::AI_minPathTurns(const CvPlot* pTo, int iStepsPerTurn) const
+{
+	const int iDist = stepDistance(getX_INLINE(), getY_INLINE(), pTo->getX_INLINE(), pTo->getY_INLINE());
+	if (iDist == 0)
+	{
+		return 0;
+	}
+	if (iStepsPerTurn == MAX_INT)
+	{
+		return 1;
+	}
+	return std::max(1, (iDist + iStepsPerTurn - 1) / iStepsPerTurn);
 }
 
