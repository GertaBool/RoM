+// A lone settler in one of our cities takes a spare defender along: one above
+// the city's minimum garrison, alone in its group and idle or guarding this
+// city. Defenders join settlers on their own only when no danger is near, so a
+// city near a war never released one and its settlers waited indefinitely.
+bool CvUnitAI::AI_recruitSettlerEscort()
+{
+	CvCity* pCity = plot()->getPlotCity();
+	if (pCity == NULL || pCity->getOwnerINLINE() != getOwnerINLINE() || isCargo() ||
+		getGroup()->canDefend() || !GET_PLAYER(getOwnerINLINE()).AI_hasDeliverableSettlementSite(plot()))
+	{
+		return false;
+	}
+	const int iDefenders = plot()->plotCount(PUF_canDefend, -1, -1, getOwnerINLINE(), NO_TEAM, PUF_isDomainType, DOMAIN_LAND);
+	if (iDefenders <= static_cast<CvCityAI*>(pCity)->AI_minDefenders())
+	{
+		return false;
+	}
+	CvUnit* pBest = NULL;
+	int iBestValue = 0;
+	CLLNode<IDInfo>* pNode = plot()->headUnitNode();
+	while (pNode != NULL)
+	{
+		CvUnit* pLoopUnit = ::getUnit(pNode->m_data);
+		pNode = plot()->nextUnitNode(pNode);
+		if (pLoopUnit == NULL || pLoopUnit->getOwnerINLINE() != getOwnerINLINE() || pLoopUnit->getDomainType() != DOMAIN_LAND ||
+			!pLoopUnit->canDefend() || pLoopUnit->isCargo() || pLoopUnit->getGroup()->getNumUnits() != 1 ||
+			pLoopUnit->getGroup()->isBusy())
+		{
+			continue;
+		}
+		const MissionAITypes eJob = pLoopUnit->getGroup()->AI_getMissionAIType();
+		if (eJob != NO_MISSIONAI && !(eJob == MISSIONAI_GUARD_CITY && pLoopUnit->getGroup()->AI_getMissionAIPlot() == plot()))
+		{
+			continue;
+		}
+		// Prefer a unit that is not the garrison, then one that can leave now,
+		// then the stronger one.
+		const int iValue = 1 + (pLoopUnit->AI_getUnitAIType() != UNITAI_CITY_DEFENSE ? 2000000 : 0) +
+			(pLoopUnit->canMove() ? 1000000 : 0) + std::min(999999, pLoopUnit->currEffectiveStr(NULL, NULL));
+		if (iValue > iBestValue)
+		{
+			iBestValue = iValue;
+			pBest = pLoopUnit;
+		}
+	}
+	if (pBest == NULL)
+	{
+		return false;
+	}
+	pBest->joinGroup(getGroup());
+	if (gUnitLogLevel >= 2) logBBAI("    Settler %d: ESCORT %d from %S", getID(), pBest->getID(), pCity->getName().GetCString());
+	return getGroup()->canDefend();
+}
