+#!/usr/bin/env python3
+"""A blocked path step must end the mission, not loop the AI turn forever.
+
+CvSelectionGroup::groupPathTo is compiled from the DLL source with stand-ins
+whose movement rules follow the engine: canMoveInto() refuses a tile held by
+enemy units, canMoveOrAttackInto() accepts it for a unit that can attack, and
+groupMove() splits off every unit that cannot take the step. Before the fix a
+lone combat unit with a worker order onto an enemy-held tile was split into a
+new group on every update slice and the turn never ended (seen on a real save
+replayed in the GertaBool/RoM toolchain/harness). The watchdog counter
+CvUnitAI::AI_noteGroupLostAndLooping is compiled from source too.
+"""
+import unittest
+from test_review_correctness import DLL, remaining, block, compile_run
+
+HOST = r'''
+#include <cassert>
+#include <cstddef>
+#include <vector>
+enum { MOVE_THROUGH_ENEMY = 8, DOMAIN_LAND = 0, DOMAIN_AIR = 2 };
+enum MissionAITypes { NO_MISSIONAI = -1, MISSIONAI_BUILD = 19, MISSIONAI_BLOCKADE = 16, MISSIONAI_PILLAGE = 17 };
+#define FAssert(x) ((void)0)
+#define FAssertMsg(x, m) ((void)0)
+#define NO_PLAYER -1
+struct CvUnit;
+typedef CvUnit* IDInfo;
+template<class T> struct CLLNode { T m_data; CLLNode* next; };
+CvUnit* getUnit(IDInfo i) { return i; }
+struct CvPlot { bool enemy, city; int x, y; CvPlot(): enemy(false), city(false), x(0), y(0) {}
+	bool isEnemyCity(const CvUnit&) const { return city && enemy; } int getX_INLINE() { return x; } int getY_INLINE() { return y; } };
+struct CvUnit { bool attacker, moves, noCapture; CvUnit(): attacker(false), moves(true), noCapture(false) {}
+	bool canMove() const { return moves; }
+	bool isNoCapture() const { return noCapture; }
+	bool canMoveInto(CvPlot* p) const { return !p->enemy; }
+	bool canMoveOrAttackInto(CvPlot* p) const { return !p->enemy || attacker; } };
+struct Map { CvPlot plots[4]; CvPlot* plotINLINE(int x, int) { return &plots[x]; } } theMap;
+struct Globals { Map& getMapINLINE() { return theMap; } } GC;
+struct CvSelectionGroup {
+	std::vector<CLLNode<IDInfo> > nodes; CvPlot* where; CvPlot* firstStep; int moves, splits;
+	MissionAITypes job;
+	CvSelectionGroup(): where(&theMap.plots[0]), firstStep(&theMap.plots[1]), moves(0), splits(0), job(MISSIONAI_BUILD) {}
+	void add(CvUnit* u) { CLLNode<IDInfo> n; n.m_data = u; n.next = NULL; nodes.push_back(n);
+		for (size_t i = 0; i + 1 < nodes.size(); ++i) nodes[i].next = &nodes[i + 1]; }
+	CLLNode<IDInfo>* headUnitNode() { return nodes.empty() ? NULL : &nodes[0]; }
+	CLLNode<IDInfo>* nextUnitNode(CLLNode<IDInfo>* n) { return n->next; }
+	bool at(int x, int) { return where->x == x; }
+	bool isBusy() { return false; }
+	int getOwnerINLINE() { return 0; }
+	void* headMissionQueueNode() { return this; }
+	bool canAllMove() { return true; }
+	int getDomainType() { return DOMAIN_LAND; }
+	bool canMoveInto(CvPlot*) { return true; }
+	CvPlot* plot() { return where; }
+	bool generatePath(CvPlot*, CvPlot*, int) { return true; }
+	CvPlot* getPathFirstPlot() { return firstStep; }
+	bool groupAmphibMove(CvPlot*, int) { return false; }
+	MissionAITypes AI_getMissionAIType() { return job; }
+	bool groupDeclareWar(CvPlot*, bool) { return false; }
+	// Engine rule: each unit that cannot take the step leaves for a new group.
+	void groupMove(CvPlot* p, bool bCombat, CvUnit*, bool) {
+		++moves;
+		for (size_t i = 0; i < nodes.size(); ++i) {
+			CvUnit* u = nodes[i].m_data;
+			if (!(u->canMove() && (bCombat ? u->canMoveOrAttackInto(p) : u->canMoveInto(p)))) ++splits;
+		}
+	}
+	bool groupPathTo(int iX, int iY, int iFlags);
+};
+'''
+
+UNIT_AI = r'''
+#include <cassert>
+struct Game { int turn; int getGameTurn() { return turn; } } theGame;
+struct Globals { Game& getGameINLINE() { return theGame; } } GC;
+struct CvUnitAI { int m_iGroupLossTurn, m_iGroupLossCount; CvUnitAI(): m_iGroupLossTurn(-1), m_iGroupLossCount(0) {}
+	bool AI_noteGroupLostAndLooping(); };
+'''
+
+
+def program(tail):
+    group = (DLL / 'CvSelectionGroup.cpp').read_text(encoding='latin-1')
+    return HOST + block(group, 'bool CvSelectionGroup::groupPathTo(') + tail
+
+
+class TurnEndGuardTests(unittest.TestCase):
+    def test_lone_worker_onto_enemy_tile_ends_mission(self):
+        compile_run(program(r'''
+int main() { CvSelectionGroup g; CvUnit javelineer; javelineer.attacker = true; g.add(&javelineer);
+ theMap.plots[1].enemy = true; theMap.plots[1].x = 1;
+ assert(!g.groupPathTo(1, 0, 0));
+ assert(g.moves == 0 && g.splits == 0); }
+'''))
+
+    def test_free_step_still_moves(self):
+        compile_run(program(r'''
+int main() { CvSelectionGroup g; CvUnit worker; g.add(&worker); theMap.plots[1].x = 1;
+ assert(g.groupPathTo(1, 0, 0));
+ assert(g.moves == 1 && g.splits == 0); }
+'''))
+
+    def test_mixed_group_moves_and_splits_the_blocked_unit(self):
+        compile_run(program(r'''
+int main() { CvSelectionGroup g; CvUnit a, b; b.moves = false; g.add(&a); g.add(&b); theMap.plots[1].x = 1;
+ assert(g.groupPathTo(1, 0, 0));
+ assert(g.moves == 1 && g.splits == 1); }
+'''))
+
+    def test_attack_order_still_attacks(self):
+        compile_run(program(r'''
+int main() { CvSelectionGroup g; CvUnit axe; axe.attacker = true; g.add(&axe);
+ theMap.plots[1].enemy = true; theMap.plots[1].x = 1;
+ assert(g.groupPathTo(1, 0, MOVE_THROUGH_ENEMY));
+ assert(g.moves == 1 && g.splits == 0); }
+'''))
+
+    def test_watchdog_trips_after_twenty_losses_per_turn(self):
+        unit_ai = (DLL / 'CvUnitAI.cpp').read_text(encoding='latin-1')
+        compile_run(UNIT_AI + block(unit_ai, 'bool CvUnitAI::AI_noteGroupLostAndLooping(') + r'''
+int main() { CvUnitAI u; theGame.turn = 5;
+ for (int i = 0; i < 20; ++i) assert(!u.AI_noteGroupLostAndLooping());
+ assert(u.AI_noteGroupLostAndLooping());
+ theGame.turn = 6; assert(!u.AI_noteGroupLostAndLooping()); }
+''')
+
+
+if __name__ == '__main__':
+    unittest.main(argv=[__file__] + remaining, verbosity=2)
