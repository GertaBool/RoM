@@ -0,0 +1,100 @@
+#!/usr/bin/env python3
+"""The AI's gold reserve follows prices, not the number of turns a speed has.
+
+CvPlayerAI::AI_goldTarget is compiled from the DLL source with stand-ins for
+the game. Elapsed turns were added to the target and then scaled by the
+speed's price multiplier, although a slow speed already has more turns for the
+same stretch of history; on RoM Marathon (1470 turns, 600/300/200 percent) that
+term was about eight times its Normal value, and the turn-runway cap used the
+600 percent research factor. AIs then kept research at 5-25% for many turns
+while banking gold (seen on a real Marathon save replayed in the GertaBool/RoM
+toolchain/harness).
+"""
+import unittest
+from test_review_correctness import DLL, remaining, block, compile_run
+
+HOST = r'''
+#include <cassert>
+#include <algorithm>
+#include <cstring>
+enum GameSpeedTypes { NORMAL = 0, MARATHON = 1 };
+enum CommerceTypes { NUM_COMMERCE_TYPES = 4 };
+enum CorporationTypes { NO_CORPORATION = -1 };
+struct GameTurnInfo { int iMonthIncrement; int iNumGameTurnsPerIncrement; };
+struct CvGameSpeedInfo
+{
+	int research, train, construct; GameTurnInfo turns[2];
+	int getResearchPercent() const { return research; } int getTrainPercent() const { return train; }
+	int getConstructPercent() const { return construct; } int getNumTurnIncrements() const { return 2; }
+	GameTurnInfo& getGameTurnInfo(int i) const { return const_cast<GameTurnInfo&>(turns[i]); }
+} speeds[2];
+struct CvCorporationInfo { int getSpreadCost() const { return 0; } } corp;
+struct CvGame { GameSpeedTypes speed; int elapsed;
+	GameSpeedTypes getGameSpeedType() const { return speed; } int getElapsedGameTurns() const { return elapsed; } } game;
+struct Globals
+{
+	CvGame& getGameINLINE() { return game; }
+	const CvGameSpeedInfo& getGameSpeedInfo(int i) { return speeds[i]; }
+	int getNumGameSpeedInfos() { return 2; }
+	int getDefineINT(const char* s) { return strcmp(s, "STANDARD_GAMESPEED") == 0 ? NORMAL :
+		strcmp(s, "AI_GOLD_UPGRADE_RESERVE_TURNS_WAR") == 0 ? 2 : strcmp(s, "AI_GOLD_UPGRADE_RESERVE_TURNS_PEACE") == 0 ? 1 : 1; }
+	int getNumCorporationInfos() { return 0; }
+	CvCorporationInfo& getCorporationInfo(int) { return corp; }
+} GC;
+struct CvTeam { int wars; int getAtWarCount(bool) const { return wars; } } team;
+CvTeam& GET_TEAM(int) { return team; }
+struct CvPlayerAI
+{
+	int cities, pop, commerce, upgrades;
+	int getNumCities() const { return cities; } int getTotalPopulation() const { return pop; }
+	int getTeam() const { return 0; } bool AI_avoidScience() const { return false; }
+	int getCommerceRate(CommerceTypes) const { return commerce / 4; }
+	int AI_goldToUpgradeAllUnits() const { return upgrades; }
+	int getHasCorporationCount(int) const { return 0; } int calculateInflationRate() const { return 0; }
+	int AI_getExtraGoldTarget() const { return 0; }
+	int AI_goldTarget() const;
+};
+'''
+
+
+def program(tail):
+    src = (DLL / 'CvPlayerAI.cpp').read_text(encoding='latin-1')
+    helpers = block(src, 'int calendarTurns(GameSpeedTypes eSpeed)') + '\n' + block(src, 'int calendarTurnsPercent()')
+    return HOST + helpers + '\n' + block(src, 'int CvPlayerAI::AI_goldTarget() const') + r'''
+void setSpeeds() {
+ speeds[NORMAL].research = 100; speeds[NORMAL].train = 100; speeds[NORMAL].construct = 100;
+ speeds[NORMAL].turns[0].iNumGameTurnsPerIncrement = 300; speeds[NORMAL].turns[1].iNumGameTurnsPerIncrement = 400;
+ speeds[MARATHON].research = 600; speeds[MARATHON].train = 300; speeds[MARATHON].construct = 200;
+ speeds[MARATHON].turns[0].iNumGameTurnsPerIncrement = 630; speeds[MARATHON].turns[1].iNumGameTurnsPerIncrement = 840;
+}
+''' + tail
+
+
+class GoldTargetSpeedTests(unittest.TestCase):
+    def test_normal_speed_keeps_the_bts_formula(self):
+        compile_run(program(r'''
+int main() { setSpeeds(); game.speed = NORMAL; game.elapsed = 128; team.wars = 0;
+ CvPlayerAI p; p.cities = 6; p.pop = 33; p.commerce = 4000; p.upgrades = 0;
+ // (6 * 3 + 33 / 3 + 128 / 2) * 100 / 100
+ assert(p.AI_goldTarget() == 93);
+ p.commerce = 40; // one turn of commerce caps the peaceful reserve
+ assert(p.AI_goldTarget() == 40); }
+'''))
+
+    def test_marathon_reserve_follows_prices_not_turn_count(self):
+        compile_run(program(r'''
+int main() { setSpeeds(); team.wars = 0;
+ CvPlayerAI p; p.cities = 6; p.pop = 33; p.commerce = 100000; p.upgrades = 0;
+ game.speed = NORMAL; game.elapsed = 128; const int iNormal = p.AI_goldTarget();
+ // The same point of history on Marathon: 210 turns for every 100 Normal turns.
+ game.speed = MARATHON; game.elapsed = 128 * 1470 / 700; const int iMarathon = p.AI_goldTarget();
+ // Prices on Marathon are (600 + 300 + 200) / 3 = 366 percent of Normal.
+ assert(iMarathon >= iNormal * 366 / 100 - 4 && iMarathon <= iNormal * 366 / 100 + 4);
+ // The liquidity cap is 2.1 turns of commerce in peace (was 6, the research percent).
+ p.commerce = 100; assert(p.AI_goldTarget() == 210);
+ team.wars = 1; assert(p.AI_goldTarget() == 420); }
+'''))
+
+
+if __name__ == '__main__':
+    unittest.main(argv=[__file__] + remaining, verbosity=2)
