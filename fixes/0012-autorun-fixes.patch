+void CvPlayerAI::AI_updateSettleReach() const
+{
+	PROFILE_FUNC();
+
+	CvMap& kMap = GC.getMapINLINE();
+	const int iNumPlots = kMap.numPlotsINLINE();
+	const TeamTypes eTeam = getTeam();
+	m_aiSettleLandRegion.assign(iNumPlots, -1);
+	m_aiSettleSeaRegion.assign(iNumPlots, -1);
+	m_aSettlePortLinks.clear();
+	std::vector<int> aiQueue;
+	aiQueue.reserve(iNumPlots);
+
+	// Land regions: from each of our cities through revealed land that is ours
+	// or unclaimed, the plots a MOVE_SAFE_TERRITORY path may cross.
+	int iLoop;
+	int iRegions = 0;
+	for (CvCity* pCity = firstCity(&iLoop); pCity != NULL; pCity = nextCity(&iLoop))
+	{
+		const int iStart = kMap.plotNumINLINE(pCity->getX_INLINE(), pCity->getY_INLINE());
+		if (m_aiSettleLandRegion[iStart] >= 0)
+		{
+			continue;
+		}
+		const int iRegion = iRegions++;
+		m_aiSettleLandRegion[iStart] = iRegion;
+		aiQueue.clear();
+		aiQueue.push_back(iStart);
+		for (size_t iHead = 0; iHead < aiQueue.size(); ++iHead)
+		{
+			const CvPlot* pPlot = kMap.plotByIndexINLINE(aiQueue[iHead]);
+			for (int iDir = 0; iDir < NUM_DIRECTION_TYPES; ++iDir)
+			{
+				CvPlot* pAdj = plotDirection(pPlot->getX_INLINE(), pPlot->getY_INLINE(), (DirectionTypes)iDir);
+				if (pAdj == NULL || pAdj->isWater() || pAdj->isImpassable() || !pAdj->isRevealed(eTeam, false) ||
+					(pAdj->isOwned() && pAdj->getTeam() != eTeam))
+				{
+					continue;
+				}
+				const int iAdj = kMap.plotNumINLINE(pAdj->getX_INLINE(), pAdj->getY_INLINE());
+				if (m_aiSettleLandRegion[iAdj] < 0)
+				{
+					m_aiSettleLandRegion[iAdj] = iRegion;
+					aiQueue.push_back(iAdj);
+				}
+			}
+		}
+	}
+
+	// Sea regions: the transports we have or can train, and the water they may enter.
+	std::vector<UnitTypes> aeTransports;
+	for (int iClass = 0; iClass < GC.getNumUnitClassInfos(); ++iClass)
+	{
+		const UnitTypes eUnit = (UnitTypes)GC.getCivilizationInfo(getCivilizationType()).getCivilizationUnits(iClass);
+		if (eUnit == NO_UNIT || GC.getUnitInfo(eUnit).getDomainType() != DOMAIN_SEA ||
+			GC.getUnitInfo(eUnit).getCargoSpace() <= 0 || !GC.getUnitInfo(eUnit).getUnitAIType(UNITAI_SETTLER_SEA))
+		{
+			continue;
+		}
+		bool bAvailable = getUnitClassCount((UnitClassTypes)iClass) > 0;
+		for (CvCity* pCity = firstCity(&iLoop); pCity != NULL && !bAvailable; pCity = nextCity(&iLoop))
+		{
+			bAvailable = pCity->isCoastal(GC.getMIN_WATER_SIZE_FOR_OCEAN()) && pCity->canTrain(eUnit);
+		}
+		if (bAvailable)
+		{
+			aeTransports.push_back(eUnit);
+		}
+	}
+	if (aeTransports.empty())
+	{
+		return;
+	}
+	const CvTeam& kTeam = GET_TEAM(eTeam);
+	std::vector<bool> abTerrain(GC.getNumTerrainInfos(), false);
+	std::vector<bool> abFeature(GC.getNumFeatureInfos(), false);
+	for (size_t iUnit = 0; iUnit < aeTransports.size(); ++iUnit)
+	{
+		const CvUnitInfo& kUnit = GC.getUnitInfo(aeTransports[iUnit]);
+		for (int iTerrain = 0; iTerrain < GC.getNumTerrainInfos(); ++iTerrain)
+		{
+			const TechTypes eTech = (TechTypes)kUnit.getTerrainPassableTech(iTerrain);
+			if (!kUnit.getTerrainImpassable(iTerrain) || (eTech != NO_TECH && kTeam.isHasTech(eTech)))
+			{
+				abTerrain[iTerrain] = true;
+			}
+		}
+		for (int iFeature = 0; iFeature < GC.getNumFeatureInfos(); ++iFeature)
+		{
+			const TechTypes eTech = (TechTypes)kUnit.getFeaturePassableTech(iFeature);
+			if (!kUnit.getFeatureImpassable(iFeature) || (eTech != NO_TECH && kTeam.isHasTech(eTech)))
+			{
+				abFeature[iFeature] = true;
+			}
+		}
+	}
+	iRegions = 0;
+	for (CvCity* pCity = firstCity(&iLoop); pCity != NULL; pCity = nextCity(&iLoop))
+	{
+		const int iLandRegion = m_aiSettleLandRegion[kMap.plotNumINLINE(pCity->getX_INLINE(), pCity->getY_INLINE())];
+		for (int iPortDir = 0; iPortDir < NUM_DIRECTION_TYPES; ++iPortDir)
+		{
+			CvPlot* pWater = plotDirection(pCity->getX_INLINE(), pCity->getY_INLINE(), (DirectionTypes)iPortDir);
+			if (pWater == NULL || !pWater->isWater() || !pWater->isRevealed(eTeam, false) || pWater->isImpassable() ||
+				!abTerrain[pWater->getTerrainType()] ||
+				(pWater->getFeatureType() != NO_FEATURE && !abFeature[pWater->getFeatureType()]) ||
+				(pWater->isOwned() && atWar(pWater->getTeam(), eTeam)))
+			{
+				continue;
+			}
+			const int iStart = kMap.plotNumINLINE(pWater->getX_INLINE(), pWater->getY_INLINE());
+			if (m_aiSettleSeaRegion[iStart] < 0)
+			{
+				const int iRegion = iRegions++;
+				m_aiSettleSeaRegion[iStart] = iRegion;
+				aiQueue.clear();
+				aiQueue.push_back(iStart);
+				for (size_t iHead = 0; iHead < aiQueue.size(); ++iHead)
+				{
+					const CvPlot* pPlot = kMap.plotByIndexINLINE(aiQueue[iHead]);
+					for (int iDir = 0; iDir < NUM_DIRECTION_TYPES; ++iDir)
+					{
+						CvPlot* pAdj = plotDirection(pPlot->getX_INLINE(), pPlot->getY_INLINE(), (DirectionTypes)iDir);
+						if (pAdj == NULL || !pAdj->isWater() || !pAdj->isRevealed(eTeam, false) || pAdj->isImpassable() ||
+							!abTerrain[pAdj->getTerrainType()] ||
+							(pAdj->getFeatureType() != NO_FEATURE && !abFeature[pAdj->getFeatureType()]) ||
+							(pAdj->isOwned() && atWar(pAdj->getTeam(), eTeam)))
+						{
+							continue;
+						}
+						const int iAdj = kMap.plotNumINLINE(pAdj->getX_INLINE(), pAdj->getY_INLINE());
+						if (m_aiSettleSeaRegion[iAdj] < 0)
+						{
+							m_aiSettleSeaRegion[iAdj] = iRegion;
+							aiQueue.push_back(iAdj);
+						}
+					}
+				}
+			}
+			const std::pair<int, int> kLink(iLandRegion, m_aiSettleSeaRegion[iStart]);
+			if (std::find(m_aSettlePortLinks.begin(), m_aSettlePortLinks.end(), kLink) == m_aSettlePortLinks.end())
+			{
+				m_aSettlePortLinks.push_back(kLink);
+			}
+		}
+	}
+	// A party lands from the water next to its site; record that water's region
+	// on the land plot (land plots carry no sea region otherwise).
+	for (int iPlot = 0; iPlot < iNumPlots; ++iPlot)
+	{
+		const CvPlot* pPlot = kMap.plotByIndexINLINE(iPlot);
+		if (!pPlot->isWater() || m_aiSettleSeaRegion[iPlot] < 0)
+		{
+			continue;
+		}
+		for (int iDir = 0; iDir < NUM_DIRECTION_TYPES; ++iDir)
+		{
+			CvPlot* pAdj = plotDirection(pPlot->getX_INLINE(), pPlot->getY_INLINE(), (DirectionTypes)iDir);
+			if (pAdj != NULL && !pAdj->isWater() && pAdj->isRevealed(eTeam, false) &&
+				(!pAdj->isOwned() || pAdj->getTeam() == eTeam))
+			{
+				const int iAdj = kMap.plotNumINLINE(pAdj->getX_INLINE(), pAdj->getY_INLINE());
+				if (m_aiSettleSeaRegion[iAdj] < 0)
+				{
+					m_aiSettleSeaRegion[iAdj] = m_aiSettleSeaRegion[iPlot];
+				}
+			}
+		}
+	}
+}
+
+bool CvPlayerAI::AI_canDeliverSettler(const CvPlot* pFrom, const CvPlot* pSite, bool* pbByLand) const
+{
+	if (pbByLand != NULL)
+	{
+		*pbByLand = false;
+	}
+	CvMap& kMap = GC.getMapINLINE();
+	const int iFrom = kMap.plotNumINLINE(pFrom->getX_INLINE(), pFrom->getY_INLINE());
+	const int iSite = kMap.plotNumINLINE(pSite->getX_INLINE(), pSite->getY_INLINE());
+	// Not computed (barbarians, no found values yet), or a party outside the
+	// land joined to our cities (at sea, landed abroad): do not limit it.
+	if ((int)m_aiSettleLandRegion.size() != kMap.numPlotsINLINE() || pFrom->isWater() ||
+		m_aiSettleLandRegion[iFrom] < 0)
+	{
+		if (pbByLand != NULL)
+		{
+			*pbByLand = true;
+		}
+		return true;
+	}
+	if (m_aiSettleLandRegion[iSite] == m_aiSettleLandRegion[iFrom])
+	{
+		if (pbByLand != NULL)
+		{
+			*pbByLand = true;
+		}
+		return true;
+	}
+	if (m_aiSettleSeaRegion.empty() || m_aiSettleSeaRegion[iSite] < 0)
+	{
+		return false;
+	}
+	const std::pair<int, int> kLink(m_aiSettleLandRegion[iFrom], m_aiSettleSeaRegion[iSite]);
+	return std::find(m_aSettlePortLinks.begin(), m_aSettlePortLinks.end(), kLink) != m_aSettlePortLinks.end();
+}
+
+bool CvPlayerAI::AI_isSettleSiteDeliverable(const CvPlot* pSite) const
+{
+	CvMap& kMap = GC.getMapINLINE();
+	const int iSite = kMap.plotNumINLINE(pSite->getX_INLINE(), pSite->getY_INLINE());
+	if ((int)m_aiSettleLandRegion.size() != kMap.numPlotsINLINE())
+	{
+		return true;
+	}
+	return m_aiSettleLandRegion[iSite] >= 0 || (!m_aiSettleSeaRegion.empty() && m_aiSettleSeaRegion[iSite] >= 0);
+}
+
+bool CvPlayerAI::AI_hasDeliverableSettlementSite(const CvPlot* pFrom) const
+{
+	const int iCandidates = AI_getNumSettlementCandidates();
+	for (int i = 0; i < iCandidates; ++i)
+	{
+		int iFound;
+		if (AI_canDeliverSettler(pFrom, AI_getSettlementCandidate(i, iFound)))
+		{
+			return true;
+		}
+	}
+	return false;
+}
+
+// Sites a party at pFrom can only reach by boat; 0 when one can be walked to.
+int CvPlayerAI::AI_countSeaOnlySettlementSites(const CvPlot* pFrom) const
+{
+	int iSeaSites = 0;
+	const int iCandidates = AI_getNumSettlementCandidates();
+	for (int i = 0; i < iCandidates; ++i)
+	{
+		int iFound;
+		bool bByLand;
+		if (AI_canDeliverSettler(pFrom, AI_getSettlementCandidate(i, iFound), &bByLand))
+		{
+			if (bByLand)
+			{
+				return 0;
+			}
+			++iSeaSites;
+		}
+	}
+	return iSeaSites;
+}
 
