+namespace
+{
+	// Game turns in a speed's calendar (the sum of its turn increments).
+	int calendarTurns(GameSpeedTypes eSpeed)
+	{
+		int iTurns = 0;
+		const CvGameSpeedInfo& kSpeed = GC.getGameSpeedInfo(eSpeed);
+		for (int i = 0; i < kSpeed.getNumTurnIncrements(); ++i)
+		{
+			iTurns += kSpeed.getGameTurnInfo(i).iNumGameTurnsPerIncrement;
+		}
+		return std::max(1, iTurns);
+	}
+
+	// Turns of this game's speed per 100 turns of the standard speed, for the
+	// same stretch of history (Marathon in RoM: 1470 / 700 -> 210).
+	int calendarTurnsPercent()
+	{
+		const GameSpeedTypes eSpeed = GC.getGameINLINE().getGameSpeedType();
+		const GameSpeedTypes eStandard = (GameSpeedTypes)GC.getDefineINT("STANDARD_GAMESPEED");
+		if (eStandard < 0 || eStandard >= GC.getNumGameSpeedInfos())
+		{
+			return 100;
+		}
+		return std::max(1, (100 * calendarTurns(eSpeed)) / calendarTurns(eStandard));
+	}
+}
