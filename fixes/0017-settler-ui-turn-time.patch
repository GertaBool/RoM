diff --git a/Tools/test_patch_0017.py b/Tools/test_patch_0017.py
new file mode 100644
index 0000000..9f24ad4
--- /dev/null
+++ b/Tools/test_patch_0017.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""A settler that waited forever, and work the interface and AI did for nothing.
+
+Found in the GertaBool/RoM toolchain/harness over whole Marathon games:
+- On Earth 12, Genghis Khan never founded a city. His start plot cannot hold a
+  city in RoM, China founded next to the plot his settler walked to, and from
+  then on AI_found accepted a site only for a settler with an escort, which a
+  player without cities can never train. The original RoM DLL does the same.
+- Every unit birth or death redrew the Python plot list while the human had
+  nothing selected: the plot was compared with the selection plot, and both
+  were NULL.
+- Hovering over a stack of more than 15 units cleared a 21 MB table of
+  promotion counts (423 unit types x 51 players x 244 promotions).
+- CvGame::updateScore called calculateScore (a Python callback) once per
+  comparison, players x players times.
+- CvPlayer::canBuild tested the plot before the cheaper tech requirement, and
+  getBestRoute scanned every build; calculatePreInflatedCosts called Python
+  getExtraCost, which returns 0 in RoM, tens of thousands of times a turn.
+"""
+import unittest
+from test_review_correctness import DLL, block
+
+
+def src(name):
+    return (DLL / name).read_text(encoding='latin-1')
+
+
+class SettlerTests(unittest.TestCase):
+    def test_settler_without_cities_travels_alone(self):
+        method = block(src('CvUnitAI.cpp'), 'bool CvUnitAI::AI_found(')
+        self.assertIn('const bool bEscortOptional = kPlayer.getNumCities() == 0;', method)
+        self.assertEqual(method.count('(bEscortOptional || getGroup()->canDefend() ||'), 2)
+
+
+class InterfaceTests(unittest.TestCase):
+    def test_no_plot_list_redraw_without_a_plot(self):
+        for name in ('CvUnit.cpp', 'CvSelectionGroup.cpp'):
+            text = src(name)
+            self.assertNotIn('if (pPlot == gDLL->getInterfaceIFace()->getSelectionPlot())\r\n\t\t\t{\r\n\t\t\t\tgDLL->getInterfaceIFace()->setDirty(PlotListButtons_DIRTY_BIT', text)
+            self.assertNotIn('if (plot() == gDLL->getInterfaceIFace()->getSelectionPlot())', text)
+        self.assertEqual(src('CvUnit.cpp').count('!= NULL && pPlot == gDLL->getInterfaceIFace()->getSelectionPlot()') +
+                         src('CvUnit.cpp').count('plot() != NULL && plot() == gDLL->getInterfaceIFace()->getSelectionPlot()'), 4)
+
+    def test_hover_help_allocates_rows_on_demand(self):
+        method = block(src('CvGameTextMgr.cpp'), 'void CvGameTextMgr::setPlotListHelp(')
+        self.assertIn('m_apbPromotion.resize(GC.getNumUnitInfos() * MAX_PLAYERS, NULL);', method)
+        self.assertNotIn('m_apbPromotion.push_back(new int[numPromotionInfos]);', method)
+        self.assertNotIn('m_apbPromotion[iI][iJ] = 0;', method)
+        self.assertIn('m_apbPromotion.clear();', block(src('CvGameTextMgr.cpp'), 'void CvGameTextMgr::DeInitialize('))
+
+    def test_score_computed_once_per_player(self):
+        method = block(src('CvGame.cpp'), 'void CvGame::updateScore(')
+        self.assertEqual(method.count('calculateScore(false)'), 1)
+        self.assertIn('iScore = aiPlayerScore[iJ];', method)
+
+
+class TurnTimeTests(unittest.TestCase):
+    def test_can_build_tests_tech_before_plot(self):
+        method = block(src('CvPlayer.cpp'), 'bool CvPlayer::canBuild(')
+        self.assertLess(method.index('getTechPrereq()'), method.index('pPlot->canBuild('))
+
+    def test_best_route_scans_route_builds_only(self):
+        method = block(src('CvPlayer.cpp'), 'RouteTypes CvPlayer::getBestRoute(')
+        self.assertIn('aeRouteBuilds', method)
+        self.assertNotIn('for (iI = 0; iI < GC.getNumBuildInfos(); iI++)', method)
+
+    def test_extra_cost_callback_behind_switch(self):
+        method = block(src('CvPlayer.cpp'), 'int CvPlayer::calculatePreInflatedCosts(')
+        self.assertIn('USE_GET_EXTRA_COST_CALLBACK', method)
+        xml = (DLL.parent / 'XML' / 'PythonCallbackDefines.xml').read_text(encoding='latin-1')
+        self.assertIn('<DefineName>USE_GET_EXTRA_COST_CALLBACK</DefineName>', xml)
+
+
+if __name__ == '__main__':
+    unittest.main()
