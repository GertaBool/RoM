 within maximum bounds (invalid Index)");\n\tm_aaiContactTimer[eIndex1][eIndex2] = (AI_getContactTimer(eIndex1, eIndex2) + iChange);\n\tFAssert(AI_getContactTimer(eIndex1, eIndex2) >= 0);\n}\n\n\nint CvPlayerAI::AI_getMemoryCount(PlayerTypes eIndex1, MemoryTypes eIndex2) const\n{\n\tFAssertMsg(eIndex1 >= 0, "eIndex1 is expected to be non-negative (invalid Index)");\n\tFAssertMsg(eIndex1 < MAX_PLAYERS, "eIndex1 is expected to be within maximum bounds (invalid Index)");\n\tFAssertMsg(eIndex2 >= 0, "eIndex2 is expected to be non-negative (invalid Index)");\n\tFAssertMsg(eIndex2 < NUM_MEMORY_TYPES, "eIndex2 is expected to be within maximum bounds (invalid Index)");\n\treturn m_aaiMemoryCount[eIndex1][eIndex2];\n}\n\n\nvoid CvPlayerAI::AI_changeMemoryCount(PlayerTypes eIndex1, MemoryTypes eIndex2, int iChange)\n{\n\tFAssertMsg(eIndex1 >= 0, "eIndex1 is expected to be non-negative (invalid Index)");\n\tFAssertMsg(eIndex1 < MAX_PLAYERS, "eIndex1 is expected to be within maximum bounds (invalid Index)");\n\tFAssertMsg(eIndex2 >= 0, "eIndex2 is expected to be non-negative (invalid Index)");\n\tFAssertMsg(eIndex2 < NUM_MEMORY_TYPES, "eIndex2 is expected to be within maximum bounds (invalid Index)");\n\tm_aaiMemoryCount[eIndex1][eIndex2] += iChange;\n// BUG - Update Attitude Icons - start\n\tif (eIndex1 == GC.getGameINLINE().getActivePlayer())\n\t{\n\t\tgDLL->getInterfaceIFace()->setDirty(Score_DIRTY_BIT, true);\n\t}\n// BUG - Update Attitude Icons - end\n\tFAssert(AI_getMemoryCount(eIndex1, eIndex2) >= 0);\n}\n\nint CvPlayerAI::AI_calculateGoldenAgeValue() const\n{\n    int iValue;\n    int iTempValue;\n    int iI;\n\n    iValue = 0;\n    for (iI = 0; iI <  NUM_YIELD_TYPES; ++iI)\n    {\n        iTempValue = (GC.getYieldInfo((YieldTypes)iI).getGoldenAgeYield() * AI_yieldWeight((YieldTypes)iI));\n        iTempValue /= std::max(1, (1 + GC.getYieldInfo((YieldTypes)iI).getGoldenAgeYieldThreshold()));\n        iValue += iTempValue;\n    }\n\n    iValue *= getTotalPopulation();\n    iValue *= GC.getGameINLINE().goldenAgeLength();\n    iValue /= 100;\n\n    return iValue;\n}\n\n// Protected Functions...\n\nvoid CvPlayerAI::AI_doCounter()\n{\n\tint iBonusImports;\n\tint iI, iJ;\n\n\tfor (iI = 0; iI < MAX_PLAYERS; iI++)\n\t{\n\t\tif (GET_PLAYER((PlayerTypes)iI).isAlive())\n\t\t{\n\t\t\tif (GET_PLAYER((PlayerTypes)iI).getTeam() != getTeam())\n\t\t\t{\n\t\t\t\tif (GET_TEAM(getTeam()).isHasMet(GET_PLAYER((PlayerTypes)iI).getTeam()))\n\t\t\t\t{\n\t\t\t\t\tif ((getStateReligion() != NO_RELIGION) &&\n\t\t\t\t\t\t  (getStateReligion() == GET_PLAYER((PlayerTypes)iI).getStateReligion()))\n\t\t\t\t\t{\n\t\t\t\t\t\tAI_changeSameReligionCounter(((PlayerTypes)iI), 1);\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tif (AI_getSameReligionCounter((PlayerTypes)iI) > 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tAI_changeSameReligionCounter(((PlayerTypes)iI), -1);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\n\t\t\t\t\tif ((getStateReligion() != NO_RELIGION) &&\n\t\t\t\t\t\t  (GET_PLAYER((PlayerTypes)iI).getStateReligion() != NO_RELIGION) &&\n\t\t\t\t\t\t  (getStateReligion() != GET_PLAYER((PlayerTypes)iI).getStateReligion()))\n\t\t\t\t\t{\n\t\t\t\t\t\tAI_changeDifferentReligionCounter(((PlayerTypes)iI), 1);\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tif (AI_getDifferentReligionCounter((PlayerTypes)iI) > 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tAI_changeDifferentReligionCounter(((PlayerTypes)iI), -1);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\n\t\t\t\t\tif (GC.getLeaderHeadInfo(getPersonalityType()).getFavoriteCivic() != NO_CIVIC)\n\t\t\t\t\t{\n\t\t\t\t\t\tif (isCivic((CivicTypes)(GC.getLeaderHeadInfo(getPersonalityType()).getFavoriteCivic())) &&\n\t\t\t\t\t\t\t  GET_PLAYER((PlayerTypes)iI).isCivic((CivicTypes)(GC.getLeaderHeadInfo(getPersonalityType()).getFavoriteCivic())))\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tAI_changeFavoriteCivicCounter(((PlayerTypes)iI), 1);\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif (AI_getFavoriteCivicCounter((PlayerTypes)iI) > 0)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tAI_changeFavoriteCivicCounter(((PlayerTypes)iI), -1);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\n\t\t\t\t\tiBonusImports = getNumTradeBonusImports((PlayerTypes)iI);\n\n\t\t\t\t\tif (iBonusImports > 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tAI_changeBonusTradeCounter(((PlayerTypes)iI), iBonusImports);\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tAI_changeBonusTradeCounter(((PlayerTypes)iI), -(std::min(AI_getBonusTradeCounter((PlayerTypes)iI), ((GET_PLAYER((PlayerTypes)iI).getNumCities() / 4) + 1))));\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\tfor (iI = 0; iI < MAX_PLAYERS; iI++)\n\t{\n\t\tif (GET_PLAYER((PlayerTypes)iI).isAlive())\n\t\t{\n\t\t\tfor (iJ = 0; iJ < NUM_CONTACT_TYPES; iJ++)\n\t\t\t{\n\t\t\t\tif (AI_getContactTimer(((PlayerTypes)iI), ((ContactTypes)iJ)) > 0)\n\t\t\t\t{\n\t\t\t\t\tAI_changeContactTimer(((PlayerTypes)iI), ((ContactTypes)iJ), -1);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\tfor (iI = 0; iI < MAX_PLAYERS; iI++)\n\t{\n\t\tif (GET_PLAYER((PlayerTypes)iI).isAlive())\n\t\t{\n\t\t\tfor (iJ = 0; iJ < NUM_MEMORY_TYPES; iJ++)\n\t\t\t{\n\t\t\t\tif (AI_getMemoryCount(((PlayerTypes)iI), ((MemoryTypes)iJ)) > 0)\n\t\t\t\t{\n\t\t\t\t\tif (GC.getLeaderHeadInfo(getPersonalityType()).getMemoryDecayRand(iJ) > 0)\n\t\t\t\t\t{\n\t\t\t\t\t\tif (GC.getGameINLINE().getSorenRandNum(GC.getLeaderHeadInfo(getPersonalityType()).getMemoryDecayRand(iJ), "Memory Decay") == 0)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tAI_changeMemoryCount(((PlayerTypes)iI), ((MemoryTypes)iJ), -1);\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n}\n\n\nnamespace\n{\n\t// Doctrine badges also identify commanders commissioned by the operation\n\t// controller. Keep this file-local so incremental legacy/PCH builds do not\n\t// require a new CvPlayerAI public member merely to inspect a unit.\n\tbool isCommissionedGeneral(const CvUnit* pGeneral)\n\t{\n\t\tif (pGeneral == NULL || pGeneral->AI_getUnitAIType() != UNITAI_GENERAL)\n\t\t{\n\t\t\treturn false;\n\t\t}\n\t\tconst char* aszBadges[NUM_AI_GENERAL_PERSONALITY_TYPES] =\n\t\t{\n\t\t\t"PROMOTION_OPERATION_GENERAL_CONQUEROR",\n\t\t\t"PROMOTION_OPERATION_GENERAL_LOGISTICIAN",\n\t\t\t"PROMOTION_OPERATION_GENERAL_RAIDER",\n\t\t\t"PROMOTION_OPERATION_GENERAL_COLONIZER"\n\t\t};\n\t\tfor (int i = 0; i < NUM_AI_GENERAL_PERSONALITY_TYPES; ++i)\n\t\t{\n\t\t\tPromotionTypes eBadge = (PromotionTypes)GC.getInfoTypeForString(aszBadges[i], true);\n\t\t\tif (eBadge != NO_PROMOTION && pGeneral->isHasPromotion(eBadge))\n\t\t\t{\n\t\t\t\treturn true;\n\t\t\t}\n\t\t}\n\t\treturn false;\n\t}\n\n\tvoid setOperationalGeneralBadge(CvUnit* pGeneral, int iPersonality)\n\t{\n\t\tif (pGeneral == NULL)\n\t\t{\n\t\t\treturn;\n\t\t}\n\t\tconst char* aszBadges[NUM_AI_GENERAL_PERSONALITY_TYPES] =\n\t\t{\n\t\t\t"PROMOTION_OPERATION_GENERAL_CONQUEROR",\n\t\t\t"PROMOTION_OPERATION_GENERAL_LOGISTICIAN",\n\t\t\t"PROMOTION_OPERATION_GENERAL_RAIDER",\n\t\t\t"PROMOTION_OPERATION_GENERAL_COLONIZER"\n\t\t};\n\t\tfor (int i = 0; i < NUM_AI_GENERAL_PERSONALITY_TYPES; ++i)\n\t\t{\n\t\t\tPromotionTypes eBadge = (PromotionTypes)GC.getInfoTypeForString(aszBadges[i], true);\n\t\t\tif (eBadge != NO_PROMOTION)\n\t\t\t{\n\t\t\t\tpGeneral->setHasPromotion(eBadge, i == iPersonality);\n\t\t\t}\n\t\t}\n\t}\n}\n\nint CvPlayerAI::AI_getNumMilitaryOperations() const\n{\n\treturn (int)m_aiMilitaryOperations.size();\n}\n\nbool CvPlayerAI::AI_isOperationalGeneral(int iGeneralUnitID) const\n{\n\tfor (size_t i = 0; i < m_aiMilitaryOperations.size(); ++i)\n\t{\n\t\tif (m_aiMilitaryOperations[i].iGeneralUnitID == iGeneralUnitID)\n\t\t{\n\t\t\treturn true;\n\t\t}\n\t}\n\treturn false;\n}\n\nCvSelectionGroup* CvPlayerAI::AI_getGeneralOperationGroup(int iGeneralUnitID) const\n{\n\tfor (size_t i = 0; i < m_aiMilitaryOperations.size(); ++i)\n\t{\n\t\tif (m_aiMilitaryOperations[i].iGeneralUnitID == iGeneralUnitID)\n\t\t{\n\t\t\treturn getSelectionGroup(m_aiMilitaryOperations[i].iGroupID);\n\t\t}\n\t}\n\treturn NULL;\n}\n\nCvCity* CvPlayerAI::AI_getOperationTargetCity(int iGroupID) const\n{\n\tif (isHuman())\n\t{\n\t\treturn NULL;\n\t}\n\tfor (size_t i = 0; i < m_aiMilitaryOperations.size(); ++i)\n\t{\n\t\tconst AIOperationData& kOperation = m_aiMilitaryOperations[i];\n\t\tif (kOperation.iGroupID != iGroupID)\n\t\t{\n\t\t\tcontinue;\n\t\t}\n\t\t// An assembling or recovering army still publishes reinforcement demand,\n\t\t// but it must not be dragged toward the objective before it is ready.\n\t\tif (kOperation.iState != AI_OPERATION_ADVANCING)\n\t\t{\n\t\t\treturn NULL;\n\t\t}\n\t\tCvPlot* pTargetPlot = GC.getMapINLINE().plotINLINE(kOperation.iTargetX, kOperation.iTargetY);\n\t\tCvCity* pTargetCity = (pTargetPlot == NULL) ? NULL : pTargetPlot->getPlotCity();\n\t\tif (pTargetCity != NULL && pTargetCity->getOwnerINLINE() == kOperation.iTargetOwner &&\n\t\t\tatWar(getTeam(), pTargetCity->getTeam()))\n\t\t{\n\t\t\treturn pTargetCity;\n\t\t}\n\t}\n\treturn NULL;\n}\n\nCvCity* CvPlayerAI::AI_findOperationTargetCity(CvArea* pArea, CvSelectionGroup* pGroup) const\n{\n\tif (pArea == NULL || pGroup == NULL) return NULL;\n\tCvCity* pBestCity = NULL;\n\tint iBestValue = 0;\n\tfor (int iPlayer = 0; iPlayer < MAX_CIV_PLAYERS; ++iPlayer)\n\t{\n\t\tCvPlayer& kTargetPlayer = GET_PLAYER((PlayerTypes)iPlayer);\n\t\tif (!kTargetPlayer.isAlive() || !atWar(getTeam(), kTargetPlayer.getTeam())) continue;\n\t\tint iCityLoop = 0;\n\t\tfor (CvCity* pCity = kTargetPlayer.firstCity(&iCityLoop); pCity != NULL;\n\t\t\tpCity = kTargetPlayer.nextCity(&iCityLoop))\n\t\t{\n\t\t\tif (pCity->area() != pArea) continue;\n\t\t\tint iClaimants = 0;\n\t\t\tfor (size_t iOperation = 0; iOperation < m_aiMilitaryOperations.size(); ++iOperation)\n\t\t\t{\n\t\t\t\tconst AIOperationData& kOperation = m_aiMilitaryOperations[iOperation];\n\t\t\t\tif (kOperation.iTargetOwner == pCity->getOwnerINLINE() &&\n\t\t\t\t\tkOperation.iTargetCityID == pCity->getID()) ++iClaimants;\n\t\t\t}\n\t\t\tconst int iDistance = plotDistance(pGroup->getX(), pGroup->getY(),\n\t\t\t\tpCity->getX_INLINE(), pCity->getY_INLINE());\n\t\t\tconst int iValue = AIHierarchyPolicy::operationTargetValue(\n\t\t\t\tAI_targetCityValue(pCity, false), iDistance, iClaimants,\n\t\t\t\tAI_getStrategicRiskTolerance());\n\t\t\tif (iValue > iBestValue || (iValue == iBestValue && iValue > 0 &&\n\t\t\t\t(pBestCity == NULL || pCity->getID() < pBestCity->getID())))\n\t\t\t{\n\t\t\t\tiBestValue = iValue;\n\t\t\t\tpBestCity = pCity;\n\t\t\t}\n\t\t}\n\t}\n\treturn pBestCity;\n}\n\nnamespace\n{\nbool isOperationFieldRole(UnitAITypes eRole)\n{\n    return eRole == UNITAI_ATTACK_CITY || eRole == UNITAI_ATTACK || eRole == UNITAI_COUNTER ||\n        eRole == UNITAI_COLLATERAL || eRole == UNITAI_PILLAGE;\n}\n}\n\nint CvPlayerAI::AI_getOperationRoleTarget(UnitAITypes eRole, CvArea* pArea, CvCity* pSourceCity) const\n{\n\tif (isHuman() || pArea == NULL || !isOperationFieldRole(eRole))\n\t{\n\t\treturn 0;\n\t}\n\tint iTarget = 0;\n\n\tconst int iTurn = GC.getGameINLINE().getGameTurn();\n\tconst int iSourceCityID = pSourceCity == NULL ? -1 : pSourceCity->getID();\n\tif (m_iOperationDeliveryCacheTurn != iTurn || m_iOperationDeliveryCacheCityID != iSourceCityID)\n\t{\n\t\tm_aiOperationDeliveryCache.clear();\n\t\tm_iOperationDeliveryCacheTurn = iTurn;\n\t\tm_iOperationDeliveryCacheCityID = iSourceCityID;\n\t}\n\n\tfor (size_t i = 0; i < m_aiMilitaryOperations.size(); ++i)\n\t{\n\t\tconst AIOperationData& kOperation = m_aiMilitaryOperations[i];\n\t\tCvSelectionGroup* pGroup = getSelectionGroup(kOperation.iGroupID);\n\t\tif (pGroup != NULL && pGroup->getHeadUnit() != NULL && pGroup->area() == pArea)\n\t\t{\n            if (kOperation.aiDesiredRoles[eRole] <= 0) continue;\n            // Same area is already required above. Plot ownership is not delivery:\n            // the stack is often on a road, neutral ground or enemy land exactly\n            // when it needs replacements. The safe-path query and the logistics\n            // horizon below are the gate. plotDistance/baseMoves is not a sound\n            // reject either: movementCost is at least 1, while a unit has\n            // baseMoves * MOVE_DENOMINATOR points per turn, so a roaded stack\n            // nine plots away can still arrive inside a four-turn horizon.\n            if (pSourceCity == NULL) continue;\n\t\t\tint iDeliveryTurns = 0;\n\t\t\tbool bReachable = false;\n\t\t\tbool bCached = false;\n\t\t\tconst AIOperationDeliveryCache* pDelivery = NULL;\n\t\t\tfor (size_t iCache = 0; iCache < m_aiOperationDeliveryCache.size(); ++iCache)\n\t\t\t{\n\t\t\t\tconst AIOperationDeliveryCache& kCache = m_aiOperationDeliveryCache[iCache];\n\t\t\t\tif (kCache.iOperationID == kOperation.iID)\n\t\t\t\t{\n\t\t\t\t\tiDeliveryTurns = kCache.iDeliveryTurns;\n\t\t\t\t\tbReachable = kCache.bReachable;\n\t\t\t\t\tbCached = true;\n\t\t\t\t\tpDelivery = &kCache;\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\t\t\tif (!bCached)\n\t\t\t{\n\t\t\t\tbReachable = pGroup->generatePath(pSourceCity->plot(), pGroup->plot(),\n\t\t\t\t\tMOVE_SAFE_TERRITORY, true, &iDeliveryTurns);\n\t\t\t\tAIOperationDeliveryCache kCache;\n\t\t\t\tkCache.iOperationID = kOperation.iID;\n\t\t\t\tkCache.iDeliveryTurns = iDeliveryTurns;\n\t\t\t\tkCache.bReachable = bReachable;\n\t\t\t\tfor (int iRole = 0; iRole < NUM_UNITAI_TYPES; ++iRole)\n\t\t\t\t{\n\t\t\t\t\tkCache.aiPresent[iRole] = 0;\n\t\t\t\t\tkCache.aiIncoming[iRole] = 0;\n\t\t\t\t}\n\t\t\t\tCLLNode<IDInfo>* pMemberNode = pGroup->headUnitNode();\n\t\t\t\twhile (pMemberNode != NULL)\n\t\t\t\t{\n\t\t\t\t\tCvUnit* pMember = ::getUnit(pMemberNode->m_data);\n\t\t\t\t\tpMemberNode = pGroup->nextUnitNode(pMemberNode);\n\t\t\t\t\tif (pMember != NULL && pMember->AI_getUnitAIType() >= 0 &&\n\t\t\t\t\t\tpMember->AI_getUnitAIType() < NUM_UNITAI_TYPES)\n\t\t\t\t\t{\n\t\t\t\t\t\tkCache.aiPresent[pMember->AI_getUnitAIType()]++;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tCvUnit* pOperationHead = pGroup->getHeadUnit();\n\t\t\t\tint iGroupLoop = 0;\n\t\t\t\tfor (CvSelectionGroup* pIncomingGroup = firstSelectionGroup(&iGroupLoop);\n\t\t\t\t\tpIncomingGroup != NULL; pIncomingGroup = nextSelectionGroup(&iGroupLoop))\n\t\t\t\t{\n\t\t\t\t\tif (pIncomingGroup == pGroup || pIncomingGroup->AI_getMissionAIType() != MISSIONAI_GROUP ||\n\t\t\t\t\t\tpIncomingGroup->AI_getMissionAIUnit() != pOperationHead) continue;\n\t\t\t\t\tCLLNode<IDInfo>* pIncomingNode = pIncomingGroup->headUnitNode();\n\t\t\t\t\twhile (pIncomingNode != NULL)\n\t\t\t\t\t{\n\t\t\t\t\t\tCvUnit* pIncoming = ::getUnit(pIncomingNode->m_data);\n\t\t\t\t\t\tpIncomingNode = pIncomingGroup->nextUnitNode(pIncomingNode);\n\t\t\t\t\t\tif (pIncoming != NULL && pIncoming->AI_getUnitAIType() >= 0 &&\n\t\t\t\t\t\t\tpIncoming->AI_getUnitAIType() < NUM_UNITAI_TYPES)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tkCache.aiIncoming[pIncoming->AI_getUnitAIType()]++;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tm_aiOperationDeliveryCache.push_back(kCache);\n\t\t\t\tpDelivery = &m_aiOperationDeliveryCache.back();\n\t\t\t}\n\t\t\tif (!bReachable || iDeliveryTurns >\n\t\t\t\tAIHierarchyPolicy::operationDeliveryHorizon(AI_getLogisticsPriority()) ||\n\t\t\t\tpDelivery == NULL) continue;\n            int iHave = pDelivery->aiPresent[eRole];\n            int iIncoming = pDelivery->aiIncoming[eRole];\n            iTarget += std::max(0, kOperation.aiDesiredRoles[eRole] - iHave - iIncoming);\n\t\t}\n\t}\n    // Recovery needs replacements too. Same-area, safe-path and horizon gates still apply.\n    // Caller subtracts all existing/training area roles. Add them back only to\n    // express a bounded unmet operation request; training reduces the deficit.\n    return AIHierarchyPolicy::operationRoleTarget(\n        AI_totalAreaUnitAIs(pArea, eRole), iTarget,\n        pArea->getNumTrainAIUnits(getID(), eRole), true, 0,\n        AIHierarchyPolicy::operationDeliveryHorizon(AI_getLogisticsPriority()));\n}\n\nint CvPlayerAI::AI_countIncomingOperationRole(CvSelectionGroup* pOperationGroup, UnitAITypes eRole,\n\tCvSelectionGroup* pSkipSelectionGroup) const\n{\n\tif (pOperationGroup == NULL || eRole < 0 || eRole >= NUM_UNITAI_TYPES) return 0;\n\tCvUnit* pOperationHead = pOperationGroup->getHeadUnit();\n\tif (pOperationHead == NULL) return 0;\n\tint iCount = 0;\n\tint iLoop = 0;\n\tfor (CvSelectionGroup* pIncomingGroup = firstSelectionGroup(&iLoop);\n\t\tpIncomingGroup != NULL; pIncomingGroup = nextSelectionGroup(&iLoop))\n\t{\n\t\tif (pIncomingGroup == pOperationGroup || pIncomingGroup == pSkipSelectionGroup ||\n\t\t\tpIncomingGroup->AI_getMissionAIType() != MISSIONAI_GROUP ||\n\t\t\tpIncomingGroup->AI_getMissionAIUnit() != pOperationHead) continue;\n\t\tCLLNode<IDInfo>* pNode = pIncomingGroup->headUnitNode();\n\t\twhile (pNode != NULL)\n\t\t{\n\t\t\tCvUnit* pUnit = ::getUnit(pNode->m_data);\n\t\t\tpNode = pIncomingGroup->nextUnitNode(pNode);\n\t\t\tif (pUnit != NULL && pUnit->AI_getUnitAIType() == eRole) ++iCount;\n\t\t}\n\t}\n\treturn iCount;\n}\n\nvoid CvPlayerAI::AI_recordGeneralLoss(const AIOperationData& kOperation)\n{\n    // The dead id is about to be recycled by initUnit. Keying the career on it\n    // either drops the loss when the successor is remembered, or hands the old\n    // doctrine to whichever later unit draws that slot.\n    AIGeneralCareer kCareer;\n    kCareer.iAvailableTurn = GC.getGameINLINE().getGameTurn();\n    int iLowestKey = 0;\n    for (size_t i = 0; i < m_aiGeneralCareers.size(); ++i)\n    {\n        if (m_aiGeneralCareers[i].iUnitID < iLowestKey)\n            iLowestKey = m_aiGeneralCareers[i].iUnitID;\n    }\n    kCareer.iUnitID = AIDecisionPolicy::nextLossCareerKey(iLowestKey);\n    kCareer.iPersonality = kOperation.iPersonality;\n    kCareer.iAuthority = range(kOperation.iAuthority, 0, 1000);\n    kCareer.iPerformance = range(kOperation.iPerformance, -100, 100);\n    m_aiGeneralCareers.push_back(kCareer);\n}\n\nvoid CvPlayerAI::AI_rememberGeneral(const AIOperationData& kOperation)\n{\n    if (getUnit(kOperation.iGeneralUnitID) == NULL)\n    {\n        AI_recordGeneralLoss(kOperation);\n        return;\n    }\n    AIGeneralCareer kCareer;\n    kCareer.iAvailableTurn = GC.getGameINLINE().getGameTurn();\n    if (kOperation.iState == AI_OPERATION_RECOVERING)\n        kCareer.iAvailableTurn += AIDecisionPolicy::scaledTurns(4,\n            GC.getGameSpeedInfo(GC.getGameINLINE().getGameSpeedType()).getTrainPercent());\n    kCareer.iUnitID = kOperation.iGeneralUnitID;\n    kCareer.iPersonality = kOperation.iPersonality;\n    kCareer.iAuthority = range(kOperation.iAuthority, 0, 1000);\n    kCareer.iPerformance = range(kOperation.iPerformance, -100, 100);\n    for (size_t i = 0; i < m_aiGeneralCareers.size(); ++i)\n    {\n        if (m_aiGeneralCareers[i].iUnitID == kCareer.iUnitID)\n        {\n            m_aiGeneralCareers[i] = kCareer;\n            return;\n        }\n    }\n    m_aiGeneralCareers.push_back(kCareer);\n}\n\nCvSelectionGroup* CvPlayerAI::AI_getOperationReinforcementGroup(CvUnit* pUnit) const\n{\n    if (isHuman() || pUnit == NULL || !isOperationFieldRole(pUnit->AI_getUnitAIType())) return NULL;\n    CvSelectionGroup* pBest = NULL;\n    int iBest = 0;\n    for (size_t i = 0; i < m_aiMilitaryOperations.size(); ++i)\n    {\n        const AIOperationData& kOperation = m_aiMilitaryOperations[i];\n        CvSelectionGroup* pGroup = getSelectionGroup(kOperation.iGroupID);\n        if (pGroup == NULL || pGroup == pUnit->getGroup() || pGroup->area() != pUnit->area() ||\n            pGroup->getHeadUnit() == NULL) continue;\n        int iHave = 0;\n        CLLNode<IDInfo>* pNode = pGroup->headUnitNode();\n        while (pNode != NULL)\n        {\n            CvUnit* pMember = ::getUnit(pNode->m_data);\n            pNode = pGroup->nextUnitNode(pNode);\n            if (pMember != NULL && pMember->AI_getUnitAIType() == pUnit->AI_getUnitAIType()) ++iHave;\n        }\n        // Count all reserved joiners conservatively; avoid competing assignments.\n        int iNeed = kOperation.aiDesiredRoles[pUnit->AI_getUnitAIType()] - iHave -\n            AI_countIncomingOperationRole(pGroup, pUnit->AI_getUnitAIType(), pUnit->getGroup());\n        if (iNeed <= 0) continue;\n        int iTurns = 0;\n        if (!pUnit->generatePath(pGroup->plot(), MOVE_SAFE_TERRITORY, true, &iTurns) ||\n\t\t\tiTurns > AIHierarchyPolicy::operationDeliveryHorizon(AI_getLogisticsPriority())) continue;\n        int iValue = 100 * iNeed / (1 + iTurns);\n        if (iValue > iBest) { iBest = iValue; pBest = pGroup; }\n    }\n    return pBest;\n}\n\nint CvPlayerAI::AI_getOperationState(int iGroupID) const\n{\n    if (isHuman()) return -1;\n    for (size_t i = 0; i < m_aiMilitaryOperations.size(); ++i)\n        if (m_aiMilitaryOperations[i].iGroupID == iGroupID) return m_aiMilitaryOperations[i].iState;\n    return -1;\n}\n\nint CvPlayerAI::AI_getOperationSiegeUrgency(int iGroupID) const\n{\n    if (isHuman()) return 0;\n    for (size_t i = 0; i < m_aiMilitaryOperations.size(); ++i)\n        if (m_aiMilitaryOperations[i].iGroupID == iGroupID)\n            return m_aiMilitaryOperations[i].iState == AI_OPERATION_ADVANCING ? m_aiMilitaryOperations[i].iSiegeUrgency : 0;\n    return 0;\n}\n\nvoid CvPlayerAI::AI_updateMilitaryOperations()\n{\n\tPROFILE_FUNC();\n\tif (isHuman() || isBarbarian() || isMinorCiv() || !isAlive())\n\t{\n\t\treturn;\n\t}\n\n\tconst int iTurn = GC.getGameINLINE().getGameTurn();\n\tfor (int i = (int)m_aiMilitaryOperations.size() - 1; i >= 0; --i)\n\t{\n\t\tAIOperationData& kOperation = m_aiMilitaryOperations[i];\n\t\tCvUnit* pGeneral = getUnit(kOperation.iGeneralUnitID);\n\t\tCvSelectionGroup* pGroup = getSelectionGroup(kOperation.iGroupID);\n\t\tCvPlot* pTargetPlot = GC.getMapINLINE().plotINLINE(kOperation.iTargetX, kOperation.iTargetY);\n\t\tCvCity* pTargetCity = (pTargetPlot == NULL) ? NULL : pTargetPlot->getPlotCity();\n\n\t\tif (pGeneral == NULL)\n\t\t{\n\t\t\tint iSurvivalChance = 80 + ((kOperation.iPersonality == AI_GENERAL_LOGISTICIAN) ? 5 : 0);\n\t\t\tiSurvivalChance += range(kOperation.iPerformance / 20, -15, 5);\n\t\t\tiSurvivalChance = range(iSurvivalChance, 60, 90);\n\t\t\tCvCity* pCapital = getCapitalCity();\n\t\t\t// Before the survival roll\'s initUnit. Remembering afterwards sees\n\t\t\t// the recycled id and never stores the commander who actually died.\n\t\t\t// The roll itself is unchanged and still consumes one random draw.\n\t\t\tAI_rememberGeneral(kOperation);\n\t\t\tif (pCapital != NULL && GC.getGameINLINE().getSorenRandNum(100, "AI General Survival") < iSurvivalChance)\n\t\t\t{\n\t\t\t\tpGeneral = initUnit((UnitTypes)kOperation.iGeneralUnitType, pCapital->getX_INLINE(),\n\t\t\t\t\tpCapital->getY_INLINE(), UNITAI_GENERAL);\n\t\t\t\tif (pGeneral == NULL)\n\t\t\t\t{\n\t\t\tm_aiMilitaryOperations.erase(m_aiMilitaryOperations.begin() + i);\n\t\t\t\t\tcontinue;\n\t\t\t\t}\n\t\t\t\tkOperation.iGeneralUnitID = pGeneral->getID();\n\t\t\t\tkOperation.iAuthority = std::max(0, kOperation.iAuthority - 200);\n\t\t\t\tkOperation.iPerformance = AIDecisionPolicy::performance(kOperation.iPerformance, -70);\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\tm_aiMilitaryOperations.erase(m_aiMilitaryOperations.begin() + i);\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t}\n\t\tif (pGeneral->AI_getUnitAIType() != UNITAI_GENERAL)\n\t\t{\n\t\t\tAI_rememberGeneral(kOperation);\n\t\t\tm_aiMilitaryOperations.erase(m_aiMilitaryOperations.begin() + i);\n\t\t\tcontinue;\n\t\t}\n\t\tsetOperationalGeneralBadge(pGeneral, kOperation.iPersonality);\n\n\t\tif (pTargetCity != NULL && pTargetCity->getOwnerINLINE() == getID() &&\n            pGroup != NULL && plotDistance(pGroup->getX(), pGroup->getY(), kOperation.iTargetX, kOperation.iTargetY) <= 1)\n\t\t{\n\t\t\t// A victorious commander substantially shortens occupation, but cannot\n\t\t\t// erase it outright. Authority and conqueror skill raise a capped 45..80%.\n\t\t\tint iPacifyPercent = 45 + kOperation.iAuthority / 25;\n\t\t\tif (kOperation.iPersonality == AI_GENERAL_CONQUEROR)\n\t\t\t{\n\t\t\t\tiPacifyPercent += 15;\n\t\t\t}\n\t\t\tiPacifyPercent = range(iPacifyPercent, 45, 80);\n\t\t\tif (pTargetCity->getOccupationTimer() > 1)\n\t\t\t{\n\t\t\t\tint iReduction = std::max(1, (pTargetCity->getOccupationTimer() * iPacifyPercent) / 100);\n\t\t\t\tpTargetCity->changeOccupationTimer(-std::min(iReduction, pTargetCity->getOccupationTimer() - 1));\n\t\t\t}\n\t\t\tif (pTargetCity->getRevolutionIndex() > 0)\n\t\t\t{\n\t\t\t\tpTargetCity->changeRevolutionIndex(-std::min(pTargetCity->getRevolutionIndex(),\n\t\t\t\t\t10 + kOperation.iAuthority / 20));\n\t\t\t}\n\t\t\tkOperation.iAuthority = std::min(1000, kOperation.iAuthority + 160);\n\t\t\tkOperation.iPerformance = AIDecisionPolicy::performance(kOperation.iPerformance, 100);\n\t\t\tif (gPlayerLogLevel >= 2)\n\t\t\t{\n\t\t\t\tlogBBAI("    Player %d operation %d captured %S: occupation reduced %d%%",\n\t\t\t\t\tgetID(), kOperation.iID, pTargetCity->getName().GetCString(), iPacifyPercent);\n\t\t\t}\n\t\t\t// Move the surviving physical commander into the captured city. This\n\t\t\t// makes doctrine revolt protection operational during the vulnerable\n\t\t\t// post-capture turns instead of leaving it stranded one tile behind.\n\t\t\tif (!pGeneral->atPlot(pTargetCity->plot()))\n\t\t\t{\n\t\t\t\tpGeneral->getGroup()->pushMission(MISSION_MOVE_TO, pTargetCity->getX_INLINE(),\n\t\t\t\t\tpTargetCity->getY_INLINE(), MOVE_SAFE_TERRITORY);\n\t\t\t}\n\t\t\tAI_rememberGeneral(kOperation);\n\t\t\tm_aiMilitaryOperations.erase(m_aiMilitaryOperations.begin() + i);\n\t\t\tcontinue;\n\t\t}\n\n\t\tif (pTargetCity == NULL || pTargetCity->getOwnerINLINE() != kOperation.iTargetOwner ||\n            pTargetCity->getID() != kOperation.iTargetCityID ||\n\t\t\t!atWar(getTeam(), pTargetCity->getTeam()))\n\t\t{\n\t\t\tAI_rememberGeneral(kOperation);\n\t\t\tm_aiMilitaryOperations.erase(m_aiMilitaryOperations.begin() + i);\n\t\t\tcontinue;\n\t\t}\n\n\t\tif (pGroup == NULL || pGroup->getNumUnits() == 0)\n\t\t{\n            kOperation.iState = AI_OPERATION_RECOVERING;\n\t\t\tkOperation.iAuthority = std::max(0, kOperation.iAuthority - 180);\n\t\t\tkOperation.iPerformance = AIDecisionPolicy::performance(kOperation.iPerformance, -80);\n\t\t\tAI_rememberGeneral(kOperation);\n\t\t\tm_aiMilitaryOperations.erase(m_aiMilitaryOperations.begin() + i);\n\t\t\tcontinue;\n\t\t}\n\n        // Embarked movement belongs to the transport AI. Ocean travel is not a\n        // stalled land siege; do not expire the operation while it is cargo.\n        if (pGroup->getHeadUnit() != NULL && pGroup->getHeadUnit()->isCargo())\n        {\n            kOperation.iLastProgressTurn = iTurn;\n            kOperation.iStateTurn = iTurn;\n            kOperation.iLastDistance = plotDistance(pGroup->getX(), pGroup->getY(),\n                kOperation.iTargetX, kOperation.iTargetY);\n            kOperation.iLastGroupSize = pGroup->getNumUnits();\n            kOperation.iSiegeStartTurn = -1;\n            kOperation.iSiegeUrgency = 0;\n            AI_rememberGeneral(kOperation);\n            continue;\n        }\n\t\tint iGroupSize = pGroup->getNumUnits();\n\t\tint iDistance = plotDistance(pGroup->getX(), pGroup->getY(),\n\t\t\tkOperation.iTargetX, kOperation.iTargetY);\n\t\tif (iDistance < kOperation.iLastDistance)\n\t\t{\n\t\t\tkOperation.iLastProgressTurn = iTurn;\n\t\t\tkOperation.iLastDistance = iDistance;\n\t\t}\n\t\tif (iGroupSize < kOperation.iLastGroupSize)\n\t\t{\n\t\t\tint iLoss = kOperation.iLastGroupSize - iGroupSize;\n\t\t\tkOperation.iAuthority = std::max(0, kOperation.iAuthority - 20 * iLoss);\n\t\t\tkOperation.iPerformance = AIDecisionPolicy::performance(kOperation.iPerformance, -std::min(100, 7 * iLoss));\n\t\t}\n\t\telse if (iGroupSize > kOperation.iLastGroupSize)\n\t\t{\n\t\t\tkOperation.iAuthority = std::min(1000, kOperation.iAuthority + 5 * (iGroupSize - kOperation.iLastGroupSize));\n\t\t\tkOperation.iLastProgressTurn = iTurn;\n\t\t}\n\t\tkOperation.iLastGroupSize = iGroupSize;\n\n        int iDesiredFieldUnits = 0;\n        for (int iRole = 0; iRole < NUM_UNITAI_TYPES; ++iRole)\n            if (isOperationFieldRole((UnitAITypes)iRole)) iDesiredFieldUnits += kOperation.aiDesiredRoles[iRole];\n        int iReadyUnits = 0;\n        int iCapturers = 0;\n        int iHealth = 0;\n        int iCombatUnits = 0;\n        CLLNode<IDInfo>* pNode = pGroup->headUnitNode();\n        while (pNode != NULL)\n        {\n            CvUnit* pUnit = ::getUnit(pNode->m_data);\n            pNode = pGroup->nextUnitNode(pNode);\n            if (pUnit == NULL || !pUnit->canAttack() || pUnit->getDomainType() != DOMAIN_LAND) continue;\n            ++iCombatUnits;\n            iHealth += 100 * pUnit->currHitPoints() / std::max(1, pUnit->maxHitPoints());\n            if (isOperationFieldRole(pUnit->AI_getUnitAIType()) &&\n                kOperation.aiDesiredRoles[pUnit->AI_getUnitAIType()] > 0 && pUnit->getDamage() <= 40) ++iReadyUnits;\n            if (!pUnit->isNoCapture() && pUnit->combatLimit() >= 100 && pUnit->getDamage() <= 40) ++iCapturers;\n        }\n        iHealth /= std::max(1, iCombatUnits);\n        const bool bKnownTarget = pTargetCity->isVisible(getTeam(), false) || iDistance <= 2;\n        // At strategic assembly time movement points may not yet be reset. Test\n        // combat capability, not this instant\'s movement allowance.\n        const int iRatio = bKnownTarget ? pGroup->AI_compareStacks(pTargetPlot, true, true, false) : 0;\n        int iAssemblyRatio = iRatio;\n\t\tconst int iRequiredRatio = range(125 - AI_getStrategicRiskTolerance() / 20, 95, 120);\n\n        if (bKnownTarget)\n        {\n            int iRemovableDefense = std::max(0, pTargetCity->getDefenseModifier(true)) *\n                std::max(0, 20 - pGroup->getBombardTurns(pTargetCity)) / 20;\n            iAssemblyRatio = iRatio * (100 + iRemovableDefense) / 100;\n            // Reinforcement demand responds to observed strength, not just the\n            // original defender headcount. Cap each operation\'s assault request.\n            if (iAssemblyRatio < iRequiredRatio && iReadyUnits > 0)\n                kOperation.aiDesiredRoles[UNITAI_ATTACK_CITY] = std::min(24,\n                    std::max(kOperation.aiDesiredRoles[UNITAI_ATTACK_CITY],\n                    iCapturers + (iReadyUnits * (iRequiredRatio - iAssemblyRatio) + std::max(25, iAssemblyRatio) - 1) /\n                    std::max(25, iAssemblyRatio)));\n        }\n        const bool bForceReady = iCapturers >= 2 && (bKnownTarget ?\n\t\t\tiAssemblyRatio >= iRequiredRatio : iReadyUnits >= std::max(4, (2 * iDesiredFieldUnits + 2) / 3));\n        const int iScale = GC.getGameSpeedInfo(GC.getGameINLINE().getGameSpeedType()).getTrainPercent();\n        const int iRecoverTurns = AIDecisionPolicy::scaledTurns(2, iScale);\n        const int iStallTurns = AIDecisionPolicy::scaledTurns(12, iScale);\n        const int iOldState = kOperation.iState;\n        const int iHealthLoss = std::max(0, kOperation.iLastHealthPercent - iHealth);\n        kOperation.iSiegeUrgency = 0;\n        bool bSiegeUnsafe = false;\n        if (iDistance <= 1)\n        {\n            if (kOperation.iSiegeStartTurn < 0) kOperation.iSiegeStartTurn = iTurn;\n            const bool bWallProgress = pTargetCity->getDefenseDamage() > kOperation.iLastDefenseDamage;\n            if (bWallProgress) kOperation.iLastProgressTurn = iTurn;\n            int iWait = iTurn - kOperation.iSiegeStartTurn;\n            kOperation.iSiegeUrgency = std::min(15, 2 * iHealthLoss +\n                (bWallProgress ? 0 : std::max(0, iWait - AIDecisionPolicy::scaledTurns(2, iScale))));\n            if ((iHealthLoss >= 5 && iRatio < 110) ||\n                (iWait >= AIDecisionPolicy::scaledTurns(6, iScale) && iRatio < 110))\n            {\n                bSiegeUnsafe = true;\n                kOperation.iState = AI_OPERATION_RECOVERING;\n            }\n        }\n        else kOperation.iSiegeStartTurn = -1;\n        kOperation.iLastHealthPercent = iHealth;\n        kOperation.iLastDefenseDamage = pTargetCity->getDefenseDamage();\n        if (iOldState == AI_OPERATION_RECOVERING)\n        {\n            if (AIDecisionPolicy::recoveryReady(iTurn - kOperation.iStateTurn, iRecoverTurns, iHealth, bForceReady && !bSiegeUnsafe))\n                kOperation.iState = AI_OPERATION_ADVANCING;\n            else if (iTurn - kOperation.iStateTurn >= iStallTurns)\n            {\n                kOperation.iAuthority = std::max(0, kOperation.iAuthority - 120);\n                kOperation.iPerformance = AIDecisionPolicy::performance(kOperation.iPerformance, -50);\n                AI_rememberGeneral(kOperation);\n                m_aiMilitaryOperations.erase(m_aiMilitaryOperations.begin() + i);\n                continue;\n            }\n        }\n        else if (kOperation.iState != AI_OPERATION_RECOVERING)\n        {\n            if (iTurn - kOperation.iLastProgressTurn > iStallTurns || iHealth < 60)\n                kOperation.iState = AI_OPERATION_RECOVERING;\n            else kOperation.iState = bForceReady ? AI_OPERATION_ADVANCING : AI_OPERATION_ASSEMBLING;\n        }\n        if (kOperation.iState != iOldState)\n        {\n            kOperation.iStateTurn = iTurn;\n            if (kOperation.iState == AI_OPERATION_ADVANCING)\n            {\n                kOperation.iLastProgressTurn = iTurn;\n                kOperation.iLastDistance = iDistance;\n                kOperation.iSiegeStartTurn = -1;\n            }\n            if (gPlayerLogLevel >= 2)\n                logBBAI("    Operation %d state %d -> %d health %d ratio %d field %d capture %d urgency %d",\n                    kOperation.iID, iOldState, kOperation.iState, iHealth, iRatio, iReadyUnits, iCapturers, kOperation.iSiegeUrgency);\n        }\n        AI_rememberGeneral(kOperation);\n\t}\n\n    // A general\'s death is operational evidence, not a reason to erase the\n\t// campaign instantly. Retain the bounded career record for the same horizon\n\t// used by agenda feedback, then discard it to cap memory and stale influence.\n\tconst int iCareerHorizon = AIDecisionPolicy::scaledTurns(80,\n\t\tGC.getGameSpeedInfo(GC.getGameINLINE().getGameSpeedType()).getTrainPercent());\n\tfor (int iCareer = (int)m_aiGeneralCareers.size() - 1; iCareer >= 0; --iCareer)\n\t{\n\t\tif (getUnit(m_aiGeneralCareers[iCareer].iUnitID) == NULL &&\n\t\t\tiTurn - m_aiGeneralCareers[iCareer].iAvailableTurn >= iCareerHorizon)\n\t\t{\n\t\t\tm_aiGeneralCareers.erase(m_aiGeneralCareers.begin() + iCareer);\n\t\t}\n\t}\n\n\t// Do not turn a speculative preparation plan into a production sink. A\n\t// commander receives operational authority only after hostilities begin.\n\tif (GET_TEAM(getTeam()).getAtWarCount(true) == 0)\n\t{\n\t\treturn;\n\t}\n\n\tconst int iOperationCap = std::min(3, 1 + getNumCities() / 6);\n\tif ((int)m_aiMilitaryOperations.size() >= iOperationCap)\n\t{\n\t\treturn;\n\t}\n\n\t// Operations must not depend on first farming enough combat experience for a\n\t// Great General. If an actual war and an unassigned assault stack exist, an AI\n\t// may commission one physical commander per operation slot. Doctrine badges\n\t// mark these units as standing commanders so they cannot become free Academy,\n\t// specialist, or Warlord consumables when an operation ends.\n\tint iCommissionedGenerals = 0;\n\tint iUnitLoop;\n\tfor (CvUnit* pLoopUnit = firstUnit(&iUnitLoop); pLoopUnit != NULL; pLoopUnit = nextUnit(&iUnitLoop))\n\t{\n\t\tif (pLoopUnit->AI_getUnitAIType() == UNITAI_GENERAL)\n\t\t{\n\t\t\tif (isCommissionedGeneral(pLoopUnit))\n\t\t\t{\n\t\t\t\tiCommissionedGenerals++;\n\t\t\t}\n\t\t}\n\t}\n\n\tif (iCommissionedGenerals < iOperationCap)\n\t{\n\t\tCvSelectionGroup* pSeedGroup = NULL;\n\t\tint iGroupLoop;\n\t\tfor (CvSelectionGroup* pLoopGroup = firstSelectionGroup(&iGroupLoop); pLoopGroup != NULL; pLoopGroup = nextSelectionGroup(&iGroupLoop))\n\t\t{\n\t\t\tCvUnit* pHead = pLoopGroup->getHeadUnit();\n\t\t\tif (pHead == NULL || pHead->isCargo() || pHead->AI_getUnitAIType() != UNITAI_ATTACK_CITY)\n\t\t\t{\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tbool bAssigned = false;\n\t\t\tfor (size_t i = 0; i < m_aiMilitaryOperations.size(); ++i)\n\t\t\t{\n\t\t\t\tbAssigned = bAssigned || m_aiMilitaryOperations[i].iGroupID == pLoopGroup->getID();\n\t\t\t}\n\t\t\tif (!bAssigned && (pSeedGroup == NULL || pLoopGroup->getNumUnits() > pSeedGroup->getNumUnits()))\n\t\t\t{\n\t\t\t\tpSeedGroup = pLoopGroup;\n\t\t\t}\n\t\t}\n\n\t\tCvCity* pSeedTarget = (pSeedGroup == NULL) ? NULL :\n\t\t\tAI_findOperationTargetCity(pSeedGroup->area(), pSeedGroup);\n\t\tif (pSeedTarget != NULL && !atWar(getTeam(), pSeedTarget->getTeam()))\n\t\t{\n\t\t\tpSeedTarget = NULL;\n\t\t}\n\t\tbool bAreaGeneralAvailable = false;\n\t\tif (pSeedGroup != NULL)\n\t\t{\n\t\t\tint iGeneralLoop;\n\t\t\tfor (CvUnit* pLoopGeneral = firstUnit(&iGeneralLoop); pLoopGeneral != NULL; pLoopGeneral = nextUnit(&iGeneralLoop))\n\t\t\t{\n\t\t\t\tif (pLoopGeneral->AI_getUnitAIType() == UNITAI_GENERAL &&\n\t\t\t\t\t!AI_isOperationalGeneral(pLoopGeneral->getID()) && pLoopGeneral->area() == pSeedGroup->area())\n\t\t\t\t{\n\t\t\t\t\tbAreaGeneralAvailable = true;\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t\n\t\tCvCity* pCommissionCity = NULL;\n\t\tint iBestDistance = MAX_INT;\n\t\tif (pSeedGroup != NULL && pSeedTarget != NULL && !bAreaGeneralAvailable)\n\t\t{\n\t\t\tint iCityLoop;\n\t\t\tfor (CvCity* pLoopCity = firstCity(&iCityLoop); pLoopCity != NULL; pLoopCity = nextCity(&iCityLoop))\n\t\t\t{\n\t\t\t\tif (pLoopCity->area() == pSeedGroup->area())\n\t\t\t\t{\n\t\t\t\t\tint iDistance = plotDistance(pLoopCity->getX_INLINE(), pLoopCity->getY_INLINE(),\n\t\t\t\t\t\tpSeedGroup->getX(), pSeedGroup->getY());\n\t\t\t\t\tif (iDistance < iBestDistance)\n\t\t\t\t\t{\n\t\t\t\t\t\tiBestDistance = iDistance;\n\t\t\t\t\t\tpCommissionCity = pLoopCity;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tUnitClassTypes eGeneralClass = (UnitClassTypes)GC.getInfoTypeForString("UNITCLASS_GREAT_GENERAL", true);\n\t\tUnitTypes eGeneral = NO_UNIT;\n\t\tif (eGeneralClass != NO_UNITCLASS)\n\t\t{\n\t\t\teGeneral = (UnitTypes)GC.getCivilizationInfo(getCivilizationType()).getCivilizationUnits(eGeneralClass);\n\t\t}\n\t\tif (pCommissionCity != NULL && eGeneral != NO_UNIT)\n\t\t{\n\t\t\tCvUnit* pCommissionedGeneral = initUnit(eGeneral, pCommissionCity->getX_INLINE(),\n\t\t\t\tpCommissionCity->getY_INLINE(), UNITAI_GENERAL);\n\t\t\tif (gPlayerLogLevel >= 2 && pCommissionedGeneral != NULL)\n\t\t\t{\n\t\t\t\tlogBBAI("    Player %d commissions operational general %d at %S",\n\t\t\t\t\tgetID(), pCommissionedGeneral->getID(), pCommissionCity->getName().GetCString());\n\t\t\t}\n\t\t}\n\t}\n\n\tint iGeneralLoop;\n\tfor (CvUnit* pGeneral = firstUnit(&iGeneralLoop); pGeneral != NULL; pGeneral = nextUnit(&iGeneralLoop))\n\t{\n\t\tif (pGeneral->AI_getUnitAIType() != UNITAI_GENERAL || AI_isOperationalGeneral(pGeneral->getID()))\n\t\t{\n\t\t\tcontinue;\n\t\t}\n\n        bool bCoolingDown = false;\n        for (size_t iCareer = 0; iCareer < m_aiGeneralCareers.size(); ++iCareer)\n            if (m_aiGeneralCareers[iCareer].iUnitID == pGeneral->getID() &&\n                m_aiGeneralCareers[iCareer].iAvailableTurn > iTurn) bCoolingDown = true;\n        if (bCoolingDown) continue;\n\n\t\tCvSelectionGroup* pBestGroup = NULL;\n\t\t// Distance can outweigh 100 * group size on sparse maps. Start below every\n\t\t// legal score so a distant but valid army is not mistaken for no army.\n\t\tint iBestGroupValue = -MAX_INT;\n\t\tint iGroupLoop;\n\t\tfor (CvSelectionGroup* pLoopGroup = firstSelectionGroup(&iGroupLoop); pLoopGroup != NULL; pLoopGroup = nextSelectionGroup(&iGroupLoop))\n\t\t{\n\t\t\tCvUnit* pHead = pLoopGroup->getHeadUnit();\n\t\t\tif (pHead == NULL || pHead->isCargo() || pHead->AI_getUnitAIType() != UNITAI_ATTACK_CITY ||\n\t\t\t\tpLoopGroup->area() != pGeneral->area())\n\t\t\t{\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tbool bAlreadyAssigned = false;\n\t\t\tfor (size_t j = 0; j < m_aiMilitaryOperations.size(); ++j)\n\t\t\t{\n\t\t\t\tbAlreadyAssigned = bAlreadyAssigned || (m_aiMilitaryOperations[j].iGroupID == pLoopGroup->getID());\n\t\t\t}\n\t\t\tif (bAlreadyAssigned)\n\t\t\t{\n\t\t\t\tcontinue;\n\t\t\t}\n\t\t\tint iValue = 100 * pLoopGroup->getNumUnits() - 10 * plotDistance(pGeneral->getX_INLINE(),\n\t\t\t\tpGeneral->getY_INLINE(), pHead->getX_INLINE(), pHead->getY_INLINE());\n\t\t\tif (iValue > iBestGroupValue)\n\t\t\t{\n\t\t\t\tiBestGroupValue = iValue;\n\t\t\t\tpBestGroup = pLoopGroup;\n\t\t\t}\n\t\t}\n\t\tif (pBestGroup == NULL)\n\t\t{\n\t\t\tcontinue;\n\t\t}\n\n\t\tCvCity* pTarget = AI_findOperationTargetCity(pBestGroup->area(), pBestGroup);\n\t\tif (pTarget == NULL || !atWar(getTeam(), pTarget->getTeam()))\n\t\t{\n\t\t\tcontinue;\n\t\t}\n\n\t\tAIOperationData kOperation;\n\t\tkOperation.iID = m_iNextOperationID++;\n\t\tkOperation.iGeneralUnitID = pGeneral->getID();\n\t\tkOperation.iGeneralUnitType = pGeneral->getUnitType();\n\t\tkOperation.iGroupID = pBestGroup->getID();\n\t\tkOperation.iTargetOwner = pTarget->getOwnerINLINE();\n\t\tkOperation.iTargetCityID = pTarget->getID();\n\t\tkOperation.iTargetX = pTarget->getX_INLINE();\n\t\tkOperation.iTargetY = pTarget->getY_INLINE();\n\t\tkOperation.iLastDistance = plotDistance(pBestGroup->getX(), pBestGroup->getY(),\n\t\t\tpTarget->getX_INLINE(), pTarget->getY_INLINE());\n\t\tfor (int iRole = 0; iRole < NUM_UNITAI_TYPES; ++iRole)\n\t\t{\n\t\t\tkOperation.aiDesiredRoles[iRole] = 0;\n\t\t}\n\t\tkOperation.aiDesiredRoles[UNITAI_ATTACK_CITY] =\n\t\t\tstd::max(2, pTarget->plot()->getNumVisibleEnemyDefenders(pGeneral)) + 2;\n\t\tkOperation.aiDesiredRoles[UNITAI_ATTACK] = 2;\n\t\tkOperation.aiDesiredRoles[UNITAI_COUNTER] = 2;\n\t\tkOperation.aiDesiredRoles[UNITAI_COLLATERAL] = std::max(2,\n\t\t\t(kOperation.aiDesiredRoles[UNITAI_ATTACK_CITY] - 2) / 2);\n\t\t// Removed: unit-ID modulo assigned doctrine without regard to the mission.\n\t\t// New commanders now match dense targets, long supply lines, soft raiding\n\t\t// opportunities, or expansion policy using bounded current observations.\n\t\tkOperation.iPersonality = AIFeedbackPolicy::chooseGeneralPersonality(\n\t\t\tAI_getAgendaBudget(AI_BUDGET_EXPANSION), AI_getLogisticsPriority(),\n\t\t\tAI_getStrategicRiskTolerance(), AI_getWarPosture(), kOperation.iLastDistance,\n\t\t\tkOperation.aiDesiredRoles[UNITAI_ATTACK_CITY] - 2);\n\t\tkOperation.iState = AI_OPERATION_ASSEMBLING;\n\t\tkOperation.iAuthority = 500;\n\t\tkOperation.iPerformance = 0;\n        // Only a badged returning commander retains a career doctrine. A newly\n\t\t// commissioned unit can reuse an engine unit ID after a casualty and must\n\t\t// not inherit that dead commander\'s record.\n        for (size_t iCareer = 0; isCommissionedGeneral(pGeneral) &&\n\t\t\tiCareer < m_aiGeneralCareers.size(); ++iCareer)\n        {\n            const AIGeneralCareer& kCareer = m_aiGeneralCareers[iCareer];\n            if (kCareer.iUnitID == pGeneral->getID())\n            {\n                kOperation.iPersonality = kCareer.iPersonality;\n                kOperation.iAuthority = kCareer.iAuthority;\n                kOperation.iPerformance = kCareer.iPerformance;\n                break;\n            }\n        }\n        kOperation.iStateTurn = iTurn;\n        kOperation.iLastHealthPercent = 100;\n        kOperation.iLastDefenseDamage = pTarget->getDefenseDamage();\n        kOperation.iSiegeStartTurn = -1;\n        kOperation.iSiegeUrgency = 0;\n\t\tkOperation.iStartTurn = iTurn;\n\t\tkOperation.iLastProgressTurn = iTurn;\n\t\tkOperation.iLastGroupSize = pBestGroup->getNumUnits();\n\t\tif (kOperation.iPersonality == AI_GENERAL_CONQUEROR)\n\t\t{\n\t\t\tkOperation.aiDesiredRoles[UNITAI_ATTACK_CITY] += 2;\n\t\t}\n\t\telse if (kOperation.iPersonality == AI_GENERAL_LOGISTICIAN)\n\t\t{\n\t\t\tkOperation.aiDesiredRoles[UNITAI_COUNTER] += 1;\n\t\t\tkOperation.aiDesiredRoles[UNITAI_RESERVE] = 2;\n\t\t}\n\t\telse if (kOperation.iPersonality == AI_GENERAL_RAIDER)\n\t\t{\n\t\t\tkOperation.aiDesiredRoles[UNITAI_PILLAGE] = 3;\n\t\t\tkOperation.aiDesiredRoles[UNITAI_ATTACK_CITY] = std::max(3,\n\t\t\t\tkOperation.aiDesiredRoles[UNITAI_ATTACK_CITY] - 2);\n\t\t}\n\t\telse if (kOperation.iPersonality == AI_GENERAL_COLONIZER)\n\t\t{\n\t\t\tkOperation.aiDesiredRoles[UNITAI_CITY_DEFENSE] = 2;\n\t\t\tkOperation.aiDesiredRoles[UNITAI_WORKER] = 1;\n\t\t}\n\t\t// The unit may already have queued a join/construct mission before being\n\t\t// appointed. Detach it first so clearing that stale order cannot erase the\n\t\t// missions of unrelated escorts sharing its old selection group.\n\t\tif (pGeneral->getGroup()->getNumUnits() > 1)\n\t\t{\n\t\t\tpGeneral->joinGroup(NULL);\n\t\t}\n\t\tpGeneral->getGroup()->clearMissionQueue();\n\t\tpGeneral->getGroup()->setActivityType(ACTIVITY_AWAKE);\n\t\tsetOperationalGeneralBadge(pGeneral, kOperation.iPersonality);\n\t\tm_aiMilitaryOperations.push_back(kOperation);\n        AI_rememberGeneral(kOperation);\n\t\tif (gPlayerLogLevel >= 2)\n\t\t{\n\t\t\tlogBBAI("    Player %d creates operation %d general %d personality %d target %S group %d",\n\t\t\t\tgetID(), kOperation.iID, kOperation.iGeneralUnitID, kOperation.iPersonality,\n\t\t\t\tpTarget->getName().GetCString(), kOperation.iGroupID);\n\t\t}\n\t\tbreak;\n\t}\n}\n\n\nvoid CvPlayerAI::AI_doMilitary()\n{\n\t// Human players retain complete control; the operation controller is an AI\n\t// coordination layer, never an automation override for human armies.\n\tif (!isHuman())\n\t{\n\t\tAI_updateMilitaryOperations();\n\t}\n\tif (GET_TEAM(getTeam()).getAnyWarPlanCount(true) == 0)\n\t{\n\t\twhile (AI_isFinancialTrouble() && (calculateUnitCost() > 0))\n\t\t{\n\t\t\tif (!AI_disbandUnit(1, false))\n\t\t\t{\n\t\t\t\tbreak;\n\t\t\t}\n\t\t}\n\t}\n\t\n\tint iAgendaAttackOdds = 0;\n\tif (AI_getAgenda() == AI_AGENDA_SURVIVE)\n\t{\n\t\tiAgendaAttackOdds = -10;\n\t}\n\telse if (AI_getAgenda() == AI_AGENDA_POWER_SPIKE)\n\t{\n\t\tiAgendaAttackOdds = 4;\n\t}\n\telse if (AI_getAgenda() == AI_AGENDA_CONQUEST)\n\t{\n\t\tiAgendaAttackOdds = 7;\n\t}\n\n\tAI_setAttackOddsChange(GC.getLeaderHeadInfo(getPersonalityType()).getBaseAttackOddsChange() +\n\t\tGC.getGameINLINE().getSorenRandNum(GC.getLeaderHeadInfo(getPersonalityType()).getAttackOddsChangeRand(), "AI Attack Odds Change #1") +\n\t\tGC.getGameINLINE().getSorenRandNum(GC.getLeaderHeadInfo(getPersonalityType()).getAttackOddsChangeRand(), "AI Attack Odds Change #2") +\n\t\tiAgendaAttackOdds);\n}\n\n\nvoid CvPlayerAI::AI_doResearch()\n{\n\tFAssertMsg(!isHuman(), "isHuman did not return false as expected");\n\n\tif (getCurrentResearch() == NO_TECH)\n\t{\n\t\tAI_chooseResearch();\n\t\tAI_forceUpdateStrategies(); //to account for current research.\n\t}\n}\n\n\nvoid CvPlayerAI::AI_doCommerce()\n{\n\tCvCity* pLoopCity;\n\tint iIdealPercent;\n\tint iGoldTarget;\n\tint iLoop;\n\n\tFAssertMsg(!isHuman(), "isHuman did not return false as expected");\n\n/************************************************************************************************/\n/* BETTER_BTS_AI_MOD                      07/20/09                                jdog5000      */\n/*                                                                                              */\n/* Barbarian AI, efficiency                                                                     */\n/************************************************************************************************/\n\tif( isBarbarian() )\n\t{\n\t\treturn;\n\t}\n/************************************************************************************************/\n/* BETTER_BTS_AI_MOD                       END                                                  */\n/************************************************************************************************/\n\n\tiGoldTarget = AI_goldTarget();\n\n\t// The agenda now controls a bounded treasury posture. Existing solvency,\n\t// upgrade, and no-research rules below remain hard constraints.\n\tif (AI_getAgenda() == AI_AGENDA_RECOVER)\n\t{\n\t\tiGoldTarget = (iGoldTarget * 3) / 2;\n\t}\n\telse if (AI_getAgenda() == AI_AGENDA_SCIENCE)\n\t{\n\t\tiGoldTarget = (iGoldTarget * 3) / 4;\n\t}\n\telse if (AI_getAgenda() == AI_AGENDA_SURVIVE || AI_getAgenda() == AI_AGENDA_CONQUEST)\n\t{\n\t\tiGoldTarget = (iGoldTarget * 5) / 4;\n\t}\n\n\tint iTargetTurns = 4 * GC.getGameSpeedInfo(GC.getGameINLINE().getGameSpeedType()).getResearchPercent();\n\tiTargetTurns /= 100;\n\tiTargetTurns = std::max(3, iTargetTurns);\n\n\t// Early research is an existential priority.  A peaceful, solvent ancient\n\t// AI should spend its treasury rather than preserve a speculative reserve.\n\tif (getCurrentEra() == 0 && !AI_isFinancialTrouble() && !isNoResearchAvailable())\n\t{\n\t\tbool bAtWar = GET_TEAM(getTeam()).getAtWarCount(true) > 0;\n\t\t// A speculative war plan is not an emergency. Peaceful ancient empires\n\t\t// bank nothing; an actual war keeps only one turn of operating costs.\n\t\tiGoldTarget = bAtWar ? std::min(iGoldTarget, std::max(20, calculateInflatedCosts())) : 0;\n\t\tiTargetTurns = std::max(2, iTargetTurns / 2);\n\t}\n\n    if (isCommerceFlexible(COMMERCE_RESEARCH) && !AI_avoidScience())\n\t{\n        // set research rate to 100%\n\t\tsetCommercePercent(COMMERCE_RESEARCH, 100);\n\t\t\n\t\t// if the gold rate is under 0 at 90% research\n\t\tint iGoldRate = calculateGoldRate();\n\t\tif (iGoldRate < 0)\n\t\t{\n\t\t\tTechTypes eCurrentResearch = getCurrentResearch();\n\t\t\tif (eCurrentResearch != NO_TECH)\n\t\t\t{\n\t\t\t\tint iResearchTurnsLeft = getResearchTurnsLeft(eCurrentResearch, true);\n\t\t\t\t\n\t\t\t\t// if we can finish the current research without running out of gold, let us spend 2/3rds of our gold \n\t\t\t\t__int64 iResearchRunwayCost = -((__int64)iResearchTurnsLeft * iGoldRate);\n\t\t\t\t\n\t\t\t\tif ((__int64)getGold() >= iResearchRunwayCost)\n\t\t\t\t{\n\t\t\t\t\tiGoldTarget /= 3;\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\n\tbool bReset = false;\n\n\tif (isCommerceFlexible(COMMERCE_CULTURE))\n\t{\n\t\tif (getCommercePercent(COMMERCE_CULTURE) > 0)\n\t\t{\n\t\t\tsetCommercePercent(COMMERCE_CULTURE, 0);\n\n\t\t\tbReset = true;\n\t\t}\n\t}\n\n\tif (isCommerceFlexible(COMMERCE_ESPIONAGE))\n\t{\n/********************************************************************************/\n/* \tBETTER_BTS_AI_MOD\t\t\t\t\t\t9/6/08\t\t\t\tjdog5000\t    */\n/* \t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t    */\n/* \tEspionage AI\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t    */\n/********************************************************************************/\n\t\t/* original BTS code\n\t\tif (getCommercePercent(COMMERCE_ESPIONAGE) > 0)\n\t\t{\n\t\t\tsetCommercePercent(COMMERCE_ESPIONAGE, 0);\n\n\t\t\tfor (int iTeam = 0; iTeam < MAX_CIV_TEAMS; ++iTeam)\n\t\t\t{\n\t\t\t\tsetEspionageSpendingWeightAgainstTeam((TeamTypes)iTeam, 0);\n\t\t\t}\n\n\t\t\tbReset = true;\n\t\t}\n\t\t*/\n\t\t\n\t\t// Reset espionage spending always\n\t\tfor (int iTeam = 0; iTeam < MAX_CIV_TEAMS; ++iTeam)\n\t\t{\n\t\t\tsetEspionageSpendingWeightAgainstTeam((TeamTypes)iTeam, 0);\n\t\t}\n\n\t\tif (getCommercePercent(COMMERCE_ESPIONAGE) > 0)\n\t\t{\n\t\t\tsetCommercePercent(COMMERCE_ESPIONAGE, 0);\n\n\t\t\tbReset = true;\n\t\t}\n/********************************************************************************/\n/* \tBETTER_BTS_AI_MOD\t\t\t\t\t\tEND\t\t\t\t\t\t\t\t    */\n/********************************************************************************/\n\t}\n\n\tif (bReset)\n\t{\n\t\tAI_assignWorkingPlots();\n\t}\n\n\tbool bFirstTech = AI_isFirstTech(getCurrentResearch());\n\tif (isCommerceFlexible(COMMERCE_CULTURE))\n\t{\n\t\tif (getNumCities() > 0)\n\t\t{\n\t\t\tiIdealPercent = 0;\n\n\t\t\tfor (pLoopCity = firstCity(&iLoop); pLoopCity != NULL; pLoopCity = nextCity(&iLoop))\n\t\t\t{\n\t\t\t\tif (pLoopCity->getCommerceHappinessPer(COMMERCE_CULTURE) > 0)\n\t\t\t\t{\n\t\t\t\t\tiIdealPercent += ((pLoopCity->angryPopulation() * 100) / pLoopCity->getCommerceHappinessPer(COMMERCE_CULTURE));\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tiIdealPercent /= getNumCities();\n\n\t\t\tiIdealPercent -= (iIdealPercent % GC.getDefineINT("COMMERCE_PERCENT_CHANGE_INCREMENTS"));\n\n\t\t\tiIdealPercent = std::min(iIdealPercent, 20);\n\n/************************************************************************************************/\n/* BETTER_BTS_AI_MOD                      03/08/10                                jdog5000      */\n/*                                                                                              */\n/* Victory Strategy AI                                                                          */\n/************************************************************************************************/\n\t\t\tif (AI_isDoVictoryStrategy(AI_VICTORY_CULTURE4))\n/************************************************************************************************/\n/* BETTER_BTS_AI_MOD                       END                                                  */\n/************************************************************************************************/\n\t\t\t{\n\t\t\t    iIdealPercent = 100;\n\t\t\t}\n\n\t\t\tsetCommercePercent(COMMERCE_CULTURE, iIdealPercent);\n\t\t}\n\t}\n\n\tif (isCommerceFlexible(COMMERCE_RESEARCH))\n\t{\n/************************************************************************************************/\n/* BETTER_BTS_AI_MOD                      03/08/10                                jdog5000      */\n/*                                                                                              */\n/* Victory Strategy AI                                                                          */\n/************************************************************************************************/\n\t\tif ((isNoResearchAvailable() || AI_isDoVictoryStrategy(AI_VICTORY_CULTURE4)) && !bFirstTech)\n/************************************************************************************************/\n/* BETTER_BTS_AI_MOD                       END                                                  */\n/************************************************************************************************/\n\t\t{\n\t\t\tsetCommercePercent(COMMERCE_RESEARCH, 0);\n\t\t}\n\t\telse\n\t\t{\n\t\t\twhile (calculateGoldRate() > 0)\n\t\t\t{\n\t\t\t\tchangeCommercePercent(COMMERCE_RESEARCH, GC.getDefineINT("COMMERCE_PERCENT_CHANGE_INCREMENTS"));\n\n\t\t\t\tif (getCommercePercent(COMMERCE_RESEARCH) == 100)\n\t\t\t\t{\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tif (getGold() + iTargetTurns * calculateGoldRate() < iGoldTarget)\n\t\t\t{\n\t\t\t\twhile (getGold() + iTargetTurns * calculateGoldRate() <= iGoldTarget)\n\t\t\t\t{\n\t\t\t\t\tchangeCommercePercent(COMMERCE_RESEARCH, -(GC.getDefineINT("COMMERCE_PERCENT_CHANGE_INCREMENTS")));\n\n\t\t\t\t\tif ((getCommercePercent(COMMERCE_RESEARCH) == 0))\n\t\t\t\t\t{\n\t\t\t\t\t\tbreak;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tif (AI_avoidScience())\n\t\t\t\t{\n\t\t\t\t\tchangeCommercePercent(COMMERCE_RESEARCH, -(GC.getDefineINT("COMMERCE_PERCENT_CHANGE_INCREMENTS")));\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tif (getCurrentEra() > 0 && ((GET_TEAM(getTeam()).getChosenWarCount(true) > 0) || (GET_TEAM(getTeam()).getWarPlanCount(WARPLAN_ATTACKED_RECENT, true) > 0)))\n\t\t\t{\n\t\t\t\tchangeCommercePercent(COMMERCE_RESEARCH, -(GC.getDefineINT("COMMERCE_PERCENT_CHANGE_INCREMENTS")));\n\t\t\t}\n\n\t\t\tif ((getCommercePercent(COMMERCE_RESEARCH) == 0) && (calculateGoldRate() > 0))\n\t\t\t{\n\t\t\t\tsetCommercePercent(COMMERCE_RESEARCH, GC.getDefineINT("COMMERCE_PERCENT_CHANGE_INCREMENTS"));\n\t\t\t}\n\t\t}\n\t}\n\n\tif (isCommerceFlexible(COMMERCE_ESPIONAGE) && !bFirstTech)\n\t{\n/********************************************************************************/\n/* \tBETTER_BTS_AI_MOD\t\t\t\t\t\t9/7/08\t\t\t\tjdog5000\t    */\n/* \t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t    */\n/* \tEspionage AI\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t    */\n/********************************************************************************/\n\t\t// original BTS code\n\t\t/*\n\t\tint iEspionageTargetRate = 0;\n\t\t//TSHEEP Additional variables for targetting tech leader\n\t\tint iTechTeam = MAX_CIV_TEAMS;\n\t\tint iTechScore = 0;\n\t\tint iTechHighScore = 0;\n\t\t//TSHEEP End\n\n\t\tfor (int iTeam = 0; iTeam < MAX_CIV_TEAMS; ++iTeam)\n\t\t{\n\t\t\tCvTeam& kLoopTeam = GET_TEAM((TeamTypes)iTeam);\n\t\t\tif (kLoopTeam.isAlive() && iTeam != getTeam() && !kLoopTeam.isVassal(getTeam()) && !GET_TEAM(getTeam()).isVassal((TeamTypes)iTeam))\n\t\t\t{\n\t\t\t\tint iTarget = (kLoopTeam.getEspionagePointsAgainstTeam(getTeam()) - GET_TEAM(getTeam()).getEspionagePointsAgainstTeam((TeamTypes)iTeam)) / 8;\n\n\t\t\t\tiTarget -= GET_TEAM(getTeam()).AI_getAttitudeVal((TeamTypes)iTeam);\n\n\t\t\t\tif (iTarget > 0)\n\t\t\t\t{\n\t\t\t\t\tiEspionageTargetRate += iTarget;\n\t\t\t\t\tchangeEspionageSpendingWeightAgainstTeam((TeamTypes)iTeam, iTarget);\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t\t*/\n\t\t\n\t\tint iEspionageTargetRate = 0;\n\t\tint* piTarget = new int[MAX_CIV_TEAMS];\n\t\tint* piWeight = new int[MAX_CIV_TEAMS];\n\n\t\tfor (int iTeam = 0; iTeam < MAX_CIV_TEAMS; ++iTeam)\n\t\t{\n\t\t\tpiTarget[iTeam] = 0;\n\t\t\tpiWeight[iTeam] = 0;\n\n\t\t\tCvTeam& kLoopTeam = GET_TEAM((TeamTypes)iTeam);\n\t\t\tif (kLoopTeam.isAlive() && iTeam != getTeam() && !kLoopTeam.isVassal(getTeam()) && !GET_TEAM(getTeam()).isVassal((TeamTypes)iTeam))\n\t\t\t{\n\t\t\t\tif( GET_TEAM(getTeam()).isHasMet((TeamTypes)iTeam) )\n\t\t\t\t{\t\n\t\t\t\t\tint iTheirEspPoints = kLoopTeam.getEspionagePointsAgainstTeam(getTeam());\n\t\t\t\t\tint iOurEspPoints = GET_TEAM(getTeam()).getEspionagePointsAgainstTeam((TeamTypes)iTeam);\n\t\t\t\t\tint iDesiredMissionPoints = 0;\n\t\t\t\t\tint iDesiredEspPoints = 0;\n\t\t\t\t\t\n\t\t\t\t\tpiWeight[iTeam] = 10;\n\t\t\t\t\tint iRateDivisor = 12;\n\n\t\t\t\t\tif( GET_TEAM(getTeam()).AI_getWarPlan((TeamTypes)iTeam) != NO_WARPLAN )\n\t\t\t\t\t{\n\t\t\t\t\t\tiTheirEspPoints *= 3;\n\t\t\t\t\t\tiTheirEspPoints /= 2;\n\n\t\t\t\t\t\tfor (int iMission = 0; iMission < GC.getNumEspionageMissionInfos(); ++iMission)\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tCvEspionageMissionInfo& kMissionInfo = GC.getEspionageMissionInfo((EspionageMissionTypes)iMission);\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\tif( kMissionInfo.isPassive() )\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tif( kMissionInfo.isSeeDemographics() || kMissionInfo.isSeeResearch() )\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tint iMissionCost = (11*getEspionageMissionCost((EspionageMissionTypes)iMission, GET_TEAM((TeamTypes)iTeam).getLeaderID(), NULL, -1, NULL))/10;\n\t\t\t\t\t\t\t\t\tif( iDesiredMissionPoints < iMissionCost )\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tiDesiredMissionPoints = iMissionCost;\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\n\t\t\t\t\t\tiRateDivisor = 10;\n\t\t\t\t\t\tpiWeight[iTeam] = 20;\n\n\t\t\t\t\t\tif( GET_TEAM(getTeam()).AI_hasCitiesInPrimaryArea((TeamTypes)iTeam) )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tpiWeight[iTeam] = 30;\n\t\t\t\t\t\t\tiRateDivisor = 8;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\telse\n\t\t\t\t\t{\n\t\t\t\t\t\tint iAttitude = range(GET_TEAM(getTeam()).AI_getAttitudeVal((TeamTypes)iTeam), -12, 12);\n\n\t\t\t\t\t\tiTheirEspPoints -= (iTheirEspPoints*iAttitude)/(2*12);\n\n\t\t\t\t\t\tif( iAttitude <= -3 )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tfor (int iMission = 0; iMission < GC.getNumEspionageMissionInfos(); ++iMission)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tCvEspionageMissionInfo& kMissionInfo = GC.getEspionageMissionInfo((EspionageMissionTypes)iMission);\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\tif( kMissionInfo.isPassive() )\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tif( kMissionInfo.isSeeDemographics() || kMissionInfo.isSeeResearch() )\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tint iMissionCost = (11*getEspionageMissionCost((EspionageMissionTypes)iMission, GET_TEAM((TeamTypes)iTeam).getLeaderID(), NULL, -1, NULL))/10;\n\t\t\t\t\t\t\t\t\t\tif( iDesiredMissionPoints < iMissionCost )\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tiDesiredMissionPoints = iMissionCost;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t\telse if( iAttitude < 3 )\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tfor (int iMission = 0; iMission < GC.getNumEspionageMissionInfos(); ++iMission)\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tCvEspionageMissionInfo& kMissionInfo = GC.getEspionageMissionInfo((EspionageMissionTypes)iMission);\n\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\tif( kMissionInfo.isPassive() )\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tif( kMissionInfo.isSeeDemographics() )\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tint iMissionCost = (11*getEspionageMissionCost((EspionageMissionTypes)iMission, GET_TEAM((TeamTypes)iTeam).getLeaderID(), NULL, -1, NULL))/10;\n\t\t\t\t\t\t\t\t\t\tif( iDesiredMissionPoints < iMissionCost )\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tiDesiredMissionPoints = iMissionCost;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\n\t\t\t\t\t\tiRateDivisor += (iAttitude/5);\n\t\t\t\t\t\tpiWeight[iTeam] -= (iAttitude/2);\n\t\t\t\t\t}\n\n\t\t\t\t\tiDesiredEspPoints = std::max(iTheirEspPoints,iDesiredMissionPoints);\n\n\t\t\t\t\tpiTarget[iTeam] = (iDesiredEspPoints - iOurEspPoints)/std::max(6,iRateDivisor);\n\n\t\t\t\t\tif( piTarget[iTeam] > 0 )\n\t\t\t\t\t{\n\t\t\t\t\t\tiEspionageTargetRate += piTarget[iTeam];\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\n\t\tfor (int iTeam = 0; iTeam < MAX_CIV_TEAMS; ++iTeam)\n\t\t{\n\t\t\tif( piTarget[iTeam] > 0 )\n\t\t\t{\n\t\t\t\tpiWeight[iTeam] += (150*piTarget[iTeam])/std::max(4,iEspionageTargetRate);\n\t\t\t}\n\t\t\telse if( piTarget[iTeam] < 0 )\n\t\t\t{\n\t\t\t\tpiWeight[iTeam] += 2*piTarget[iTeam];\n\t\t\t}\t\n\t\t\tsetEspionageSpendingWeightAgainstTeam((TeamTypes)iTeam, std::max(0,piWeight[iTeam]));\n\t\t}\n\t\tSAFE_DELETE(piTarget);\n\t\tSAFE_DELETE(piWeight);\n/********************************************************************************/\n/* \tBETTER_BTS_AI_MOD\t\t\t\t\t\tEND\t\t\t\t\t\t\t\t    */\n/********************************************************************************/\n\n\t\t//if economy is weak, neglect espionage spending.\n\t\t//instead invest hammers into espionage via spies/builds\n/************************************************************************************************/\n/* BETTER_BTS_AI_MOD                      03/08/10                                jdog5000      */\n/*                                                                                              */\n/* Victory Strategy AI                                                                          */\n/************************************************************************************************/\n\t\tif (AI_isFinancialTrouble() || AI_isDoVictoryStrategy(AI_VICTORY_CULTURE3))\n/************************************************************************************************/\n/* BETTER_BTS_AI_MOD                       END                                                  */\n/************************************************************************************************/\n\t\t{\n\t\t\t//can still get trickle espionage income\n\t\t\tiEspionageTargetRate = 0;\n\t\t}\n\t\telse\n\t\t{\n\t\t\tiEspionageTargetRate *= (110 - getCommercePercent(COMMERCE_GOLD) * 2);\n\t\t\tiEspionageTargetRate /= 110;\n\n\t\t\tiEspionageTargetRate *= GC.getLeaderHeadInfo(getLeaderType()).getEspionageWeight();\n\t\t\tiEspionageTargetRate /= 100;\n\n\t\t\tint iInitialResearchPercent = getCommercePercent(COMMERCE_RESEARCH);\n\n\t\t\twhile (getCommerceRate(COMMERCE_ESPIONAGE) < iEspionageTargetRate && getCommercePercent(COMMERCE_ESPIONAGE) < 20)\n\t\t\t{\n\t\t\t\tchangeCommercePercent(COMMERCE_RESEARCH, -GC.getDefineINT("COMMERCE_PERCENT_CHANGE_INCREMENTS"));\t\t\t\n\t\t\t\tchangeCommercePercent(COMMERCE_ESPIONAGE, GC.getDefineINT("COMMERCE_PERCENT_CHANGE_INCREMENTS"));\n\n\t\t\t\tif (getGold() + iTargetTurns * calculateGoldRate() < iGoldTarget)\n\t\t\t\t{\n\t\t\t\t\tbreak;\n\t\t\t\t}\n\n\t\t\t\tif (!AI_avoidScience() && !isNoResearchAvailable())\n\t\t\t\t{\n\t//\t\t\t\tif (2 * getCommercePercent(COMMERCE_RESEARCH) < iInitialResearchPercent)\n\t//\t\t\t\t{\n\t//\t\t\t\t\tbreak;\n\t//\t\t\t\t}\n\t\t\t\t\tif (getCommercePercent(COMMERCE_RESEARCH) * 2 <= (getCommercePercent(COMMERCE_ESPIONAGE) + GC.getDefineINT("COMMERCE_PERCENT_CHANGE_INCREMENTS")) * 3)\n\t\t\t\t\t{\n\t\t\t\t\t\tbreak;\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\t\t}\n\t}\n\t\n\tif (!bFirstTech && (getGold() < iGoldTarget) && (getCommercePercent(COMMERCE_RESEARCH) > 40))\n\t{\n\t\tbool bHurryGold = false;\n\t\tfor (int iHurry = 0; iHurry < GC.getNumHurryInfos(); iHurry++)\n\t\t{\n\t\t\tif ((GC.getHurryInfo((HurryTypes)iHurry).getGoldPerProduction() > 0) && canHurry((HurryTypes)iHurry))\n\t\t\t{\n\t\t\t\tbHurryGold = true;\n\t\t\t\tbreak;\t\t\t\t\n\t\t\t}\n\t\t}\n\t\tif (bHurryGold)\n\t\t{\n\t\t\tif (getCommercePercent(COMMERCE_ESPIONAGE) > 0)\n\t\t\t{\n\t\t\t\tchangeCommercePercent(COMMERCE_ESPIONAGE, -GC.getDefineINT("COMMERCE_PERCENT_CHANGE_INCREMENTS"));\t\t\t\n\t\t\t}\n\t\t\telse\n\t\t\t{\n\t\t\t\tchangeCommercePercent(COMMERCE_RESEARCH, -GC.getDefineINT("COMMERCE_PERCENT_CHANGE_INCREMENTS"));\t\t\t\n\t\t\t}\n\t\t\t//changeCommercePercent(COMMERCE_GOLD, GC.getDefineINT("COMMERCE_PERCENT_CHANGE_INCREMENTS"));\n\t\t}\n\t}\n\n\t// Apply the ancient research floor after culture, espionage, war-plan, and\n\t// hurry adjustments. A purely speculative war plan cannot silently undo it.\n\t// The final verifier below remains authoritative when solvency truly requires gold.\n\tif (getCurrentEra() == 0 && !AI_isFinancialTrouble() && !isNoResearchAvailable())\n\t{\n\t\tint iResearchFloor = (GET_TEAM(getTeam()).getAtWarCount(true) > 0) ? 70 : 90;\n\t\tsetCommercePercent(COMMERCE_RESEARCH, std::max(getCommercePercent(COMMERCE_RESEARCH), iResearchFloor));\n\t}\n\t\n\t// this is called on doTurn, so make sure our gold is high enough keep us above zero gold.\n\tverifyGoldCommercePercent();\n}\n\n/************************************************************************************************/\n/* BETTER_BTS_AI_MOD                      07/19/09                                jdog5000      */\n/*                                                                                              */\n/* Civic AI                                                                                     */\n/************************************************************************************************/\nvoid CvPlayerAI::AI_doCivics()\n{\n\n\tFAssertMsg(!isHuman(), "isHuman did not return false as expected");\n\tif (isBarbarian())\n\t{\n\t\treturn;\n\t}\n\tif (AI_getCivicTimer() > 0)\n\t{\n\t\tAI_changeCivicTimer(-1);\n\t\treturn;\n\t}\n\tif (!canRevolution(NULL))\n\t{\n\t\treturn;\n\t}\n\n\tFAssertMsg(AI_getCivicTimer() == 0, "AI Civic timer is expected to be 0");\n\n\tconst int iOptionCount = GC.getNumCivicOptionInfos();\n\tstd::vector<CivicTypes> aeBestCivics(iOptionCount, NO_CIVIC);\n\tstd::vector<int> aiBestValues(iOptionCount, MIN_INT);\n\tstd::vector<int> aiCivicValues(GC.getNumCivicInfos(), MIN_INT);\n\n\t// Score every legal civic exactly once, then reduce by category.  The old\n\t// nested AI_bestCivic calls repeatedly walked the full civic table and scored\n\t// the current package a second time.\n\tfor (int iCivic = 0; iCivic < GC.getNumCivicInfos(); ++iCivic)\n\t{\n\t\tconst CivicTypes eCivic = (CivicTypes)iCivic;\n\t\tif (!canDoCivics(eCivic))\n\t\t{\n\t\t\tcontinue;\n\t\t}\n\t\tconst int iOption = GC.getCivicInfo(eCivic).getCivicOptionType();\n\t\tconst int iValue = AI_civicValue(eCivic);\n\t\taiCivicValues[iCivic] = iValue;\n\t\tif (iValue > aiBestValues[iOption])\n\t\t{\n\t\t\taiBestValues[iOption] = iValue;\n\t\t\taeBestCivics[iOption] = eCivic;\n\t\t}\n\t}\n\n\t__int64 iCurrentPackageValue = 0;\n\t__int64 iBestPackageValue = 0;\n\tbool bChangesCivic = false;\n\tfor (int iOption = 0; iOption < iOptionCount; ++iOption)\n\t{\n\t\tconst CivicTypes eCurrent = getCivics((CivicOptionTypes)iOption);\n\t\tint iCurrentValue = (eCurrent != NO_CIVIC) ? aiCivicValues[eCurrent] : 1;\n\t\tif (iCurrentValue == MIN_INT)\n\t\t{\n\t\t\tiCurrentValue = AI_civicValue(eCurrent);\n\t\t}\n\n\t\tif (aeBestCivics[iOption] == NO_CIVIC)\n\t\t{\n\t\t\taeBestCivics[iOption] = eCurrent;\n\t\t\taiBestValues[iOption] = iCurrentValue;\n\t\t}\n\t\tiCurrentPackageValue += iCurrentValue;\n\t\tiBestPackageValue += aiBestValues[iOption];\n\t\tbChangesCivic = bChangesCivic || aeBestCivics[iOption] != eCurrent;\n\t}\n\n\tif (!bChangesCivic)\n\t{\n\t\treturn;\n\t}\n\tconst int iAnarchyTurns = getCivicAnarchyLength(&aeBestCivics[0]);\n\tconst int iHorizonTurns = 2 * range(GC.getDefineINT("AI_CIVIC_CHANGE_DELAY"), 6, 500);\n\tint iThreshold = std::max(0, GC.getDefineINT("AI_CIVIC_SWITCH_THRESHOLD_PERCENT"));\n\tif (getAnarchyTurns() > 0 && !isGoldenAge())\n\t{\n\t\tiThreshold += 13;\n\t}\n\n\n\tif (AICivicPolicy::shouldSwitch(iCurrentPackageValue, iBestPackageValue,\n\t\tiAnarchyTurns, iHorizonTurns, iThreshold) && canRevolution(&aeBestCivics[0]))\n\t{\n\t\trevolution(&aeBestCivics[0]);\n\t\tAI_setCivicTimer((getMaxAnarchyTurns() == 0) ? (GC.getDefineINT("MIN_REVOLUTION_TURNS") * 2) :\n\t\t\tstd::max(GC.getDefineINT("MIN_REVOLUTION_TURNS"), GC.getDefineINT("AI_CIVIC_CHANGE_DELAY")));\n\t}\n}\n/************************************************************************************************/\n/* BETTER_BTS_AI_MOD                       END                                                  */\n/************************************************************************************************/\n\n\nvoid CvPlayerAI::AI_doReligion()\n{\n\tReligionTypes eBestReligion;\n\n\tFAssertMsg(!isHuman(), "isHuman did not return false as expected");\n/************************************************************************************************/\n/* BETTER_BTS_AI_MOD                      07/20/09                                jdog5000      */\n/*                                                                                              */\n/* Barbarian AI, efficiency                                                                     */\n/************************************************************************************************/\n\tif( isBarbarian() )\n\t{\n\t\treturn;\n\t}\n/************************************************************************************************/\n/* BETTER_BTS_AI_MOD                       END                                                  */\n/************************************************************************************************/\n\n\tif (AI_getReligionTimer() > 0)\n\t{\n\t\tAI_changeReligionTimer(-1);\n\t\treturn;\n\t}\n\n\tif (!canChangeReligion())\n\t{\n\t\treturn;\n\t}\n\n\tFAssertMsg(AI_getReligionTimer() == 0, "AI Religion timer is expected to be 0");\n\n\teBestReligion = AI_bestReligion();\n\n\tif (eBestReligion == NO_RELIGION)\n\t{\n\t\teBestReligion = getStateReligion();\n\t}\n\n\tif (canConvert(eBestReligion))\n\t{\n\t\tconvert(eBestReligion);\n\t\tAI_setReligionTimer((getMaxAnarchyTurns() == 0) ? (GC.getDefineINT("MIN_CONVERSION_TURNS") * 2) : RELIGION_CHANGE_DELAY);\n\t}\n}\n\n/************************************************************************************************/\n/* REVOLUTIONDCM_MOD                         02/04/08                            Glider1        */\n/*                                                                                              */\n/*                                                                                              */\n/************************************************************************************************/\n// RevolutionDCM start - new diplomacy option\nvoid CvPlayerAI::AI_beginDiplomacy(CvDiploParameters* pDiploParams, PlayerTypes ePlayer)\n{\n\tif (isDoNotBotherStatus(ePlayer))\n\t{\n\t\t// Divert AI diplomacy away from the diplomacy screen and induce the appropriate reaction\n\t\t// in the AI equivalent to a human rejecting the AI\'s requests in the interface. There are\n\t\t// a number of AI requests that do not need handling and that simply time out. There are\n\t\t// also AI requests that occur in CvTeam that induce the diplomacy screen in any case.\n\t\t// This diplomacy modification does not alter the AI\'s characteristics at all and is actually \n\t\t// just an interface modification for a player to shut down talks with an AI automatically.\n\t\tint ai_request;\n\t\tai_request = (DiploCommentTypes)GC.getInfoTypeForString("AI_DIPLOCOMMENT_RELIGION_PRESSURE");\n\t\tif (ai_request == pDiploParams->getDiploComment())\n\t\t{\n\t\t\tthis->handleDiploEvent(DIPLOEVENT_NO_CONVERT, ePlayer, -1, -1);\n\t\t}\n\n\t\tai_request = (DiploCommentTypes)GC.getInfoTypeForString("AI_DIPLOCOMMENT_CIVIC_PRESSURE");\n\t\tif (ai_request == pDiploParams->getDiploComment())\n\t\t{\n\t\t\tthis->handleDiploEvent(DIPLOEVENT_NO_REVOLUTION, ePlayer, -1, -1);\n\t\t}\n\n\t\tai_request = (DiploCommentTypes)GC.getInfoTypeForString("AI_DIPLOCOMMENT_JOIN_WAR");\n\t\tif (ai_request == pDiploParams->getDiploComment())\n\t\t{\n\t\t\tthis->handleDiploEvent(DIPLOEVENT_NO_JOIN_WAR, ePlayer, -1, -1);\n\t\t}\n\n\t\tai_request = (DiploCommentTypes)GC.getInfoTypeForString("AI_DIPLOCOMMENT_STOP_TRADING");\n\t\tif (ai_request == pDiploParams->getDiploComment())\n\t\t{\n\t\t\tthis->handleDiploEvent(DIPLOEVENT_NO_STOP_TRADING, ePlayer, -1, -1);\n\t\t}\n\n\t\tai_request = (DiploCommentTypes)GC.getInfoTypeForString("AI_DIPLOCOMMENT_ASK_FOR_HELP");\n\t\tif (ai_request == pDiploParams->getDiploComment())\n\t\t{\n\t\t\tthis->handleDiploEvent(DIPLOEVENT_REFUSED_HELP, ePlayer, -1, -1);\n\t\t}\n\n\t\tai_request = (DiploCommentTypes)GC.getInfoTypeForString("AI_DIPLOCOMMENT_DEMAND_TRIBUTE");\n\t\tif (ai_request == pDiploParams->getDiploComment())\n\t\t{\n\t\t\tthis->handleDiploEvent(DIPLOEVENT_REJECTED_DEMAND, ePlayer, -1, -1);\n\t\t\tif (AI_demandRebukedWar(ePlayer))\n\t\t\t{\n\t\t\t\tthis->handleDiploEvent(DIPLOEVENT_DEMAND_WAR, ePlayer, -1, -1);\n\t\t\t}\n\t\t}\n\t}\n\telse\n\t{\n\t\tgDLL->beginDiplomacy(pDiploParams, (PlayerTypes)ePlayer);\n\t}\n}\n// RevolutionDCM end\n/************************************************************************************************/\n/* REVOLUTIONDCM_MOD                         END                                 Glider1        */\n/************************************************************************************************/\n\nvoid CvPlayerAI::AI_doDiplo()\n{\n\tPROFILE_FUNC();\n\n\tCLLNode<TradeData>* pNode;\n\tCvDiploParameters* pDiplo;\n\tCvDeal* pLoopDeal;\n\tCvCity* pLoopCity;\n\tCvPlot* pLoopPlot;\n\tCLinkList<TradeData> ourList;\n\tCLinkList<TradeData> theirList;\n\tbool abContacted[MAX_TEAMS];\n\tTradeData item;\n\tCivicTypes eFavoriteCivic;\n\tBonusTypes eBestReceiveBonus;\n\tBonusTypes eBestGiveBonus;\n\tTechTypes eBestReceiveTech;\n\tTechTypes eBestGiveTech;\n\tTeamTypes eBestTeam;\n\tbool bCancelDeal;\n\tint iReceiveGold;\n\tint iGiveGold;\n\tint iGold;\n\tint iGoldData;\n\tint iGoldWeight;\n\tint iGoldValuePercent;\n\tint iCount;\n\tint iPossibleCount;\n\tint iValue;\n\tint iBestValue;\n\tint iOurValue;\n\tint iTheirValue;\n\tint iPass;\n\tint iLoop;\n\tint iI, iJ;\n\n\tFAssert(!isHuman());\n\tFAssert(!isMinorCiv());\n\tFAssert(!isBarbarian());\n\n\t// allow python to handle it\n\tCyArgsList argsList;\n\targsList.add(getID());\n\tlong lResult=0;\n\tgDLL->getPythonIFace()->callFunction(PYGameModule, "AI_doDiplo", argsList.makeFunctionArgs(), &lResult);\n\tif (lResult == 1)\n\t{\n\t\treturn;\n\t}\n\t\n\tiGoldValuePercent = AI_goldTradeValuePercent();\n\n\tfor (iI = 0; iI < MAX_TEAMS; iI++)\n\t{\n\t\tabContacted[iI] = false;\n\t}\n\n\tfor (iPass = 0; iPass < 2; iPass++)\n\t{\n\t\tfor (iI = 0; iI < MAX_CIV_PLAYERS; iI++)\n\t\t{\n\t\t\tif (GET_PLAYER((PlayerTypes)iI).isAlive())\n\t\t\t{\n\t\t\t\tif (GET_PLAYER((PlayerTypes)iI).isHuman() == (iPass == 1))\n\t\t\t\t{\n\t\t\t\t\tif (iI != getID())\n\t\t\t\t\t{\n\t\t\t\t\t\tif (GET_PLAYER((PlayerTypes)iI).getTeam() != getTeam())\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tfor(pLoopDeal = GC.getGameINLINE().firstDeal(&iLoop); pLoopDeal != NULL; pLoopDeal = GC.getGameINLINE().nextDeal(&iLoop))\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tif (pLoopDeal->isCancelable(getID()))\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tif ((GC.getGameINLINE().getGameTurn() - pLoopDeal->getInitialGameTurn()) >= (GC.getDefineINT("PEACE_TREATY_LENGTH") * 2))\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tbCancelDeal = false;\n\n\t\t\t\t\t\t\t\t\t\tif ((pLoopDeal->getFirstPlayer() == getID()) && (pLoopDeal->getSecondPlayer() == ((PlayerTypes)iI)))\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tif (GET_PLAYER((PlayerTypes)iI).isHuman())\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tif (!AI_considerOffer(((PlayerTypes)iI), pLoopDeal->getSecondTrades(), pLoopDeal->getFirstTrades(), -1))\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\tbCancelDeal = true;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tfor (pNode = pLoopDeal->getFirstTrades()->head(); pNode; pNode = pLoopDeal->getFirstTrades()->next(pNode))\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\tif (getTradeDenial(((PlayerTypes)iI), pNode->m_data) != NO_DENIAL)\n\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tbCancelDeal = true;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\telse if ((pLoopDeal->getFirstPlayer() == ((PlayerTypes)iI)) && (pLoopDeal->getSecondPlayer() == getID()))\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tif (GET_PLAYER((PlayerTypes)iI).isHuman())\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tif (!AI_considerOffer(((PlayerTypes)iI), pLoopDeal->getFirstTrades(), pLoopDeal->getSecondTrades(), -1))\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\tbCancelDeal = true;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tfor (pNode = pLoopDeal->getSecondTrades()->head(); pNode; pNode = pLoopDeal->getSecondTrades()->next(pNode))\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\tif (getTradeDenial(((PlayerTypes)iI), pNode->m_data) != NO_DENIAL)\n\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tbCancelDeal = true;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tbreak;\n\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\t\t\t\tif (bCancelDeal)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tif (canContact((PlayerTypes)iI) && AI_isWillingToTalk((PlayerTypes)iI))\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tif (GET_PLAYER((PlayerTypes)iI).isHuman())\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\tourList.clear();\n\t\t\t\t\t\t\t\t\t\t\t\t\ttheirList.clear();\n\n\t\t\t\t\t\t\t\t\t\t\t\t\tfor (pNode = pLoopDeal->headFirstTradesNode(); (pNode != NULL); pNode = pLoopDeal->nextFirstTradesNode(pNode))\n\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif (pLoopDeal->getFirstPlayer() == getID())\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tourList.insertAtEnd(pNode->m_data);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\ttheirList.insertAtEnd(pNode->m_data);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\t\t\t\t\t\t\tfor (pNode = pLoopDeal->headSecondTradesNode(); (pNode != NULL); pNode = pLoopDeal->nextSecondTradesNode(pNode))\n\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif (pLoopDeal->getSecondPlayer() == getID())\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tourList.insertAtEnd(pNode->m_data);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\ttheirList.insertAtEnd(pNode->m_data);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo = new CvDiploParameters(getID());\n\t\t\t\t\t\t\t\t\t\t\t\t\tFAssertMsg(pDiplo != NULL, "pDiplo must be valid");\n\n\t\t\t\t\t\t\t\t\t\t\t\t\tif (pLoopDeal->isVassalDeal())\n\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo->setDiploComment((DiploCommentTypes)GC.getInfoTypeForString("AI_DIPLOCOMMENT_NO_VASSAL"));\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo->setAIContact(true);\n/***************************************************************************************************/\n/* REVOLUTIONDCM_MOD                         02/04/08                            Glider1        */\n/*                                                                                              */\n/*                                                                                              */\n/************************************************************************************************/\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t// RevolutionDCM start - new diplomacy option\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tAI_beginDiplomacy(pDiplo, (PlayerTypes)iI);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t// gDLL->beginDiplomacy(pDiplo, (PlayerTypes)iI);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t// RevolutionDCM end\n/************************************************************************************************/\n/* REVOLUTIONDCM_MOD                         END                                 Glider1        */\n/************************************************************************************************/\n\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo->setDiploComment((DiploCommentTypes)GC.getInfoTypeForString("AI_DIPLOCOMMENT_CANCEL_DEAL"));\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo->setAIContact(true);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo->setOurOfferList(theirList);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo->setTheirOfferList(ourList);\n/************************************************************************************************/\n/* REVOLUTIONDCM_MOD                         02/04/08                            Glider1        */\n/*                                                                                              */\n/*                                                                                              */\n/************************************************************************************************/\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t// RevolutionDCM start - new diplomacy option\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tAI_beginDiplomacy(pDiplo, (PlayerTypes)iI);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t// gDLL->beginDiplomacy(pDiplo, (PlayerTypes)iI);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t// RevolutionDCM end\n/************************************************************************************************/\n/* REVOLUTIONDCM_MOD                         END                                 Glider1        */\n/************************************************************************************************/\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\tabContacted[GET_PLAYER((PlayerTypes)iI).getTeam()] = true;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\t\t\t\t\tpLoopDeal->kill(); // XXX test this for AI...\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\n\t\t\t\t\t\tif (canContact((PlayerTypes)iI) && AI_isWillingToTalk((PlayerTypes)iI))\n\t\t\t\t\t\t{\n\t\t\t\t\t\t\tif (GET_PLAYER((PlayerTypes)iI).getTeam() == getTeam() || GET_TEAM(GET_PLAYER((PlayerTypes)iI).getTeam()).isVassal(getTeam()))\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t// XXX will it cancel this deal if it loses it\'s first resource???\n\n\t\t\t\t\t\t\t\tiBestValue = 0;\n\t\t\t\t\t\t\t\teBestGiveBonus = NO_BONUS;\n\n\t\t\t\t\t\t\t\tfor (iJ = 0; iJ < GC.getNumBonusInfos(); iJ++)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tif (getNumTradeableBonuses((BonusTypes)iJ) > 1)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tif ((GET_PLAYER((PlayerTypes)iI).AI_bonusTradeVal(((BonusTypes)iJ), getID(), 1) > 0)\n\t\t\t\t\t\t\t\t\t\t\t&& (GET_PLAYER((PlayerTypes)iI).AI_bonusVal((BonusTypes)iJ, 1) > AI_bonusVal((BonusTypes)iJ, -1)))\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tsetTradeItem(&item, TRADE_RESOURCES, iJ);\n\n\t\t\t\t\t\t\t\t\t\t\tif (canTradeItem(((PlayerTypes)iI), item, true))\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tiValue = (1 + GC.getGameINLINE().getSorenRandNum(10000, "AI Bonus Trading #1"));\n\n\t\t\t\t\t\t\t\t\t\t\t\tif (iValue > iBestValue)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\tiBestValue = iValue;\n\t\t\t\t\t\t\t\t\t\t\t\t\teBestGiveBonus = ((BonusTypes)iJ);\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\t\tif (eBestGiveBonus != NO_BONUS)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tourList.clear();\n\t\t\t\t\t\t\t\t\ttheirList.clear();\n\n\t\t\t\t\t\t\t\t\tsetTradeItem(&item, TRADE_RESOURCES, eBestGiveBonus);\n\t\t\t\t\t\t\t\t\tourList.insertAtEnd(item);\n\n\t\t\t\t\t\t\t\t\tif (GET_PLAYER((PlayerTypes)iI).isHuman())\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tif (!(abContacted[GET_PLAYER((PlayerTypes)iI).getTeam()]))\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tpDiplo = new CvDiploParameters(getID());\n\t\t\t\t\t\t\t\t\t\t\tFAssertMsg(pDiplo != NULL, "pDiplo must be valid");\n\t\t\t\t\t\t\t\t\t\t\tpDiplo->setDiploComment((DiploCommentTypes)GC.getInfoTypeForString("AI_DIPLOCOMMENT_GIVE_HELP"));\n\t\t\t\t\t\t\t\t\t\t\tpDiplo->setAIContact(true);\n\t\t\t\t\t\t\t\t\t\t\tpDiplo->setTheirOfferList(ourList);\n/************************************************************************************************/\n/* REVOLUTIONDCM_MOD                         02/04/08                            Glider1        */\n/*                                                                                              */\n/*                                                                                              */\n/************************************************************************************************/\n\t\t\t\t\t\t\t\t\t\t\t// RevolutionDCM start - new diplomacy option\n\t\t\t\t\t\t\t\t\t\t\tAI_beginDiplomacy(pDiplo, (PlayerTypes)iI);\n\t\t\t\t\t\t\t\t\t\t\t// gDLL->beginDiplomacy(pDiplo, (PlayerTypes)iI);\n\t\t\t\t\t\t\t\t\t\t\t// RevolutionDCM end\n/************************************************************************************************/\n/* REVOLUTIONDCM_MOD                         END                                 Glider1        */\n/************************************************************************************************/\t\t\t\t\t\t\t\t\t\t\tabContacted[GET_PLAYER((PlayerTypes)iI).getTeam()] = true;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tGC.getGameINLINE().implementDeal(getID(), ((PlayerTypes)iI), &ourList, &theirList);\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\tif (GET_PLAYER((PlayerTypes)iI).getTeam() != getTeam() && GET_TEAM(GET_PLAYER((PlayerTypes)iI).getTeam()).isVassal(getTeam()))\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tiBestValue = 0;\n\t\t\t\t\t\t\t\teBestGiveTech = NO_TECH;\n\n/************************************************************************************************/\n/* BETTER_BTS_AI_MOD                      12/06/09                                jdog5000      */\n/*                                                                                              */\n/* Diplomacy                                                                                    */\n/************************************************************************************************/\n\t\t\t\t\t\t\t\t// Don\'t give techs for tree to advanced vassals ...\n\t\t\t\t\t\t\t\tif( GET_PLAYER((PlayerTypes)iI).getTechScore()*10 < getTechScore()*9 )\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tfor (iJ = 0; iJ < GC.getNumTechInfos(); iJ++)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t// canTradeItem(.., true) includes this team\'s tech-trade denial.\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tsetTradeItem(&item, TRADE_TECHNOLOGIES, iJ);\n\n\t\t\t\t\t\t\t\t\t\t\tif (canTradeItem(((PlayerTypes)iI), item, true))\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tiValue = (1 + GC.getGameINLINE().getSorenRandNum(10000, "AI Vassal Tech gift"));\n\n\t\t\t\t\t\t\t\t\t\t\t\tif (iValue > iBestValue)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\tiBestValue = iValue;\n\t\t\t\t\t\t\t\t\t\t\t\t\teBestGiveTech = ((TechTypes)iJ);\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n/************************************************************************************************/\n/* BETTER_BTS_AI_MOD                       END                                                  */\n/************************************************************************************************/\n\n\t\t\t\t\t\t\t\tif (eBestGiveTech != NO_TECH)\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tourList.clear();\n\t\t\t\t\t\t\t\t\ttheirList.clear();\n\n\t\t\t\t\t\t\t\t\tsetTradeItem(&item, TRADE_TECHNOLOGIES, eBestGiveTech);\n\t\t\t\t\t\t\t\t\tourList.insertAtEnd(item);\n\n\t\t\t\t\t\t\t\t\tif (GET_PLAYER((PlayerTypes)iI).isHuman())\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tif (!(abContacted[GET_PLAYER((PlayerTypes)iI).getTeam()]))\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tpDiplo = new CvDiploParameters(getID());\n\t\t\t\t\t\t\t\t\t\t\tFAssertMsg(pDiplo != NULL, "pDiplo must be valid");\n\t\t\t\t\t\t\t\t\t\t\tpDiplo->setDiploComment((DiploCommentTypes)GC.getInfoTypeForString("AI_DIPLOCOMMENT_GIVE_HELP"));\n\t\t\t\t\t\t\t\t\t\t\tpDiplo->setAIContact(true);\n\t\t\t\t\t\t\t\t\t\t\tpDiplo->setTheirOfferList(ourList);\n/************************************************************************************************/\n/* REVOLUTIONDCM_MOD                         02/04/08                            Glider1        */\n/*                                                                                              */\n/*                                                                                              */\n/************************************************************************************************/\n\t\t\t\t\t\t\t\t\t\t\t// RevolutionDCM start - new diplomacy option\n\t\t\t\t\t\t\t\t\t\t\tAI_beginDiplomacy(pDiplo, (PlayerTypes)iI);\n\t\t\t\t\t\t\t\t\t\t\t// gDLL->beginDiplomacy(pDiplo, (PlayerTypes)iI);\n\t\t\t\t\t\t\t\t\t\t\t// RevolutionDCM end\n/************************************************************************************************/\n/* REVOLUTIONDCM_MOD                         END                                 Glider1        */\n/************************************************************************************************/\t\t\t\t\t\t\t\t\t\t\tabContacted[GET_PLAYER((PlayerTypes)iI).getTeam()] = true;\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tGC.getGameINLINE().implementDeal(getID(), ((PlayerTypes)iI), &ourList, &theirList);\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\tif (GET_PLAYER((PlayerTypes)iI).getTeam() != getTeam() && !(GET_TEAM(getTeam()).isHuman()) && (GET_PLAYER((PlayerTypes)iI).isHuman() || !(GET_TEAM(GET_PLAYER((PlayerTypes)iI).getTeam()).isHuman())))\n\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\tFAssertMsg(!(GET_PLAYER((PlayerTypes)iI).isBarbarian()), "(GET_PLAYER((PlayerTypes)iI).isBarbarian()) did not return false as expected");\n\t\t\t\t\t\t\t\tFAssertMsg(iI != getID(), "iI is not expected to be equal with getID()");\n\n\t\t\t\t\t\t\t\tif (GET_TEAM(GET_PLAYER((PlayerTypes)iI).getTeam()).isVassal(getTeam()))\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tiBestValue = 0;\n\t\t\t\t\t\t\t\t\teBestGiveBonus = NO_BONUS;\n\n\t\t\t\t\t\t\t\t\tfor (iJ = 0; iJ < GC.getNumBonusInfos(); iJ++)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tif (GET_PLAYER((PlayerTypes)iI).getNumTradeableBonuses((BonusTypes)iJ) > 0 && getNumAvailableBonuses((BonusTypes)iJ) == 0)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tiValue = AI_bonusTradeVal((BonusTypes)iJ, (PlayerTypes)iI, 1);\n\n\t\t\t\t\t\t\t\t\t\t\tif (iValue > iBestValue)\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tiBestValue = iValue;\n\t\t\t\t\t\t\t\t\t\t\t\teBestGiveBonus = ((BonusTypes)iJ);\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\t\t\tif (eBestGiveBonus != NO_BONUS)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\ttheirList.clear();\n\t\t\t\t\t\t\t\t\t\tourList.clear();\n\n\t\t\t\t\t\t\t\t\t\tsetTradeItem(&item, TRADE_RESOURCES, eBestGiveBonus);\n\t\t\t\t\t\t\t\t\t\ttheirList.insertAtEnd(item);\n\n\t\t\t\t\t\t\t\t\t\tif (GET_PLAYER((PlayerTypes)iI).isHuman())\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tif (!(abContacted[GET_PLAYER((PlayerTypes)iI).getTeam()]))\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tCvPopupInfo* pInfo = new CvPopupInfo(BUTTONPOPUP_VASSAL_GRANT_TRIBUTE, getID(), eBestGiveBonus);\n\t\t\t\t\t\t\t\t\t\t\t\tif (pInfo)\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\tgDLL->getInterfaceIFace()->addPopup(pInfo, (PlayerTypes)iI);\n\t\t\t\t\t\t\t\t\t\t\t\t\tabContacted[GET_PLAYER((PlayerTypes)iI).getTeam()] = true;\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tGC.getGameINLINE().implementDeal(getID(), ((PlayerTypes)iI), &ourList, &theirList);\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\t\tif (!(GET_TEAM(getTeam()).isAtWar(GET_PLAYER((PlayerTypes)iI).getTeam())))\n\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\tif (AI_getAttitude((PlayerTypes)iI) >= ATTITUDE_CAUTIOUS)\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tfor (pLoopCity = firstCity(&iLoop); pLoopCity != NULL; pLoopCity = nextCity(&iLoop))\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tif (pLoopCity->getPreviousOwner() != ((PlayerTypes)iI))\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tif (((pLoopCity->getGameTurnAcquired() + 4) % 20) == (GC.getGameINLINE().getGameTurn() % 20))\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\tiCount = 0;\n\t\t\t\t\t\t\t\t\t\t\t\t\tiPossibleCount = 0;\n\n\t\t\t\t\t\t\t\t\t\t\t\t\tfor (iJ = 0; iJ < NUM_CITY_PLOTS; iJ++)\n\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tpLoopPlot = plotCity(pLoopCity->getX_INLINE(), pLoopCity->getY_INLINE(), iJ);\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif (pLoopPlot != NULL)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tif (pLoopPlot->getOwnerINLINE() == iI)\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tiCount++;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tiPossibleCount++;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\t\t\t\t\t\t\tif (iCount >= (iPossibleCount / 2))\n\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tsetTradeItem(&item, TRADE_CITIES, pLoopCity->getID());\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif (canTradeItem(((PlayerTypes)iI), item, true))\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tourList.clear();\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tourList.insertAtEnd(item);\n\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tif (GET_PLAYER((PlayerTypes)iI).isHuman())\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t//if (!(abContacted[GET_PLAYER((PlayerTypes)iI).getTeam()]))\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo = new CvDiploParameters(getID());\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tFAssertMsg(pDiplo != NULL, "pDiplo must be valid");\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo->setDiploComment((DiploCommentTypes)GC.getInfoTypeForString("AI_DIPLOCOMMENT_OFFER_CITY"));\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo->setAIContact(true);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo->setTheirOfferList(ourList);\n/************************************************************************************************/\n/* REVOLUTIONDCM_MOD                         02/04/08                            Glider1        */\n/*                                                                                              */\n/*                                                                                              */\n/************************************************************************************************/\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t// RevolutionDCM start - new diplomacy option\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tAI_beginDiplomacy(pDiplo, (PlayerTypes)iI);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t// gDLL->beginDiplomacy(pDiplo, (PlayerTypes)iI);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t// RevolutionDCM end\n/************************************************************************************************/\n/* REVOLUTIONDCM_MOD                         END                                 Glider1        */\n/************************************************************************************************/\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tabContacted[GET_PLAYER((PlayerTypes)iI).getTeam()] = true;\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tGC.getGameINLINE().implementDeal(getID(), ((PlayerTypes)iI), &ourList, NULL);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t\t\t}\n\n\t\t\t\t\t\t\t\t\tif (GET_TEAM(getTeam()).getLeaderID() == getID())\n\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\tif (AI_getContactTimer(((PlayerTypes)iI), CONTACT_PERMANENT_ALLIANCE) == 0)\n\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\tbool bOffered = false;\n\t\t\t\t\t\t\t\t\t\t\tif (GC.getGameINLINE().getSorenRandNum(GC.getLeaderHeadInfo(getPersonalityType()).getContactRand(CONTACT_PERMANENT_ALLIANCE), "AI Diplo Alliance") == 0)\n\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\tsetTradeItem(&item, TRADE_PERMANENT_ALLIANCE);\n\n\t\t\t\t\t\t\t\t\t\t\t\tif (canTradeItem(((PlayerTypes)iI), item, true) && GET_PLAYER((PlayerTypes)iI).canTradeItem(getID(), item, true))\n\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\tourList.clear();\n\t\t\t\t\t\t\t\t\t\t\t\t\ttheirList.clear();\n\n\t\t\t\t\t\t\t\t\t\t\t\t\tourList.insertAtEnd(item);\n\t\t\t\t\t\t\t\t\t\t\t\t\ttheirList.insertAtEnd(item);\n\n\t\t\t\t\t\t\t\t\t\t\t\t\tbOffered = true;\n\n\t\t\t\t\t\t\t\t\t\t\t\t\tif (GET_PLAYER((PlayerTypes)iI).isHuman())\n\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\tif (!(abContacted[GET_PLAYER((PlayerTypes)iI).getTeam()]))\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t{\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tAI_changeContactTimer(((PlayerTypes)iI), CONTACT_PERMANENT_ALLIANCE, GC.getLeaderHeadInfo(getPersonalityType()).getContactDelay(CONTACT_PERMANENT_ALLIANCE));\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo = new CvDiploParameters(getID());\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tFAssertMsg(pDiplo != NULL, "pDiplo must be valid");\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo->setDiploComment((DiploCommentTypes)GC.getInfoTypeForString("AI_DIPLOCOMMENT_OFFER_DEAL"));\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo->setAIContact(true);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo->setOurOfferList(theirList);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tpDiplo->setTheirOfferList(ourList);\n/************************************************************************************************/\n/* REVOLUTIONDCM_MOD                         02/04/08                            Glider1        */\n/*                                                                                              */\n/*                                                                                              */\n/************************************************************************************************/\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t// RevolutionDCM start - new diplomacy option\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tAI_beginDiplomacy(pDiplo, (PlayerTypes)iI);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t// gDLL->beginDiplomacy(pDiplo, (PlayerTypes)iI);\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t// RevolutionDCM end\n/**********************************************************************************