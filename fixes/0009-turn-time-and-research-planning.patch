diff --git a/Assets/CvGameCoreDLL/CvResearchGraph.h b/Assets/CvGameCoreDLL/CvResearchGraph.h
new file mode 100644
index 0000000..0007ffb
--- /dev/null
+++ b/Assets/CvGameCoreDLL/CvResearchGraph.h
@@ -0,0 +1,46 @@
+#ifndef CV_RESEARCH_GRAPH_H
+#define CV_RESEARCH_GRAPH_H
+
+#include "CvGlobals.h"
+#include "CvInfos.h"
+#include "CvPlayer.h"
+#include "CvTeamAI.h"
+#include "ResearchPathPlan.h"
+
+// Technology data as seen by one player, for ResearchPathPlan. A technology is
+// satisfied when the team knows it or the player has already queued it.
+class CvResearchGraph
+{
+public:
+	explicit CvResearchGraph(const CvPlayer& kPlayer) :
+		m_kPlayer(kPlayer), m_kTeam(GET_TEAM(kPlayer.getTeam()))
+	{
+	}
+
+	int numTechs() const { return GC.getNumTechInfos(); }
+	int numAndPrereqs() const { return GC.getNUM_AND_TECH_PREREQS(); }
+	int numOrPrereqs() const { return GC.getNUM_OR_TECH_PREREQS(); }
+	int andPrereq(int iTech, int i) const { return GC.getTechInfo((TechTypes)iTech).getPrereqAndTechs(i); }
+	int orPrereq(int iTech, int i) const { return GC.getTechInfo((TechTypes)iTech).getPrereqOrTechs(i); }
+
+	bool satisfied(int iTech) const
+	{
+		return m_kTeam.isHasTech((TechTypes)iTech) || m_kPlayer.isResearchingTech((TechTypes)iTech);
+	}
+
+	bool researchable(int iTech) const { return m_kPlayer.canEverResearch((TechTypes)iTech); }
+
+	int cost(int iTech) const
+	{
+		const int iCost = m_kTeam.getResearchCost((TechTypes)iTech);
+		return iCost > 0 ? iCost : 0;
+	}
+
+private:
+	const CvPlayer& m_kPlayer;
+	const CvTeam& m_kTeam;
+};
+
+typedef ResearchPathPlan::Planner<CvResearchGraph> CvResearchPlanner;
+
+#endif
