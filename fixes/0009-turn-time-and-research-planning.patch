index 0000000..ffa61a5
--- /dev/null
+++ b/Tools/test_research_plan.py
@@ -0,0 +1,324 @@
+#!/usr/bin/env python3
+"""Check research plans on Rise of Mankind's real technology tree.
+
+The production ResearchPathPlan.h is compiled in C++03 with UBSan and run on
+CIV4TechInfos.xml from random reachable research states. Every plan must be a
+valid prerequisite-first queue with no known, duplicate or redundant entry, and
+each technology is resolved at most once per planner. The test also measures
+what the replaced tree recursion counted, compares plan cost with the original
+pushResearch rule, and against an exhaustive optimum on small instances.
+Source contracts require queueing, path length and AI valuation to share it.
+"""
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+import xml.etree.ElementTree as ET
+from test_ai_decisions import function
+
+ROOT = Path(__file__).resolve().parents[1]
+DLL = ROOT / "Assets" / "CvGameCoreDLL"
+XML = ROOT / "Assets" / "XML" / "Technologies" / "CIV4TechInfos.xml"
+
+
+def local(tag):
+    return tag.rsplit("}", 1)[-1]
+
+
+def child(node, name):
+    for item in node:
+        if local(item.tag) == name:
+            return item
+    return None
+
+
+techs = []
+for info in ET.parse(XML).getroot().iter():
+    if local(info.tag) != "TechInfo":
+        continue
+    def prereqs(group):
+        node = child(info, group)
+        return [] if node is None else [item.text for item in node if item.text]
+    disable = child(info, "bDisable")
+    techs.append((child(info, "Type").text, int(child(info, "iCost").text),
+                  prereqs("AndPreReqs"), prereqs("OrPreReqs"),
+                  disable is not None and disable.text.strip() == "1"))
+index = dict((name, i) for i, (name, _, _, _, _) in enumerate(techs))
+max_and = max(len(t[2]) for t in techs) or 1
+max_or = max(len(t[3]) for t in techs) or 1
+
+
+def row(values, width):
+    return "{" + ", ".join(str(v) for v in (values + [-1] * width)[:width]) + "}"
+
+
+data = "\n".join([
+    "const int N = %d, MAX_AND = %d, MAX_OR = %d;" % (len(techs), max_and, max_or),
+    "const int COST[N] = {%s};" % ", ".join(str(t[1]) for t in techs),
+    "const int DISABLED[N] = {%s};" % ", ".join("1" if t[4] else "0" for t in techs),
+    "const int AND_[N][MAX_AND] = {%s};" % ", ".join(row([index[p] for p in t[2]], max_and) for t in techs),
+    "const int OR_[N][MAX_OR] = {%s};" % ", ".join(row([index[p] for p in t[3]], max_or) for t in techs),
+])
+
+program = r'''
+#include "ResearchPathPlan.h"
+#include <cassert>
+#include <climits>
+#include <ctime>
+#include <iostream>
+#include <vector>
+DATA
+
+struct Graph
+{
+    std::vector<char> known;
+    int numTechs() const { return N; }
+    int numAndPrereqs() const { return MAX_AND; }
+    int numOrPrereqs() const { return MAX_OR; }
+    int andPrereq(int t, int i) const { return AND_[t][i]; }
+    int orPrereq(int t, int i) const { return OR_[t][i]; }
+    bool satisfied(int t) const { return known[t] != 0; }
+    bool researchable(int t) const { return !DISABLED[t]; }
+    int cost(int t) const { return COST[t]; }
+};
+
+unsigned int seed = 2026u;
+int rnd(int n) { seed = seed * 1664525u + 1013904223u; return (int)((seed >> 8) % (unsigned int)n); }
+
+bool canResearchNow(const std::vector<char>& known, int t)
+{
+    if (known[t] || DISABLED[t]) return false;
+    bool hasOr = false, orOk = false;
+    for (int i = 0; i < MAX_AND; ++i) if (AND_[t][i] >= 0 && !known[AND_[t][i]]) return false;
+    for (int i = 0; i < MAX_OR; ++i) if (OR_[t][i] >= 0) { hasOr = true; if (known[OR_[t][i]]) orOk = true; }
+    return !hasOr || orOk;
+}
+
+// What CvPlayer::findPathLength(eTech, false) used to return (tree expansion).
+long long treeSteps(const std::vector<char>& known, int t, std::vector<long long>& memo)
+{
+    if (known[t]) return 0;
+    if (memo[t] >= 0) return memo[t];
+    long long s = 1;
+    for (int i = 0; i < MAX_AND; ++i) if (AND_[t][i] >= 0) s += treeSteps(known, AND_[t][i], memo);
+    long long best = LLONG_MAX;
+    for (int i = 0; i < MAX_OR; ++i) if (OR_[t][i] >= 0) { long long v = treeSteps(known, OR_[t][i], memo); if (v < best) best = v; }
+    if (best != LLONG_MAX) s += best;
+    if (s > (1LL << 50)) s = 1LL << 50;
+    return memo[t] = s;
+}
+
+// The original recursive pushResearch rule: AND prerequisites, then the OR
+// alternative with the shortest tree path (first on ties; a known one wins).
+// Returns false where pushResearch failed: an unresearchable technology on the route.
+bool originalPush(std::vector<char>& queued, int t, std::vector<long long>& memo, const std::vector<char>& known)
+{
+    if (queued[t]) return true;
+    if (DISABLED[t]) return false;
+    for (int i = 0; i < MAX_AND; ++i) if (AND_[t][i] >= 0 && !originalPush(queued, AND_[t][i], memo, known)) return false;
+    int bestOr = -1; long long best = LLONG_MAX;
+    for (int i = 0; i < MAX_OR; ++i)
+    {
+        const int o = OR_[t][i];
+        if (o < 0) continue;
+        if (known[o]) { bestOr = o; break; }
+        if (DISABLED[o]) continue;
+        std::vector<long long> fresh(N, -1);	// findPathLength saw the queue as it stood
+        const long long v = queued[o] ? 0 : treeSteps(queued, o, fresh);
+        if (v < best) { best = v; bestOr = o; }
+    }
+    if (bestOr >= 0 && !originalPush(queued, bestOr, memo, known)) return false;
+    queued[t] = 1;
+    return true;
+}
+
+// Exhaustive minimum-cost plan for small instances.
+long long bestCost;
+void exhaustive(std::vector<char>& have, std::vector<int>& open, long long cost)
+{
+    if (cost >= bestCost) return;
+    while (!open.empty() && have[open.back()]) open.pop_back();
+    if (open.empty()) { bestCost = cost; return; }
+    const int t = open.back(); open.pop_back();
+    have[t] = 1;
+    std::vector<int> base = open;
+    for (int i = 0; i < MAX_AND; ++i) if (AND_[t][i] >= 0) base.push_back(AND_[t][i]);
+    bool hasOr = false, orOk = false;
+    for (int i = 0; i < MAX_OR; ++i) if (OR_[t][i] >= 0) { hasOr = true; if (have[OR_[t][i]]) orOk = true; }
+    if (!hasOr || orOk) { std::vector<int> next = base; exhaustive(have, next, cost + COST[t]); }
+    else for (int i = 0; i < MAX_OR; ++i)
+    {
+        const int o = OR_[t][i];
+        if (o < 0 || DISABLED[o]) continue;
+        std::vector<int> next = base; next.push_back(o);
+        exhaustive(have, next, cost + COST[t]);
+    }
+    have[t] = 0;
+    open.push_back(t);
+}
+
+int main()
+{
+    long long plans = 0, better = 0, same = 0, worse = 0, smallCases = 0, optimal = 0, undercounts = 0, originalFailed = 0, proved = 0;
+    long long inOld[2] = {0, 0}, inNew[2] = {0, 0};
+    long long maxTree = 0; int maxPlan = 0; double worstGap = 0.0, worstOriginalGap = 0.0;
+    for (int state = 0; state < 300; ++state)
+    {
+        Graph g; g.known.assign(N, 0);
+        const int progress = rnd(N);
+        for (int step = 0; step < progress; ++step)
+        {
+            std::vector<int> options;
+            for (int t = 0; t < N; ++t) if (canResearchNow(g.known, t)) options.push_back(t);
+            if (options.empty()) break;
+            g.known[options[rnd((int)options.size())]] = 1;
+        }
+        ResearchPathPlan::Planner<Graph> planner(g);
+        for (int target = 0; target < N; ++target)
+        {
+            if (g.known[target]) { assert(planner.steps(target) == 0); continue; }
+            std::vector<int> plan;
+            if (!planner.plan(target, plan)) { assert(planner.steps(target) == INT_MAX); continue; }
+            ++plans;
+            assert(!plan.empty() && plan.back() == target);
+            assert((int)plan.size() == planner.steps(target));
+            std::vector<char> have = g.known, needed(N, 0);
+            long long cost = 0;
+            for (size_t i = 0; i < plan.size(); ++i)
+            {
+                const int t = plan[i];
+                assert(!have[t]);
+                assert(canResearchNow(have, t));
+                have[t] = 1; cost += COST[t];
+            }
+            assert(cost == planner.cost(target));
+            // Irredundant: every entry is the target or a prerequisite some later entry used.
+            needed[target] = 1;
+            for (int i = (int)plan.size() - 1; i >= 0; --i)
+            {
+                const int t = plan[i];
+                assert(needed[t]);
+                std::vector<char> before = g.known;
+                for (int j = 0; j < i; ++j) before[plan[j]] = 1;
+                for (int k = 0; k < MAX_AND; ++k) if (AND_[t][k] >= 0) needed[AND_[t][k]] = 1;
+                bool orKnown = false; int firstPlanned = -1;
+                for (int k = 0; k < MAX_OR; ++k) if (OR_[t][k] >= 0) { if (g.known[OR_[t][k]]) orKnown = true; else if (before[OR_[t][k]] && firstPlanned < 0) firstPlanned = OR_[t][k]; }
+                if (!orKnown && firstPlanned >= 0)
+                    for (int k = 0; k < MAX_OR; ++k) if (OR_[t][k] >= 0 && before[OR_[t][k]]) needed[OR_[t][k]] = 1;
+            }
+            std::vector<long long> memo(N, -1);
+            const long long tree = treeSteps(g.known, target, memo);
+            // The old count ignored unresearchable OR alternatives, so it can
+            // also undercount a route that cannot actually be queued.
+            if (tree < (long long)plan.size()) ++undercounts;
+            if (tree > maxTree) maxTree = tree;
+            for (int h = 0; h < 2; ++h)
+            {
+                const int horizon = h == 0 ? 3 : 6;
+                if (tree <= horizon) ++inOld[h];
+                if ((long long)plan.size() <= horizon) ++inNew[h];
+            }
+            if ((int)plan.size() > maxPlan) maxPlan = (int)plan.size();
+
+            std::vector<char> queued = g.known; std::vector<long long> memo2(N, -1);
+            if (!originalPush(queued, target, memo2, g.known)) { ++originalFailed; continue; }
+            long long originalCost = 0;
+            for (int t = 0; t < N; ++t) if (queued[t] && !g.known[t]) originalCost += COST[t];
+            if (cost < originalCost) ++better; else if (cost == originalCost) ++same; else ++worse;
+            if (cost > originalCost && (double)cost / originalCost - 1.0 > worstOriginalGap) worstOriginalGap = (double)cost / originalCost - 1.0;
+
+            if (planner.provedOptimal(target)) ++proved;
+            if (plan.size() <= 9)
+            {
+                bestCost = LLONG_MAX; std::vector<char> h = g.known; std::vector<int> open(1, target);
+                exhaustive(h, open, 0);
+                assert(bestCost <= cost);
+                if (planner.provedOptimal(target)) assert(bestCost == cost);
+                ++smallCases; if (bestCost == cost) ++optimal;
+                const double gap = (double)cost / (double)bestCost - 1.0;
+                if (gap > worstGap) worstGap = gap;
+            }
+        }
+        assert(planner.resolvedCount() <= N);
+    }
+    {
+        // Informational timing: the deepest plan from the opening state, fresh planner each time.
+        Graph g; g.known.assign(N, 0);
+        int deepest = 0; long long deepestTree = 0;
+        for (int t = 0; t < N; ++t)
+        {
+            std::vector<long long> memo(N, -1);
+            const long long tree = treeSteps(g.known, t, memo);
+            if (tree > deepestTree) { deepestTree = tree; deepest = t; }
+        }
+        const std::clock_t start = std::clock();
+        int stepsTotal = 0;
+        for (int repeat = 0; repeat < 20; ++repeat)
+        {
+            ResearchPathPlan::Planner<Graph> fresh(g);
+            stepsTotal += fresh.steps(deepest);
+        }
+        const double each = double(std::clock() - start) / CLOCKS_PER_SEC / 20.0;
+        std::cout << "INFO: deepest target from scratch: " << stepsTotal / 20 << " techs planned in "
+                  << each * 1000.0 << " ms; the former recursion would make " << deepestTree << " calls\n";
+    }
+    std::cout << "PASS: " << plans << " plans valid, irredundant and resolved once per technology; "
+              << proved << " proved optimal by branch and bound\n";
+    std::cout << "PASS: largest plan " << maxPlan << " techs; the replaced tree recursion counted up to " << maxTree
+              << " (and undercounted " << undercounts << " plans through unresearchable alternatives)\n";
+    std::cout << "INFO: the original queue rule failed on " << originalFailed << " reachable targets; elsewhere it was dearer "
+              << better << ", equal " << same << ", cheaper " << worse << " (worst +" << (int)(worstOriginalGap * 100 + 0.5) << "%)\n";
+    std::cout << "INFO: targets inside AI_bestTech's horizon: depth 3 " << inOld[0] << " -> " << inNew[0]
+              << ", depth 6 " << inOld[1] << " -> " << inNew[1] << " (former tree count -> plan size)\n";
+    std::cout << "INFO: exhaustive optimum matched in " << optimal << " of " << smallCases
+              << " small cases (worst +" << (int)(worstGap * 100 + 0.5) << "%)\n";
+    return 0;
+}
+'''.replace("DATA", data)
+
+with tempfile.TemporaryDirectory() as directory:
+    source = Path(directory) / "research_plan.cpp"
+    binary = Path(directory) / "research_plan"
+    source.write_text(program)
+    subprocess.run(["g++", "-std=c++03", "-O2", "-Wall", "-Wextra", "-Werror", "-fsanitize=undefined",
+                    "-fno-sanitize-recover=all", "-I", str(DLL), str(source), "-o", str(binary)], check=True)
+    subprocess.run([str(binary)], check=True, timeout=600)
+
+
+def code(text):
+    return re.sub(r"/\*.*?\*/|//[^\n]*", "", text, flags=re.S)
+
+
+player = code((DLL / "CvPlayer.cpp").read_text(errors="replace"))
+player_ai = code((DLL / "CvPlayerAI.cpp").read_text(errors="replace"))
+find = function(player, "int CvPlayer::findPathLength(TechTypes eTech, bool bCost) const")
+assert "CvResearchPlanner" in find and "findPathLength(" not in find
+push = function(player, "bool CvPlayer::pushResearch(TechTypes eTech, bool bClear)")
+assert "kPlanner.plan(eTech, aiPlan)" in push and "pushResearch(" not in push and "findPathLength(" not in push
+loop = push[push.index("for (int iI = 0; iI < (int)aiPlan.size(); ++iI)"):]
+for needle in ("m_researchQueue.insertAtEnd(eStep);", "setResearchingTech(eStep, true);",
+               "ResearchButtons_DIRTY_BIT", "techSelected(eStep, getID());"):
+    assert needle in loop, needle
+assert push.index("clearResearchQueue();") < push.index("kPlanner.plan(")
+best = function(player_ai, "TechTypes CvPlayerAI::AI_bestTech(")
+assert "kResearchPlanner.steps(iI)" in best and "kResearchPlanner.cost(iI)" in best
+assert "AI_cachedTechPathLength" not in player_ai
+graph = (DLL / "CvResearchGraph.h").read_text()
+assert "isHasTech" in graph and "isResearchingTech" in graph and "canEverResearch" in graph
+print("PASS: queueing, path length and AI valuation share one research plan")
+
+# Technology help shows the same plan that selecting the technology queues.
+text_mgr = code((DLL / "CvGameTextMgr.cpp").read_text(errors="replace"))
+help_text = function(text_mgr, "void CvGameTextMgr::setTechTradeHelp(")
+plan_help = help_text[help_text.index("CvResearchPlanner kPlanner(kGraph);"):]
+assert "kPlanner.plan(eTech, aiPlan) && aiPlan.size() > 1" in plan_help
+assert "getResearchLeft((TechTypes)aiPlan[iStep])" in plan_help
+assert "TXT_KEY_TECH_RESEARCH_PLAN" in plan_help and "TXT_KEY_TECH_RESEARCH_PLAN_NO_RATE" in plan_help
+strings = ET.parse(ROOT / "Assets" / "XML" / "Text" / "RoM_GameText_ResearchPlan.xml").getroot()
+for entry in strings:
+    tag = child(entry, "Tag").text
+    expected = ["%d1", "%d2", "%d3"] if tag == "TXT_KEY_TECH_RESEARCH_PLAN" else ["%d1", "%d2"]
+    for language in ("English", "French", "German", "Italian", "Spanish"):
+        found = re.findall(r"%d\d", child(entry, language).text)
+        assert found == expected, (tag, language, found)
+print("PASS: technology help reports the queued plan in every shipped language")
