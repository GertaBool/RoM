@@ -0,0 +1,305 @@
+#!/usr/bin/env python3
+"""Execute civilian dispatch plus native amphibious forwarding and group movement.
+
+Path graphs, scheduling and per-unit movement side effects are explicit adapters;
+this is not a full engine replay. Unlike earlier dispatch tests, cargo is moved.
+"""
+import unittest
+from test_review_correctness import DLL, remaining, block, compile_run
+
+HOST = r'''
+#include <cassert>
+#include <climits>
+#include <cstddef>
+#include <vector>
+#include <algorithm>
+#include "AISettlementPolicy.h"
+using std::size_t;
+const int MAX_INT=INT_MAX;
+const int NO_PLAYER=-1;typedef unsigned int uint;
+const int MOVE_IGNORE_DANGER=16;
+int stepDistance(int x,int y,int a,int b){return std::max(abs(x-a),abs(y-b));}
+#include <cstdlib>
+enum {NO_MISSIONAI,MISSIONAI_FOUND,MISSIONAI_LOAD_SETTLER,MISSIONAI_PICKUP,MISSIONAI_ASSAULT,MISSIONAI_GUARD_CITY};
+enum {UNITAI_SETTLE,UNITAI_WORKER,UNITAI_ATTACK,UNITAI_CITY_DEFENSE,UNITAI_SETTLER_SEA,UNITAI_ASSAULT_SEA};
