diff --git a/Tools/test_python_callbacks.py b/Tools/test_python_callbacks.py
new file mode 100644
index 0000000..3636b54
--- /dev/null
+++ b/Tools/test_python_callbacks.py
@@ -0,0 +1,331 @@
+#!/usr/bin/env python3
+"""Execute the RoM Python game-utility callbacks against a stubbed game API.
+
+These callbacks run for every candidate unit or building in every city, so the
+tests check both the rules and that a query no longer scales with the number
+of cities. The production module source is executed unchanged except that
+Python 2 semantics are restored (integer ``/`` floors; ``d.has_key(k)``), because
+the game embeds Python 2.4.
+"""
+from pathlib import Path
+import ast
+import random
+import sys
+import types
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+PY = ROOT / "Assets" / "Python"
+
+TYPES = {}
+
+
+def info_type(name):
+    if name not in TYPES:
+        TYPES[name] = len(TYPES)
+    return TYPES[name]
+
+
+class Info:
+    def __init__(self, name, **fields):
+        self.name = name
+        self.fields = fields
+
+    def getType(self):
+        return self.name
+
+    def __getattr__(self, attr):
+        if attr.startswith("get") and attr[3:] in self.fields:
+            return lambda: self.fields[attr[3:]]
+        raise AttributeError(attr)
+
+
+class Plot:
+    def __init__(self, team, terrain="TERRAIN_GRASS", hills=False, peak=False, none=False):
+        self.team, self.terrain, self.hills, self.peak, self.none = team, terrain, hills, peak, none
+
+    def isNone(self): return self.none
+    def getTeam(self): return self.team
+    def isHills(self): return self.hills
+    def isPeak(self): return self.peak
+    def getTerrainType(self): return info_type(self.terrain)
+
+
+class City:
+    def __init__(self, team, buildings=(), plots=None):
+        self.team = team
+        self.buildings = set(buildings)
+        self.plots = plots or [Plot(team) for _ in range(21)]
+
+    def getTeam(self): return self.team
+    def getOwner(self): return 0
+    def plot(self): return types.SimpleNamespace(getOwner=lambda: 0)
+    def getNumActiveBuilding(self, e): return 1 if e in self.buildings else 0
+    def getNumRealBuilding(self, e): return 1 if e in self.buildings else 0
+    def getCityIndexPlot(self, i): return self.plots[i]
+
+
+class Team:
+    def __init__(self):
+        self.techs = set()
+
+    def isHasTech(self, e): return e == -1 or e in self.techs
+
+
+class Unit:
+    def __init__(self, unit_type, discount=0):
+        self.unit_type, self.discount = unit_type, discount
+
+    def getUnitType(self): return self.unit_type
+    def getUpgradeDiscount(self): return self.discount
+
+
+class Player:
+    def __init__(self):
+        self.civics = {}
+        self.class_counts = {}
+        self.cities = []
+        self.city_queries = 0
+        self.bonuses = set()
+        self.human = True
+        self.era = 2
+        self.upgrade_modifier = 0
+        self.units = {}
+        self.production = {}
+
+    def getCivics(self, option): return self.civics.get(option, -1)
+    def isCivic(self, civic): return civic in self.civics.values()
+    def getBuildingClassCount(self, c): return self.class_counts.get(c, 0)
+    def getTeam(self): return 0
+    def getID(self): return 0
+    def getNumCities(self): return len(self.cities)
+    def isHuman(self): return self.human
+    def isBarbarian(self): return False
+    def hasBonus(self, b): return b in self.bonuses
+    def getCurrentEra(self): return self.era
+    def getUnitUpgradePriceModifier(self): return self.upgrade_modifier
+    def getUnit(self, i): return self.units[i]
+    def getUnitProductionNeeded(self, u): return self.production[u]
+
+    def getCity(self, i):
+        self.city_queries += 1
+        return self.cities[i]
+
+
+class Handicap:
+    def getAIUnitUpgradePercent(self): return 80
+    def getAIPerEraModifier(self): return -5
+
+
+class GlobalContext:
+    def __init__(self):
+        self.player = Player()
+        self.team = Team()
+        self.buildings = {}
+        self.defines = {"BASE_UNIT_UPGRADE_COST": 20, "UNIT_UPGRADE_COST_PER_PRODUCTION": 3}
+
+    def getInfoTypeForString(self, s): return info_type(s)
+    def getPlayer(self, i): return self.player
+    def getTeam(self, i): return self.team
+    def getGame(self): return types.SimpleNamespace(isOption=lambda o: False, getHandicapType=lambda: 0)
+    def getHandicapInfo(self, i): return Handicap()
+    def getDefineINT(self, s): return self.defines[s]
+    def getNUM_CITY_PLOTS(self): return 21
+
+    def getBuildingInfo(self, e):
+        if e not in self.buildings:
+            name = next(k for k, v in TYPES.items() if v == e)
+            self.buildings[e] = Info(name, BuildingClassType=info_type(name.replace("BUILDING_", "BUILDINGCLASS_")), ObsoleteTech=-1)
+        return self.buildings[e]
+
+    def getCivicInfo(self, e): return Info(next(k for k, v in TYPES.items() if v == e), CivicOptionType=0)
+    def getUnitInfo(self, e): return Info(next(k for k, v in TYPES.items() if v == e))
+    def getNumBuildingInfos(self): return 0
+    def getNumUnitInfos(self): return 0
+    def getNumCivicInfos(self): return 0
+    def getNumCivicOptionInfos(self): return 0
+    def getCivicOptionInfo(self, e): return None
+
+
+GC = GlobalContext()
+LOOKUPS = {"count": 0}
+
+
+def find_info_type_num(getter, count, name):
+    LOOKUPS["count"] += 1
+    return info_type(name)
+
+
+def stub(name, **attrs):
+    module = types.ModuleType(name)
+    module.__dict__.update(attrs)
+    sys.modules[name] = module
+    return module
+
+
+# The engine's CvPythonExtensions also exports lowercase true/false (vanilla
+# Firaxis scripts rely on them).
+extensions = stub("CvPythonExtensions", CyGlobalContext=lambda: GC,
+                  GameOptionTypes=types.SimpleNamespace(GAMEOPTION_NO_REVOLUTION=0),
+                  true=True, false=False)
+extensions.__all__ = ["CyGlobalContext", "GameOptionTypes", "true", "false"]
+stub("CvUtil", findInfoTypeNum=find_info_type_num)
+for empty in ("CvEventInterface", "Popup", "BugOptions", "BugCore", "RevInstances", "RevDCM", "PlayerUtil"):
+    stub(empty)
+stub("PyHelpers", PyPlayer=None, PyInfo=None, PyCity=None, PyGame=None)
+stub("BugUtil", fixSets=lambda g: None)
+
+
+class Python2Semantics(ast.NodeTransformer):
+    """Integer ``/`` floors and ``d.has_key(k)`` means ``k in d`` in Python 2."""
+
+    def visit_BinOp(self, node):
+        self.generic_visit(node)
+        if isinstance(node.op, ast.Div):
+            node.op = ast.FloorDiv()
+        return node
+
+    def visit_Call(self, node):
+        self.generic_visit(node)
+        if isinstance(node.func, ast.Attribute) and node.func.attr == "has_key" and len(node.args) == 1:
+            return ast.copy_location(ast.Compare(left=node.args[0], ops=[ast.In()], comparators=[node.func.value]), node)
+        return node
+
+
+def load(name):
+    tree = Python2Semantics().visit(ast.parse((PY / (name + ".py")).read_text()))
+    module = types.ModuleType(name)
+    sys.modules[name] = module
+    exec(compile(ast.fix_missing_locations(tree), str(PY / (name + ".py")), "exec"), module.__dict__)
+    return module
+
+
+zCivics = load("zCivics")
+RoM = load("RoMGameUtils")
+UTILS = RoM.RoMGameUtils()
+T = info_type
+
+
+class CallbackTests(unittest.TestCase):
+    def setUp(self):
+        GC.player = Player()
+        GC.player.cities = [City(0)]
+        GC.team = Team()
+        LOOKUPS["count"] = 0
+
+    def civics(self, **chosen):
+        options = {"LEADERSHIP": UTILS.iLeadershipCivicOption, "ADMIN": UTILS.iAdminCivicOption,
+                   "RELIGION": UTILS.iReligionCivicOption, "TAX": UTILS.iTaxCivicOption,
+                   "ECONOMY": UTILS.iEconomyCivicOption, "MILITARY": UTILS.iMilitaryCivicOption}
+        for option, civic in chosen.items():
+            GC.player.civics[options[option]] = T(civic)
+
+    def cost(self, building):
+        return UTILS.getBuildingCostMod((0, 0, T(building)))
+
+    def test_djenne_discount_is_constant_time(self):
+        GC.player.cities = [City(0) for _ in range(39)] + [City(0, [T("BUILDING_DJENNE")])]
+        GC.player.class_counts[T("BUILDINGCLASS_DJENNE")] = 1
+        self.assertEqual(self.cost("BUILDING_CHRISTIAN_CATHEDRAL"), 50)
+        self.assertEqual(self.cost("BUILDING_LIBRARY"), -1)
+        self.assertEqual(GC.player.city_queries, 0)
+        GC.buildings[T("BUILDING_DJENNE")].fields["ObsoleteTech"] = T("TECH_X")
+        GC.team.techs.add(T("TECH_X"))
+        self.assertEqual(self.cost("BUILDING_CHRISTIAN_CATHEDRAL"), -1)
+        GC.player.class_counts.clear()
+        GC.player.cities = [City(0) for _ in range(40)]
+        GC.team.techs.clear()
+        self.assertEqual(self.cost("BUILDING_CHRISTIAN_CATHEDRAL"), -1)
+
+    def test_independent_civic_discounts(self):
+        self.civics(LEADERSHIP="CIVIC_IMPERIUM", ECONOMY="CIVIC_CORPORATE")
+        self.assertEqual(self.cost("BUILDING_SID_SUSHI_RESTAURANT"), 75)
+        self.assertEqual(self.cost("BUILDING_PUBLIC_TRANSPORTATION"), 75)
+        self.civics(LEADERSHIP="CIVIC_HEREDITARY_RULE", MILITARY="CIVIC_FORTIFICATION")
+        self.assertEqual(self.cost("BUILDING_CASTLE"), 50)
+        self.civics(LEADERSHIP="CIVIC_IMPERIUM", MILITARY="CIVIC_FORTIFICATION")
+        self.assertEqual(self.cost("BUILDING_CASTLE"), 75)
+        self.civics(LEADERSHIP="CIVIC_HEREDITARY_RULE", MILITARY="CIVIC_NONE")
+        self.assertEqual(self.cost("BUILDING_CASTLE"), 75)
+        self.civics(LEADERSHIP="CIVIC_IMPERIUM", MILITARY="CIVIC_NONE", ECONOMY="CIVIC_BARTER")
+        self.assertEqual(self.cost("BUILDING_CASTLE"), -1)
+        self.assertEqual(self.cost("BUILDING_MARKET"), 75)
+
+    def test_missionary_cost_uses_cached_lookups(self):
+        self.civics(RELIGION="CIVIC_STATE_RELIGION")
+        self.assertEqual(UTILS.getUnitCostMod((0, T("UNIT_CHRISTIAN_MISSIONARY"))), 75)
+        self.assertEqual(UTILS.getUnitCostMod((0, T("UNIT_WARRIOR"))), -1)
+        self.civics(RELIGION="CIVIC_FOLKLORE")
+        self.assertEqual(UTILS.getUnitCostMod((0, T("UNIT_CHRISTIAN_MISSIONARY"))), -1)
+        self.assertEqual(LOOKUPS["count"], 0)
+
+    def test_upgrade_line_matches_original_algorithm(self):
+        upgrades = UTILS.aiBuildingUpgradeLine_Upgrade_InfoTypeNum
+        obsolete = UTILS.aiBuildingUpgradeLine_Obsolete_InfoTypeNum
+
+        def original(city, building):
+            up, old = upgrades[:], obsolete[:]
+            while old.count(building) > 0:
+                index = old.index(building)
+                old.remove(building)
+                if city.getNumRealBuilding(up.pop(index)) > 0:
+                    return True
+            return False
+
+        rng = random.Random(9)
+        candidates = sorted(set(upgrades) | set(obsolete))
+        for _ in range(400):
+            city = City(0, rng.sample(candidates, rng.randint(0, 6)))
+            for building in candidates:
+                expected = original(city, building)
+                actual = bool(UTILS.dSupersededBy.get(building)) and any(
+                    city.getNumRealBuilding(u) > 0 for u in UTILS.dSupersededBy[building])
+                self.assertEqual(expected, actual, building)
+
+    def test_observatory_requires_hill_in_own_radius(self):
+        plots = [Plot(0) for _ in range(21)]
+        city = City(0, plots=plots)
+        self.assertFalse(UTILS._city_has_peak_or_hill(city))
+        plots[20] = Plot(1, hills=True)
+        self.assertFalse(UTILS._city_has_peak_or_hill(city))
+        plots[19] = Plot(0, none=True, hills=True)
+        self.assertFalse(UTILS._city_has_peak_or_hill(city))
+        plots[5] = Plot(0, peak=True)
+        self.assertTrue(UTILS._city_has_peak_or_hill(city))
+        plots[6] = Plot(0, terrain="TERRAIN_DESERT")
+        self.assertTrue(UTILS._city_has_desert_in_radius(city))
+
+    def test_replicator_upgrade_price_halves_the_normal_price_once(self):
+        player = GC.player
+        player.units[1] = Unit(T("UNIT_OLD"), discount=10)
+        player.production = {T("UNIT_OLD"): 100, T("UNIT_NEW"): 160}
+        args = (0, 1, T("UNIT_NEW"))
+        self.assertEqual(UTILS.getUpgradePriceOverride(args), -1)
+        GC.team.techs.add(T("TECH_RAPID_PROTOTYPING"))
+        self.assertEqual(UTILS.getUpgradePriceOverride(args), -1)
+        player.bonuses.add(T("BONUS_PERSONAL_REPLICATORS"))
+        player.upgrade_modifier = -20
+
+        def normal(human):
+            price = 20 + 60 * 3
+            if not human:
+                price = price * 80 // 100
+                price = price * (100 - 5 * 2) // 100
+            price = price * (100 - 20) // 100
+            return price - price * 10 // 100
+
+        self.assertEqual(UTILS.getUpgradePriceOverride(args), normal(True) // 2)
+        player.human = False
+        self.assertEqual(UTILS.getUpgradePriceOverride(args), normal(False) // 2)
+
+    def test_zcivics_lookups(self):
+        civics = zCivics.zCivics()
+        self.assertFalse(civics.cannotDoCivic(0, T("CIVIC_SLAVERY")))
+        self.assertTrue(civics.cannotConstructBuilding(0, T("BUILDING_SLAVE_MARKET")))
+        GC.player.civics[0] = T("CIVIC_SLAVERY")
+        self.assertFalse(civics.cannotConstructBuilding(0, T("BUILDING_SLAVE_MARKET")))
+        self.assertFalse(civics.cannotConstructBuilding(0, T("BUILDING_LIBRARY")))
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
