diff --git a/Assets/CvGameCoreDLL/ResearchPathPlan.h b/Assets/CvGameCoreDLL/ResearchPathPlan.h
new file mode 100644
index 0000000..c04dc89
--- /dev/null
+++ b/Assets/CvGameCoreDLL/ResearchPathPlan.h
@@ -0,0 +1,707 @@
+#ifndef RESEARCH_PATH_PLAN_H
+#define RESEARCH_PATH_PLAN_H
+
+#include <limits.h>
+#include <vector>
+
+// Research planning: the set of missing technologies needed for a target,
+// shared by queueing (CvPlayer::pushResearch), path length queries
+// (CvPlayer::findPathLength) and AI research valuation (AI_bestTech).
+//
+// Model. With K the known or queued technologies, a plan for target t is a set
+// S containing t such that, for every x in S, each AND prerequisite of x is in
+// S or K, and if x has OR prerequisites one of them is in S or K. Its cost is
+// the sum of research costs over S. Minimizing it is a minimum-cost AND/OR
+// closure: NP-hard in general (Set Cover reduces to it: one AND-requirement per
+// element whose OR alternatives are the sets containing it).
+//
+// The former code computed f(x) = c(x) + sum f(AND) + min f(OR), which is exact
+// only if no technology is shared; otherwise each shared ancestor is charged
+// once per route to it. Unmemoized, it also visited every route: for the last
+// technology of Rise of Mankind's tree that is more than 10^9 nodes, for a plan
+// of 226 distinct technologies.
+//
+// Method, per target (memoized per planner):
+//  1. Feasibility and a standalone closure per technology, bottom-up, as
+//     bitsets: O(T * D * T/32) word operations for T techs, D prerequisites.
+//  2. Forced closure F(x): x, its AND prerequisites' forced closures and, for an
+//     unsatisfied OR group with exactly one feasible alternative, that
+//     alternative's. Every plan containing x contains F(x); unions of forced
+//     closures are again closed under these rules.
+//  3. Two greedy plans in pushResearch's order (an OR group already satisfied by
+//     K or the plan adds nothing): "marginal" adds the alternative whose
+//     standalone closure adds least cost; "classic" is the former rule (fewest
+//     tree-expanded steps, planned techs free, first listed on ties) evaluated
+//     with a per-decision memo. The cheaper one is the incumbent, so a plan never
+//     costs more than the former rule's queue.
+//  4. Branch and bound from F(t) over open OR groups (>= 2 feasible alternatives,
+//     unsatisfied). Lower bound: max over open groups of min over alternatives o
+//     of cost(F(o) \ S), which any completion must pay; branch on the group
+//     attaining it, cheapest alternative first. A search that finishes within the
+//     node budget proves the plan optimal; otherwise the best plan found is kept.
+//  5. The queue is a post-order of the chosen set from the target that follows
+//     only needed prerequisites, so no queued technology is redundant.
+namespace ResearchPathPlan
+{
+	// Graph must provide:
+	//   int numTechs() const;
+	//   int numAndPrereqs() const;  int andPrereq(int iTech, int i) const;  (-1 = none)
+	//   int numOrPrereqs() const;   int orPrereq(int iTech, int i) const;   (-1 = none)
+	//   bool satisfied(int iTech) const;    known, or already queued
+	//   bool researchable(int iTech) const; canEverResearch
+	//   int cost(int iTech) const;          research cost, >= 0
+	template <class Graph>
+	class Planner
+	{
+	public:
+		typedef std::vector<unsigned int> Bits;
+
+		explicit Planner(const Graph& kGraph, const int iNodeBudget = 256) :
+			m_kGraph(kGraph),
+			m_iTechs(kGraph.numTechs()),
+			m_iWords((kGraph.numTechs() + 31) / 32),
+			m_iNodeBudget(iNodeBudget),
+			m_aeState(kGraph.numTechs(), UNRESOLVED),
+			m_auiClosure(kGraph.numTechs() * ((kGraph.numTechs() + 31) / 32), 0u),
+			m_aiSteps(kGraph.numTechs(), 0),
+			m_abForced(kGraph.numTechs(), 0),
+			m_auiForced(kGraph.numTechs() * ((kGraph.numTechs() + 31) / 32), 0u),
+			m_aiPlanSteps(kGraph.numTechs(), -1),
+			m_aiPlanCost(kGraph.numTechs(), 0),
+			m_abPlanOptimal(kGraph.numTechs(), 0),
+			m_aiTreeSteps(kGraph.numTechs(), 0),
+			m_aiTreeStamp(kGraph.numTechs(), 0),
+			m_iTreeStamp(0),
+			m_iResolved(0),
+			m_iNodes(0)
+		{
+		}
+
+		bool reachable(const int iTech)
+		{
+			return resolve(iTech) != INFEASIBLE;
+		}
+
+		// Distinct missing technologies including the target; INT_MAX if unreachable.
+		int steps(const int iTech)
+		{
+			return measure(iTech) ? m_aiPlanSteps[iTech] : INT_MAX;
+		}
+
+		// Total research cost of those technologies; INT_MAX if unreachable (saturating).
+		int cost(const int iTech)
+		{
+			return measure(iTech) ? m_aiPlanCost[iTech] : INT_MAX;
+		}
+
+		// True when the branch and bound finished: the plan has minimum cost.
+		bool provedOptimal(const int iTech)
+		{
+			return measure(iTech) && m_abPlanOptimal[iTech] != 0;
+		}
+
+		// Missing technologies, prerequisites first. False if unreachable.
+		bool plan(const int iTech, std::vector<int>& aiOrder)
+		{
+			bool bOptimal = false;
+			return plan(iTech, aiOrder, bOptimal);
+		}
+
+		int resolvedCount() const { return m_iResolved; }
+		int searchNodes() const { return m_iNodes; }
+
+	private:
+		enum State { UNRESOLVED, VISITING, FEASIBLE, INFEASIBLE };
+
+		// ---- bitset helpers -------------------------------------------------
+
+		static bool has(const Bits& auiBits, const int iTech)
+		{
+			return (auiBits[iTech / 32] & (1u << (iTech % 32))) != 0u;
+		}
+
+		static void set(Bits& auiBits, const int iTech)
+		{
+			auiBits[iTech / 32] |= (1u << (iTech % 32));
+		}
+
+		static int lowestBit(const unsigned int uiBits)
+		{
+			int iBit = 0;
+			while (((uiBits >> iBit) & 1u) == 0u)
+			{
+				++iBit;
+			}
+			return iBit;
+		}
+
+		const unsigned int* closure(const int iTech) const { return &m_auiClosure[iTech * m_iWords]; }
+		const unsigned int* forced(const int iTech) const { return &m_auiForced[iTech * m_iWords]; }
+
+		void merge(Bits& auiPlan, const unsigned int* auiOther) const
+		{
+			for (int iWord = 0; iWord < m_iWords; ++iWord)
+			{
+				auiPlan[iWord] |= auiOther[iWord];
+			}
+		}
+
+		// Cost and count of auiOther's members not yet in auiPlan.
+		void marginal(const Bits& auiPlan, const unsigned int* auiOther, long long& iCost, int& iSteps) const
+		{
+			for (int iWord = 0; iWord < m_iWords; ++iWord)
+			{
+				for (unsigned int uiBits = auiOther[iWord] & ~auiPlan[iWord]; uiBits != 0; uiBits &= uiBits - 1)
+				{
+					++iSteps;
+					iCost += m_kGraph.cost(iWord * 32 + lowestBit(uiBits));
+				}
+			}
+		}
+
+		long long costOf(const std::vector<int>& aiOrder) const
+		{
+			long long iCost = 0;
+			for (int iI = 0; iI < (int)aiOrder.size(); ++iI)
+			{
+				iCost += m_kGraph.cost(aiOrder[iI]);
+			}
+			return iCost;
+		}
+
+		// ---- 1. feasibility and standalone closures -------------------------
+
+		State resolve(const int iTech)
+		{
+			if (iTech < 0 || iTech >= m_iTechs)
+			{
+				return INFEASIBLE;
+			}
+			if (m_aeState[iTech] == FEASIBLE || m_aeState[iTech] == INFEASIBLE)
+			{
+				return m_aeState[iTech];
+			}
+			if (m_aeState[iTech] == VISITING)
+			{
+				return INFEASIBLE;	// a prerequisite cycle in XML can never be completed
+			}
+			++m_iResolved;
+			if (m_kGraph.satisfied(iTech))
+			{
+				m_aeState[iTech] = FEASIBLE;	// empty closure, no cost
+				return FEASIBLE;
+			}
+			if (!m_kGraph.researchable(iTech))
+			{
+				m_aeState[iTech] = INFEASIBLE;
+				return INFEASIBLE;
+			}
+
+			m_aeState[iTech] = VISITING;
+			Bits auiPlan(m_iWords, 0u);
+			set(auiPlan, iTech);
+			for (int iI = 0; iI < m_kGraph.numAndPrereqs(); ++iI)
+			{
+				const int iPrereq = m_kGraph.andPrereq(iTech, iI);
+				if (iPrereq < 0)
+				{
+					continue;
+				}
+				if (resolve(iPrereq) == INFEASIBLE)
+				{
+					m_aeState[iTech] = INFEASIBLE;
+					return INFEASIBLE;
+				}
+				merge(auiPlan, closure(iPrereq));
+			}
+
+			bool bHasOr = false;
+			bool bOrSatisfied = false;
+			int iBestChoice = -1;
+			long long iBestCost = 0;
+			int iBestSteps = 0;
+			for (int iI = 0; iI < m_kGraph.numOrPrereqs(); ++iI)
+			{
+				const int iPrereq = m_kGraph.orPrereq(iTech, iI);
+				if (iPrereq < 0)
+				{
+					continue;
+				}
+				bHasOr = true;
+				if (resolve(iPrereq) == INFEASIBLE)
+				{
+					continue;
+				}
+				if (m_aiSteps[iPrereq] == 0 || has(auiPlan, iPrereq))
+				{
+					bOrSatisfied = true;
+					break;
+				}
+				long long iAddedCost = 0;
+				int iAddedSteps = 0;
+				marginal(auiPlan, closure(iPrereq), iAddedCost, iAddedSteps);
+				if (iBestChoice < 0 || iAddedCost < iBestCost ||
+					(iAddedCost == iBestCost && iAddedSteps < iBestSteps))
+				{
+					iBestChoice = iPrereq;
+					iBestCost = iAddedCost;
+					iBestSteps = iAddedSteps;
+				}
+			}
+			if (bHasOr && !bOrSatisfied)
+			{
+				if (iBestChoice < 0)
+				{
+					m_aeState[iTech] = INFEASIBLE;
+					return INFEASIBLE;
+				}
+				merge(auiPlan, closure(iBestChoice));
+			}
+
+			int iSteps = 0;
+			unsigned int* auiClosure = &m_auiClosure[iTech * m_iWords];
+			for (int iWord = 0; iWord < m_iWords; ++iWord)
+			{
+				auiClosure[iWord] = auiPlan[iWord];
+				for (unsigned int uiBits = auiPlan[iWord]; uiBits != 0; uiBits &= uiBits - 1)
+				{
+					++iSteps;
+				}
+			}
+			m_aiSteps[iTech] = iSteps;
+			m_aeState[iTech] = FEASIBLE;
+			return FEASIBLE;
+		}
+
+		bool known(const int iTech)
+		{
+			return resolve(iTech) == FEASIBLE && m_aiSteps[iTech] == 0;
+		}
+
+		// Feasible, unknown alternatives of iTech's OR group; bSatisfied when an
+		// alternative is already known or queued.
+		void alternatives(const int iTech, std::vector<int>& aiAlternatives, bool& bHasOr, bool& bSatisfied)
+		{
+			aiAlternatives.clear();
+			bHasOr = false;
+			bSatisfied = false;
+			for (int iI = 0; iI < m_kGraph.numOrPrereqs(); ++iI)
+			{
+				const int iPrereq = m_kGraph.orPrereq(iTech, iI);
+				if (iPrereq < 0)
+				{
+					continue;
+				}
+				bHasOr = true;
+				if (resolve(iPrereq) == INFEASIBLE)
+				{
+					continue;
+				}
+				if (known(iPrereq))
+				{
+					bSatisfied = true;
+					return;
+				}
+				aiAlternatives.push_back(iPrereq);
+			}
+		}
+
+		// ---- 2. forced closures ----------------------------------------------
+
+		// Requires resolve(iTech) == FEASIBLE.
+		void computeForced(const int iTech)
+		{
+			if (m_abForced[iTech])
+			{
+				return;
+			}
+			m_abForced[iTech] = 1;	// acyclic once feasible; also guards recursion
+			if (known(iTech))
+			{
+				return;	// empty
+			}
+			Bits auiForced(m_iWords, 0u);
+			set(auiForced, iTech);
+			for (int iI = 0; iI < m_kGraph.numAndPrereqs(); ++iI)
+			{
+				const int iPrereq = m_kGraph.andPrereq(iTech, iI);
+				if (iPrereq >= 0)
+				{
+					computeForced(iPrereq);
+					merge(auiForced, forced(iPrereq));
+				}
+			}
+			std::vector<int> aiAlternatives;
+			bool bHasOr = false;
+			bool bSatisfied = false;
+			alternatives(iTech, aiAlternatives, bHasOr, bSatisfied);
+			if (bHasOr && !bSatisfied && aiAlternatives.size() == 1)
+			{
+				computeForced(aiAlternatives[0]);
+				merge(auiForced, forced(aiAlternatives[0]));
+			}
+			unsigned int* auiOut = &m_auiForced[iTech * m_iWords];
+			for (int iWord = 0; iWord < m_iWords; ++iWord)
+			{
+				auiOut[iWord] = auiForced[iWord];
+			}
+		}
+
+		// ---- 3. greedy incumbents ----------------------------------------------
+
+		// Steps of iTech's graph expanded as a tree, planned technologies free:
+		// the former findPathLength measure, memoized for one decision.
+		long long treeSteps(const int iTech, const Bits& auiPlanned)
+		{
+			if (m_kGraph.satisfied(iTech) || has(auiPlanned, iTech))
+			{
+				return 0;
+			}
+			if (m_aiTreeStamp[iTech] == m_iTreeStamp)
+			{
+				return m_aiTreeSteps[iTech];
+			}
+			const long long iCap = 1LL << 40;
+			m_aiTreeStamp[iTech] = m_iTreeStamp;	// an XML cycle reads as unbounded
+			m_aiTreeSteps[iTech] = iCap;
+			long long iSteps = 1;
+			for (int iI = 0; iI < m_kGraph.numAndPrereqs(); ++iI)
+			{
+				const int iPrereq = m_kGraph.andPrereq(iTech, iI);
+				if (iPrereq >= 0)
+				{
+					iSteps += treeSteps(iPrereq, auiPlanned);
+				}
+			}
+			long long iShortest = -1;
+			for (int iI = 0; iI < m_kGraph.numOrPrereqs(); ++iI)
+			{
+				const int iPrereq = m_kGraph.orPrereq(iTech, iI);
+				if (iPrereq >= 0)	// as findPathLength did: researchability is checked by the caller
+				{
+					const long long iOr = treeSteps(iPrereq, auiPlanned);
+					if (iShortest < 0 || iOr < iShortest)
+					{
+						iShortest = iOr;
+					}
+				}
+			}
+			if (iShortest > 0)
+			{
+				iSteps += iShortest;
+			}
+			m_aiTreeSteps[iTech] = iSteps < iCap ? iSteps : iCap;
+			return m_aiTreeSteps[iTech];
+		}
+
+		// Depth-first in pushResearch's order; iTech is feasible.
+		void visit(const int iTech, Bits& auiPlanned, std::vector<int>& aiOrder, const bool bClassic)
+		{
+			if (known(iTech) || has(auiPlanned, iTech))
+			{
+				return;
+			}
+			for (int iI = 0; iI < m_kGraph.numAndPrereqs(); ++iI)
+			{
+				const int iPrereq = m_kGraph.andPrereq(iTech, iI);
+				if (iPrereq >= 0)
+				{
+					visit(iPrereq, auiPlanned, aiOrder, bClassic);
+				}
+			}
+
+			if (bClassic)
+			{
+				++m_iTreeStamp;
+			}
+			bool bHasOr = false;
+			int iBestChoice = -1;
+			long long iBestCost = 0;
+			int iBestSteps = 0;
+			for (int iI = 0; iI < m_kGraph.numOrPrereqs(); ++iI)
+			{
+				const int iPrereq = m_kGraph.orPrereq(iTech, iI);
+				if (iPrereq < 0 || resolve(iPrereq) == INFEASIBLE)
+				{
+					continue;
+				}
+				bHasOr = true;
+				if (known(iPrereq) || has(auiPlanned, iPrereq))
+				{
+					iBestChoice = -1;	// known, queued, or already planned
+					break;
+				}
+				long long iAddedCost = 0;
+				int iAddedSteps = 0;
+				if (bClassic)
+				{
+					iAddedCost = treeSteps(iPrereq, auiPlanned);
+				}
+				else
+				{
+					marginal(auiPlanned, closure(iPrereq), iAddedCost, iAddedSteps);
+				}
+				if (iBestChoice < 0 || iAddedCost < iBestCost ||
+					(iAddedCost == iBestCost && iAddedSteps < iBestSteps))
+				{
+					iBestChoice = iPrereq;
+					iBestCost = iAddedCost;
+					iBestSteps = iAddedSteps;
+				}
+			}
+			if (bHasOr && iBestChoice >= 0)
+			{
+				visit(iBestChoice, auiPlanned, aiOrder, bClassic);
+			}
+
+			set(auiPlanned, iTech);
+			aiOrder.push_back(iTech);
+		}
+
+		// ---- 4. branch and bound ------------------------------------------------
+
+		void search(const Bits& auiSet, const long long iSetCost, long long& iBestCost, Bits& auiBest, bool& bExhausted)
+		{
+			if (++m_iNodes > m_iNodeBudget)
+			{
+				bExhausted = true;
+				return;
+			}
+			// Open groups and the admissible bound.
+			int iBranch = -1;
+			long long iBound = 0;
+			std::vector<int> aiAlternatives;
+			std::vector<int> aiBranchAlternatives;
+			for (int iWord = 0; iWord < m_iWords; ++iWord)
+			{
+				for (unsigned int uiBits = auiSet[iWord]; uiBits != 0; uiBits &= uiBits - 1)
+				{
+					const int iTech = iWord * 32 + lowestBit(uiBits);
+					bool bHasOr = false;
+					bool bSatisfied = false;
+					alternatives(iTech, aiAlternatives, bHasOr, bSatisfied);
+					if (!bHasOr || bSatisfied)
+					{
+						continue;
+					}
+					bool bInSet = false;
+					for (int iI = 0; iI < (int)aiAlternatives.size(); ++iI)
+					{
+						if (has(auiSet, aiAlternatives[iI]))
+						{
+							bInSet = true;	// satisfied inside the set
+							break;
+						}
+					}
+					if (bInSet || aiAlternatives.empty())
+					{
+						continue;	// (a feasible member always has a feasible alternative)
+					}
+					long long iCheapest = -1;
+					for (int iI = 0; iI < (int)aiAlternatives.size(); ++iI)
+					{
+						computeForced(aiAlternatives[iI]);
+						long long iAdded = 0;
+						int iSteps = 0;
+						marginal(auiSet, forced(aiAlternatives[iI]), iAdded, iSteps);
+						if (iCheapest < 0 || iAdded < iCheapest)
+						{
+							iCheapest = iAdded;
+						}
+					}
+					if (iBranch < 0 || iCheapest > iBound)
+					{
+						iBranch = iTech;
+						iBound = iCheapest;
+						aiBranchAlternatives = aiAlternatives;
+					}
+				}
+			}
+			if (iBranch < 0)
+			{
+				if (iSetCost < iBestCost)
+				{
+					iBestCost = iSetCost;
+					auiBest = auiSet;
+				}
+				return;
+			}
+			if (iSetCost + iBound >= iBestCost)
+			{
+				return;
+			}
+			// Cheapest alternative first.
+			std::vector<long long> aiAdded(aiBranchAlternatives.size(), 0);
+			for (int iI = 0; iI < (int)aiBranchAlternatives.size(); ++iI)
+			{
+				int iSteps = 0;
+				marginal(auiSet, forced(aiBranchAlternatives[iI]), aiAdded[iI], iSteps);
+			}
+			std::vector<char> abTried(aiBranchAlternatives.size(), 0);
+			for (int iRound = 0; iRound < (int)aiBranchAlternatives.size(); ++iRound)
+			{
+				int iPick = -1;
+				for (int iI = 0; iI < (int)aiBranchAlternatives.size(); ++iI)
+				{
+					if (!abTried[iI] && (iPick < 0 || aiAdded[iI] < aiAdded[iPick]))
+					{
+						iPick = iI;
+					}
+				}
+				abTried[iPick] = 1;
+				if (iSetCost + aiAdded[iPick] >= iBestCost)
+				{
+					break;	// remaining alternatives cost at least as much
+				}
+				Bits auiNext(auiSet);
+				merge(auiNext, forced(aiBranchAlternatives[iPick]));
+				search(auiNext, iSetCost + aiAdded[iPick], iBestCost, auiBest, bExhausted);
+				if (bExhausted)
+				{
+					return;
+				}
+			}
+		}
+
+		// ---- 5. irredundant queue order ----------------------------------------
+
+		void emit(const int iTech, const Bits& auiSet, Bits& auiEmitted, std::vector<int>& aiOrder)
+		{
+			if (known(iTech) || has(auiEmitted, iTech))
+			{
+				return;
+			}
+			set(auiEmitted, iTech);
+			for (int iI = 0; iI < m_kGraph.numAndPrereqs(); ++iI)
+			{
+				const int iPrereq = m_kGraph.andPrereq(iTech, iI);
+				if (iPrereq >= 0)
+				{
+					emit(iPrereq, auiSet, auiEmitted, aiOrder);
+				}
+			}
+			std::vector<int> aiAlternatives;
+			bool bHasOr = false;
+			bool bSatisfied = false;
+			alternatives(iTech, aiAlternatives, bHasOr, bSatisfied);
+			if (bHasOr && !bSatisfied)
+			{
+				int iChoice = -1;
+				for (int iI = 0; iI < (int)aiAlternatives.size(); ++iI)
+				{
+					if (has(auiEmitted, aiAlternatives[iI]))
+					{
+						iChoice = -1;	// already provided by an earlier prerequisite
+						break;
+					}
+					if (iChoice < 0 && has(auiSet, aiAlternatives[iI]))
+					{
+						iChoice = aiAlternatives[iI];
+					}
+				}
+				if (iChoice >= 0)
+				{
+					emit(iChoice, auiSet, auiEmitted, aiOrder);
+				}
+			}
+			aiOrder.push_back(iTech);
+		}
+
+		bool plan(const int iTech, std::vector<int>& aiOrder, bool& bOptimal)
+		{
+			aiOrder.clear();
+			bOptimal = false;
+			if (!reachable(iTech))
+			{
+				return false;
+			}
+			if (known(iTech))
+			{
+				bOptimal = true;
+				return true;
+			}
+
+			std::vector<int> aiClassic;
+			{
+				Bits auiMarginal(m_iWords, 0u);
+				visit(iTech, auiMarginal, aiOrder, false);
+				Bits auiClassic(m_iWords, 0u);
+				visit(iTech, auiClassic, aiClassic, true);
+			}
+			long long iBestCost = costOf(aiOrder);
+			const long long iClassicCost = costOf(aiClassic);
+			if (iClassicCost < iBestCost ||
+				(iClassicCost == iBestCost && aiClassic.size() < aiOrder.size()))
+			{
+				aiOrder.swap(aiClassic);
+				iBestCost = iClassicCost;
+			}
+
+			computeForced(iTech);
+			Bits auiStart(forced(iTech), forced(iTech) + m_iWords);
+			long long iStartCost = 0;
+			int iStartSteps = 0;
+			Bits auiEmpty(m_iWords, 0u);
+			marginal(auiEmpty, forced(iTech), iStartCost, iStartSteps);
+
+			Bits auiBest;
+			long long iFound = iBestCost;
+			bool bExhausted = false;
+			const int iNodesBefore = m_iNodes;
+			m_iNodes = 0;
+			search(auiStart, iStartCost, iFound, auiBest, bExhausted);
+			m_iNodes += iNodesBefore;
+			if (iFound < iBestCost)
+			{
+				Bits auiEmitted(m_iWords, 0u);
+				std::vector<int> aiSearched;
+				emit(iTech, auiBest, auiEmitted, aiSearched);
+				if (costOf(aiSearched) <= iFound)
+				{
+					aiOrder.swap(aiSearched);
+				}
+			}
+			bOptimal = !bExhausted;
+			return true;
+		}
+
+		bool measure(const int iTech)
+		{
+			if (!reachable(iTech))
+			{
+				return false;
+			}
+			if (m_aiPlanSteps[iTech] < 0)
+			{
+				std::vector<int> aiOrder;
+				bool bOptimal = false;
+				plan(iTech, aiOrder, bOptimal);
+				const long long iCost = costOf(aiOrder);
+				m_aiPlanSteps[iTech] = (int)aiOrder.size();
+				m_aiPlanCost[iTech] = (int)(iCost > INT_MAX ? INT_MAX : iCost);
+				m_abPlanOptimal[iTech] = bOptimal ? 1 : 0;
+			}
+			return true;
+		}
+
+		const Graph& m_kGraph;
+		const int m_iTechs;
+		const int m_iWords;
+		const int m_iNodeBudget;
+		std::vector<State> m_aeState;
+		std::vector<unsigned int> m_auiClosure;
+		std::vector<int> m_aiSteps;
+		std::vector<char> m_abForced;
+		std::vector<unsigned int> m_auiForced;
+		std::vector<int> m_aiPlanSteps;
+		std::vector<int> m_aiPlanCost;
+		std::vector<char> m_abPlanOptimal;
+		std::vector<long long> m_aiTreeSteps;
+		std::vector<int> m_aiTreeStamp;
+		int m_iTreeStamp;
+		int m_iResolved;
+		int m_iNodes;
+	};
+}
+
+#endif
