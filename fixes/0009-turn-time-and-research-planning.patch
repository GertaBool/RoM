diff --git a/Tools/test_mission_target_index.py b/Tools/test_mission_target_index.py
new file mode 100644
index 0000000..35982af
--- /dev/null
+++ b/Tools/test_mission_target_index.py
@@ -0,0 +1,258 @@
+#!/usr/bin/env python3
+"""Prove the mission-target index returns exactly what the original group scan did.
+
+The production AIMissionTargetIndex.h is compiled in C++03 with UBSan and compared
+with the original AI_plotTargetMissionAIs loop over randomized groups, wrapped and
+bounded maps, ranges (including the aliasing fallback), skipped groups, repeated
+mission types and the NO_MISSIONAI wildcard. Map wrapping and step distance are
+taken verbatim from the production headers. Source contracts then require every
+change to group membership, the group set or a mission target to invalidate it.
+"""
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+from test_ai_decisions import function
+
+ROOT = Path(__file__).resolve().parents[1]
+DLL = ROOT / "Assets" / "CvGameCoreDLL"
+
+
+def inline_function(text, signature):
+    start = text.index(signature)
+    return text[start:text.index("{", start)] + "{" + function(text[start:], signature) + "}"
+
+
+utils = (DLL / "CvGameCoreUtils.h").read_text(errors="replace")
+cvmap = (DLL / "CvMap.h").read_text(errors="replace")
+production_geometry = "\n".join([
+    inline_function(cvmap, "inline int coordRange(int iCoord, int iRange, bool bWrap)"),
+    inline_function(utils, "inline int coordDistance(int iFrom, int iTo, int iRange, bool bWrap)"),
+])
+
+program = r'''
+#include "AIMissionTargetIndex.h"
+#include <cassert>
+#include <climits>
+#include <cstdlib>
+#include <ctime>
+#include <iostream>
+#include <vector>
+
+enum MissionAITypes { NO_MISSIONAI = -1, MISSIONAI_A, MISSIONAI_B, MISSIONAI_C, MISSIONAI_D, MISSIONAI_UNUSED };
+
+GEOMETRY
+
+struct Map
+{
+    int w, h; bool wx, wy;
+    // CvMap::plotINLINE: wrap each axis, reject coordinates off a bounded edge.
+    int plotIndex(int iX, int iY, int iDX, int iDY) const
+    {
+        const int x = coordRange(iX + iDX, w, wx), y = coordRange(iY + iDY, h, wy);
+        return (x >= 0 && x < w && y >= 0 && y < h) ? y * w + x : -1;
+    }
+    int stepDistance(int x1, int y1, int x2, int y2) const
+    {
+        const int dx = coordDistance(x1, x2, w, wx), dy = coordDistance(y1, y2, h, wy);
+        return dx > dy ? dx : dy;
+    }
+    int width() const { return w; }
+    int height() const { return h; }
+};
+
+struct Group { int x, y; bool hasPlot; MissionAITypes mission; int units; };
+
+// The original CvPlayerAI::AI_plotTargetMissionAIs loop, verbatim apart from adapters.
+int original(const Map& m, const std::vector<Group>& groups, int px, int py,
+    const MissionAITypes* aeMissionAI, int iMissionAICount, int& iClosestTargetRange,
+    const Group* pSkipSelectionGroup, int iRange)
+{
+    int iCount = 0;
+    iClosestTargetRange = INT_MAX;
+    for (size_t g = 0; g < groups.size(); ++g)
+    {
+        const Group* pLoopSelectionGroup = &groups[g];
+        if (pLoopSelectionGroup != pSkipSelectionGroup && pLoopSelectionGroup->hasPlot)
+        {
+            const MissionAITypes eGroupMissionAI = pLoopSelectionGroup->mission;
+            const int iDistance = m.stepDistance(px, py, pLoopSelectionGroup->x, pLoopSelectionGroup->y);
+            if (iDistance <= iRange)
+            {
+                for (int iMissionAIIndex = 0; iMissionAIIndex < iMissionAICount; iMissionAIIndex++)
+                {
+                    if (eGroupMissionAI == aeMissionAI[iMissionAIIndex] || aeMissionAI[iMissionAIIndex] == NO_MISSIONAI)
+                    {
+                        iCount += pLoopSelectionGroup->units;
+                        if (iDistance < iClosestTargetRange)
+                            iClosestTargetRange = iDistance;
+                    }
+                }
+            }
+        }
+    }
+    return iCount;
+}
+
+unsigned int seed = 12345u;
+int rnd(int n) { seed = seed * 1103515245u + 12345u; return (int)((seed >> 16) % (unsigned int)n); }
+
+int main()
+{
+    const int sizes[][2] = { {3, 3}, {5, 4}, {9, 7}, {24, 16}, {60, 40} };
+    long queries = 0, indexed = 0, scanned = 0;
+    AIMissionTargetIndex::Index index;
+    unsigned int epoch = 0;
+    for (int s = 0; s < 5; ++s)
+    for (int wrap = 0; wrap < 4; ++wrap)
+    for (int trial = 0; trial < 60; ++trial)
+    {
+        const Map m = { sizes[s][0], sizes[s][1], (wrap & 1) != 0, (wrap & 2) != 0 };
+        std::vector<Group> groups(rnd(40));
+        for (size_t g = 0; g < groups.size(); ++g)
+        {
+            Group& k = groups[g];
+            k.x = rnd(m.w); k.y = rnd(m.h);
+            if (rnd(4) == 0) { k.x = groups[rnd((int)g + 1)].x; k.y = groups[rnd((int)g + 1)].y; }
+            k.hasPlot = rnd(5) != 0;
+            k.mission = (MissionAITypes)(rnd(5) - 1);
+            k.units = rnd(6);
+        }
+        // Rebuild exactly as CvPlayerAI does: one entry per group with a mission plot.
+        ++epoch;
+        assert(!index.isCurrent(1, epoch, m.w * m.h));
+        index.begin(1, epoch, m.w * m.h);
+        for (size_t g = 0; g < groups.size(); ++g)
+            if (groups[g].hasPlot)
+                index.add(groups[g].y * m.w + groups[g].x, groups[g].x, groups[g].y,
+                    groups[g].mission, groups[g].units, &groups[g]);
+        assert(index.isCurrent(1, epoch, m.w * m.h));
+        assert(!index.isCurrent(2, epoch, m.w * m.h));
+        assert(!index.isCurrent(1, epoch + 1, m.w * m.h));
+
+        for (int q = 0; q < 200; ++q)
+        {
+            MissionAITypes missions[4];
+            const int count = 1 + rnd(4);
+            for (int i = 0; i < count; ++i)
+                missions[i] = (MissionAITypes)(rnd(6) - 1);
+            const int ranges[] = { -1, 0, 0, 0, 1, 2, 3, 4, 6, 30 };
+            const int range = ranges[rnd(10)];
+            const Group* skip = groups.empty() || rnd(3) == 0 ? (const Group*)0 : &groups[rnd((int)groups.size())];
+            const int px = rnd(m.w), py = rnd(m.h);
+            int expectedClosest = 0, actualClosest = 0;
+            const int expected = original(m, groups, px, py, missions, count, expectedClosest, skip, range);
+            const int actual = index.count(m, px, py, missions, count, NO_MISSIONAI, skip, range, actualClosest);
+            if (expected != actual || expectedClosest != actualClosest)
+            {
+                std::cerr << "mismatch size " << m.w << "x" << m.h << " wrap " << wrap << " range " << range
+                          << " expected " << expected << "/" << expectedClosest
+                          << " actual " << actual << "/" << actualClosest << "\n";
+                return 1;
+            }
+            const int side = 2 * range + 1;
+            if (range >= 0 && side <= m.w && side <= m.h && side * side <= index.numEntries()) ++indexed; else ++scanned;
+            ++queries;
+        }
+    }
+    // Informational timing: one whole-map scan (one query per plot) on a
+    // 144x96 wrapped map with 600 groups, as the unit AI performs per unit.
+    {
+        const Map big = { 144, 96, true, false };
+        std::vector<Group> fleet(600);
+        for (size_t g = 0; g < fleet.size(); ++g)
+        {
+            Group k = { rnd(big.w), rnd(big.h), true, (MissionAITypes)rnd(4), 1 + rnd(3) };
+            fleet[g] = k;
+        }
+        MissionAITypes build = MISSIONAI_B;
+        int closest = 0;
+        long checksumA = 0, checksumB = 0;
+        std::clock_t start = std::clock();
+        for (int y = 0; y < big.h; ++y)
+            for (int x = 0; x < big.w; ++x)
+                checksumA += original(big, fleet, x, y, &build, 1, closest, (const Group*)0, 0);
+        const double scan = double(std::clock() - start) / CLOCKS_PER_SEC;
+        start = std::clock();
+        index.begin(9, ++epoch, big.w * big.h);
+        for (size_t g = 0; g < fleet.size(); ++g)
+            index.add(fleet[g].y * big.w + fleet[g].x, fleet[g].x, fleet[g].y, fleet[g].mission, fleet[g].units, &fleet[g]);
+        for (int y = 0; y < big.h; ++y)
+            for (int x = 0; x < big.w; ++x)
+                checksumB += index.count(big, x, y, &build, 1, NO_MISSIONAI, (const void*)0, 0, closest);
+        const double indexed = double(std::clock() - start) / CLOCKS_PER_SEC;
+        assert(checksumA == checksumB);
+        std::cout << "INFO: whole-map scan, 13824 plots x 600 groups: group scan " << scan * 1000.0
+                  << " ms, index (including rebuild) " << indexed * 1000.0 << " ms\n";
+    }
+    // A rebuild of the same size must not expose entries from the previous build.
+    const Map m = { 8, 8, false, false };
+    Group a = { 2, 2, true, MISSIONAI_A, 3 };
+    index.begin(7, ++epoch, 64);
+    index.add(2 * 8 + 2, 2, 2, a.mission, a.units, &a);
+    index.begin(7, ++epoch, 64);
+    MissionAITypes any = NO_MISSIONAI;
+    int closest = 0;
+    assert(index.count(m, 2, 2, &any, 1, NO_MISSIONAI, (const void*)0, 0, closest) == 0);
+    assert(closest == INT_MAX);
+    std::cout << "PASS: " << queries << " queries matched the original scan ("
+              << indexed << " via plot buckets, " << scanned << " via entry scan)\n";
+    return 0;
+}
+'''.replace("GEOMETRY", production_geometry)
+
+with tempfile.TemporaryDirectory() as directory:
+    source = Path(directory) / "mission_index.cpp"
+    binary = Path(directory) / "mission_index"
+    source.write_text(program)
+    subprocess.run([
+        "g++", "-std=c++03", "-Wall", "-Wextra", "-Werror", "-fsanitize=undefined",
+        "-fno-sanitize-recover=all", "-I", str(DLL), str(source), "-o", str(binary),
+    ], check=True)
+    subprocess.run([str(binary)], check=True, timeout=120)
+
+
+def code(text):
+    return re.sub(r"/\*.*?\*/|//[^\n]*", "", text, flags=re.S)
+
+
+group = code((DLL / "CvSelectionGroup.cpp").read_text(errors="replace"))
+group_ai = code((DLL / "CvSelectionGroupAI.cpp").read_text(errors="replace"))
+player_ai = code((DLL / "CvPlayerAI.cpp").read_text(errors="replace"))
+
+# Every membership mutation is immediately preceded by invalidation.
+mutations = re.findall(r"([^;{}]*;)\s*([^;{}]*\bm_units\.(?:insertBefore|insertAtEnd|insertAfter|deleteNode|clear|Read)\([^;]*;)", group)
+assert len(mutations) == 5, mutations
+for before, mutation in mutations:
+    assert before.strip() == "noteMissionTargetsChanged();", (before, mutation)
+assert "uninit();" in function(group, "CvSelectionGroup::~CvSelectionGroup()")
+
+# No other translation unit edits group membership or mission targets directly.
+for path in DLL.glob("*.cpp"):
+    if path.name in ("CvSelectionGroup.cpp", "CvSelectionGroupAI.cpp"):
+        continue
+    text = code(path.read_text(errors="replace"))
+    assert not re.search(r"\bm_units\.(insert|delete|clear|Read)", text) or "CvSelectionGroup" not in path.name, path
+    assert not re.search(r"\bm_(eMissionAIType|iMissionAIX|iMissionAIY)\s*=", text), path
+
+# Mission fields change only where the epoch is bumped.
+for name in ("void CvSelectionGroupAI::AI_reset()", "void CvSelectionGroupAI::read(",
+             "void CvSelectionGroupAI::AI_setMissionAI("):
+    assert "noteMissionTargetsChanged();" in function(group_ai, name), name
+assigners = set()
+for match in re.finditer(r"\bm_(eMissionAIType|iMissionAIX|iMissionAIY)\s*=|Read\(\(int\*\)&m_eMissionAIType\)|Read\(&m_iMissionAI[XY]\)", group_ai):
+    owner = group_ai.rfind("CvSelectionGroupAI::", 0, match.start())
+    assigners.add(group_ai[owner:group_ai.index("(", owner)])
+assert assigners == {"CvSelectionGroupAI::AI_reset", "CvSelectionGroupAI::AI_setMissionAI",
+                     "CvSelectionGroupAI::read"}, assigners
+setter = function(group_ai, "void CvSelectionGroupAI::AI_setMissionAI(")
+assert setter.index("noteMissionTargetsChanged();") < setter.index("m_eMissionAIType = eNewMissionAI;")
+
+# The query rebuilds from the same group data the original loop read.
+query = function(player_ai, "int CvPlayerAI::AI_plotTargetMissionAIs(CvPlot* pPlot, MissionAITypes* aeMissionAI")
+for needle in ("CvSelectionGroup::getMissionTargetsEpoch()", "isCurrent(getID(), uiEpoch",
+               "begin(getID(), uiEpoch", "AI_getMissionAIPlot()", "AI_getMissionAIType()",
+               "getNumUnits()", "s_kMissionTargetIndex.count(", "NO_MISSIONAI, pSkipSelectionGroup, iRange"):
+    assert needle in query, needle
+assert "firstSelectionGroup(&iLoop)" in query
+print("PASS: every membership, group-set and mission-target change invalidates the index")
