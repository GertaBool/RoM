diff --git a/Assets/CvGameCoreDLL/AIMissionTargetIndex.h b/Assets/CvGameCoreDLL/AIMissionTargetIndex.h
new file mode 100644
index 0000000..3780dd5
--- /dev/null
+++ b/Assets/CvGameCoreDLL/AIMissionTargetIndex.h
@@ -0,0 +1,175 @@
+#ifndef AI_MISSION_TARGET_INDEX_H
+#define AI_MISSION_TARGET_INDEX_H
+
+#include <limits.h>
+#include <vector>
+
+// Exact index for CvPlayerAI::AI_plotTargetMissionAIs.
+//
+// The original query walks every selection group of the player and counts
+// the units of groups whose mission plot lies within a step range of the
+// queried plot. Unit AI calls it inside whole-map scans, which costs
+// O(plots x groups) per scan. This index buckets each group with a mission
+// plot under that plot once, in O(groups); a query then inspects only the
+// (2r+1)^2 plots within its range, or the compact entry list when that is
+// smaller. Results, including the closest matching range, are identical.
+//
+// The caller owns invalidation: rebuild whenever group membership, the set
+// of groups or any mission target may have changed (see the epoch kept by
+// CvSelectionGroup). The index holds no game state and is never saved.
+namespace AIMissionTargetIndex
+{
+	struct Entry
+	{
+		const void* pGroup;
+		int iMissionAI;
+		int iUnits;
+		int iX;
+		int iY;
+		int iNext;
+	};
+
+	class Index
+	{
+	public:
+		Index() : m_iOwner(-1), m_uiEpoch(0), m_iStamp(0) {}
+
+		bool isCurrent(const int iOwner, const unsigned int uiEpoch, const int iNumPlots) const
+		{
+			return m_iOwner == iOwner && m_uiEpoch == uiEpoch && (int)m_aiHead.size() == iNumPlots;
+		}
+
+		void begin(const int iOwner, const unsigned int uiEpoch, const int iNumPlots)
+		{
+			m_iOwner = iOwner;
+			m_uiEpoch = uiEpoch;
+			m_aEntries.clear();
+			if ((int)m_aiHead.size() != iNumPlots || m_iStamp == INT_MAX)
+			{
+				m_aiHead.assign(iNumPlots, -1);
+				m_aiStamp.assign(iNumPlots, 0);
+				m_iStamp = 0;
+			}
+			++m_iStamp;
+		}
+
+		void invalidate()
+		{
+			m_iOwner = -1;
+		}
+
+		void add(const int iPlot, const int iX, const int iY, const int iMissionAI,
+			const int iUnits, const void* pGroup)
+		{
+			Entry kEntry;
+			kEntry.pGroup = pGroup;
+			kEntry.iMissionAI = iMissionAI;
+			kEntry.iUnits = iUnits;
+			kEntry.iX = iX;
+			kEntry.iY = iY;
+			kEntry.iNext = head(iPlot);
+			m_aiStamp[iPlot] = m_iStamp;
+			m_aiHead[iPlot] = (int)m_aEntries.size();
+			m_aEntries.push_back(kEntry);
+		}
+
+		int numEntries() const
+		{
+			return (int)m_aEntries.size();
+		}
+
+		// Map must provide:
+		//   int plotIndex(int iX, int iY, int iDX, int iDY) const  (-1 when off a non-wrapping edge)
+		//   int stepDistance(int iX1, int iY1, int iX2, int iY2) const
+		//   int width() const; int height() const;
+		// eNoMissionAI is the wildcard value (NO_MISSIONAI) that matches every group.
+		template <class Map, class MissionAI>
+		int count(const Map& kMap, const int iX, const int iY, const MissionAI* aeMissionAI,
+			const int iMissionAICount, const MissionAI eNoMissionAI, const void* pSkipGroup,
+			const int iRange, int& iClosestTargetRange) const
+		{
+			iClosestTargetRange = INT_MAX;
+			if (iRange < 0)
+			{
+				return 0;
+			}
+
+			int iCount = 0;
+			const int iSide = 2 * iRange + 1;
+			// Offsets alias on a wrapped axis narrower than the window, and a wide
+			// window can visit more plots than there are entries: scan entries then.
+			if (iSide > kMap.width() || iSide > kMap.height() ||
+				iSide > 46340 || iSide * iSide > (int)m_aEntries.size())
+			{
+				for (int iEntry = 0; iEntry < (int)m_aEntries.size(); ++iEntry)
+				{
+					accumulate(kMap, m_aEntries[iEntry], iX, iY, aeMissionAI, iMissionAICount,
+						eNoMissionAI, pSkipGroup, iRange, iCount, iClosestTargetRange);
+				}
+				return iCount;
+			}
+
+			for (int iDX = -iRange; iDX <= iRange; ++iDX)
+			{
+				for (int iDY = -iRange; iDY <= iRange; ++iDY)
+				{
+					const int iPlot = kMap.plotIndex(iX, iY, iDX, iDY);
+					if (iPlot < 0)
+					{
+						continue;
+					}
+					for (int iEntry = head(iPlot); iEntry != -1; iEntry = m_aEntries[iEntry].iNext)
+					{
+						accumulate(kMap, m_aEntries[iEntry], iX, iY, aeMissionAI, iMissionAICount,
+							eNoMissionAI, pSkipGroup, iRange, iCount, iClosestTargetRange);
+					}
+				}
+			}
+			return iCount;
+		}
+
+	private:
+		int head(const int iPlot) const
+		{
+			return (m_aiStamp[iPlot] == m_iStamp) ? m_aiHead[iPlot] : -1;
+		}
+
+		// Mirrors the original inner loop: a group contributes once for every
+		// requested mission type it matches, and NO_MISSIONAI matches any group.
+		template <class Map, class MissionAI>
+		static void accumulate(const Map& kMap, const Entry& kEntry, const int iX, const int iY,
+			const MissionAI* aeMissionAI, const int iMissionAICount, const MissionAI eNoMissionAI,
+			const void* pSkipGroup, const int iRange, int& iCount, int& iClosestTargetRange)
+		{
+			if (kEntry.pGroup == pSkipGroup)
+			{
+				return;
+			}
+			const int iDistance = kMap.stepDistance(iX, iY, kEntry.iX, kEntry.iY);
+			if (iDistance > iRange)
+			{
+				return;
+			}
+			for (int iIndex = 0; iIndex < iMissionAICount; ++iIndex)
+			{
+				if (kEntry.iMissionAI == (int)aeMissionAI[iIndex] || aeMissionAI[iIndex] == eNoMissionAI)
+				{
+					iCount += kEntry.iUnits;
+					if (iDistance < iClosestTargetRange)
+					{
+						iClosestTargetRange = iDistance;
+					}
+				}
+			}
+		}
+
+		int m_iOwner;
+		unsigned int m_uiEpoch;
+		int m_iStamp;
+		std::vector<int> m_aiHead;
+		std::vector<int> m_aiStamp;
+		std::vector<Entry> m_aEntries;
+	};
+}
+
+#endif
