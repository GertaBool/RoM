+#!/usr/bin/env python3
+"""Regression checks for defects found by compiling the whole DLL with clang
+diagnostics and the clang static analyzer.
+
+Each check targets the defective construct itself: serialized info streams must
+be symmetric, conditions must test rather than assign, enum comparisons must use
+the same kind of ID, variadic logging must receive C strings, and values must be
+initialized on every path that reads them.
+"""
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+import unittest
+from test_ai_decisions import function
+
+ROOT = Path(__file__).resolve().parents[1]
+DLL = ROOT / "Assets" / "CvGameCoreDLL"
+
+
+def src(name):
+    return (DLL / name).read_text(errors="replace")
+
+
+def code(text):
+    return re.sub(r"/\*.*?\*/|//[^\n]*", "", text, flags=re.S)
+
+
+def stream_fields(body, operation):
+    fields = []
+    for match in re.finditer(r"stream->%s\((.*?)\);" % operation, body):
+        fields.append(re.sub(r"\s+", "", match.group(1)).lstrip("&"))
+    return fields
+
+
+class StaticFindingTests(unittest.TestCase):
+    def test_info_streams_write_values_and_match_reads(self):
+        infos = code(src("CvInfos.cpp"))
+        self.assertNotRegex(infos, r"stream->Write\(\s*&", "a pointer converts to bool true")
+        for cls in ("CvUnitInfo", "CvCivicInfo", "CvBuildingInfo"):
+            read = stream_fields(function(infos, "void %s::read(FDataStreamBase* stream)" % cls), "Read")
+            write = stream_fields(function(infos, "void %s::write(FDataStreamBase* stream)" % cls), "Write")
+            revolution = [f for f in read if re.match(r"m_[a-z]+(Rev|Inquisit|CanBeRebel|CanRebel|CannotDefect|CanQuell|UpgradeAnywhere|AllowInq|DisallowInq|Communism|FreeSpeech|CanDoElection)", f)]
+            self.assertTrue(revolution or cls == "CvBuildingInfo", cls)
+            for field in revolution:
+                self.assertIn(field, write, (cls, field))
+            positions = [write.index(f) for f in revolution]
+            self.assertEqual(positions, sorted(positions), cls)
+            self.assertEqual(len(read), len(write), cls)
+
+    def test_executive_value_tests_external_value_and_counts_rivals(self):
+        body = code(function(src("CvPlayerAI.cpp"), "int CvPlayerAI::AI_executiveValue("))
+        self.assertIn("if (iSpreadExternalValue == 0)", body)
+        self.assertNotRegex(body, r"if \(\s*iSpreadExternalValue\s*=\s*0\s*\)")
+        loop = body[body.index("for (int iCorp"):body.index("if (iOurCitiesHave >= iOurCitiesCount)")]
+        self.assertIn("iCorp != eCorporation", loop)
+        self.assertIn("getHasCorporationCount((CorporationTypes)iCorp)", loop)
+        self.assertIn("countHasCorporation((CorporationTypes)iCorp, getID())", loop)
+        self.assertNotIn("(eCorporation", loop.replace("isCompetingCorporation(eCorporation", ""))
+
