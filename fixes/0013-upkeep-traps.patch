+#!/usr/bin/env python3
+"""An AI in financial trouble must be able to shed upkeep it does not need.
+
+Seen on a real Marathon save replayed in the GertaBool/RoM toolchain/harness:
+Rome kept the Mercenaries civic for 125 turns. Its unit charges took 45 of its
+96 commerce, research ran at 5 percent, and with financial trouble its cities
+trained no settler although a good site was open; at 410 BC it had four cities
+and no Writing. Three valuation terms kept the civic ahead of the default one
+(free experience priced from population, unit charges counted without the
+handicap percent, three military units assumed in every city), the disband
+routine skipped every unit with more than one experience point although the
+civic gives five at birth, and 14 scouts against a need of three kept exploring
+because the surplus check ran only when nothing was left to explore.
+
+AICivicPolicy is compiled as it is; CvPlayerAI::AI_disbandUnit is compiled from
+the DLL source with stand-ins for units, cities and the game.
+"""
+import unittest
+from test_review_correctness import DLL, block, compile_run
+
+
+def unit_ai_enum():
+    text = (DLL / 'CvEnums.h').read_text(encoding='latin-1')
+    start = text.index('UNITAI_UNKNOWN,')
+    body = text[start:text.index('}', start)]
+    return 'enum UnitAITypes { NO_UNITAI = -1, ' + body + '};\n'
+
+
+class CivicValueTermsTests(unittest.TestCase):
+    def test_terms_in_gold_per_turn(self):
+        compile_run(r'''
+#include <cassert>
+#include "AICivicPolicy.h"
+using namespace AICivicPolicy;
+int main() {
+ // Rome at 410 BC: 45 units, 39 military; free 17 and 4; Mercenaries charges
+ // one gold per unit and one per military unit on top of the base one.
+ const int iMercenaries = recurringUnitCostPerTurn(45, 39, 17, 4, 2, 1);
+ const int iTribal = recurringUnitCostPerTurn(45, 39, 17, 4, 1, 0);
+ assert(iMercenaries == 91 && iTribal == 28);
+ // Noble: unit cost percent 50 (the AI percent is 100): the 45 gold Rome pays,
+ // 31 more than under the default civic.
+ assert(scaleCostPercent(iMercenaries, 50) == 45);
+ assert(scaleCostPercent(iMercenaries, 50) - scaleCostPercent(iTribal, 50) == 31);
+ assert(scaleCostPercent(-5, 50) == 0 && scaleCostPercent(5, -50) == 0);
+ assert(scaleCostPercent(2000000000, 300) == 2147483647);
+ // Five points buy two promotions (2 and 5 experience). Rome's 85 hammers with a
+ // war plan: 34 go to military units, each promotion worth 15 percent.
+ assert(freeExperienceValuePerTurn(85, 40, 2) == 10);
+ assert(freeExperienceValuePerTurn(85, 20, 2) == 5);
+ // The removed population term: 5 * 23 * 30 / 100 * 130 / 100.
+ assert((5 * 23 * 30 / 100) * 130 / 100 == 44);
+ assert(freeExperienceValuePerTurn(85, 40, 9) == freeExperienceValuePerTurn(85, 40, 3));
+ assert(freeExperienceValuePerTurn(85, 400, 1) == freeExperienceValuePerTurn(85, 100, 1));
+ assert(freeExperienceValuePerTurn(-1, 40, 2) == 0 && freeExperienceValuePerTurn(85, 40, -2) == 0);
+ assert(freeExperienceValuePerTurn(2000000000, 100, 3) == 900000000);
+ return 0;
+}
+''')
+
+    def test_civic_value_uses_the_terms(self):
+        src = (DLL / 'CvPlayerAI.cpp').read_text(encoding='latin-1')
+        method = block(src, 'int CvPlayerAI::AI_civicValue(CivicTypes eCivic) const')
+        self.assertIn('freeExperienceValuePerTurn', method)
+        self.assertNotIn('getTotalPopulation() * (bWarPlan ? 30 : 12)', method)
+        self.assertIn('scaleCostPercent(', method)
+        self.assertIn('getAIUnitCostPercent()', method)
+        self.assertIn('getMilitaryHappinessUnits()', method)
+        self.assertNotIn('getHappyPerMilitaryUnit() * 3;', method)
+
+
+DISBAND_HOST = r'''
+#include <cassert>
+#include <vector>
+#include <string>
+#include <algorithm>
+#include <climits>
+#pragma GCC diagnostic ignored "-Wunused-parameter"
+#pragma GCC diagnostic ignored "-Wimplicit-fallthrough"
+#define FAssert(x) ((void)0)
+#define MAX_INT INT_MAX
+#define gPlayerLogLevel 0
+void logBBAI(const char*, ...) {}
+''' + '%s' + r'''
+struct CvWString { const wchar_t* GetCString() const { return L""; } };
+void getUnitAIString(CvWString&, UnitAITypes) {}
+enum { PUF_isMilitaryHappiness = 0 };
+struct CvUnitInfo { int cost, extra; int getProductionCost() const { return cost; } int getExtraCost() const { return extra; } };
+struct CvCity;
+struct CvPlot {
+	bool city; int team; CvCity* pCity; int militaryHere;
+	CvPlot(): city(true), team(0), pCity(NULL), militaryHere(0) {}
+	bool isCity() const { return city; } int getTeam() const { return team; }
+	CvCity* getPlotCity() const { return pCity; }
+	int plotCount(int, int, int, int) const { return militaryHere; }
+};
+struct CvUnit {
+	CvUnitInfo info; int xp, level, type, created; bool fight, killed; UnitAITypes ai; CvPlot* where;
+	CvUnit(): xp(0), level(1), type(0), created(0), fight(true), killed(false), ai(UNITAI_ATTACK), where(NULL) { info.cost = 30; info.extra = 0; }
+	bool hasCargo() const { return false; } bool isGoldenAge() const { return false; }
+	const CvUnitInfo& getUnitInfo() const { return info; }
+	bool canFight() const { return fight; } int getExperience() const { return xp; } int getLevel() const { return level; }
+	int getUnitType() const { return type; } bool isMilitaryHappiness() const { return false; }
+	CvPlot* plot() const { return where; } int getTeam() const { return 0; } bool canDefend() const { return fight; }
+	UnitAITypes AI_getUnitAIType() const { return ai; } int getGameTurnCreated() const { return created; }
+	CvWString getName() const { return CvWString(); }
+	void kill(bool) { killed = true; }
+};
+struct CvCity { int birthXp; int AI_getWorkersNeeded() const { return 0; }
+	int getProductionExperience(int) { return birthXp; } };
+struct CvGame { int getSorenRandNum(int, const char*) { return 0; } int getGameTurn() const { return 100; } } game;
+struct CvTeam { int getAnyWarPlanCount(bool) const { return 0; } } team;
+CvTeam& GET_TEAM(int) { return team; }
+struct Globals { CvGame& getGameINLINE() { return game; } CvGame& getGame() { return game; } int getNumUnitInfos() { return 4; } } GC;
+struct CvPlayerAI {
+	std::vector<CvUnit*> units; std::vector<CvCity*> cities;
+	CvUnit* firstUnit(int* i) { *i = 0; return units.empty() ? NULL : units[0]; }
+	CvUnit* nextUnit(int* i) { ++*i; return *i < (int)units.size() ? units[*i] : NULL; }
+	CvCity* firstCity(int* i) { *i = 0; return cities.empty() ? NULL : cities[0]; }
+	CvCity* nextCity(int* i) { ++*i; return *i < (int)cities.size() ? cities[*i] : NULL; }
+	int getTeam() const { return 0; } int getID() const { return 0; }
+	const wchar_t* getCivilizationDescription(int) const { return L""; }
+	bool AI_disbandUnit(int iExpThreshold, bool bObsolete);
+};
+'''
+
+
+def disband_program(tail):
+    src = (DLL / 'CvPlayerAI.cpp').read_text(encoding='latin-1')
+    method = block(src, 'bool CvPlayerAI::AI_disbandUnit(int iExpThreshold, bool bObsolete)')
+    return (DISBAND_HOST % unit_ai_enum()) + method + tail
+
+
+class DisbandTests(unittest.TestCase):
+    def test_birth_experience_does_not_exempt_a_unit(self):
+        compile_run(disband_program(r'''
+int main() {
+ CvPlot home; CvCity rome; rome.birthXp = 5; home.pCity = &rome;
+ CvPlayerAI p; p.cities.push_back(&rome);
+ CvUnit fresh, veteran, worker;
+ fresh.xp = 5; fresh.level = 3; fresh.where = &home;        // trained under Mercenaries
+ veteran.xp = 9; veteran.level = 3; veteran.where = &home;  // four points from combat
+ worker.fight = false; worker.ai = UNITAI_WORKER; worker.where = &home;
+ p.units.push_back(&veteran); p.units.push_back(&worker); p.units.push_back(&fresh);
+ assert(p.AI_disbandUnit(1, false));
+ assert(fresh.killed && !veteran.killed && !worker.killed);
+ // Without free experience the old threshold holds: two points protect.
+ CvPlayerAI q; CvCity plain; plain.birthXp = 0; q.cities.push_back(&plain);
+ CvUnit one, two; one.xp = 1; one.where = &home; two.xp = 2; two.where = &home;
+ q.units.push_back(&two); q.units.push_back(&one);
+ assert(q.AI_disbandUnit(1, false) && one.killed && !two.killed);
+ CvPlayerAI r; r.cities.push_back(&plain); CvUnit vet; vet.xp = 2; vet.where = &home; r.units.push_back(&vet);
+ assert(!r.AI_disbandUnit(1, false) && !vet.killed);
+ // -1 still means any unit.
+ assert(r.AI_disbandUnit(-1, false) && vet.killed);
+ return 0;
+}
+'''))
+
+
+class ExplorerTests(unittest.TestCase):
+    def test_surplus_explorer_retires_before_exploring(self):
+        src = (DLL / 'CvUnitAI.cpp').read_text(encoding='latin-1')
+        method = block(src, 'void CvUnitAI::AI_exploreMove()')
