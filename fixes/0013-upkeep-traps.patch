+	// Added: the gold a unit-support projection really costs. calculateUnitCost
+	// scales the per-unit charges by the handicap (and for AI players by the AI
+	// unit cost and per-era percents); inflation then applies to all costs.
+	inline int scaleCostPercent(const int iCost, const int iPercent)
+	{
+		const long long iResult = ((long long)std::max(0, iCost) * std::max(0, iPercent)) / 100;
+		return iResult > INT_MAX ? INT_MAX : (int)iResult;
+	}
+
+	// Added: per-turn value of free experience. It buys every new military unit
+	// iPromotions promotions (at most three counted), each worth a fixed share of
+	// the unit's hammers, on the share of production that goes into such units.
+	inline int freeExperienceValuePerTurn(const int iProduction, const int iMilitarySharePercent,
+		const int iPromotions)
+	{
+		const int iPromotionValuePercent = 15;
+		const long long iHammers = ((long long)std::max(0, iProduction) *
+			std::max(0, std::min(100, iMilitarySharePercent))) / 100;
+		const long long iValue = (iHammers * std::max(0, std::min(3, iPromotions)) *
+			iPromotionValuePercent) / 100;
+		return iValue > INT_MAX ? INT_MAX : (int)iValue;
+	}
+
 	// Added: applying a saturated per-turn cost must not overflow the surrounding
 	// per-turn civic score when that score is already negative.
 	inline int applyPenalty(const int iValue, const int iPenalty)
