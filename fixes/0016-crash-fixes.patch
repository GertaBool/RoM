index 0000000..6bf617f
--- /dev/null
+++ b/Tools/test_crash_fixes.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Objects used after they were deleted.
+
+Found in the GertaBool/RoM toolchain/harness: a Marathon game crashed on turn
+415 inside CvWString's copy constructor. AI_conquerCity razed a captured city
+and then logged the city's name: CvPlayer::raze deletes the city, and the
+arguments of logBBAI are evaluated even when AI logging is off, so the name was
+read from freed memory. Usually the freed block still looks like an empty
+string; once the heap has reused it the game crashes.
+
+The espionage mission that bribes a worker read the unit's type after
+kill(false), which deletes the unit at once. CvCity::liberate gave conscripted
+defenders to the city it had just checked for NULL, outside the check.
+"""
+import unittest
+from test_review_correctness import DLL, block
+
+
+def src(name):
+    return (DLL / name).read_text(encoding='latin-1')
+
+
+class UseAfterDeleteTests(unittest.TestCase):
+    def test_raze_logged_before_the_city_is_deleted(self):
+        method = block(src('CvPlayerAI.cpp'), 'void CvPlayerAI::AI_conquerCity(')
+        raze = method.index('pCity->doTask(TASK_RAZE);')
+        self.assertNotIn('pCity->', method[raze + len('pCity->doTask(TASK_RAZE);'):].split('if (!bRaze)')[0])
+        self.assertIn('decides to raze city', method[:raze])
+
+    def test_bribed_worker_type_read_before_kill(self):
+        method = block(src('CvPlayer.cpp'), 'bool CvPlayer::doEspionageMission(')
+        kill = method.index('pTargetUnit->kill(false, getID());')
+        self.assertIn('UnitTypes eTargetUnitType = pTargetUnit->getUnitType();', method[:kill])
+        self.assertIn('initUnit(eTargetUnitType, iX, iY, UNITAI_WORKER)', method[kill:])
+        self.assertNotIn('pTargetUnit->getUnitType()', method[kill:])
+
+    def test_liberated_city_checked_before_conscripts(self):
+        method = block(src('CvCity.cpp'), 'void CvCity::liberate(')
+        check = method.index('if (NULL != pCity)')
+        depth, i = 0, method.index('{', check)
+        for i in range(i, len(method)):
+            depth += {'{': 1, '}': -1}.get(method[i], 0)
+            if depth == 0:
+                break
+        self.assertIn('pCity->initConscriptedUnit();', method[check:i])
+
+
+if __name__ == '__main__':
+    unittest.main()
