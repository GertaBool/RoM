+# Graphics paging (CvGame::graphicsWindowFromCamera). Index 0 reads the camera and returns how many values
+# follow; index i returns value i: the camera's eye x, y, z and target x, y, z in world units, 1 if the target
+# was read, the screen's width and height in pixels, and 1 in globe view.
+g_cameraView = []
+def getCameraView(argsList):
+	global g_cameraView
+	iIndex = argsList[0]
+	if iIndex == 0:
+		try:
+			camera = CyCamera()
+			eye = camera.GetCurrentPosition()
+			target = [0, 0, 0, 0]
+			try:
+				point = camera.GetLookAt()
+				target = [int(point.x), int(point.y), int(point.z), 1]
+			except:
+				pass
+			screen = CyGInterfaceScreen("MainInterface", CvScreenEnums.MAIN_INTERFACE)
+			bGlobe = 0
+			try:
+				bGlobe = int(CyEngine().isGlobeviewUp())
+			except:
+				pass
+			g_cameraView = [int(eye.x), int(eye.y), int(eye.z)] + target + [screen.getXResolution(), screen.getYResolution(), bGlobe]
+		except:
+			g_cameraView = []
+		return len(g_cameraView)
+	if 0 < iIndex <= len(g_cameraView):
+		return g_cameraView[iIndex - 1]
+	return 0
 
