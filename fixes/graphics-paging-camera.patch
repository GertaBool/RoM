+// The plots the screen shows, from the camera: its eye and target (CvGameInterface.getCameraView, which reads
+// CyCamera GetCurrentPosition and GetLookAt; the target is the look-at plot's centre when GetLookAt cannot be
+// read) and the screen's size. Rays through the corners and edge midpoints of the view, FIELD_OF_VIEW wide
+// vertically and the screen's aspect ratio times that horizontally (the larger footprint of the two readings
+// of FIELD_OF_VIEW), are cast onto the ground plane; a ray at or above the horizon reaches past the map. The
+// window is the footprint's extent around the look-at plot in plots, plus one for the plot's size and the
+// terrain's height. Returns 1 with aiRange (west, east, north, south), 0 when the camera cannot be read or the
+// centre ray does not come down near the look-at plot, and -1 in globe view.
+int CvGame::graphicsWindowFromCamera(const CvPlot* pLookAt, int* aiRange)
+{
+	int aiView[10];
+	long lResult = 0;
+	{
+		CyArgsList argsList;
+		argsList.add(0);
+		if (!gDLL->getPythonIFace()->callFunction(PYGameModule, "getCameraView", argsList.makeFunctionArgs(), &lResult) || lResult < 10)
+		{
+			return 0;
+		}
+	}
+	for (int iI = 0; iI < 10; iI++)
+	{
+		CyArgsList argsList;
+		argsList.add(iI + 1);
+		lResult = 0;
+		gDLL->getPythonIFace()->callFunction(PYGameModule, "getCameraView", argsList.makeFunctionArgs(), &lResult);
+		aiView[iI] = (int)lResult;
+	}
+
+	if (aiView[9] != 0)
+	{
+		return -1;
+	}
+
+	CvMap& kMap = GC.getMapINLINE();
+	const float fPlotSize = GC.getPLOT_SIZE();
+	const float fLookAtX = kMap.plotXToPointX(pLookAt->getX_INLINE());
+	const float fLookAtY = kMap.plotYToPointY(pLookAt->getY_INLINE());
+	const float afEye[3] = {(float)aiView[0], (float)aiView[1], (float)aiView[2]};
+	float afTarget[3] = {fLookAtX, fLookAtY, 0.0f};
+	if (aiView[6] != 0)
+	{
+		afTarget[0] = (float)aiView[3];
+		afTarget[1] = (float)aiView[4];
+		afTarget[2] = (float)aiView[5];
+	}
+
+	float afF[3] = {afTarget[0] - afEye[0], afTarget[1] - afEye[1], afTarget[2] - afEye[2]};
+	const float fDistance = sqrt(afF[0] * afF[0] + afF[1] * afF[1] + afF[2] * afF[2]);
+	if (afEye[2] <= 0.0f || afF[2] >= 0.0f || fDistance < GC.getCAMERA_MIN_DISTANCE() / 2.0f)
+	{
+		return 0;
+	}
+	for (int iI = 0; iI < 3; iI++)
+	{
+		afF[iI] /= fDistance;
+	}
+
+	// right = forward x up (z), up = right x forward
+	float afR[3] = {afF[1], -afF[0], 0.0f};
+	const float fRight = sqrt(afR[0] * afR[0] + afR[1] * afR[1]);
+	if (fRight < 0.001f)
+	{
+		afR[0] = 1.0f;
+		afR[1] = 0.0f;
+	}
+	else
+	{
+		afR[0] /= fRight;
+		afR[1] /= fRight;
+	}
+	const float afU[3] = {afR[1] * afF[2] - afR[2] * afF[1], afR[2] * afF[0] - afR[0] * afF[2], afR[0] * afF[1] - afR[1] * afF[0]};
+
+	const float fTanV = tan(DEGTORAD(GC.getFIELD_OF_VIEW()) / 2.0f);
+	const float fAspect = (aiView[7] > 0 && aiView[8] > 0) ? ((float)aiView[7]) / ((float)aiView[8]) : (16.0f / 9.0f);
+	const float fTanH = fTanV * std::max(1.0f, fAspect);
+	const float fReach = (float)(kMap.getGridWidthINLINE() + kMap.getGridHeightINLINE()) * fPlotSize;
+
+	float fMinX = 0.0f;
+	float fMaxX = 0.0f;
+	float fMinY = 0.0f;
+	float fMaxY = 0.0f;
+	for (int iA = -1; iA <= 1; iA++)
+	{
+		for (int iB = -1; iB <= 1; iB++)
+		{
+			float afD[3];
+			for (int iI = 0; iI < 3; iI++)
+			{
+				afD[iI] = afF[iI] + iA * fTanH * afR[iI] + iB * fTanV * afU[iI];
+			}
+			float fHitX;
+			float fHitY;
+			const float fFlat = sqrt(afD[0] * afD[0] + afD[1] * afD[1]);
+			const float fT = (afD[2] < -0.001f) ? (-afEye[2] / afD[2]) : -1.0f;
+			if (fT > 0.0f && fT * fFlat <= fReach)
+			{
+				fHitX = afEye[0] + fT * afD[0];
+				fHitY = afEye[1] + fT * afD[1];
+			}
+			else if (fFlat > 0.001f)
+			{
+				fHitX = afEye[0] + afD[0] / fFlat * fReach;
+				fHitY = afEye[1] + afD[1] / fFlat * fReach;
+			}
+			else
+			{
+				fHitX = afEye[0];
+				fHitY = afEye[1];
+			}
+			fHitX -= fLookAtX;
+			fHitY -= fLookAtY;
+			if (iA == 0 && iB == 0 && (fabs(fHitX) > 3.0f * fPlotSize || fabs(fHitY) > 3.0f * fPlotSize))
+			{
+				return 0;
+			}
+			fMinX = std::min(fMinX, fHitX);
+			fMaxX = std::max(fMaxX, fHitX);
+			fMinY = std::min(fMinY, fHitY);
+			fMaxY = std::max(fMaxY, fHitY);
+		}
+	}
+
+	aiRange[0] = range(1 + (int)ceil(-fMinX / fPlotSize), 1, kMap.getGridWidthINLINE());
+	aiRange[1] = range(1 + (int)ceil(fMaxX / fPlotSize), 1, kMap.getGridWidthINLINE());
+	aiRange[2] = range(1 + (int)ceil(fMaxY / fPlotSize), 1, kMap.getGridHeightINLINE());
+	aiRange[3] = range(1 + (int)ceil(-fMinY / fPlotSize), 1, kMap.getGridHeightINLINE());
+	return 1;
+}
+
