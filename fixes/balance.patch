+// Balance against a hegemon (AI_BALANCE_SHARE, per mille; 0 switches it off): the team, other than ours,
+// with the most power among the living teams we have met (vassals counted with their masters), when its
+// power exceeds that share of their summed power, ours included. NO_TEAM otherwise.
+TeamTypes CvTeamAI::AI_balanceHegemon() const
+{
+	const int iShare = GC.getDefineINT("AI_BALANCE_SHARE", 0);
+	if (iShare <= 0)
+	{
+		return NO_TEAM;
+	}
+	int iTotal = 0;
+	int iBestPower = 0;
+	TeamTypes eBest = NO_TEAM;
+	for (int iI = 0; iI < MAX_CIV_TEAMS; iI++)
+	{
+		const CvTeam& kTeam = GET_TEAM((TeamTypes)iI);
+		if (!kTeam.isAlive() || kTeam.isBarbarian() || kTeam.isMinorCiv() || kTeam.isAVassal())
+		{
+			continue;
+		}
+		if (iI != getID() && !isHasMet((TeamTypes)iI))
+		{
+			continue;
+		}
+		const int iPower = kTeam.getPower(true);
+		iTotal += iPower;
+		if (iPower > iBestPower)
+		{
+			iBestPower = iPower;
+			eBest = (TeamTypes)iI;
+		}
+	}
+	if (eBest == NO_TEAM || eBest == getID() || (__int64)iBestPower * 1000 <= (__int64)iShare * iTotal)
+	{
+		return NO_TEAM;
+	}
+	return eBest;
+}
+
+// The no-war probability of the war rolls against eTarget. Against a hegemon it is lowered by ten per point
+// of the leader's envy of better-ranked players (iWorseRankDifferenceAttitudeChange, averaged over our
+// members; zero or positive values change nothing), except at ATTITUDE_FRIENDLY.
+int CvTeamAI::AI_balanceNoWarProb(TeamTypes eTarget) const
+{
+	const AttitudeTypes eAttitude = AI_getAttitude(eTarget);
+	const int iProb = AI_noWarAttitudeProb(eAttitude);
+	if (eAttitude == ATTITUDE_FRIENDLY || eTarget != AI_balanceHegemon())
+	{
+		return iProb;
+	}
+	int iEnvy = 0;
+	int iCount = 0;
+	for (int iI = 0; iI < MAX_PLAYERS; iI++)
+	{
+		const CvPlayer& kPlayer = GET_PLAYER((PlayerTypes)iI);
+		if (kPlayer.isAlive() && kPlayer.getTeam() == getID())
+		{
+			iEnvy += GC.getLeaderHeadInfo(kPlayer.getPersonalityType()).getWorseRankDifferenceAttitudeChange();
+			iCount++;
+		}
+	}
+	if (iCount > 1)
+	{
+		iEnvy /= iCount;
+	}
+	return std::max(0, iProb + 10 * std::min(0, iEnvy));
+}
+
+// The power, in reach of the hegemon eTarget, of the AI teams not yet at war with it that would join this
+// turn: they have met it, can declare war on it, are no vassal, and their own dogpile no-war roll passes
+// (the roll of the dogpile path, CvTeamAI::AI_doWar). Each counts with its power after its enemies' share,
+// as this team's own power is counted.
+int CvTeamAI::AI_balanceWillingPower(TeamTypes eTarget, bool bReach) const
+{
+	int iWilling = 0;
+	for (int iJ = 0; iJ < MAX_CIV_TEAMS; iJ++)
+	{
+		const CvTeamAI& kTeam = GET_TEAM((TeamTypes)iJ);
+		if (iJ == getID() || iJ == eTarget || !kTeam.isAlive() || kTeam.isHuman() || kTeam.isBarbarian() || kTeam.isMinorCiv() ||
+			kTeam.isAVassal() || kTeam.isAtWar(eTarget) || !kTeam.isHasMet(eTarget) || !kTeam.canDeclareWar(eTarget))
+		{
+			continue;
+		}
+		int iRoll = GC.getGameINLINE().getSorenRandNum(100, "AI Balance Willing") - 20;
+		iRoll = range(iRoll + (GC.getGameINLINE().isOption(GAMEOPTION_AGGRESSIVE_AI) ? 10 : 0), 0, 99);
+		if (iRoll < kTeam.AI_balanceNoWarProb(eTarget))
+		{
+			continue;
+		}
+		int iPower = kTeam.getPower(true) * std::max(0, 100 - kTeam.AI_getEnemyPowerPercent()) / 100;
+		if (bReach)
+		{
+			iPower = (int)(((__int64)kTeam.AI_getReachablePower(eTarget) * iPower) / std::max(1, kTeam.getPower(true)));
+		}
+		iWilling += iPower;
+	}
+	return iWilling;
+}
+
+// True if every team we plan war against is weaker than the hegemon (and is not the hegemon).
+bool CvTeamAI::AI_balanceOnlyWeakerPlans(TeamTypes eHegemon) const
+{
+	const int iHegemonPower = GET_TEAM(eHegemon).getPower(true);
+	for (int iI = 0; iI < MAX_CIV_TEAMS; iI++)
+	{
+		if (AI_getWarPlan((TeamTypes)iI) == NO_WARPLAN)
+		{
+			continue;
+		}
+		if (iI == eHegemon || GET_TEAM((TeamTypes)iI).getPower(true) >= iHegemonPower)
+		{
+			return false;
+		}
+	}
+	return true;
+}
+
 //returns true if war is veto'd by rolls.
 bool CvTeamAI::AI_performNoWarRolls(TeamTypes eTeam)
 {
