+// Collateral strength as CvUnit::collateralCombat applies it: an integer, so 25 % of
+// strength 3 (an archer) is nothing at all.
+int effectiveCollateral(const CvUnit* pUnit)
+{
+	const int iStrength = pUnit->baseCombatStr() * pUnit->collateralDamage() / 100;
+	return (iStrength == 0 && pUnit->getExtraCollateralDamage() > 0) ? 1 : iStrength;
+}
