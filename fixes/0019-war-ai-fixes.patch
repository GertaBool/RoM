--- /dev/null
+++ b/Tools/test_war_ai_fixes.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Three corrections to the war AI, outside any switch.
+
+- Units in a city were disbanded for a retrained unit exactly when enemies stood
+  within two plots: the BBAI port had inverted the BTS danger check.
+- Lead From Behind scaled its whole attacker rank, including the +10000 offset,
+  by collateral, so any unit with collateral outranked every other attacker, even
+  one whose collateral does no damage.
+- The unit that opens an assault was ranked by its collateral percentage, not by
+  the collateral strength the battle applies (an integer: 25 % of strength 3 is 0).
+"""
+import unittest
+from test_review_correctness import DLL, block
+
+
+def src(name):
+    return (DLL / name).read_text(encoding='latin-1')
+
+
+def effective_collateral(base, percent, extra=0):
+    s = base * percent // 100
+    return 1 if s == 0 and extra > 0 else s
+
+
+def lfb_rank(rank, percent, targets, base):
+    if targets > 0 and effective_collateral(base, percent) > 0:
+        return 10000 + ((rank - 10000) * (100 + (percent * targets) // 5)) // 100
+    return rank
+
+
+class WarAIFixTests(unittest.TestCase):
+    def test_retrain_disband_only_when_safe(self):
+        method = block(src('CvPlayerAI.cpp'), 'void CvPlayerAI::AI_doTurnUnitsPost(')
+        self.assertIn('(calculateUnitCost() > 0) && !AI_getAnyPlotDanger( pLoopUnit->plot(), 2, false))', method)
+
+    def test_effective_collateral_is_integer_strength(self):
+        text = src('CvGameCoreUtils.cpp')
+        self.assertIn('pUnit->baseCombatStr() * pUnit->collateralDamage() / 100', text)
+        self.assertIn('int effectiveCollateral(const CvUnit* pUnit);', src('CvGameCoreUtils.h'))
+        self.assertEqual(effective_collateral(3, 25), 0)    # archer
+        self.assertEqual(effective_collateral(7, 100), 7)   # knight
+        self.assertEqual(effective_collateral(3, 25, 10), 1)
+
+    def test_lead_from_behind_scales_odds_not_offset(self):
+        method = block(src('CvUnitAI.cpp'), 'void CvUnitAI::LFBgetBetterAttacker(')
+        self.assertIn('effectiveCollateral(this) > 0', method)
+        self.assertIn('iValue = 10000 + ((iValue - 10000) *', method)
+        # A catapult at 30 % odds no longer outranks an axeman at 70 %, and an
+        # archer's collateral (none) adds nothing.
+        self.assertLess(lfb_rank(10300, 100, 3, 5), lfb_rank(10700, 0, 3, 5))
+        self.assertEqual(lfb_rank(10400, 25, 3, 3), 10400)
+
+    def test_assault_opener_needs_real_collateral(self):
+        method = block(src('CvSelectionGroup.cpp'), 'static CvUnit* pickCollateralAttacker(')
+        self.assertIn('const int iCollateral = effectiveCollateral(pLoopUnit);', method)
+        self.assertIn('if (iCollateral < 2)', method)
+
+
+if __name__ == '__main__':
+    unittest.main()
