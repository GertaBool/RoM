@@ -36,6 +36,16 @@ inline int valueFromGold(int gold, int goldValuePercent)
 	return value > INT_MAX ? INT_MAX : (int)value;
 }
 
+// Added: value * numerator / denominator in 64 bits, saturated to int. Team
+// power products (power reaches 10^5 and more in RoM's later eras) overflowed
+// 32 bits in peace, surrender and gift valuations. A non-positive denominator
+// counts as 1, as the callers' std::max(1, ...) guards did.
+inline int scaleByRatio(int value, int numerator, int denominator)
+{
+	const long long result = ((long long)value * numerator) / (denominator > 0 ? denominator : 1);
+	return result < INT_MIN ? INT_MIN : (result > INT_MAX ? INT_MAX : (int)result);
+}
+
 // Added: accumulating the bounded conversion into an existing deal score must
 // not reintroduce signed overflow at the caller boundary.
 inline int saturatingAdd(int left, int right)
