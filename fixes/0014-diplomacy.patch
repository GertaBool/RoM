+#!/usr/bin/env python3
+"""Diplomacy defects found by mapping the deal, attitude and personality code.
+
+Each case names the defect; the code map and the measurements are in the
+GertaBool/RoM research repository (research/diplomacy).
+
+- Team power reaches 10^5 and more in RoM's later eras (unit power up to 2100),
+  so power products in AI_endWarVal, AI_surrenderTrade and AI_considerOffer
+  overflowed 32 bits: peace values became garbage and capitulation was refused.
+- The AI valued a resource it would receive as a spare copy (a fifth).
+- The second tech of a war-hire deal was compared with the wrong best value.
+- Peace deals counted gold 1:1 while AI_dealVal prices it at 2 to 3 per gold.
+- Help and tribute thresholds were read from the target's leader; favourite
+  religion and espionage weight from the leader instead of the personality.
+- A victory flag was tested against the strategy bits (both are bit 7).
+- Leaders with MaxWarRand below 100 refused every capitulation.
+- Memories and gifts did not refresh the cached attitude, and the team
+  counters (turns at war or at peace, shared war, pacts) advanced a turn before
+  the attitudes that use them, so a reloaded game played differently.
+- An embargo was priced from all of the target's deals.
+- The "do not bother" path rolled the asynchronous generator in the
+  synchronous AI turn (multiplayer desync).
+- AI-to-AI resource swaps had no value check and AI vassals were never asked
+  about tribute; the AI never sold a tech for gold or paid gold per turn for a
+  resource.
+"""
+import unittest
+from test_review_correctness import DLL, block, compile_run
+
+
+def src(name):
+    return (DLL / name).read_text(encoding='latin-1')
+
+
+class ScaleByRatioTests(unittest.TestCase):
+    def test_power_products_in_64_bits(self):
+        compile_run(r'''
+#include <cassert>
+#include "AIDiplomacyPolicy.h"
+using namespace AIDiplomacyPolicy;
+int main() {
+ // AI_endWarVal with a value of 5000 and team powers of 100 000 and 80 000:
+ // 5000 * 35 * 100000 is 1.75e10, far beyond 32 bits.
+ assert(scaleByRatio(5000, 7 * (5 * 100000), 10 * (80000 + 4 * 100000)) == 3645);
+ assert(scaleByRatio(5000, 100000 + 10, 80000 + 100000 + 10) == 2777);
+ // AI_surrenderTrade: 2 * average power * loop power with both above 33 000.
+ assert(scaleByRatio(2 * 60000, 50000, 50000 + 40000) == 66666);
+ assert(scaleByRatio(-300, 3, 2) == -450);
+ assert(scaleByRatio(7, 3, 0) == 21 && scaleByRatio(7, 3, -5) == 21);
+ assert(scaleByRatio(2000000000, 2000000000, 1) == 2147483647);
+ assert(scaleByRatio(-2000000000, 2000000000, 1) == -2147483647 - 1);
+ return 0;
+}
+''')
+
+    def test_call_sites(self):
+        team = src('CvTeamAI.cpp')
+        end_war = block(team, 'int CvTeamAI::AI_endWarVal(TeamTypes eTeam) const')
+        self.assertEqual(end_war.count('AIDiplomacyPolicy::scaleByRatio'), 5)
+        self.assertNotIn('iValue *= 7 * (5 * iTheirPower);', end_war)
+        self.assertNotIn('iValue *= iTheirPower + 10;', end_war)
+        surrender = block(team, 'DenialTypes CvTeamAI::AI_surrenderTrade(')
+        self.assertEqual(surrender.count('AIDiplomacyPolicy::scaleByRatio'), 3)
+        player = src('CvPlayerAI.cpp')
+        offer = block(player, 'bool CvPlayerAI::AI_considerOffer(')
+        self.assertEqual(offer.count('AIDiplomacyPolicy::scaleByRatio'), 2)
+
+
+class DealTests(unittest.TestCase):
+    def setUp(self):
+        self.diplo = block(src('CvPlayerAI.cpp'), 'void CvPlayerAI::AI_doDiplo()')
+
+    def test_resource_swap_values_a_received_copy(self):
+        self.assertNotIn('AI_bonusTradeVal(eBestReceiveBonus, ((PlayerTypes)iI), -1)', self.diplo)
+        self.assertIn('AI_bonusTradeVal(eBestReceiveBonus, ((PlayerTypes)iI), 1)', self.diplo)
+        self.assertIn('3 * iReceiveBonusValue > 2 * iGiveBonusValue && 3 * iGiveBonusValue > 2 * iReceiveBonusValue',
+                      self.diplo)
+
+    def test_second_war_hire_tech(self):
+        start = self.diplo.index('"AI Tech Trading #2"', self.diplo.index('int iBestValue2 = 0;'))
+        self.assertIn('if (iValue > iBestValue2)', self.diplo[start:start + 400])
+
+    def test_new_deal_shapes(self):
+        self.assertIn('"AI Tech Selling"', self.diplo)
+        self.assertIn('setTradeItem(&item, TRADE_GOLD_PER_TURN, iGoldPerTurn);', self.diplo)
+
+    def test_ai_vassal_is_asked_for_tribute(self):
+        self.assertIn('else if (GET_PLAYER((PlayerTypes)iI).AI_considerOffer(getID(), &ourList, &theirList))',
+                      self.diplo)
+
+    def test_own_thresholds(self):
+        self.assertNotIn('GC.getLeaderHeadInfo(GET_PLAYER((PlayerTypes)iI).getPersonalityType()).getNoGiveHelpAttitudeThreshold()',
+                         self.diplo)
+        self.assertNotIn('GC.getLeaderHeadInfo(GET_PLAYER((PlayerTypes)iI).getPersonalityType()).getDemandTributeAttitudeThreshold()',
+                         self.diplo)
+
+    def test_peace_gold_priced(self):
+        peace = block(src('CvPlayerAI.cpp'), 'void CvPlayerAI::AI_doPeace()')
+        self.assertEqual(peace.count('AIDiplomacyPolicy::goldForValueGap'), 2)
+        self.assertNotIn('iOurValue += iGold;', peace)
+        self.assertNotIn('iTheirValue += iGold;', peace)
+
+
+class AttitudeAndPersonalityTests(unittest.TestCase):
+    def test_sync_roll_on_do_not_bother_path(self):
+        begin = block(src('CvPlayerAI.cpp'), 'void CvPlayerAI::AI_beginDiplomacy(')
+        self.assertNotIn('AI_demandRebukedWar(ePlayer)', begin)
+        self.assertIn('getSorenRandNum(100, "AI Demand Rebuked")', begin)
+
+    def test_personality_not_leader(self):
+        player = src('CvPlayerAI.cpp')
+        self.assertNotIn('getLeaderHeadInfo(getLeaderType()).getFavoriteReligion()', player)
+        self.assertNotIn('getLeaderHeadInfo(getLeaderType()).getEspionageWeight()', player)
+
+    def test_close_borders_victory_flag(self):
+        method = block(src('CvPlayerAI.cpp'), 'int CvPlayerAI::AI_getCloseBordersAttitude(PlayerTypes ePlayer)')
+        self.assertIn('AI_isDoVictoryStrategy(AI_VICTORY_CONQUEST3)', method)
+        self.assertNotIn('AI_isDoStrategy(AI_VICTORY_CONQUEST3)', method)
+
+    def test_surrender_needs_a_city_to_take(self):
+        method = block(src('CvTeamAI.cpp'), 'bool CvTeamAI::AI_acceptSurrender(')
+        self.assertIn('>= std::max(1, AI_maxWarRand()/100)', method)
+
+    def test_attitude_cache_refreshed(self):
+        player = src('CvPlayerAI.cpp')
+        memory = block(player, 'void CvPlayerAI::AI_changeMemoryCount(')
+        self.assertIn('AI_invalidateAttitudeCache(eIndex1);', memory)
+        grant = block(player, 'void CvPlayerAI::AI_changePeacetimeGrantValue(')
+        self.assertIn('AI_invalidateAttitudeCache(eIndex);', grant)
+        team_turn = block(src('CvTeamAI.cpp'), 'void CvTeamAI::AI_doTurnPre()')
+        self.assertLess(team_turn.index('AI_doCounter();'), team_turn.index('AI_invalidateAttitudeCache();'))
+        self.assertLess(team_turn.index('AI_invalidateAttitudeCache();'), team_turn.index('if (isHuman())'))
+
+    def test_embargo_prices_deals_with_the_target(self):
+        method = block(src('CvPlayerAI.cpp'), 'int CvPlayerAI::AI_stopTradingTradeVal(')
+        self.assertEqual(method.count('== eTradeTeam && pLoopDeal->isCancelable(pLoopDeal->get'), 2)
+        self.assertNotIn('pLoopDeal->isCancelable(getID())', method)
+
+
+if __name__ == '__main__':
+    unittest.main()
