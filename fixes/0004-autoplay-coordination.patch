+#!/usr/bin/env python3
+"""Execute current production fragments for the Carthage autoplay review.
+
+Narrow adapters supply counts and path answers; this is not a BTS save replay.
+Use --source PATH to verify that the pre-fix source rejects these scenarios.
+"""
+import re
+import unittest
+import xml.etree.ElementTree as ET
+from test_review_correctness import ROOT, DLL, remaining, block, compile_run
+
+
+def source(name):
+    return (DLL / name).read_text()
+
+
+def uncomment(text):
+    return re.sub(r'/\*.*?\*/|//[^\n]*', '', text, flags=re.S)
+
+
+class CoordinationTests(unittest.TestCase):
+    def test_safe_automation_allows_connecting_a_blocked_resource(self):
+        method = block(source('CvUnitAI.cpp'), 'bool CvUnitAI::AI_improveBonus(')
+        start = method.index('eImprovement = pLoopPlot->getImprovementType();')
+        fragment = method[start:method.index('iBestTempBuildValue = MAX_INT;', start)]
+        compile_run(r'''
+#include <cassert>
+typedef int ImprovementTypes;
+enum {NO_IMPROVEMENT=-1,PLAYEROPTION_SAFE_AUTOMATION};
+struct Improvement {bool city,trade;bool isActsAsCity(){return city;}
+ bool isImprovementBonusTrade(int){return trade;}} info;
+struct Globals {int getDefineINT(const char*){return 2;}
+ Improvement& getImprovementInfo(int){return info;}} GC;
+struct Plot {int improvement;int getImprovementType(){return improvement;}} tile;
+struct Player {bool safe;bool isOption(int){return safe;}} player;
+#define GET_PLAYER(x) player
+int getOwnerINLINE(){return 0;}
+bool eligible(){Plot* pLoopPlot=&tile;int eImprovement=NO_IMPROVEMENT,eNonObsoleteBonus=0;
+ FRAGMENT
+ return bDoImprove;}
+int main(){for(int safe=0;safe<2;++safe){player.safe=safe!=0;
+ for(int imp=-1;imp<3;++imp)for(int city=0;city<2;++city)for(int trade=0;trade<2;++trade){
+  tile.improvement=imp;info.city=city!=0;info.trade=trade!=0;
+  assert(eligible()==(imp==NO_IMPROVEMENT || (!city && !trade)));
+ }}}
+'''.replace('FRAGMENT', fragment))
+
+    def test_bonus_build_selector_chooses_shortest_legal_build(self):
+        method = block(source('CvUnitAI.cpp'), 'bool CvUnitAI::AI_improveBonus(')
+        loop = block(method, 'for (iJ = 0; iJ < GC.getNumBuildInfos(); iJ++)')
+        compile_run(r'''
+#include <algorithm>
+#include <cassert>
+#include <climits>
+typedef int BuildTypes; typedef int ImprovementTypes;
+enum {NO_IMPROVEMENT=-1, NO_BUILD=-1, NO_FEATURE=-1, PLAYEROPTION_LEAVE_FORESTS};
+struct Build {int time; bool legal,remove,connect;
+ int getImprovement()const{return 0;} int getTime()const{return time;}
+ bool isFeatureRemove(int)const{return remove;}};
+struct Improvement {bool connect; bool isImprovementBonusTrade(int)const{return connect;}
+ bool isActsAsCity()const{return false;}};
+struct Globals {Build builds[3]; int selected;
+ int getNumBuildInfos()const{return 3;}
+ Build& getBuildInfo(int i){selected=i;return builds[i];}
+ Improvement getImprovementInfo(int)const{Improvement v={builds[selected].connect};return v;}} GC;
+struct Plot {bool radius; int feature; bool isCityRadius()const{return radius;}
+ int getFeatureType()const{return feature;}};
+struct Player {bool leave; bool isOption(int)const{return leave;}} player;
+#define GET_PLAYER(x) player
+int getOwnerINLINE(){return 0;}
+bool canBuild(Plot*,int b){return GC.builds[b].legal;}
+int select(Plot* pLoopPlot){int iJ=0,iValue=0,iBestTempBuildValue=INT_MAX;
+ int eBuild=NO_BUILD,eBestTempBuild=NO_BUILD,eNonObsoleteBonus=0;
+ LOOP
+ return eBestTempBuild;}
+int main(){Plot plot={true,NO_FEATURE};player.leave=false;
+ const int times[]={0,1,400,401,600,10000,INT_MAX};
+ for(int a=0;a<7;++a)for(int b=0;b<7;++b)for(int c=0;c<7;++c){
+  int t[]={times[a],times[b],times[c]};
+  for(int mask=1;mask<8;++mask){int expected=-1;
+   for(int i=0;i<3;++i){Build v={t[i],(mask&(1<<i))!=0,false,true};GC.builds[i]=v;
+    if(v.legal && (expected<0 || t[i]<t[expected]))expected=i;}
+   assert(select(&plot)==expected);
+  }
+ }
+ Build first={100,true,true,true},second={400,true,false,true},third={1,true,false,false};
+ GC.builds[0]=first;GC.builds[1]=second;GC.builds[2]=third;
+ plot.feature=0;player.leave=true;assert(select(&plot)==1);
+ player.leave=false;assert(select(&plot)==0);
+ GC.builds[0].legal=false;GC.builds[1].legal=false;assert(select(&plot)==NO_BUILD);
+}
