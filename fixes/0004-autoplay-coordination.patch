 	return deficit * runwayTurns;
 }
 
-// gold minus (reserve * percent / 100). Same quotient as the 32-bit
-// multiply-then-divide when that product fits; otherwise the reserve consumes
-// a non-negative stock instead of overflowing the subtraction.
-inline int goldAfterReserve(int gold, int reserve, int percent)
-{
-	if (reserve <= 0 || percent <= 0) return gold;
-	const int quot = reserve / 100;
-	const int rem = reserve % 100;
-	if (quot > INT_MAX / percent) return gold > 0 ? 0 : gold;
-	const int mainPart = quot * percent;
-	const int extra = rem * percent / 100;
-	if (mainPart > INT_MAX - extra) return gold > 0 ? 0 : gold;
-	const int buffer = mainPart + extra;
-	if (gold <= buffer) return gold > 0 ? 0 : gold;
-	return gold - buffer;
+// Apply the speed percentage before clamping to the available gold. The
+// unscaled deficit fits in 64 bits; its product with percent need not. Check
+// the exact depletion threshold first, so the final multiply is bounded by
+// gold * 100 and preserves integer rounding without intermediate saturation.
+inline int goldAfterDeficitReserve(int gold, int goldRate, int runwayTurns, int percent)
+{
+	if (gold <= 0 || goldRate >= 0 || runwayTurns <= 0 || percent <= 0) return gold;
+	const long long reserve = -(long long)goldRate * runwayTurns;
+	const long long depletionThreshold = ((long long)gold * 100 + percent - 1) / percent;
+	if (reserve >= depletionThreshold) return 0;
+	return gold - (int)(reserve * percent / 100);
 }
 
