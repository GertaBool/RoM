+// L: turn, viewer (the tracked player whose turn begins), owner, unit id, unit, x, y, hit points,
+// experience, level, id of its group's head unit, group size, id of the unit carrying it (-1),
+// units it carries, fortify turns, moves left (in 1/GC.getMOVE_DENOMINATOR()), group activity
+// (ActivityTypes), automation (AutomateTypes), first queued mission (MissionTypes, -1 for none)
+// with its two data fields (x and y for a move), promotions.
+static CvString warUnitLine(int iTurn, PlayerTypes eViewer, const CvUnit* pUnit)
+{
+	const CvSelectionGroup* pGroup = pUnit->getGroup();
+	const CvUnit* pHead = (pGroup != NULL) ? pGroup->getHeadUnit() : NULL;
+	const CvUnit* pTransport = pUnit->getTransportUnit();
+	const CLLNode<MissionData>* pMission = (pGroup != NULL) ? pGroup->headMissionQueueNode() : NULL;
+	return CvString::format("L\t%d\t%d\t%d\t%d\t%s\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%s",
+		iTurn, eViewer, pUnit->getOwnerINLINE(), pUnit->getID(), warUnitName(pUnit), pUnit->getX_INLINE(), pUnit->getY_INLINE(),
+		pUnit->currHitPoints(), pUnit->getExperience(), pUnit->getLevel(), (pHead != NULL) ? pHead->getID() : -1,
+		(pGroup != NULL) ? pGroup->getNumUnits() : 1, (pTransport != NULL) ? pTransport->getID() : -1, pUnit->getCargo(),
+		pUnit->getFortifyTurns(), pUnit->movesLeft(), (pGroup != NULL) ? (int)pGroup->getActivityType() : -1,
+		(pGroup != NULL) ? (int)pGroup->getAutomateType() : -1, (pMission != NULL) ? (int)pMission->m_data.eMissionType : -1,
+		(pMission != NULL) ? pMission->m_data.iData1 : -1, (pMission != NULL) ? pMission->m_data.iData2 : -1,
+		warPromotionText(pUnit).c_str());
+}
+
+// Called as a player's turn begins (CvPlayer::setTurnActive; bNewTurn is false when the turn is
+// made active without its start-of-turn processing). Writes, for a tracked player:
+// I: turn, player, new turn (1) or not (0), its units, foreign cities, their defenders, teams.
+// L: each of its units (see warUnitLine).
+// J: each city of another team with at least one of the player's land units that can attack
+//    within 3 plots: turn, player, owner, x, y, population, defence %, visible to the player,
+//    at war, defenders, its units within 1 plot and within 3 (not on a ship), on ships within 3,
+//    then the assault forecast for the units within 1 and within 3 plots: chance of capture
+//    (per mille) and expected units lost (x100), as if they attacked now, at war, one after
+//    another (AI_assaultForecast; a unit further away is taken as it stands). Its defenders
+//    follow as L lines with the city's owner.
+// O: each team met: turn, player, team, at war, open borders, defensive pact, vassal (1 theirs to
+//    us, 2 ours to them, 0 none), their war plan against us and ours against them (WarPlanTypes),
+//    our war weariness against them.
+// Only plain getters are read, no AI cache and no random number, so the log does not change the game.
+void warLogTurnStart(PlayerTypes ePlayer, bool bNewTurn)
+{
+	PROFILE_FUNC();
+	if (!warLogOn() || !warLogTracked(ePlayer)) return;
+	const CvPlayer& kPlayer = GET_PLAYER(ePlayer);
+	if (!kPlayer.isAlive()) return;
+	const TeamTypes eTeam = kPlayer.getTeam();
+	const int iTurn = GC.getGameINLINE().getGameTurn();
+	std::vector<CvString> aszLines;
+	int iUnits = 0;
+	int iCities = 0;
+	int iDefenders = 0;
+	int iTeams = 0;
+	int iLoop;
+	for (CvUnit* pLoopUnit = kPlayer.firstUnit(&iLoop); pLoopUnit != NULL; pLoopUnit = kPlayer.nextUnit(&iLoop))
+	{
+		aszLines.push_back(warUnitLine(iTurn, ePlayer, pLoopUnit));
+		iUnits++;
+	}
+	for (int iP = 0; iP < MAX_PLAYERS; iP++)
+	{
+		const CvPlayer& kOwner = GET_PLAYER((PlayerTypes)iP);
+		if (!kOwner.isAlive() || kOwner.getTeam() == eTeam) continue;
+		int iCityLoop;
+		for (CvCity* pCity = kOwner.firstCity(&iCityLoop); pCity != NULL; pCity = kOwner.nextCity(&iCityLoop))
+		{
+			const CvPlot* pCityPlot = pCity->plot();
+			std::vector<const CvUnit*> apNear1;
+			std::vector<const CvUnit*> apNear3;
+			int iOnShips = 0;
+			for (int iDX = -3; iDX <= 3; iDX++)
+			{
+				for (int iDY = -3; iDY <= 3; iDY++)
+				{
+					const CvPlot* pLoopPlot = plotXY(pCity->getX_INLINE(), pCity->getY_INLINE(), iDX, iDY);
+					if (pLoopPlot == NULL) continue;
+					for (CLLNode<IDInfo>* pNode = pLoopPlot->headUnitNode(); pNode != NULL; pNode = pLoopPlot->nextUnitNode(pNode))
+					{
+						const CvUnit* pLoopUnit = ::getUnit(pNode->m_data);
+						if (pLoopUnit == NULL || pLoopUnit->getOwnerINLINE() != ePlayer || pLoopUnit->isDead() ||
+							pLoopUnit->getDomainType() != DOMAIN_LAND || !pLoopUnit->canAttack())
+						{
+							continue;
+						}
+						if (pLoopUnit->isCargo())
+						{
+							iOnShips++;
+							continue;
+						}
+						apNear3.push_back(pLoopUnit);
+						if (iDX >= -1 && iDX <= 1 && iDY >= -1 && iDY <= 1)
+						{
+							apNear1.push_back(pLoopUnit);
+						}
+					}
+				}
+			}
+			if (apNear3.empty() && iOnShips == 0) continue;
+			std::vector<const CvUnit*> apDefenders;
+			for (CLLNode<IDInfo>* pNode = pCityPlot->headUnitNode(); pNode != NULL; pNode = pCityPlot->nextUnitNode(pNode))
+			{
+				const CvUnit* pLoopUnit = ::getUnit(pNode->m_data);
+				if (pLoopUnit != NULL && pLoopUnit->getTeam() != eTeam && !pLoopUnit->isDead() && pLoopUnit->getDomainType() == DOMAIN_LAND &&
+					pLoopUnit->canDefend(pCityPlot) && !pLoopUnit->isInvisible(eTeam, false))
+				{
+					apDefenders.push_back(pLoopUnit);
+				}
+			}
+			int iLoss1 = 0;
+			int iLoss3 = 0;
+			const int iCapture1 = apNear1.empty() ? 0 : AI_assaultForecast(pCityPlot, apNear1, apDefenders, &iLoss1);
+			int iCapture3 = iCapture1;
+			iLoss3 = iLoss1;
+			if (apNear3.size() != apNear1.size())
+			{
+				iCapture3 = AI_assaultForecast(pCityPlot, apNear3, apDefenders, &iLoss3);
+			}
+			aszLines.push_back(CvString::format("J\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d", iTurn, ePlayer,
+				iP, pCity->getX_INLINE(), pCity->getY_INLINE(), pCity->getPopulation(), pCity->getDefenseModifier(false),
+				pCityPlot->isVisible(eTeam, false) ? 1 : 0, GET_TEAM(eTeam).isAtWar(kOwner.getTeam()) ? 1 : 0, (int)apDefenders.size(),
+				(int)apNear1.size(), (int)apNear3.size(), iOnShips, iCapture1, iLoss1, iCapture3, iLoss3));
+			iCities++;
+			for (size_t iD = 0; iD < apDefenders.size(); iD++)
+			{
+				aszLines.push_back(warUnitLine(iTurn, ePlayer, apDefenders[iD]));
+				iDefenders++;
+			}
+		}
+	}
+	const CvTeamAI& kTeam = GET_TEAM(eTeam);
+	for (int iT = 0; iT < MAX_CIV_TEAMS; iT++)
+	{
+		const CvTeamAI& kOther = GET_TEAM((TeamTypes)iT);
+		if (iT == eTeam || !kOther.isAlive() || !kTeam.isHasMet((TeamTypes)iT)) continue;
+		aszLines.push_back(CvString::format("O\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d\t%d", iTurn, ePlayer, iT,
+			kTeam.isAtWar((TeamTypes)iT) ? 1 : 0, kTeam.isOpenBorders((TeamTypes)iT) ? 1 : 0, kTeam.isDefensivePact((TeamTypes)iT) ? 1 : 0,
+			kOther.isVassal(eTeam) ? 1 : (kTeam.isVassal((TeamTypes)iT) ? 2 : 0), (int)kOther.AI_getWarPlan(eTeam),
+			(int)kTeam.AI_getWarPlan((TeamTypes)iT), kTeam.getWarWeariness((TeamTypes)iT)));
+		iTeams++;
+	}
+	warLogLine(CvString::format("I\t%d\t%d\t%d\t%d\t%d\t%d\t%d", iTurn, ePlayer, bNewTurn ? 1 : 0, iUnits, iCities, iDefenders, iTeams));
+	for (size_t iL = 0; iL < aszLines.size(); iL++)
+	{
+		warLogLine(aszLines[iL]);
+	}
+}
