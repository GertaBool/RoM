@@ -0,0 +1,98 @@
+#!/usr/bin/env python3
+"""War AI switches (AI_CUNNING_FLAGS), measured in the GertaBool/RoM harness.
+
+Seven behaviours, each behind one bit of AI_CUNNING_FLAGS in
+BBAI_AI_Variables_GlobalDefines.xml, so that each can be measured alone. The
+default, 111, enables all but 16; 0 restores the previous AI exactly:
+- 1: a prepared war starts only when the strike force stands at the border.
+- 2: war targets are chosen by the power each side has in the target's land areas.
+- 4: wars are reviewed by their progress once per period, not on a peace die.
+- 8: the stack bombards with any unit that can, and collateral units open AI
+  assaults.
+- 16: collateral units join city attack stacks and are trained for invasions.
+- 32: an AI at war pays only allies near the enemy to join, and accepts such a
+  request only if it is near the target itself.
+- 64: archers and siege in a city fire ranged strikes at enemies next to it.
+"""
+import re
+import unittest
+from test_review_correctness import DLL, block
+
+
+def src(name):
+    return (DLL / name).read_text(encoding='latin-1')
+
+
+class SwitchTests(unittest.TestCase):
+    def test_switch_default(self):
+        xml = (DLL.parent / 'XML' / 'BBAI_AI_Variables_GlobalDefines.xml').read_text(encoding='latin-1')
+        m = re.search(r'<DefineName>AI_CUNNING_FLAGS</DefineName>\s*<iDefineIntVal>(\d+)</iDefineIntVal>', xml)
+        self.assertIsNotNone(m)
+        self.assertEqual(m.group(1), '111')
+        self.assertIn('GC.getDefineINT("AI_CUNNING_FLAGS") & iFlag', src('CvGameCoreUtils.cpp'))
+
+    def test_every_switch_is_used(self):
+        text = ''.join(src(n) for n in ('CvTeamAI.cpp', 'CvUnitAI.cpp', 'CvSelectionGroup.cpp', 'CvPlayerAI.cpp', 'CvCityAI.cpp'))
+        for flag in (1, 2, 4, 8, 16, 32, 64):
+            self.assertIn('isAICunning(%d)' % flag, text)
+
+
+class WarDecisionTests(unittest.TestCase):
+    def test_prepared_war_waits_for_the_strike_force(self):
+        method = block(src('CvTeamAI.cpp'), 'void CvTeamAI::AI_doWar(')
+        self.assertEqual(method.count('AI_isStrikeForceReady((TeamTypes)iI)'), 2)
+        ready = block(src('CvTeamAI.cpp'), 'bool CvTeamAI::AI_isStrikeForceReady(')
+        self.assertIn('range(40 + (30 * (130 - AI_maxWarNearbyPowerRatio())) / 50, 40, 70)', ready)
+
+    def test_targets_compared_by_reachable_power(self):
+        method = block(src('CvTeamAI.cpp'), 'void CvTeamAI::AI_doWar(')
+        self.assertIn('AI_getReachableDefence()', method)
+        self.assertIn('AI_getReachablePower((TeamTypes)iI)', method)
+        self.assertIn('GET_TEAM((TeamTypes)iJ).AI_getReachablePower((TeamTypes)iI)', method)
+
+    def test_peace_by_review_not_dice(self):
+        method = block(src('CvTeamAI.cpp'), 'void CvTeamAI::AI_doWar(')
+        self.assertIn('AI_reviewWars();', method)
+        review = block(src('CvTeamAI.cpp'), 'void CvTeamAI::AI_reviewWars(')
+        self.assertNotIn('getSorenRandNum', review)
+        self.assertIn('m_aiWarSuccessAtReview[eTeam] = AI_getWarSuccess(eTeam);', review)
+
+    def test_review_state_is_saved(self):
+        read = block(src('CvTeamAI.cpp'), 'void CvTeamAI::read(')
+        write = block(src('CvTeamAI.cpp'), 'void CvTeamAI::write(')
+        self.assertIn('if (uiFlag >= 1)', read)
+        self.assertIn('m_aiEnemyWarSuccessAtReview', read)
+        self.assertIn('uint uiFlag=1;', write)
+        self.assertIn('m_aiEnemyWarSuccessAtReview', write)
+
+    def test_war_requests_need_own_reach(self):
+        method = block(src('CvTeamAI.cpp'), 'DenialTypes CvTeamAI::AI_declareWarTrade(')
+        self.assertIn('if (bConsiderPower && isAICunning(32))', method)
+        self.assertIn('!AI_isNearTarget(eWarTeam) && 2 * iOurReach < iDefence', method)
+        ask = block(src('CvPlayerAI.cpp'), 'void CvPlayerAI::AI_doDiplo(')
+        self.assertIn('AI_isNearTarget((TeamTypes)iJ)', ask)
+
+
+class StackTests(unittest.TestCase):
+    def test_any_siege_unit_bombards(self):
+        method = block(src('CvUnitAI.cpp'), 'bool CvUnitAI::AI_bombardCity(')
+        self.assertIn('pBombarder->bombardTarget(plot())', method)
+
+    def test_city_ranged_units_fire_at_besiegers(self):
+        method = block(src('CvUnitAI.cpp'), 'bool CvUnitAI::AI_update(')
+        i = method.index('isAICunning(64)')
+        self.assertIn('plot()->getOwnerINLINE() == getOwnerINLINE()', method[i:i + 300])
+        self.assertIn('AI_rangeAttack(1)', method[i:i + 400])
+
+    def test_collateral_opens_ai_assaults(self):
+        method = block(src('CvSelectionGroup.cpp'), 'bool CvSelectionGroup::groupAttack(')
+        self.assertIn('(!isHuman() && isAICunning(8)) ? pickCollateralAttacker(', method)
+
+    def test_collateral_units_join_stacks(self):
+        method = block(src('CvUnitAI.cpp'), 'void CvUnitAI::AI_collateralMove(')
+        self.assertIn('AI_group(UNITAI_ATTACK_CITY', method)
+        self.assertIn('invaderTypes.push_back(std::make_pair(UNITAI_COLLATERAL, 40));', src('CvCityAI.cpp'))
+
+
+if __name__ == '__main__':
+    unittest.main()
