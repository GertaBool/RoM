+// Whether enough of the strike force stands at the target's border to start the
+// war: the share of our offensive land units, in areas that hold the target's
+// cities, within three plots of the target's territory. Leaders who want a larger
+// power edge before a war (a lower nearby power ratio) also want more of the army
+// in place: 40 to 70 percent, and at least four units. Overseas targets keep the
+// timer, since their armies gather on transports.
+bool CvTeamAI::AI_isStrikeForceReady(TeamTypes eTarget) const
+{
+	if (!AI_isLandTarget(eTarget))
+	{
+		return true;
+	}
+
+	int iTotal = 0;
+	int iNear = 0;
+	for (int iPlayer = 0; iPlayer < MAX_CIV_PLAYERS; iPlayer++)
+	{
+		CvPlayerAI& kPlayer = GET_PLAYER((PlayerTypes)iPlayer);
+		if (!kPlayer.isAlive() || kPlayer.getTeam() != getID())
+		{
+			continue;
+		}
+		int iLoop;
+		for (CvUnit* pUnit = kPlayer.firstUnit(&iLoop); pUnit != NULL; pUnit = kPlayer.nextUnit(&iLoop))
+		{
+			if (pUnit->getDomainType() != DOMAIN_LAND || pUnit->plot() == NULL || !pUnit->canAttack())
+			{
+				continue;
+			}
+			const UnitAITypes eAI = pUnit->AI_getUnitAIType();
+			if (eAI != UNITAI_ATTACK_CITY && eAI != UNITAI_ATTACK && eAI != UNITAI_COLLATERAL && eAI != UNITAI_COUNTER)
+			{
+				continue;
+			}
+			CvArea* pArea = pUnit->area();
+			if (pArea == NULL || GET_TEAM(eTarget).countNumCitiesByArea(pArea) == 0)
+			{
+				continue;
+			}
+			iTotal++;
+			bool bNear = false;
+			for (int iDX = -3; iDX <= 3 && !bNear; iDX++)
+			{
+				for (int iDY = -3; iDY <= 3 && !bNear; iDY++)
+				{
+					const CvPlot* pLoopPlot = plotXY(pUnit->getX_INLINE(), pUnit->getY_INLINE(), iDX, iDY);
+					bNear = (pLoopPlot != NULL && pLoopPlot->getTeam() == eTarget && pLoopPlot->area() == pArea);
+				}
+			}
+			if (bNear)
+			{
+				iNear++;
+			}
+		}
+	}
+
+	const int iShare = range(40 + (30 * (130 - AI_maxWarNearbyPowerRatio())) / 50, 40, 70);
+	return (iNear >= 4) && (iNear * 100 >= iShare * iTotal);
+}
+
+// Whether we can fight eTarget on land soon: a shared border, or one of our cities
+// within eight plots of one of its cities on the same landmass. A large unclaimed
+// continent makes AI_isLandTarget true for every team on it; this does not.
+bool CvTeamAI::AI_isNearTarget(TeamTypes eTarget) const
+{
+	if (AI_calculateAdjacentLandPlots(eTarget) >= 8)
+	{
+		return true;
+	}
+	for (int iPlayer = 0; iPlayer < MAX_CIV_PLAYERS; iPlayer++)
+	{
+		CvPlayer& kPlayer = GET_PLAYER((PlayerTypes)iPlayer);
+		if (!kPlayer.isAlive() || kPlayer.getTeam() != getID())
+		{
+			continue;
+		}
+		int iLoop;
+		for (CvCity* pCity = kPlayer.firstCity(&iLoop); pCity != NULL; pCity = kPlayer.nextCity(&iLoop))
+		{
+			for (int iOther = 0; iOther < MAX_CIV_PLAYERS; iOther++)
+			{
+				CvPlayer& kOther = GET_PLAYER((PlayerTypes)iOther);
+				if (!kOther.isAlive() || kOther.getTeam() != eTarget)
+				{
+					continue;
+				}
+				int iOtherLoop;
+				for (CvCity* pOther = kOther.firstCity(&iOtherLoop); pOther != NULL; pOther = kOther.nextCity(&iOtherLoop))
+				{
+					if (pOther->area() == pCity->area() &&
+						plotDistance(pCity->getX_INLINE(), pCity->getY_INLINE(), pOther->getX_INLINE(), pOther->getY_INLINE()) <= 8)
+					{
+						return true;
+					}
+				}
+			}
+		}
+	}
+	return false;
+}
+
+namespace
+{
+	// Land unit power of a team and its vassals in the land areas that hold eTarget's cities.
+	int powerInTargetAreas(TeamTypes eTeam, TeamTypes eTarget)
+	{
+		int iPower = 0;
+		int iLoop;
+		for (CvArea* pArea = GC.getMapINLINE().firstArea(&iLoop); pArea != NULL; pArea = GC.getMapINLINE().nextArea(&iLoop))
+		{
+			if (pArea->isWater() || GET_TEAM(eTarget).countNumCitiesByArea(pArea) == 0)
+			{
+				continue;
+			}
+			for (int iTeam = 0; iTeam < MAX_CIV_TEAMS; iTeam++)
+			{
+				const CvTeam& kLoopTeam = GET_TEAM((TeamTypes)iTeam);
+				if (kLoopTeam.isAlive() && (iTeam == eTeam || kLoopTeam.isVassal(eTeam)))
+				{
+					iPower += kLoopTeam.countPowerByArea(pArea);
+				}
+			}
+		}
+		return iPower;
+	}
+}
+
+// The power we can bring against eTarget on land: our units (and our vassals') in
+// the land areas that hold its cities. Garrisons on other continents do not count.
+int CvTeamAI::AI_getReachablePower(TeamTypes eTarget) const
+{
+	return powerInTargetAreas(getID(), eTarget);
+}
+
+// Our defence on land where we can be attacked: the units of the teams in
+// getDefensivePower (ourselves, our master, our defensive pacts, with vassals) in
+// the land areas that hold our cities.
+int CvTeamAI::AI_getReachableDefence() const
+{
+	int iPower = 0;
+	for (int iI = 0; iI < MAX_CIV_TEAMS; iI++)
+	{
+		const CvTeam& kLoopTeam = GET_TEAM((TeamTypes)iI);
+		if (kLoopTeam.isAlive() && !kLoopTeam.isAVassal())
+		{
+			if (getID() == iI || isVassal((TeamTypes)iI) || isDefensivePact((TeamTypes)iI))
+			{
+				iPower += powerInTargetAreas((TeamTypes)iI, getID());
+			}
+		}
+	}
+	return iPower;
+}
+
+// Review each war we chose by its progress, once per review period instead of on a
+// die roll. Patient leaders (a high make-peace rand) review less often. A war that
+// gained us at least a city's worth of war success since the last review, and more
+// than the enemy gained, goes on. Otherwise we make peace if both sides value peace
+// at least half as much as the other does (the "long draw" test).
+void CvTeamAI::AI_reviewWars()
+{
+	const int iPeriod = std::max(1, ((6 + AI_makePeaceRand() / 6) * (50 + GC.getGameSpeedInfo(GC.getGameINLINE().getGameSpeedType()).getTrainPercent())) / 150);
+	const int iCityValue = std::max(1, GC.getDefineINT("WAR_SUCCESS_CITY_CAPTURING"));
+
+	for (int iI = 0; iI < MAX_CIV_TEAMS; iI++)
+	{
+		const TeamTypes eTeam = (TeamTypes)iI;
+		CvTeamAI& kTeam = GET_TEAM(eTeam);
+		if (!kTeam.isAlive() || eTeam == getID() || kTeam.isHuman() || !canContact(eTeam) || !isAtWar(eTeam))
+		{
+			continue;
+		}
+		const int iCounter = AI_getAtWarCounter(eTeam);
+		if (iCounter < iPeriod || (iCounter % iPeriod) != 0)
+		{
+			continue;
+		}
+		const bool bFirst = (iCounter == iPeriod);
+		const int iOurGain = std::max(0, AI_getWarSuccess(eTeam) - (bFirst ? 0 : m_aiWarSuccessAtReview[eTeam]));
+		const int iTheirGain = std::max(0, kTeam.AI_getWarSuccess(getID()) - (bFirst ? 0 : m_aiEnemyWarSuccessAtReview[eTeam]));
+		m_aiWarSuccessAtReview[eTeam] = AI_getWarSuccess(eTeam);
+		m_aiEnemyWarSuccessAtReview[eTeam] = kTeam.AI_getWarSuccess(getID());
+
+		if (!AI_isChosenWar(eTeam))
+		{
+			continue;   // wars made on us end through AI_doPeace
+		}
+		const bool bAloneInDogpile = (AI_getWarPlan(eTeam) == WARPLAN_DOGPILE) && (kTeam.getAtWarCount(true) == 1);
+		if (iOurGain >= iCityValue && iOurGain > iTheirGain && !bAloneInDogpile)
+		{
+			continue;
+		}
+		const int iOurValue = AI_endWarVal(eTeam);
+		const int iTheirValue = kTeam.AI_endWarVal(getID());
+		if (iTheirValue > iOurValue / 2 && (bAloneInDogpile || iOurValue > iTheirValue / 2))
+		{
+			if( gTeamLogLevel >= 1 )
+			{
+				logBBAI("  Team %d (%S) making peace after review: gain %d vs %d over %d turns, endWarVal %d vs their %d", getID(), GET_PLAYER(getLeaderID()).getCivilizationDescription(0), iOurGain, iTheirGain, iPeriod, iOurValue, iTheirValue);
+			}
+			makePeace(eTeam);
+			break;
+		}
+	}
+}
