@@ -4325,6 +4325,61 @@ bool CvSelectionGroup::groupDeclareWar(CvPlot* pPlot, bool bForce)
 
 
 // Returns true if attack was made...
+// The unit to open an AI assault with: while at least two defenders on the plot
+// are unhurt and the best attacker's true odds are below 80, the healthy unit with
+// the most collateral damage softens the stack before the main attackers go in.
+static CvUnit* pickCollateralAttacker(CvSelectionGroup* pGroup, const CvPlot* pPlot, int iTrueOdds, bool bNoBlitz)
+{
+	if (iTrueOdds >= 80)
+	{
+		return NULL;
+	}
+	int iHealthy = 0;
+	CLLNode<IDInfo>* pNode = pPlot->headUnitNode();
+	while (pNode != NULL)
+	{
+		const CvUnit* pLoopUnit = ::getUnit(pNode->m_data);
+		pNode = pPlot->nextUnitNode(pNode);
+		if (pLoopUnit != NULL && pLoopUnit->canDefend() && pLoopUnit->getDamage() == 0 &&
+			GET_TEAM(pGroup->getTeam()).isAtWar(pLoopUnit->getTeam()))
+		{
+			iHealthy++;
+		}
+	}
+	if (iHealthy < 2)
+	{
+		return NULL;
+	}
+	CvUnit* pBest = NULL;
+	int iBestValue = 0;
+	pNode = pGroup->headUnitNode();
+	while (pNode != NULL)
+	{
+		CvUnit* pLoopUnit = ::getUnit(pNode->m_data);
+		pNode = pGroup->nextUnitNode(pNode);
+		if (pLoopUnit == NULL || pLoopUnit->isDead() || pLoopUnit->collateralDamage() <= 0 || !pLoopUnit->canAttack() || !pLoopUnit->canMove())
+		{
+			continue;
+		}
+		if (bNoBlitz && pLoopUnit->isBlitz() && pLoopUnit->isMadeAttack())
+		{
+			continue;
+		}
+		if (pLoopUnit->getDamage() * 2 > pLoopUnit->maxHitPoints() || !pLoopUnit->canMoveInto(pPlot, true))
+		{
+			continue;
+		}
+		const int iValue = pLoopUnit->collateralDamage() * std::min(iHealthy - 1, std::max(1, pLoopUnit->collateralDamageMaxUnits())) *
+			pLoopUnit->currHitPoints() / std::max(1, pLoopUnit->maxHitPoints());
+		if (iValue > iBestValue)
+		{
+			iBestValue = iValue;
+			pBest = pLoopUnit;
+		}
+	}
+	return pBest;
+}
