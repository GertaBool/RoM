+// Graphics paging: units, cities and plot symbols far from where the camera looks keep only a
+// bare entity or no symbol; they are set up again when the camera comes near. Graphics only.
+bool CvGame::isGraphicsPaging() const
+{
+	return m_bGraphicsPaging;
+}
+
+bool CvGame::isInGraphicsWindow(int iX, int iY, bool bMargin) const
+{
+	if (!m_bGraphicsPaging)
+	{
+		return true;
+	}
+
+	int iMargin = (bMargin ? m_iPagingMargin : 0);
+	int iDX = dxWrap(iX - m_iPagingX);
+	int iDY = dyWrap(iY - m_iPagingY);
+
+	return (abs(iDX) <= m_iPagingRangeX + iMargin) && (iDY <= m_iPagingNorth + iMargin) && (-iDY <= m_iPagingSouth + iMargin);
+}
+
+void CvGame::updateGraphicsPaging()
+{
+	PROFILE_FUNC();
+
+	if (!GC.IsGraphicsInitialized())
+	{
+		m_bGraphicsPaging = false;
+		return;
+	}
+
+	CvPlot* pLookAt = gDLL->getInterfaceIFace()->getLookAtPlot();
+	bool bOn = (GC.getDefineINT("GRAPHICS_PAGING") > 0) && (pLookAt != NULL) && !gDLL->GetWorldBuilderMode() && (getActivePlayer() != NO_PLAYER);
+
+	if (!bOn)
+	{
+		if (m_bGraphicsPaging)
+		{
+			pageGraphics(true);
+		}
+		return;
+	}
+
+	DWORD dwNow = GetTickCount();
+	bool bFirst = !m_bGraphicsPaging;
+	bool bMoved = bFirst || (abs(dxWrap(pLookAt->getX_INLINE() - m_iPagingX)) >= m_iPagingStep) || (abs(dyWrap(pLookAt->getY_INLINE() - m_iPagingY)) >= m_iPagingStep);
+	bool bActivePlayerChanged = (getActivePlayer() != m_ePagingActivePlayer);
+
+	if (!bMoved && !bActivePlayerChanged && (dwNow - m_dwPagingTime) < (DWORD)std::max(100, GC.getDefineINT("GRAPHICS_PAGING_INTERVAL_MS")))
+	{
+		return;
+	}
+
+	// The window: GRAPHICS_PAGING_RANGE_* plots from the look-at plot at the widest zoom, scaled down
+	// with the camera's zoom (CyCamera().GetZoom(), 0 to 1, larger is farther) when GRAPHICS_PAGING_ZOOM is set.
+	int iScalePercent = 100;
+	int iZoom = -1;
+	static bool s_bZoomFailed = false;	// a game without CvGameInterface.getCameraZoom: ask once
+	if (GC.getDefineINT("GRAPHICS_PAGING_ZOOM") > 0 && !s_bZoomFailed)
+	{
+		long lResult = -1;
+		CyArgsList argsList;
+		if (gDLL->getPythonIFace()->callFunction(PYGameModule, "getCameraZoom", argsList.makeFunctionArgs(), &lResult))
+		{
+			iZoom = (int)lResult;
+		}
+		else
+		{
+			s_bZoomFailed = true;
+		}
+		if (iZoom >= 0 && iZoom <= 1000)
+		{
+			iScalePercent = (iZoom * GC.getDefineINT("GRAPHICS_PAGING_ZOOM_SAFETY_PERCENT")) / 1000;
+			iScalePercent = range(iScalePercent, GC.getDefineINT("GRAPHICS_PAGING_ZOOM_MIN_PERCENT"), 100);
+		}
+	}
+
+	int iRangeX = std::max(1, (GC.getDefineINT("GRAPHICS_PAGING_RANGE_X") * iScalePercent + 99) / 100);
+	int iNorth = std::max(1, (GC.getDefineINT("GRAPHICS_PAGING_RANGE_NORTH") * iScalePercent + 99) / 100);
+	int iSouth = std::max(1, (GC.getDefineINT("GRAPHICS_PAGING_RANGE_SOUTH") * iScalePercent + 99) / 100);
+
+	m_bGraphicsPaging = true;
+	if (bMoved)
+	{
+		m_iPagingX = pLookAt->getX_INLINE();
+		m_iPagingY = pLookAt->getY_INLINE();
+	}
+	m_iPagingRangeX = iRangeX;
+	m_iPagingNorth = iNorth;
+	m_iPagingSouth = iSouth;
+	m_iPagingMargin = std::max(0, GC.getDefineINT("GRAPHICS_PAGING_MARGIN"));
+	m_iPagingStep = std::max(1, GC.getDefineINT("GRAPHICS_PAGING_STEP"));
+	m_ePagingActivePlayer = getActivePlayer();
+	m_dwPagingTime = dwNow;
+
+	if (GC.getDefineINT("GRAPHICS_PAGING_LOG") > 0 && (bMoved || bActivePlayerChanged))
+	{
+		CvString szLine;
+		szLine.Format("turn %d look (%d,%d) zoom %d scale %d%%: window x %d north %d south %d margin %d",
+			getGameTurn(), m_iPagingX, m_iPagingY, iZoom, iScalePercent, m_iPagingRangeX, m_iPagingNorth, m_iPagingSouth, m_iPagingMargin);
+		gDLL->logMsg("GraphicsPaging.log", szLine.c_str(), false, true);
+	}
+
+	pageGraphics(false);
+}
+
+// bAllIn: set everything up again and stop paging. Otherwise page in what is inside the window
+// and page out what is outside the window and its margin; what is in the margin stays as it is.
+void CvGame::pageGraphics(bool bAllIn)
+{
+	PROFILE_FUNC();
+
+	int aiIn[3] = {0, 0, 0};
+	int aiOut[3] = {0, 0, 0};
+	int aiPagedOut[3] = {0, 0, 0};
+	CvMap& kMap = GC.getMapINLINE();
+
+	if (bAllIn)
+	{
+		m_bGraphicsPaging = false;
+	}
+
+	for (int iI = 0; iI < kMap.numPlotsINLINE(); iI++)
+	{
+		CvPlot* pPlot = kMap.plotByIndexINLINE(iI);
+		int iX = pPlot->getX_INLINE();
+		int iY = pPlot->getY_INLINE();
+		int iWant = 0;	// 1 in, -1 out, 0 leave
+
+		if (bAllIn || isInGraphicsWindow(iX, iY, false))
+		{
+			iWant = 1;
+		}
+		else if (!isInGraphicsWindow(iX, iY, true))
+		{
+			iWant = -1;
+		}
+
+		if (iWant != 0)
+		{
+			bool bIn = (iWant > 0);
+			if (pPlot->pageGraphics(bIn))
+			{
+				(bIn ? aiIn : aiOut)[0]++;
+			}
+
+			CLLNode<IDInfo>* pUnitNode = pPlot->headUnitNode();
+			while (pUnitNode != NULL)
+			{
+				CvUnit* pLoopUnit = ::getUnit(pUnitNode->m_data);
+				pUnitNode = pPlot->nextUnitNode(pUnitNode);
+
+				if (pLoopUnit != NULL && pLoopUnit->pageGraphics(bIn))
+				{
+					(bIn ? aiIn : aiOut)[1]++;
+				}
+			}
+
+			CvCity* pCity = pPlot->getPlotCity();
+			if (pCity != NULL && pCity->pageGraphics(bIn))
+			{
+				(bIn ? aiIn : aiOut)[2]++;
+			}
+		}
+
+		if (pPlot->isGraphicsPagedOut())
+		{
+			aiPagedOut[0]++;
+		}
+		CLLNode<IDInfo>* pUnitNode = pPlot->headUnitNode();
+		while (pUnitNode != NULL)
+		{
+			CvUnit* pLoopUnit = ::getUnit(pUnitNode->m_data);
+			pUnitNode = pPlot->nextUnitNode(pUnitNode);
+			if (pLoopUnit != NULL && pLoopUnit->isGraphicsPagedOut())
+			{
+				aiPagedOut[1]++;
+			}
+		}
+		if (pPlot->getPlotCity() != NULL && pPlot->getPlotCity()->isGraphicsPagedOut())
+		{
+			aiPagedOut[2]++;
+		}
+	}
+
+	// The active player's units and cities stay in wherever they are; when the active player
+	// changes (hotseat), bring in the new one's.
+	if (!bAllIn && getActivePlayer() != NO_PLAYER)
+	{
+		CvPlayer& kActive = GET_PLAYER(getActivePlayer());
+		int iLoop;
+		for (CvUnit* pLoopUnit = kActive.firstUnit(&iLoop); pLoopUnit != NULL; pLoopUnit = kActive.nextUnit(&iLoop))
+		{
+			if (pLoopUnit->isGraphicsPagedOut() && pLoopUnit->pageGraphics(true))
+			{
+				aiIn[1]++;
+				aiPagedOut[1]--;
+			}
+		}
+		for (CvCity* pLoopCity = kActive.firstCity(&iLoop); pLoopCity != NULL; pLoopCity = kActive.nextCity(&iLoop))
+		{
+			if (pLoopCity->isGraphicsPagedOut() && pLoopCity->pageGraphics(true))
+			{
+				aiIn[2]++;
+				aiPagedOut[2]--;
+			}
+		}
+	}
+
+	if (GC.getDefineINT("GRAPHICS_PAGING_LOG") > 0 && (aiIn[0] + aiIn[1] + aiIn[2] + aiOut[0] + aiOut[1] + aiOut[2]) > 0)
+	{
+		CvString szLine;
+		szLine.Format("turn %d look (%d,%d) %s: in plots %d units %d cities %d, out plots %d units %d cities %d; paged out plots %d units %d cities %d",
+			getGameTurn(), m_iPagingX, m_iPagingY, bAllIn ? "all in" : "pass",
+			aiIn[0], aiIn[1], aiIn[2], aiOut[0], aiOut[1], aiOut[2], aiPagedOut[0], aiPagedOut[1], aiPagedOut[2]);
+		gDLL->logMsg("GraphicsPaging.log", szLine.c_str(), false, true);
+	}
+}
+
