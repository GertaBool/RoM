+// Graphics paging. The active player's units, and units fighting or dying, are never paged out.
+bool CvUnit::canPageGraphicsOut() const
+{
+	if (plot() == NULL || getOwnerINLINE() == NO_PLAYER || getOwnerINLINE() == GC.getGameINLINE().getActivePlayer())
+	{
+		return false;
+	}
+
+	return !isFighting() && getCombatUnit() == NULL && getAttackPlot() == NULL && !isDelayedDeath() && !isCombatFocus();
+}
+
+// Out: the entity is removed and replaced by a bare one, as the constructor makes it. In: it is set up as setupGraphical does.
+bool CvUnit::pageGraphics(bool bIn)
+{
+	if (!GC.IsGraphicsInitialized() || gDLL->GetDone())
+	{
+		return false;
+	}
+
+	if (bIn)
+	{
+		if (!m_bGraphicsPagedOut || plot() == NULL)
+		{
+			return false;
+		}
+
+		m_bGraphicsPagedOut = false;
+		CvDLLEntity::setup();
+		if (getGroup()->getActivityType() == ACTIVITY_INTERCEPT)
+		{
+			airCircle(true);
+		}
+		gDLL->getEntityIFace()->updateEnemyGlow(getUnitEntity());
+		return true;
+	}
+
+	if (m_bGraphicsPagedOut || !canPageGraphicsOut())
+	{
+		return false;
+	}
+
+	gDLL->getEntityIFace()->RemoveUnitFromBattle(this);
+	CvDLLEntity::removeEntity();
+	CvDLLEntity::destroyEntity();
+	CvDLLEntity::createUnitEntity(this);
+	m_bGraphicsPagedOut = true;
+	return true;
+}
