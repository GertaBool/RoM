 		<DefineName>AIAUTOPLAY_CANCEL_ON_LOAD</DefineName>
 		<iDefineIntVal>1</iDefineIntVal>
 	</Define>
+<!-- Graphics paging (CvGame::updateGraphicsPaging) -->
+	<!-- Graphics paging: 1 keeps unit, city and plot graphics only near where the camera looks; 0 keeps them everywhere -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING</DefineName>
+		<iDefineIntVal>1</iDefineIntVal>
+	</Define>
+	<!-- plots east and west of the look-at plot, at the widest zoom -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING_RANGE_X</DefineName>
+		<iDefineIntVal>40</iDefineIntVal>
+	</Define>
+	<!-- plots north (the far side of the screen), at the widest zoom -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING_RANGE_NORTH</DefineName>
+		<iDefineIntVal>40</iDefineIntVal>
+	</Define>
+	<!-- plots south, at the widest zoom -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING_RANGE_SOUTH</DefineName>
+		<iDefineIntVal>16</iDefineIntVal>
+	</Define>
+	<!-- plots beyond the window that keep whatever graphics they have, so a camera moving back and forth does not rebuild -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING_MARGIN</DefineName>
+		<iDefineIntVal>4</iDefineIntVal>
+	</Define>
+	<!-- plots the camera moves before the window follows at once -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING_STEP</DefineName>
+		<iDefineIntVal>2</iDefineIntVal>
+	</Define>
+	<!-- milliseconds between passes while the camera stands still -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING_INTERVAL_MS</DefineName>
+		<iDefineIntVal>500</iDefineIntVal>
+	</Define>
+	<!-- 1 scales the window with the camera zoom (0 to 1); 0 keeps it at the widest-zoom size -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING_ZOOM</DefineName>
+		<iDefineIntVal>1</iDefineIntVal>
+	</Define>
+	<!-- the window at zoom z is z times this percent of the widest, at most 100 -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING_ZOOM_SAFETY_PERCENT</DefineName>
+		<iDefineIntVal>150</iDefineIntVal>
+	</Define>
+	<!-- the window is never smaller than this percent of the widest -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING_ZOOM_MIN_PERCENT</DefineName>
+		<iDefineIntVal>35</iDefineIntVal>
+	</Define>
+	<!-- 1 writes the window and the counts of each pass to Logs/GraphicsPaging.log (needs logging on) -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING_LOG</DefineName>
+		<iDefineIntVal>0</iDefineIntVal>
+	</Define>
