--- a/Assets/CvGameCoreDLL/CvCity.cpp
+++ b/Assets/CvGameCoreDLL/CvCity.cpp
@@ -741,12 +741,62 @@ void CvCity::setupGraphical()
 		return;
 	}
 
+	// Graphics paging: far from the camera the city keeps a bare entity until the camera comes near.
+	if (GC.getGameINLINE().isGraphicsPaging() && canPageGraphicsOut() && !GC.getGameINLINE().isInGraphicsWindow(getX_INLINE(), getY_INLINE(), true))
+	{
+		pageGraphics(false);
+		return;
+	}
+
+	m_bGraphicsPagedOut = false;
 	CvDLLEntity::setup();
 
 	setInfoDirty(true);
 	setLayoutDirty(true);
 }
 
+// Graphics paging. The active player's cities are never paged out.
+bool CvCity::canPageGraphicsOut() const
+{
+	return getOwnerINLINE() != NO_PLAYER && getOwnerINLINE() != GC.getGameINLINE().getActivePlayer() && plot() != NULL;
+}
+
+// Out: the entity is removed and replaced by a bare one, as the constructor makes it, and the
+// executable sees no dirty billboard or layout. In: it is set up as setupGraphical does.
+bool CvCity::pageGraphics(bool bIn)
+{
+	if (!GC.IsGraphicsInitialized() || gDLL->GetDone())
+	{
+		return false;
+	}
+
+	if (bIn)
+	{
+		if (!m_bGraphicsPagedOut)
+		{
+			return false;
+		}
+
+		m_bGraphicsPagedOut = false;
+		CvDLLEntity::setup();
+		setInfoDirty(true);
+		setLayoutDirty(true);
+		updateVisibility();
+		return true;
+	}
+
+	if (m_bGraphicsPagedOut || !canPageGraphicsOut())
+	{
+		return false;
+	}
+
+	CvDLLEntity::removeEntity();
+	CvDLLEntity::destroyEntity();
+	CvDLLEntity::createCityEntity(this);
+	m_bGraphicsPagedOut = true;
+	return true;
+}
+
