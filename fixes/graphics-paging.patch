+// Hands a mission to the engine. A unit in it whose graphics are paged out gets them back when
+// the mission's plot is visible to the active team; otherwise the mission, only a visual, is skipped.
+void addEntityMission(const CvMissionDefinition* pMission)
+{
+	const CvPlot* pPlot = pMission->getPlot();
+	bool bVisible = (pPlot != NULL) && pPlot->isActiveVisible(false);
