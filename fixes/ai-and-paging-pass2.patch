diff --git a/Assets/CvGameCoreDLL/AIDiplomacyPolicy.h b/Assets/CvGameCoreDLL/AIDiplomacyPolicy.h
index 4c48a8b..d6d964a 100644
--- a/Assets/CvGameCoreDLL/AIDiplomacyPolicy.h
+++ b/Assets/CvGameCoreDLL/AIDiplomacyPolicy.h
@@ -102,6 +102,50 @@ inline int maxAffordableGoldPerTurn(int maxValue, int maxGoldPerTurn, int goldVa
 	}
 	return iLow;
 }
+
+// 64-bit ratio scaling for callers whose intermediate numerator or denominator
+// products can exceed 32-bit int (e.g. late-game RoM team power >= 10^7).
+inline int scaleByRatio64(long long value, long long numerator, long long denominator)
+{
+	const long long denom = (denominator > 0) ? denominator : (long long)1;
+	const long long result = (value * numerator) / denom;
+	return result < INT_MIN ? INT_MIN : (result > INT_MAX ? INT_MAX : (int)result);
+}
+
+// (100 * numerator) / max(1, denominator) in 64 bits, saturated to int.
+inline int powerRatioPercent(int numerator, int denominator)
+{
+	const long long denom = (denominator > 0) ? (long long)denominator : (long long)1;
+	const long long result = ((long long)numerator * 100) / denom;
+	return result < INT_MIN ? INT_MIN : (result > INT_MAX ? INT_MAX : (int)result);
+}
+
+// Overflow-free comparison of (leftWeight * leftVal) > (rightWeight * rightVal).
+inline bool isWeightedGreater(long long leftWeight, long long leftVal,
+	long long rightWeight, long long rightVal)
+{
+	return (leftWeight * leftVal) > (rightWeight * rightVal);
+}
+
+// Reservation price for selling/renewing a resource: seller's own marginal cost
+// plus ``sharePercent``% of positive buyer surplus. Ensures spare resources
+// cannot be bought for 1 GPT while leaving gains from trade for both sides.
+inline int resourceReservationVal(int ourLoss, int buyerVal, int sharePercent)
+{
+	const long long iLoss = (ourLoss > 0) ? (long long)ourLoss : (long long)0;
+	if (buyerVal <= iLoss || sharePercent <= 0)
+	{
+		return (iLoss > INT_MAX) ? INT_MAX : (int)iLoss;
+	}
+	const long long iSurplus = (long long)buyerVal - iLoss;
+	long long iShare = (iSurplus * sharePercent) / 100;
+	if (iShare <= 0)
+	{
+		iShare = 1;
+	}
+	const long long iPrice = iLoss + iShare;
+	return (iPrice > INT_MAX) ? INT_MAX : (int)iPrice;
+}
 }
 
 #endif
