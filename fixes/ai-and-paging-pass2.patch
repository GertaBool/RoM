+// Reservation price for exporting or continuing to export one resource copy.
+// For a new deal (iChange >= 0), our cost is losing one copy (-1) and the buyer
+// gains (+1); strategic resources (unlocking units/buildings/routes) demand at
+// least 50% of surplus from non-friendly, non-vassal buyers. For a standing deal
+// under renewal (iChange < 0), our opportunity cost is regaining our exported
+// copy (+1, which is 0 while we still have a spare copy, or full value if our
+// own copy was lost) and the buyer's stake is losing it (-1).
+int CvPlayerAI::AI_resourceReservationVal(BonusTypes eBonus, PlayerTypes ePlayer, int iChange, int iSharePercent) const
+{
+	const int iOurCost = AI_bonusTradeVal(eBonus, ePlayer, (iChange < 0) ? 1 : -1);
+	const int iBuyerVal = GET_PLAYER(ePlayer).AI_bonusTradeVal(eBonus, getID(), (iChange < 0) ? -1 : 1);
+	int iEffectiveShare = iSharePercent;
+	if (iChange >= 0 && iEffectiveShare > 0 && iEffectiveShare < 50 &&
+		GET_PLAYER(ePlayer).AI_bonusUnlockVal(eBonus) > 0 &&
+		!GET_TEAM(GET_PLAYER(ePlayer).getTeam()).isVassal(getTeam()) &&
+		AI_getAttitude(ePlayer) < ATTITUDE_FRIENDLY)
+	{
+		iEffectiveShare = 50;
+	}
+	return AIDiplomacyPolicy::resourceReservationVal(iOurCost, iBuyerVal, iEffectiveShare);
+}
+
+int CvPlayerAI::AI_tradeReservationVal(PlayerTypes ePlayer, const CLinkList<TradeData>* pList, int iChange, int iSharePercent) const
+{
+	FAssertMsg(ePlayer != getID(), "shouldn't call this function on ourselves");
+
+	long long iValue = GET_PLAYER(ePlayer).AI_dealVal(getID(), pList, false, iChange);
+	for (CLLNode<TradeData>* pNode = pList->head(); pNode != NULL; pNode = pList->next(pNode))
+	{
+		const int iData = pNode->m_data.m_iData;
+		switch (pNode->m_data.m_eItemType)
+		{
+		case TRADE_RESOURCES:
+			iValue -= GET_PLAYER(ePlayer).AI_bonusTradeVal((BonusTypes)iData, getID(), iChange);
+			iValue += AI_resourceReservationVal((BonusTypes)iData, ePlayer, iChange, iSharePercent);
+			break;
+		case TRADE_GOLD:
+			iValue -= AIDiplomacyPolicy::valueFromGold(iData,
+				GET_PLAYER(ePlayer).AI_goldTradeValuePercent());
+			iValue += AIDiplomacyPolicy::valueFromGold(iData, AI_goldTradeValuePercent());
+			break;
+		case TRADE_GOLD_PER_TURN:
+			iValue -= GET_PLAYER(ePlayer).AI_goldPerTurnTradeVal(iData);
+			iValue += AI_goldPerTurnCostVal(iData);
+			break;
+		}
+	}
+
+	return (iValue <= 0) ? 0 : ((iValue >= MAX_INT) ? MAX_INT : (int)iValue);
+}
