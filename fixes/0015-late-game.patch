diff --git a/Tools/test_late_game_fixes.py b/Tools/test_late_game_fixes.py
new file mode 100644
index 0000000..ec5b830
--- /dev/null
+++ b/Tools/test_late_game_fixes.py
@@ -0,0 +1,56 @@
+#!/usr/bin/env python3
+"""Late-game turn time, and a reloaded game that plays like the running one.
+
+Measured in the GertaBool/RoM toolchain/harness from a Marathon snapshot at turn
+400 (342 cities, 1,800 units): CvCity::canTrain took a fifth of the turn.
+AI_buildingValueThreshold asked, for every building and every unit combat
+type, whether the city could train any unit of that type (a scan over all unit
+classes) before looking at whether the building gives that type any
+experience; AI_bestUnitAI asked canTrain and AI_unitValue twice for every unit.
+Both now give the same answers with half the calls or fewer (the snapshot
+plays out identically; the turn takes 17 percent less time).
+
+A game saved at the start of a turn and loaded again played differently from
+the game that saved it. AI_getAnyPlotDanger flagged plots as border danger for
+the enemy team and on the enemy's plot, where nothing was known; the flags
+are not saved and were cleared only by war, peace or a nearby owner change, so
+the running game kept marking safe plots as dangerous and a reloaded game did
+not. In multiplayer a rejoining player would go out of sync.
+"""
+import unittest
+from test_review_correctness import DLL, block
+
+
+def src(name):
+    return (DLL / name).read_text(encoding='latin-1')
+
+
+class TurnTimeTests(unittest.TestCase):
+    def test_building_experience_checked_before_can_train(self):
+        method = block(src('CvCityAI.cpp'), 'int CvCityAI::AI_buildingValueThreshold(')
+        self.assertIn('kBuilding.getUnitCombatFreeExperience(iI) != 0 && canTrain((UnitCombatTypes)iI)', method)
+        self.assertIn('kBuilding.getUnitCombatFreeExperience(iCombatType) != 0 && kUnitInfo.getDomainType() == DOMAIN_SEA && canTrain(eUnit)',
+                      method)
+
+    def test_best_unit_asks_once_per_unit(self):
+        method = block(src('CvCityAI.cpp'), 'UnitTypes CvCityAI::AI_bestUnitAI(')
+        self.assertEqual(method.count('canTrain(eLoopUnit)'), 1)
+        self.assertEqual(method.count('AI_unitValue(eLoopUnit, eUnitAI, area())'), 1)
+        self.assertIn('if (aiOriginalValue[iI] >= 0)', method)
+
+
+class SaveConsistencyTests(unittest.TestCase):
+    def test_border_danger_flags_only_what_is_known(self):
+        method = block(src('CvPlayerAI.cpp'), 'bool CvPlayerAI::AI_getAnyPlotDanger(')
+        self.assertEqual(method.count('setIsTeamBorderCache('), 1)
+        self.assertIn('pPlot->setIsTeamBorderCache(eTeam, true);', method)
+        self.assertNotIn('pLoopPlot->setIsTeamBorderCache', method)
+
+    def test_border_danger_flags_cleared_each_turn(self):
+        method = block(src('CvGame.cpp'), 'void CvGame::doTurn()')
+        self.assertIn('->invalidateIsTeamBorderCache();', method)
+        self.assertLess(method.index('->invalidateIsTeamBorderCache();'), method.index('GET_TEAM((TeamTypes)iI).doTurn();'))
+
+
+if __name__ == '__main__':
+    unittest.main()
