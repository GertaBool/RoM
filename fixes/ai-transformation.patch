--- /dev/null
+++ b/Assets/CvGameCoreDLL/AIStrategicDefensePolicy.h
@@ -0,0 +1,78 @@
+// Pure deterministic C++03 policies for peacetime staged-army deterrence,
+// Open Borders revocation, anti-hegemon balance-of-power coalitions,
+// and active counterstroke posture. No engine dependencies.
+#ifndef AI_STRATEGIC_DEFENSE_POLICY_H
+#define AI_STRATEGIC_DEFENSE_POLICY_H
+
+#include <algorithm>
+#include <climits>
+
+namespace AIStrategicDefensePolicy
+{
+inline int clamp(int iVal, int iLow, int iHigh)
+{
+	return iVal < iLow ? iLow : (iVal > iHigh ? iHigh : iVal);
+}
+
+// Computes extra garrison defenders needed when a non-allied foreign stack
+// (peacetime border buildup or offshore loaded transports) threatens a city.
+inline int stagedGarrisonDeficit(int iStagedAttackStrength, int iPresentDefenseStrength, int iCurrentDefenders)
+{
+	if (iStagedAttackStrength <= 0) return 0;
+	// Require ~1.25x effective defense coverage against visible staged attackers.
+	const int iNeededDefense = (iStagedAttackStrength * 5) / 4;
+	if (iPresentDefenseStrength >= iNeededDefense) return 0;
+	const int iAvgDefenderStr = (iCurrentDefenders > 0 && iPresentDefenseStrength > 0)
+		? std::max(1, iPresentDefenseStrength / iCurrentDefenders)
+		: std::max(1, iStagedAttackStrength / 3);
+	const int iGap = iNeededDefense - iPresentDefenseStrength;
+	const int iExtra = (iGap + iAvgDefenderStr - 1) / iAvgDefenderStr;
+	return clamp(iExtra, 1, 6);
+}
+
+// True when a non-Friendly, non-vassal neighbor with Open Borders has massed
+// enough combat power near our cities to threaten a turn-1 surprise capture.
+inline bool shouldCancelOpenBordersForStaging(int iStagedStrength, int iBestLocalDefense,
+	bool bIsFriendly, bool bIsVassalOrMaster, bool bAtWar)
+{
+	if (bIsFriendly || bIsVassalOrMaster || bAtWar) return false;
+	if (iStagedStrength <= 0) return false;
+	// Cancel once staged attack power exceeds 90% of local garrison strength.
+	return iStagedStrength * 10 >= (iBestLocalDefense > 0 ? iBestLocalDefense * 9 : 10);
+}
+
+// Detects a runaway hegemon that warrants a prospective balance-of-power coalition:
+// >33% of all met teams' power, >32% of all met teams' score (with >= 3 met teams),
+// or active Victory Level 3 alert.
+inline bool isHegemonThreat(long long iTargetPower, long long iTotalMetPower,
+	long long iTargetScore, long long iTotalMetScore, int iAliveMetTeams, bool bVictoryLevel3)
+{
+	if (bVictoryLevel3) return true;
+	if (iAliveMetTeams < 3) return false;
+	if (iTotalMetPower > 0 && iTargetPower * 100 >= iTotalMetPower * 33) return true;
+	if (iTotalMetScore > 0 && iTargetScore * 100 >= iTotalMetScore * 32) return true;
+	return false;
+}
+
+// 64-bit coalition power gate: combined reachable power of willing coalition members
+// must match the hegemon's reachable defense scaled by iRequiredPercent (e.g. 115%).
+inline bool coalitionCanMatchTarget(long long iCoalitionReachablePower, long long iTargetDefence, int iRequiredPercent)
+{
+	if (iCoalitionReachablePower <= 0) return false;
+	if (iTargetDefence <= 0) return true;
+	const long long iPct = clamp(iRequiredPercent, 50, 300);
+	return iCoalitionReachablePower * 100 >= iTargetDefence * iPct;
+}
+
+// Prevents full AREAAI_DEFENSIVE paralysis when our area power is still competitive
+// enough to strike invading columns on open ground or counter-raid undefended cities.
+inline bool defensiveCounterstrokeAllowed(int iOurAreaPower, int iEnemyAreaPower, int iWarSuccessCapitulationRatio)
+{
+	if (iEnemyAreaPower <= 0) return true;
+	if (iWarSuccessCapitulationRatio < -50) return false;
+	// Allow active massing/counterstroke down to 65% of enemy area power.
+	return (long long)iOurAreaPower * 100 >= (long long)iEnemyAreaPower * 65;
+}
+}
+
+#endif
