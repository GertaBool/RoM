From 0fabccdb17a7ee715d26785cc51725bf18a1a3de Mon Sep 17 00:00:00 2001
From: GertaBool <67003432+GertaBool@users.noreply.github.com>
Date: Mon, 23 Nov 2026 21:55:00 +0000
Subject: [PATCH] 5-pass RoM AI transformation (Passes 3-7 over pass 2 f0d5629)

Cumulative save-compatible patch over pass 2 (f0d5629):
1. Pass 3 (unconditional bug fixes & AI parity):
   - Deterministic C++ Colonist/Pioneer/Roman Colonist founding packages in
     CvUnit::found() + removal of UI-dependent CyInterface().getHeadSelectedUnit()
     block in RoMEventManager.py + AI_unitValue UNITAI_SETTLE parity.
   - Fix AI_bonusTrade luxury/general resource misclassification as strategic.
   - Count slider-diverted commerce in AI_isFinancialTrouble; exclude
     UNITAI_COLLATERAL/DEFENSE_AIR from AI_getTotalFloatingDefenders.
   - Fix setUpgradeAnywhere(false) and processCivics trait/civic recomputation.
   - Fix AI_assaultForecast capture check for 1-move final attackers.
   - 64-bit AI_specialistValue GPP; fix FreeBonus scaling, Pass-0 BonusYield,
     and hoisted isProductionProject() in CvCityAI.
   - Fix AI_makePeaceTrade, AI_getTechMonopolyValue, and remaining 64-bit power
     overflows in AI_doWar.
   - Fix settler escort drop, worker Needed/Have inversion & fort preemption,
     4x road dead-code bug, sea escort arg, Inquisition return, nuke/nukeRange
     targeting, and DCM bombard null/random/flag bugs.
2. Pass 4 (economic & building-line mastery, AI_ECONOMY_FLAGS=15):
   - Add AIBuildingLinePolicy.h and isAIEconomy() flag helper.
   - Net-delta building replacement valuation across RoM's 29 upgrade lines,
     per-city BuildingClassNeededs chain lookahead, obsolescence decay, Golden
     Age/military/Python-scripted Wonders, Peasantry/RevIdx civic co-evaluation,
     GameSpeed civic horizon, inflation-adjusted corporation net profit, and
     multi-pair surplus luxury swaps.
3. Pass 5 (strategic defense & diplomacy, AI_CUNNING_FLAGS=1023):
   - Add AIStrategicDefensePolicy.h (bits 128/256/512).
   - Peacetime border & offshore staged-army deterrence, proactive Open Borders
     revocation on lethal staging, prospective anti-hegemon coalitions and
     Victory-Level-3 prevention, defensive counterstroke posture, and
     deterministic AI_doPeace demands.
4. Pass 6 (city specialization & tech lookahead):
   - Activate City Governor specialization & 50% Process parity, negative-food
     Slave starvation guard, Financial/Agricultural yield thresholds,
     FirstFreeUnitClass/TechCityTrade/DisableTechs tech scoring, and depth-5/6
     research lookahead.
5. Pass 7 (tactical combat & execution mastery):
   - Priority-ranked unit upgrades, 65% hero odds floor, non-stall siege
     bombard, wartime promotion banking for +50% field heal, transport cargo
     promotions (PROMOTION_TRANSPORT1/2/3), and combat engineer road building.
---
diff --git a/Assets/CvGameCoreDLL/AIBuildingLinePolicy.h b/Assets/CvGameCoreDLL/AIBuildingLinePolicy.h
new file mode 100644
index 0000000..37a49c3
--- /dev/null
+++ b/Assets/CvGameCoreDLL/AIBuildingLinePolicy.h
@@ -0,0 +1,152 @@
+// Pure deterministic C++03 policies for RoM building upgrade lines,
+// prerequisite chains, Python-scripted wonders, civic-speed scaling,
+// and corporation net-profit economics. No engine dependencies.
+#ifndef AI_BUILDING_LINE_POLICY_H
+#define AI_BUILDING_LINE_POLICY_H
+
+#include <climits>
+
+namespace AIBuildingLinePolicy
+{
+inline int clamp(int iVal, int iLow, int iHigh)
+{
+	return iVal < iLow ? iLow : (iVal > iHigh ? iHigh : iVal);
+}
+
+// Net incremental value when completing an upgrade building deletes an already-built
+// predecessor in the same city (RoMEventManager.py building upgrade lines).
+// Keeps a small positive floor (10% of gross) when gross > replaced so genuine
+// upgrades remain eligible once cheap new buildings are done.
+inline int netUpgradeValue(int iGrossUpgradeValue, int iReplacedValue)
+{
+	if (iGrossUpgradeValue <= 0) return 0;
+	if (iReplacedValue <= 0) return iGrossUpgradeValue;
+	const int iDelta = iGrossUpgradeValue - iReplacedValue;
+	if (iDelta <= 0) return 0;
+	return iDelta;
+}
+
+// Discounted credit a prerequisite building earns for unlocking a higher-tier
+// same-city building via BuildingClassNeededs (e.g. Settlement -> Town Essentials).
+// Bounded to avoid runaway values on cheap prerequisites while strongly pulling
+// cities through multi-tier urban chains when the downstream tech is known.
+inline int prereqChainCredit(int iDownstreamValue, int iOwnCost, int iDownstreamCost, bool bDownstreamTechKnown)
+{
+	if (iDownstreamValue <= 0) return 0;
+	const int iTotalCost = (iOwnCost > 0 ? iOwnCost : 1) + (iDownstreamCost > 0 ? iDownstreamCost : 1);
+	const int iCostShare = clamp((iOwnCost > 0 ? iOwnCost : 1) * 100 / iTotalCost, 10, 60);
+	const int iTechScale = bDownstreamTechKnown ? 45 : 15;
+	// Smaller prerequisites (like 10-hammer Settlement Essentials gating 70-hammer Town Essentials)
+	// receive stronger pull because they are trivial bottlenecks to a large payoff.
+	const int iBottleneckBoost = 100 + (60 - iCostShare);
+	const long long iCredit = ((long long)iDownstreamValue * iTechScale * iBottleneckBoost) / 10000;
+	return iCredit > 600 ? 600 : (int)iCredit;
+}
+
+// Depreciates non-obsolete-safe building value when its ObsoleteTech is already
+// researched by rivals or within 1-2 tech eras of the player.
+inline int obsolescenceFactorPercent(int iObsoleteEra, int iCurrentEra, bool bPlayerHasTech)
+{
+	if (bPlayerHasTech) return 0;
+	if (iObsoleteEra < 0) return 100;
+	const int iGap = iObsoleteEra - iCurrentEra;
+	if (iGap <= 0) return 45;
+	if (iGap == 1) return 75;
+	return 100;
+}
+
+// Valuation of buildings granting an immediate Golden Age (Colossus, Taj Mahal,
+// Magician Pyramid) or extending all future Golden Ages (Mausoleum, Forum Romanum).
+inline int goldenAgeBuildingValue(bool bTriggersGoldenAge, int iGoldenAgeModifier, int iNumCities, int iTotalPop)
+{
+	int iVal = 0;
+	const int iEmpireScale = clamp(iNumCities * 12 + iTotalPop * 2, 16, 400);
+	if (bTriggersGoldenAge)
+	{
+		iVal += iEmpireScale;
+	}
+	if (iGoldenAgeModifier > 0)
+	{
+		iVal += (iEmpireScale * clamp(iGoldenAgeModifier, 0, 200)) / 100;
+	}
+	return iVal;
+}
+
+// Valuation of empire-wide unit upgrade discount buildings (Art of War -50%)
+// and Great General rate modifiers (Art of War +50%, Crusade +50%, Shinto +25%).
+inline int militaryWonderBonusValue(int iUnitUpgradePriceModifier, int iGreatGeneralRateModifier,
+	int iMilitaryUnits, int iWarmongerPercent, bool bWarPlan)
+{
+	int iVal = 0;
+	if (iUnitUpgradePriceModifier < 0)
+	{
+		const int iDiscount = clamp(-iUnitUpgradePriceModifier, 0, 90);
+		iVal += (iDiscount * clamp(iMilitaryUnits, 4, 80) * (bWarPlan ? 3 : 2)) / 25;
+	}
+	if (iGreatGeneralRateModifier > 0)
+	{
+		const int iRate = clamp(iGreatGeneralRateModifier, 0, 200);
+		iVal += (iRate * clamp(iWarmongerPercent, 50, 200) * (bWarPlan ? 2 : 1)) / 200;
+	}
+	return iVal;
+}
+
+// Valuation of Python-scripted RoM Wonders whose effects live in RoMEventManager.py / RoMGameUtils.py.
+inline int worldBankValue(int iTreasuryGold, int iNetGoldPerTurn, int iNumCities)
+{
+	// +50% instant gold on completion + 1% compound interest per turn on treasury.
+	const int iInstant = clamp(iTreasuryGold / 2, 0, 20000);
+	const int iAnnualInterest = clamp(iTreasuryGold / 100 + (iNetGoldPerTurn > 0 ? iNetGoldPerTurn / 10 : 0), 5, 500);
+	return clamp(80 + iInstant / 40 + iAnnualInterest * 2 + iNumCities * 4, 80, 900);
+}
+
+inline int crusadeWonderValue(int iWarmongerPercent, bool bWarPlan, int iNumCities)
+{
+	// Spawns free Enemy-Road Crusader every 4-16 turns + +25% production in XML.
+	return clamp((bWarPlan ? 180 : 90) * clamp(iWarmongerPercent, 60, 180) / 100 + iNumCities * 3, 60, 450);
+}
+
+inline int djenneWonderValue(int iDesertPlotsInRadius, int iNumCities, bool bHasStateReligion)
+{
+	// +2 commerce on every desert tile in city radius + 50% cheaper Cathedrals empire-wide.
+	return clamp(iDesertPlotsInRadius * 28 + (bHasStateReligion ? iNumCities * 8 : 0), 0, 500);
+}
+
+inline int himejiWonderValue(int iWarmongerPercent, bool bWarPlan, int iNumCities)
+{
+	// 2x pillage gold for owner, 0 enemy pillage & capture gold against owner.
+	return clamp((bWarPlan ? 110 : 50) * clamp(iWarmongerPercent, 60, 180) / 100 + iNumCities * 4, 40, 320);
+}
+
+inline int naniteDefuserValue(int iEnemyNukes, int iOwnNukes)
+{
+	if (iEnemyNukes <= 0) return 0;
+	if (iOwnNukes > iEnemyNukes * 2) return 0;
+	return clamp(150 + (iEnemyNukes - iOwnNukes) * 40, 100, 800);
+}
+
+// Scales the civic switch amortization horizon by GameSpeed anarchy percent so
+// Marathon (200% anarchy) and Snail (400% anarchy) do not reject high-value civics
+// or thrash on unscaled Normal-speed constants.
+inline int scaledCivicHorizon(int iBaseDelay, int iAnarchyPercent)
+{
+	const int iClampedDelay = clamp(iBaseDelay, 6, 500);
+	const int iScale = clamp(iAnarchyPercent, 50, 500);
+	return clamp((2 * iClampedDelay * iScale) / 100, 12, 1000);
+}
+
+// Net per-turn value (x100 gold equivalents) of spreading or keeping a corporation
+// in a city after inflation-scaled corporation maintenance.
+inline int corporationNetValue100(int iGrossYieldValue100, int iHqGoldPerTurn100,
+	int iCorpMaintenanceTimes100, int iInflationPercent)
+{
+	const int iInfl = clamp(iInflationPercent, 0, 500);
+	const long long iInflatedMaint = ((long long)clamp(iCorpMaintenanceTimes100, 0, 1000000) * (100 + iInfl)) / 100;
+	const long long iNet = (long long)iGrossYieldValue100 + (long long)iHqGoldPerTurn100 - iInflatedMaint;
+	if (iNet < INT_MIN / 2) return INT_MIN / 2;
+	if (iNet > INT_MAX / 2) return INT_MAX / 2;
+	return (int)iNet;
+}
+}
+
+#endif
