+				"BUILDINGCLASS_FORGE", "BUILDINGCLASS_MARKET", NULL
+			};
+			static const char* const aszColonistCoastal[] = {
+				"BUILDINGCLASS_HARBOR", "BUILDINGCLASS_LIGHTHOUSE", NULL
+			};
+			static const char* const aszPioneerBuildings[] = {
+				"BUILDINGCLASS_TOWN_ESSENTIALS", "BUILDINGCLASS_GARRISON",
+				"BUILDINGCLASS_FORGE", "BUILDINGCLASS_COURTHOUSE", "BUILDINGCLASS_MARKET",
+				"BUILDINGCLASS_STABLE", "BUILDINGCLASS_GROCER", "BUILDINGCLASS_BANK",
+				"BUILDINGCLASS_LIBRARY", NULL
+			};
+			static const char* const aszPioneerCoastal[] = {
+				"BUILDINGCLASS_PORT", "BUILDINGCLASS_LIGHTHOUSE", NULL
+			};
+			static const char* const aszRomanBuildings[] = {
+				"BUILDINGCLASS_SETTLEMENT_ESSENTIALS", "BUILDINGCLASS_WALLS",
+				"BUILDINGCLASS_EARLY_BARRACKS", "BUILDINGCLASS_FORGE",
+				"BUILDINGCLASS_MARKET", "BUILDINGCLASS_ROMAN_DEPOT", NULL
+			};
+			const char* const* pBaseList = NULL;
+			const char* const* pCoastalList = NULL;
+
+			if (eUnitClass == iColonistClass)
+			{
+				iTargetPop = 3;
+				pBaseList = aszColonistBuildings;
+				pCoastalList = aszColonistCoastal;
+			}
+			else if (eUnitClass == iPioneerClass)
+			{
+				iTargetPop = 4;
+				pBaseList = aszPioneerBuildings;
+				pCoastalList = aszPioneerCoastal;
+			}
+			else if (eUnitClass == iRomanColonistClass)
+			{
+				iTargetPop = 3;
+				pBaseList = aszRomanBuildings;
+				pCoastalList = aszColonistCoastal;
+			}
+
+			if (iTargetPop > 0)
+			{
+				if (pFoundedCity->getPopulation() < iTargetPop)
+				{
+					pFoundedCity->setPopulation(iTargetPop);
+				}
+				const CvCivilizationInfo& kCivInfo = GC.getCivilizationInfo(pFoundedCity->getCivilizationType());
+				for (int iList = 0; iList < 2; ++iList)
+				{
