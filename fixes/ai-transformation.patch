+							{
+								pFoundedCity->setNumRealBuilding(eBuilding, 1);
+							}
+						}
+					}
+				}
+			}
+		}
+	}
+
 	if (plot()->isActiveVisible(false))
 	{
 		NotifyEntity(MISSION_FOUND);
