From 77ccaff6bbe36fe52e03d28d8fd52e6b6e422c9e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 13 Oct 2026 13:16:55 +0000
Subject: [PATCH] Settler transport: recognise escorts at sea and keep the
 landed party together

AI_settlerSeaTransport recognised the escort with canDefend(), which asks
about the unit's current plot; a land unit aboard a ship at sea cannot defend
water, so after the first leg the ship found no escort and waited next to the
site indefinitely. Use canFight(). After landing, rejoin the escort to the
settler (CvUnit::setXY splits disembarking cargo into new groups) and restore
MISSIONAI_FOUND on the site.

The landing tests' canDefend() stand-in ignored the plot and their move()
kept groups intact; both now follow the engine.
---
 Assets/CvGameCoreDLL/CvUnitAI.cpp | 17 +++++++++++-
 Docs/SETTLER_LANDING_FIX.md       | 44 +++++++++++++++++++++++++++++++
 Tools/test_settler_landing.py     | 16 ++++++++---
 3 files changed, 73 insertions(+), 4 deletions(-)

diff --git a/Assets/CvGameCoreDLL/CvUnitAI.cpp b/Assets/CvGameCoreDLL/CvUnitAI.cpp
index 3f0a84b..5256c58 100644
--- a/Assets/CvGameCoreDLL/CvUnitAI.cpp
+++ b/Assets/CvGameCoreDLL/CvUnitAI.cpp
@@ -17887,7 +17887,10 @@ bool CvUnitAI::AI_settlerSeaTransport()
 	for (size_t i = 0; i < aCargo.size(); ++i)
 	{
 		if (aCargo[i]->AI_getUnitAIType() == UNITAI_SETTLE && pSettler == NULL) pSettler = aCargo[i];
-		if (aCargo[i]->getDomainType() == DOMAIN_LAND && aCargo[i]->canDefend() &&
+		// canFight, not canDefend: canDefend() asks about the unit's current plot,
+		// and a land unit aboard a ship at sea cannot defend water. After the
+		// first leg every escort stopped counting and the ship waited forever.
+		if (aCargo[i]->getDomainType() == DOMAIN_LAND && aCargo[i]->canFight() &&
 			(pEscort == NULL || aCargo[i]->canMove() || !pEscort->canMove())) pEscort = aCargo[i];
 	}
 	if (pSettler == NULL) return false;
@@ -18084,6 +18087,18 @@ bool CvUnitAI::AI_settlerSeaTransport()
 			pSettler->getTransportUnit() == this && pEscort->getTransportUnit() == this;
 		if (gUnitLogLevel >= 2) logBBAI("    Settler transport %d: %s at %d,%d", getID(),
 			bDelivered ? "LANDED_PARTY" : (bPending ? "LANDING_QUEUED" : "LANDING_PARTY_CHANGED"), pSite->getX_INLINE(), pSite->getY_INLINE());
+		if (bDelivered)
+		{
+			// CvUnit::setXY moves every disembarking cargo unit into a new group of
+			// its own, so the party arrives split and its new groups carry no
+			// destination. Re-form it and restore the accepted site; AI_settleMove
+			// founds there next turn (landing from water costs all moves).
+			if (pEscort->getGroup() != pSettler->getGroup())
+			{
+				pEscort->joinGroup(pSettler->getGroup());
+			}
+			pSettler->getGroup()->AI_setMissionAI(MISSIONAI_FOUND, pSite, NULL);
+		}
 		getGroup()->pushMission(MISSION_SKIP, -1, -1, 0, false, false,
 			bPending ? MISSIONAI_FOUND : NO_MISSIONAI, bPending ? pSite : NULL);
 		return true;
