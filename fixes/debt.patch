index 0000000..5e297e7
--- /dev/null
+++ b/Assets/CvGameCoreDLL/AIDebtPolicy.h
@@ -0,0 +1,268 @@
+// Added: deterministic, engine-independent arithmetic for debt contracts (loans and bonds).
+// Every quantity is an integer: gold, turns, and rates in parts per million per turn (ppm).
+// Floating point is avoided so that every machine of a network game computes the same numbers.
+// The functions take no game objects, so they compile and are checked natively
+// (fixes/debt/tests/test_debt_policy.cpp in the analysis repository).
+#ifndef AI_DEBT_POLICY_H
+#define AI_DEBT_POLICY_H
+
+#include <climits>
+
+namespace AIDebtPolicy
+{
+static const long long PPM = 1000000;
+
+inline int clampInt(long long value)
+{
+	return value < INT_MIN ? INT_MIN : (value > INT_MAX ? INT_MAX : (int)value);
+}
+
+inline int clampRange(int value, int low, int high)
+{
+	return value < low ? low : (value > high ? high : value);
+}
+
+// Interest of one turn on an amount, rounded up so that a positive rate on a positive amount
+// always charges something.
+inline int interestFor(int amount, int ratePpm)
+{
+	if (amount <= 0 || ratePpm <= 0)
+	{
+		return 0;
+	}
+	const long long numerator = (long long)amount * ratePpm;
+	return clampInt((numerator + PPM - 1) / PPM);
+}
+
+// (1 + r)^turns in units of PPM, saturated far below overflow.
+inline long long growthFactor(int ratePpm, int turns)
+{
+	long long factor = PPM;
+	const long long step = PPM + (ratePpm > 0 ? ratePpm : 0);
+	for (int i = 0; i < turns; ++i)
+	{
+		factor = (factor * step) / PPM;
+		if (factor > (long long)1000000 * PPM)
+		{
+			return (long long)1000000 * PPM;
+		}
+	}
+	return factor;
+}
+
+// What is still owed after a number of turns of equal payments, interest charged each turn
+// first and rounded up as interestFor does (the rule CvGame::recordDebtPayments applies).
+inline long long residualAfter(int principal, int ratePpm, int turns, long long payment)
+{
+	long long owed = principal;
+	for (int i = 0; i < turns && owed > 0; ++i)
+	{
+		owed += interestFor(clampInt(owed), ratePpm);
+		owed -= (owed < payment) ? owed : payment;
+	}
+	return owed;
+}
+
+// Equal payment per turn that repays a principal with interest over a term (an annuity):
+// A = P r / (1 - (1+r)^-T) = P r F / (F - 1), F = (1+r)^T, rounded up; never below the
+// interest of the first turn plus one, so the principal falls with every payment. The formula
+// assumes exact interest; the game rounds each turn's interest up, so the payment is then
+// raised until the last payment clears the debt within the term.
+inline int annuityPaymentFormula(int principal, int ratePpm, int turns)
+{
+	if (principal <= 0)
+	{
+		return 0;
+	}
+	if (turns <= 0)
+	{
+		return principal;
+	}
+	if (ratePpm <= 0)
+	{
+		return clampInt(((long long)principal + turns - 1) / turns);
+	}
+	const long long factor = growthFactor(ratePpm, turns);
+	const long long denominator = (factor - PPM) * PPM;
+	if (denominator <= 0)
+	{
+		return clampInt(((long long)principal + turns - 1) / turns);
+	}
+	// P * r * F / ((F - 1) * PPM), with r and F in PPM units; split to stay inside 64 bits.
+	const long long rateTimesFactor = ((long long)ratePpm * factor) / PPM; // r*F in PPM units
+	const long long numerator = (long long)principal * rateTimesFactor;
+	long long payment = (numerator + (factor - PPM) - 1) / (factor - PPM);
+	const int firstInterest = interestFor(principal, ratePpm);
+	if (payment < firstInterest + 1)
+	{
+		payment = firstInterest + 1;
+	}
+	return clampInt(payment);
+}
+
+inline int annuityPayment(int principal, int ratePpm, int turns)
+{
+	long long payment = annuityPaymentFormula(principal, ratePpm, turns);
+	if (principal <= 0 || turns <= 0)
+	{
+		return clampInt(payment);
+	}
+	for (int i = 0; i < 64; ++i)
+	{
+		const long long residual = residualAfter(principal, ratePpm, turns, payment);
+		if (residual <= 0)
+		{
+			break;
+		}
+		payment += (residual + turns - 1) / turns;
+	}
+	return clampInt(payment);
+}
+
+// Coupon of a bond: the interest of one turn on its principal.
+inline int couponPayment(int principal, int ratePpm)
+{
+	return interestFor(principal, ratePpm);
+}
+
+// Present value of a stream of equal payments for a number of turns, discounted at a rate,
+// plus a final lump (the principal of a bond at maturity).
+inline int presentValue(int payment, int turns, int finalLump, int discountPpm)
+{
+	long long value = 0;
+	long long factor = PPM;
+	const long long step = PPM + (discountPpm > 0 ? discountPpm : 0);
+	for (int i = 0; i < turns; ++i)
+	{
+		factor = (factor * step) / PPM;
+		if (factor <= 0)
+		{
+			break;
+		}
+		value += ((long long)payment * PPM) / factor;
+	}
+	if (finalLump > 0 && factor > 0)
+	{
+		value += ((long long)finalLump * PPM) / factor;
+	}
+	return clampInt(value);
+}
+
+// The rate per turn of a game speed whose game is iLengthPercent percent as many turns as a
+// Normal game, such that compounding over the same share of the game gives the same growth as
+// iNormalRatePpm per Normal turn: (1 + r)^L = (1 + rN)^100. Found by bisection on integers.
+inline int rateForSpeed(int iNormalRatePpm, int iLengthPercent)
+{
+	if (iNormalRatePpm <= 0)
+	{
+		return 0;
+	}
+	if (iLengthPercent <= 0 || iLengthPercent == 100)
+	{
+		return iNormalRatePpm;
+	}
+	const long long target = growthFactor(iNormalRatePpm, 100);
+	int low = 0;
+	int high = (iLengthPercent < 100) ? (int)(((long long)iNormalRatePpm * 100) / iLengthPercent) * 2 + 1 : iNormalRatePpm;
+	while (low < high)
+	{
+		const int middle = low + (high - low) / 2;
+		if (growthFactor(middle, iLengthPercent) < target)
+		{
+			low = middle + 1;
+		}
+		else
+		{
+			high = middle;
+		}
+	}
+	return low;
+}
+
+// Turns scaled from Normal speed to a game speed of iLengthPercent, at least one.
+inline int scaleTurns(int iNormalTurns, int iLengthPercent)
+{
+	const long long turns = ((long long)iNormalTurns * (iLengthPercent > 0 ? iLengthPercent : 100) + 50) / 100;
+	return turns < 1 ? 1 : clampInt(turns);
+}
+
+// A credit score from 0 (no credit) to 100 (best), from the borrower's own figures.
+//   iServicePercent   payments owed per turn, percent of gross gold plus research commerce
+//   bTrouble          the funded-percent test of financial trouble holds
+//   iDefaultTurns     turns left of the market's exclusion after a default (0 when none)
+//   bAtWar            at war with anyone
+//   bLosingWar        lost cities in war recently
+//   iCities           number of cities
+inline int creditScore(int iServicePercent, bool bTrouble, int iDefaultTurns, bool bAtWar,
+	bool bLosingWar, int iCities)
+{
+	int score = 75;
+	score -= clampRange(iServicePercent, 0, 60);
+	if (bTrouble)
+	{
+		score -= 15;
+	}
+	if (iDefaultTurns > 0)
+	{
+		score -= 25 + clampRange(iDefaultTurns / 4, 0, 25);
+	}
+	if (bAtWar)
+	{
+		score -= 5;
+	}
+	if (bLosingWar)
+	{
+		score -= 10;
+	}
+	score += clampRange(iCities / 2, 0, 15);
+	return clampRange(score, 0, 100);
+}
+
+// The spread a borrower pays above the base rate: none at score 100, iMaxSpreadPpm at score 0,
+// rising with the square of the shortfall so that good credit is cheap and bad credit dear.
+inline int creditSpread(int iScore, int iMaxSpreadPpm)
+{
+	const int shortfall = 100 - clampRange(iScore, 0, 100);
+	return clampInt(((long long)iMaxSpreadPpm * shortfall * shortfall) / 10000);
+}
+
+// The largest principal whose payment keeps total debt service within iMaxServicePercent of
+// gross commerce. iDue is what is owed per turn already. Found by bisection on the annuity
+// (loan) or the coupon (bond); iCap bounds the search.
+inline int borrowingLimit(int iGrossCommerce, int iMaxServicePercent, int iDue, int ratePpm,
+	int turns, bool bBond, int iCap)
+{
+	const long long room = ((long long)iGrossCommerce * iMaxServicePercent) / 100 - iDue;
+	if (room <= 0 || iCap <= 0)
+	{
+		return 0;
+	}
+	int low = 0;
+	int high = iCap;
+	while (low < high)
+	{
+		const int middle = low + (high - low + 1) / 2;
+		const int payment = bBond ? couponPayment(middle, ratePpm) : annuityPayment(middle, ratePpm, turns);
+		if (payment <= room)
+		{
+			low = middle;
+		}
+		else
+		{
+			high = middle - 1;
+		}
+	}
+	return low;
+}
+
+// Expected value to a lender of a loan: the present value of its payments at the lender's
+// hurdle rate, times the chance in percent that the payments continue, minus the principal.
+inline int loanValueToLender(int principal, int payment, int turns, int finalLump, int hurdlePpm,
+	int iContinuePercent)
+{
+	const long long pv = presentValue(payment, turns, finalLump, hurdlePpm);
+	return clampInt((pv * clampRange(iContinuePercent, 0, 100)) / 100 - principal);
+}
+}
+
+#endif
