+
+	# ------------------------------------------------------------------ input
+
+	def handleInput(self, inputClass):
+		screen = self.getScreen()
+		szName = inputClass.getFunctionName()
+		iCode = inputClass.getNotifyCode()
+		if iCode == NotifyCode.NOTIFY_LISTBOX_ITEM_SELECTED:
+			iIndex = screen.getSelectedPullDownID(szName)
+			iData = screen.getPullDownData(szName, iIndex)
+			if szName == "DebtProductList":
+				self.iProduct = iData
+			elif szName == "DebtTermList":
+				self.iTerm = iData
+			elif szName == "DebtOtherList":
+				self.iOther = iData
+			elif szName == "DebtDirectionList":
+				self.bWeLend = (iData == 1)
+				self.iCollateral = -1
+			elif szName == "DebtCollateralList":
+				self.iCollateral = iData
+			self.drawContents()
+			return 1
+		if iCode != NotifyCode.NOTIFY_CLICKED:
+			return 0
+		iData = inputClass.getID()
+		game = CyGame()
+		player = gc.getPlayer(self.iPlayer)
+		if szName == "DebtRepay":
+			CyMessageControl().sendModNetMessage(MSG_REPAY, self.iPlayer, iData, 0, 0)
+		elif szName == "DebtSell":
+			CyMessageControl().sendModNetMessage(MSG_SELL, self.iPlayer, iData, 0, 0)
+		elif szName == "DebtAccept":
+			CyMessageControl().sendModNetMessage(MSG_ACCEPT, self.iPlayer, iData, 0, 0)
+		elif szName == "DebtRefuse":
+			CyMessageControl().sendModNetMessage(MSG_REFUSE, self.iPlayer, iData, 0, 0)
+		elif szName == "DebtBorrow":
+			szKey, iKind, iConditions = PRODUCTS[self.iProduct]
+			iAmount = game.getMarketLimit(self.iPlayer, iKind, self.iTerm, iConditions) * iData / 100
+			CyMessageControl().sendModNetMessage(MSG_BORROW, self.iPlayer | (iKind << 8) | (iConditions << 12), iAmount, self.iTerm, 0)
+		elif szName == "DebtDeposit":
+			iAmount = player.getGold() * iData / 100
+			CyMessageControl().sendModNetMessage(MSG_LEND_MARKET, self.iPlayer | (DEBT_BOND << 8), iAmount, self.iTerm, 0)
+		elif szName == "DebtOffer":
+			if self.bWeLend:
+				iAmount = player.getGold() * iData / 100
+			else:
+				iAmount = gc.getPlayer(self.iOther).getGold() * iData / 100
+			iCollateral = COLLATERAL_NONE
+			iCollateralData = -1
+			if not self.bWeLend and self.iCollateral >= 0:
+				iCollateral = COLLATERAL_RESOURCE
+				iCollateralData = self.iCollateral
+			iFromLends = 0
+			if self.bWeLend:
+				iFromLends = 1
+			iData2 = self.iPlayer | (self.iOther << 8) | (iFromLends << 16) | (DEBT_LOAN << 17) | (iCollateral << 19) | (1 << 22)
+			CyMessageControl().sendModNetMessage(MSG_OFFER, iData2, iAmount, self.iTerm, iCollateralData)
+		else:
+			return 0
+		return 1
+
+	def update(self, fDelta):
+		if self.iPlayer < 0:
+			return
+		if self.signature() != self.szSignature:
+			self.drawContents()
+
+	def onClose(self):
+		return 0
