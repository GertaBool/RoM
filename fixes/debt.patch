diff --git a/Assets/Python/Screens/CvDebtScreen.py b/Assets/Python/Screens/CvDebtScreen.py
new file mode 100644
index 0000000..9883e7c
--- /dev/null
+++ b/Assets/Python/Screens/CvDebtScreen.py
@@ -0,0 +1,420 @@
+## Debt screen: loans and bonds between civilizations and with the open market.
+## The rules live in the DLL (CvDebt.cpp). This screen only shows them and sends network
+## messages (ids 7000-7099), which every machine runs in C++, so it never changes the game itself.
+## Opened from the Finance Advisor.
+from CvPythonExtensions import *
+import CvUtil
+import CvScreenEnums
+
+gc = CyGlobalContext()
+ArtFileMgr = CyArtFileMgr()
+localText = CyTranslator()
+
+# Network message ids and layouts (CvDebt.h, DebtMessages)
+MSG_BORROW = 7000
+MSG_LEND_MARKET = 7001
+MSG_REPAY = 7002
+MSG_SELL = 7003
+MSG_OFFER = 7010
+MSG_ACCEPT = 7011
+MSG_REFUSE = 7012
+
+# CvDebt.h enums
+DEBT_LOAN = 0
+DEBT_BOND = 1
+COLLATERAL_NONE = 0
+COLLATERAL_RESOURCE = 1
+COLLATERAL_CITY = 2
+COND_WAR_BOND = 1
+COND_DEVELOPMENT = 2
+COND_FLOATING = 4
+COND_NO_WAR = 8
+
+F_ID, F_KIND, F_BORROWER, F_LENDER, F_PRINCIPAL, F_OUTSTANDING, F_RATE, F_PAYMENT, F_SIGN, F_MATURITY, F_ARREARS, F_MISSED, F_COLLATERAL, F_COLLATERAL_DATA, F_CONDITIONS, F_FROZEN, F_DUE = range(17)
+O_ID, O_FROM, O_TO, O_FROM_LENDS, O_KIND, O_AMOUNT, O_TERM, O_COLLATERAL, O_COLLATERAL_DATA, O_CONDITIONS, O_RATE, O_EXPIRE = range(12)
+
+NUM_TERMS = 4
+
+# The products the market offers: (text key, kind, conditions)
+PRODUCTS = [
+	("TXT_KEY_DEBT_PRODUCT_LOAN", DEBT_LOAN, 0),
+	("TXT_KEY_DEBT_PRODUCT_FLOATING_LOAN", DEBT_LOAN, COND_FLOATING),
+	("TXT_KEY_DEBT_PRODUCT_BOND", DEBT_BOND, 0),
+	("TXT_KEY_DEBT_PRODUCT_WAR_BOND", DEBT_BOND, COND_WAR_BOND),
+	("TXT_KEY_DEBT_PRODUCT_DEVELOPMENT_LOAN", DEBT_LOAN, COND_DEVELOPMENT),
+]
+SHARES = [25, 50, 100]
+
+def txt(szKey, args=()):
+	return localText.getText(szKey, args)
+
+def rateText(iPpm):
+	"rate per turn in percent, two decimals"
+	if iPpm < 0:
+		return u"-"
+	return u"%.2f%%" % (iPpm / 10000.0)
+
+def partyName(iPlayer):
+	if iPlayer < 0:
+		return txt("TXT_KEY_DEBT_MARKET_NAME")
+	return gc.getPlayer(iPlayer).getCivilizationShortDescription(0)
+
+
+class CvDebtScreen:
+
+	def __init__(self):
+		self.SCREEN_NAME = "DebtScreen"
+		self.WIDGET_ID = "DebtWidget"
+		self.W_SCREEN = 1024
+		self.H_SCREEN = 768
+		self.Z = -2.3
+		self.nWidgetCount = 0
+		self.iPlayer = -1
+		self.iProduct = 0
+		self.iTerm = 1
+		self.iOther = -1
+		self.bWeLend = True
+		self.iCollateral = -1		# -1: none; otherwise a bonus id of ours when we borrow
+		self.szSignature = ""
+
+	def getScreen(self):
+		return CyGInterfaceScreen(self.SCREEN_NAME, CvScreenEnums.DEBT_SCREEN)
+
+	def interfaceScreen(self):
+		self.iPlayer = CyGame().getActivePlayer()
+		if self.iPlayer < 0:
+			return
+		screen = self.getScreen()
+		if screen.isActive():
+			return
+		screen.setRenderInterfaceOnly(True)
+		screen.showScreen(PopupStates.POPUPSTATE_IMMEDIATE, False)
+		screen.setDimensions(screen.centerX(0), screen.centerY(0), self.W_SCREEN, self.H_SCREEN)
+		screen.addDDSGFC("DebtBackground", ArtFileMgr.getInterfaceArtInfo("MAINMENU_SLIDESHOW_LOAD").getPath(), 0, 0, self.W_SCREEN, self.H_SCREEN, WidgetTypes.WIDGET_GENERAL, -1, -1)
+		screen.addPanel("DebtTopPanel", u"", u"", True, False, 0, 0, self.W_SCREEN, 55, PanelStyles.PANEL_STYLE_TOPBAR)
+		screen.addPanel("DebtBottomPanel", u"", u"", True, False, 0, 713, self.W_SCREEN, 55, PanelStyles.PANEL_STYLE_BOTTOMBAR)
+		screen.showWindowBackground(False)
+		screen.setText("DebtExit", "Background", u"<font=4>" + txt("TXT_KEY_PEDIA_SCREEN_EXIT").upper() + u"</font>", CvUtil.FONT_RIGHT_JUSTIFY, 994, 726, self.Z, FontTypes.TITLE_FONT, WidgetTypes.WIDGET_CLOSE_SCREEN, -1, -1)
+		screen.setLabel("DebtHeader", "Background", u"<font=4b>" + txt("TXT_KEY_DEBT_SCREEN_TITLE").upper() + u"</font>", CvUtil.FONT_CENTER_JUSTIFY, self.W_SCREEN / 2, 12, self.Z, FontTypes.TITLE_FONT, WidgetTypes.WIDGET_GENERAL, -1, -1)
+		self.drawContents()
+
+	# ------------------------------------------------------------------ drawing
+
+	def name(self):
+		szName = self.WIDGET_ID + str(self.nWidgetCount)
+		self.nWidgetCount += 1
+		return szName
+
+	def deleteAllWidgets(self):
+		screen = self.getScreen()
+		i = self.nWidgetCount - 1
+		while i >= 0:
+			screen.deleteWidget(self.WIDGET_ID + str(i))
+			i -= 1
+		self.nWidgetCount = 0
+		for szName in self.aFixedWidgets():
+			screen.deleteWidget(szName)
+
+	def aFixedWidgets(self):
+		return ["DebtProductList", "DebtTermList", "DebtOtherList", "DebtDirectionList", "DebtCollateralList"]
+
+	def label(self, szText, x, y, iJustify=CvUtil.FONT_LEFT_JUSTIFY, iFont=3):
+		self.getScreen().setLabel(self.name(), "Background", u"<font=%d>" % iFont + szText + u"</font>", iJustify, x, y, self.Z, FontTypes.GAME_FONT, WidgetTypes.WIDGET_GENERAL, -1, -1)
+
+	def button(self, szFunction, iData, szText, x, y):
+		"a clickable text; its widget name is szFunction followed by iData (ScreenInput splits them)"
+		self.getScreen().setText(szFunction + str(iData), "Background", u"<font=3>[" + szText + u"]</font>", CvUtil.FONT_LEFT_JUSTIFY, x, y, self.Z, FontTypes.GAME_FONT, WidgetTypes.WIDGET_GENERAL, -1, -1)
+		self.aButtons.append(szFunction + str(iData))
+
+	def signature(self):
+		game = CyGame()
+		player = gc.getPlayer(self.iPlayer)
+		parts = [game.getGameTurn(), player.getGold(), game.getNumDebts(), game.getNumDebtOffers(), game.getMarketCapital(), player.getDebtOutstanding(), player.getDebtHeld()]
+		return ",".join([str(x) for x in parts])
+
+	def drawContents(self):
+		screen = self.getScreen()
+		for szName in getattr(self, "aButtons", []):
+			screen.deleteWidget(szName)
+		self.aButtons = []
+		self.deleteAllWidgets()
+		self.szSignature = self.signature()
+		game = CyGame()
+		player = gc.getPlayer(self.iPlayer)
+
+		if not game.isDebtEnabled():
+			self.label(txt("TXT_KEY_DEBT_DISABLED"), self.W_SCREEN / 2, 80, CvUtil.FONT_CENTER_JUSTIFY)
+			return
+
+		# Summary
+		y = 62
+		self.label(txt("TXT_KEY_DEBT_SUMMARY", (player.getGold(), player.getDebtOutstanding(), player.getDebtDuePerTurn(), player.getDebtHeld(), player.getDebtIncomePerTurn(), player.getCreditScore())), 30, y)
+		y += 22
+		self.label(txt("TXT_KEY_DEBT_MARKET_SUMMARY", (rateText(game.getMarketBaseRatePpm()), game.getMarketCapital())), 30, y)
+		if player.getDebtDefaultTurns() > 0:
+			self.label(txt("TXT_KEY_DEBT_EXCLUDED", (player.getDebtDefaultTurns(),)), 600, y)
+
+		self.drawContracts(115)
+		self.drawMarket(415)
+		self.drawCivs(415)
+
+	def drawContracts(self, yTop):
+		screen = self.getScreen()
+		game = CyGame()
+		screen.addPanel(self.name(), u"", u"", True, True, 20, yTop, 984, 290, PanelStyles.PANEL_STYLE_MAIN)
+		self.label(txt("TXT_KEY_DEBT_CONTRACTS").upper(), 512, yTop + 8, CvUtil.FONT_CENTER_JUSTIFY)
+		y = yTop + 32
+		columns = [(35, "TXT_KEY_DEBT_COL_KIND"), (170, "TXT_KEY_DEBT_COL_PARTY"), (330, "TXT_KEY_DEBT_COL_OUTSTANDING"), (440, "TXT_KEY_DEBT_COL_RATE"), (530, "TXT_KEY_DEBT_COL_PAYMENT"), (630, "TXT_KEY_DEBT_COL_TURNS"), (720, "TXT_KEY_DEBT_COL_STATE")]
+		for x, szKey in columns:
+			self.label(u"<color=200,200,255>" + txt(szKey) + u"</color>", x, y)
+		y += 22
+		iShown = 0
+		iTurn = game.getGameTurn()
+		for i in range(game.getNumDebts()):
+			iBorrower = game.getDebtField(i, F_BORROWER)
+			iLender = game.getDebtField(i, F_LENDER)
+			if iBorrower != self.iPlayer and iLender != self.iPlayer:
+				continue
+			if iShown >= 10:
+				self.label(txt("TXT_KEY_DEBT_MORE", (self.countOwnContracts() - iShown,)), 35, y)
+				break
+			iID = game.getDebtField(i, F_ID)
+			bOwe = (iBorrower == self.iPlayer)
+			iKind = game.getDebtField(i, F_KIND)
+			iConditions = game.getDebtField(i, F_CONDITIONS)
+			szKind = txt(self.kindKey(iKind, iConditions))
+			if bOwe:
+				szParty = txt("TXT_KEY_DEBT_OWED_TO", (partyName(iLender),))
+			else:
+				szParty = txt("TXT_KEY_DEBT_OWED_BY", (partyName(iBorrower),))
+			szState = txt("TXT_KEY_DEBT_STATE_CURRENT")
+			if game.getDebtField(i, F_FROZEN):
+				szState = txt("TXT_KEY_DEBT_STATE_FROZEN")
+			elif game.getDebtField(i, F_ARREARS) > 0:
+				szState = txt("TXT_KEY_DEBT_STATE_ARREARS", (game.getDebtField(i, F_ARREARS), game.getDebtField(i, F_MISSED)))
+			self.label(szKind, 35, y)
