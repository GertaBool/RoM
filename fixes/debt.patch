diff --git a/Assets/XML/GlobalDefinesAlt.xml b/Assets/XML/GlobalDefinesAlt.xml
index b16e844..be15cc1 100644
--- a/Assets/XML/GlobalDefinesAlt.xml
+++ b/Assets/XML/GlobalDefinesAlt.xml
@@ -1037,4 +1037,137 @@
 		<DefineName>GRAPHICS_PAGING_LOG</DefineName>
 		<iDefineIntVal>0</iDefineIntVal>
 	</Define>
+	<!-- Debt: loans and bonds between civilizations and with the open market (CvDebt.cpp; codemap/guides/loans-and-bonds.md in the analysis repository). 1 on, 0 off: no contract can be made, and the market does not run. -->
+	<Define>
+		<DefineName>DEBT_ENABLE</DefineName>
+		<iDefineIntVal>1</iDefineIntVal>
+	</Define>
+	<!-- Rates are basis points (1/100 of a percent) per turn at Normal speed; at other speeds they are converted so that the same share of the game compounds alike. Turns are Normal-speed turns, scaled by the length of the game speed (Marathon 210 percent). -->
+	<!-- DEBT_REAL_RATE_BP: the market's real rate; the base rate adds inflation of the price level each turn -->
+	<Define>
+		<DefineName>DEBT_REAL_RATE_BP</DefineName>
+		<iDefineIntVal>40</iDefineIntVal>
+	</Define>
+	<!-- DEBT_MAX_SPREAD_BP: spread above the base rate at credit score 0 (none at 100, rising with the square of the shortfall) -->
+	<Define>
+		<DefineName>DEBT_MAX_SPREAD_BP</DefineName>
+		<iDefineIntVal>120</iDefineIntVal>
+	</Define>
+	<!-- DEBT_TERM_PREMIUM_BP: added per step of term (terms 0 to 3) -->
+	<Define>
+		<DefineName>DEBT_TERM_PREMIUM_BP</DefineName>
+		<iDefineIntVal>5</iDefineIntVal>
+	</Define>
+	<!-- DEBT_WAR_BOND_PREMIUM_BP: added for a war bond -->
+	<Define>
+		<DefineName>DEBT_WAR_BOND_PREMIUM_BP</DefineName>
+		<iDefineIntVal>40</iDefineIntVal>
+	</Define>
+	<!-- DEBT_DEVELOPMENT_DISCOUNT_BP: taken off for a development loan (at most half the base rate) -->
+	<Define>
+		<DefineName>DEBT_DEVELOPMENT_DISCOUNT_BP</DefineName>
+		<iDefineIntVal>20</iDefineIntVal>
+	</Define>
+	<!-- DEBT_AI_HURDLE_BP: the AI lends to another civilization only above the base rate plus this, after the risk of default -->
+	<Define>
+		<DefineName>DEBT_AI_HURDLE_BP</DefineName>
+		<iDefineIntVal>20</iDefineIntVal>
+	</Define>
+	<!-- DEBT_DEPOSIT_PERCENT: the market pays this percent of its base rate (plus the term premium) on the bonds it sells -->
+	<Define>
+		<DefineName>DEBT_DEPOSIT_PERCENT</DefineName>
+		<iDefineIntVal>75</iDefineIntVal>
+	</Define>
+	<!-- DEBT_MAX_SERVICE_PERCENT: the market lends while all payments stay within this percent of gross gold and research commerce -->
+	<Define>
+		<DefineName>DEBT_MAX_SERVICE_PERCENT</DefineName>
+		<iDefineIntVal>25</iDefineIntVal>
+	</Define>
+	<!-- DEBT_WAR_BOND_SERVICE_PERCENT: the same, for war bonds -->
+	<Define>
+		<DefineName>DEBT_WAR_BOND_SERVICE_PERCENT</DefineName>
+		<iDefineIntVal>40</iDefineIntVal>
+	</Define>
+	<!-- DEBT_PRINCIPAL_CAP_TURNS: and while the principal stays within this many turns of gross commerce -->
+	<Define>
+		<DefineName>DEBT_PRINCIPAL_CAP_TURNS</DefineName>
+		<iDefineIntVal>20</iDefineIntVal>
+	</Define>
+	<Define>
+		<DefineName>DEBT_TERM_0</DefineName>
+		<iDefineIntVal>10</iDefineIntVal>
+	</Define>
+	<Define>
+		<DefineName>DEBT_TERM_1</DefineName>
+		<iDefineIntVal>20</iDefineIntVal>
+	</Define>
+	<Define>
+		<DefineName>DEBT_TERM_2</DefineName>
+		<iDefineIntVal>30</iDefineIntVal>
+	</Define>
+	<!-- DEBT_TERM_3: the four terms offered, in turns -->
+	<Define>
+		<DefineName>DEBT_TERM_3</DefineName>
+		<iDefineIntVal>50</iDefineIntVal>
+	</Define>
+	<!-- DEBT_EARLY_REPAY_TURNS: early repayment costs this many turns of interest -->
+	<Define>
+		<DefineName>DEBT_EARLY_REPAY_TURNS</DefineName>
+		<iDefineIntVal>2</iDefineIntVal>
+	</Define>
+	<!-- DEBT_ARREARS_PENALTY_BP: unpaid amounts accrue this much on top of the contract rate -->
+	<Define>
+		<DefineName>DEBT_ARREARS_PENALTY_BP</DefineName>
+		<iDefineIntVal>100</iDefineIntVal>
+	</Define>
+	<!-- DEBT_GRACE_TURNS: turns in a row with arrears before default -->
+	<Define>
+		<DefineName>DEBT_GRACE_TURNS</DefineName>
+		<iDefineIntVal>5</iDefineIntVal>
+	</Define>
+	<!-- DEBT_DEFAULT_EXCLUSION_TURNS: after a default the market lends nothing to the defaulter for this many turns -->
+	<Define>
+		<DefineName>DEBT_DEFAULT_EXCLUSION_TURNS</DefineName>
+		<iDefineIntVal>30</iDefineIntVal>
+	</Define>
+	<!-- DEBT_DEFAULT_MEMORY_TURNS: a lender remembers a default against it for this many turns -->
+	<Define>
+		<DefineName>DEBT_DEFAULT_MEMORY_TURNS</DefineName>
+		<iDefineIntVal>50</iDefineIntVal>
+	</Define>
+	<!-- DEBT_ATTITUDE_DEFAULT: attitude lost towards a defaulter at first, fading with the memory -->
+	<Define>
+		<DefineName>DEBT_ATTITUDE_DEFAULT</DefineName>
+		<iDefineIntVal>4</iDefineIntVal>
+	</Define>
+	<!-- DEBT_MARKET_START_CAPITAL: the market's capital at the start, per civilization -->
+	<Define>
+		<DefineName>DEBT_MARKET_START_CAPITAL</DefineName>
+		<iDefineIntVal>150</iDefineIntVal>
+	</Define>
+	<!-- DEBT_MARKET_INFLOW_PERCENT: percent of the world's gold commerce added to the market's capital each turn -->
+	<Define>
+		<DefineName>DEBT_MARKET_INFLOW_PERCENT</DefineName>
+		<iDefineIntVal>3</iDefineIntVal>
+	</Define>
+	<!-- DEBT_MARKET_TARGET_TURNS: capital below a quarter of this many turns of inflow raises the real rate by half; above twice it, lowers it by a quarter -->
+	<Define>
+		<DefineName>DEBT_MARKET_TARGET_TURNS</DefineName>
+		<iDefineIntVal>25</iDefineIntVal>
+	</Define>
+	<!-- DEBT_OFFER_TURNS: an offer to a human expires after this many turns -->
+	<Define>
+		<DefineName>DEBT_OFFER_TURNS</DefineName>
+		<iDefineIntVal>3</iDefineIntVal>
+	</Define>
+	<!-- DEBT_AI_OFFER_INTERVAL: an AI with spare gold considers offering a loan this often -->
+	<Define>
+		<DefineName>DEBT_AI_OFFER_INTERVAL</DefineName>
+		<iDefineIntVal>10</iDefineIntVal>
+	</Define>
+	<!-- DEBT_MIN_AMOUNT: the smallest contract, in gold -->
+	<Define>
+		<DefineName>DEBT_MIN_AMOUNT</DefineName>
+		<iDefineIntVal>10</iDefineIntVal>
+	</Define>
 </Civ4Defines>
