+#pragma once
+
+// Debt contracts: loans and bonds between civilizations and with the open market.
+// Held by CvGame (CvGame::m_aDebts), saved with it from save flag 2. The rules are in CvDebt.cpp;
+// the arithmetic in AIDebtPolicy.h. Design: codemap/guides/loans-and-bonds.md (analysis repository).
+
+#ifndef CIV4_DEBT_H
+#define CIV4_DEBT_H
+
+class FDataStreamBase;
+
+// The kinds of contract. Not seen by the exe.
+enum DebtKinds
+{
+	NO_DEBT_KIND = -1,
+	DEBT_LOAN,		// equal payments each turn (annuity) until repaid
+	DEBT_BOND,		// a coupon each turn, the principal at maturity
+	NUM_DEBT_KINDS
+};
+
+// What a defaulting borrower forfeits. Only between civilizations: the market takes none.
+enum DebtCollateral
+{
+	DEBT_COLLATERAL_NONE = 0,
+	DEBT_COLLATERAL_RESOURCE,	// iCollateralData: BonusTypes; given to the lender as an annual deal
+	DEBT_COLLATERAL_CITY,		// iCollateralData: city id of the borrower; ceded to the lender
+	NUM_DEBT_COLLATERALS
+};
+
+// Conditions, as bit flags.
+enum DebtConditionFlags
+{
+	DEBT_CONDITION_NONE = 0,
+	DEBT_CONDITION_WAR_BOND = 1,		// market: only at war; higher limit, higher rate
+	DEBT_CONDITION_DEVELOPMENT = 2,		// market: only below the average score; lower rate
+	DEBT_CONDITION_FLOATING = 4,		// market: the rate follows the market base rate
+	DEBT_CONDITION_NO_WAR = 8,			// between civilizations: declaring war on the lender is default
+	DEBT_CONDITION_ALL = 15
+};
+
+// Network message ids handled in C++ (CvNetModNetMessage::Execute). The mod's Python uses
+// 100, 101, 410, 411, 500, 501, 5088 and 5656; this range is free.
+enum DebtMessages
+{
+	DEBT_MESSAGE_FIRST = 7000,
+	DEBT_MESSAGE_BORROW = 7000,			// iData2 player | kind<<8 | conditions<<12; iData3 amount; iData4 term index
+	DEBT_MESSAGE_LEND_MARKET = 7001,	// iData2 player | kind<<8; iData3 amount; iData4 term index
+	DEBT_MESSAGE_REPAY = 7002,			// iData2 player; iData3 contract id
+	DEBT_MESSAGE_SELL = 7003,			// iData2 player; iData3 contract id
+	DEBT_MESSAGE_OFFER = 7010,			// iData2 player | other<<8 | proposer lends<<16 | kind<<17 | collateral<<19 | no-war<<22;
+										// iData3 amount; iData4 term index; iData5 collateral data
+	DEBT_MESSAGE_ACCEPT = 7011,			// iData2 player; iData3 offer id
+	DEBT_MESSAGE_REFUSE = 7012,			// iData2 player; iData3 offer id
+	DEBT_MESSAGE_LAST = 7099
+};
+
+// Fields of a contract as Python reads them (CyGame::getDebtField).
+enum DebtFields
+{
+	DEBT_FIELD_ID = 0,
+	DEBT_FIELD_KIND,
+	DEBT_FIELD_BORROWER,
+	DEBT_FIELD_LENDER,
+	DEBT_FIELD_PRINCIPAL,
+	DEBT_FIELD_OUTSTANDING,
+	DEBT_FIELD_RATE_PPM,
+	DEBT_FIELD_PAYMENT,
+	DEBT_FIELD_SIGN_TURN,
+	DEBT_FIELD_MATURITY_TURN,
+	DEBT_FIELD_ARREARS,
+	DEBT_FIELD_MISSED_TURNS,
+	DEBT_FIELD_COLLATERAL,
+	DEBT_FIELD_COLLATERAL_DATA,
+	DEBT_FIELD_CONDITIONS,
+	DEBT_FIELD_FROZEN,
+	DEBT_FIELD_DUE,
+	NUM_DEBT_FIELDS
+};
+
+// Fields of a pending offer between civilizations (CyGame::getDebtOfferField).
+enum DebtOfferFields
+{
+	DEBT_OFFER_FIELD_ID = 0,
+	DEBT_OFFER_FIELD_FROM,
+	DEBT_OFFER_FIELD_TO,
+	DEBT_OFFER_FIELD_FROM_LENDS,
+	DEBT_OFFER_FIELD_KIND,
+	DEBT_OFFER_FIELD_AMOUNT,
+	DEBT_OFFER_FIELD_TERM_INDEX,
+	DEBT_OFFER_FIELD_COLLATERAL,
+	DEBT_OFFER_FIELD_COLLATERAL_DATA,
+	DEBT_OFFER_FIELD_CONDITIONS,
+	DEBT_OFFER_FIELD_RATE_PPM,
+	DEBT_OFFER_FIELD_EXPIRE_TURN,
+	NUM_DEBT_OFFER_FIELDS
+};
+
+#define NUM_DEBT_TERMS 4
+
+struct CvDebtContract
+{
+	int iID;
+	int eKind;				// DebtKinds
+	int eBorrower;			// PlayerTypes; NO_PLAYER = the market
+	int eLender;			// PlayerTypes; NO_PLAYER = the market
+	int iPrincipal;			// gold at signing
+	int iOutstanding;		// owed now: principal not yet repaid plus unpaid interest
+	int iRatePpm;			// per turn, parts per million
+	int iSpreadPpm;			// above the market base rate, for a floating rate
+	int iPayment;			// scheduled per turn: annuity (loan) or coupon (bond)
+	int iSignTurn;
+	int iMaturityTurn;
+	int iArrears;			// scheduled payments not made, carried forward
+	int iMissedTurns;		// consecutive turns with arrears
+	int eCollateral;		// DebtCollateral
+	int iCollateralData;
+	int iConditions;		// DebtConditionFlags
+
+	CvDebtContract();
+	void read(FDataStreamBase* pStream);
+	void write(FDataStreamBase* pStream) const;
+};
+
+struct CvDebtOffer
+{
+	int iID;
+	int eFrom;				// the civilization that proposes
+	int eTo;
+	bool bFromLends;		// true: the proposer lends; false: the proposer borrows
+	int eKind;
+	int iAmount;
+	int iTermIndex;
+	int eCollateral;
+	int iCollateralData;
+	int iConditions;
+	int iRatePpm;			// fixed when the offer is made, from the market quote for the borrower
+	int iExpireTurn;
+
+	CvDebtOffer();
+	void read(FDataStreamBase* pStream);
+	void write(FDataStreamBase* pStream) const;
+};
+
+#endif
