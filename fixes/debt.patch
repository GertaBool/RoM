+// Debt contracts: loans and bonds between civilizations and with the open market.
+// Design: codemap/guides/loans-and-bonds.md in the analysis repository (written at 1d9a473).
+//
+// Where things happen:
+//   CvGame::doDebt                 once per game turn, after doDeals: market rate and capital,
+//                                  market bonds, floating rates, wars, deaths, defaults, offers
+//   CvPlayer::doGold               the borrower pays (CvGame::recordDebtPayments) only what it has;
+//                                  receipts are credited to the lender at its next doGold
+//   CvPlayer::calculateBaseNetGold reads the per-player caches; never loops over contracts
+//   CvNetModNetMessage::Execute    ids 7000-7099: actions from the screens, run on every machine
+//   CvTeam::declareWar             a borrower declaring war on its lender defaults
+// All arithmetic is in integers (AIDebtPolicy.h).
+
+#include "CvGameCoreDLL.h"
+#include "CvDebt.h"
+#include "AIDebtPolicy.h"
+#include "CvGameAI.h"
+#include "CvPlayerAI.h"
+#include "CvTeamAI.h"
+#include "CvGlobals.h"
+#include "CvDLLInterfaceIFaceBase.h"
+
+// ---------------------------------------------------------------------------------------------
+// Records
+
+CvDebtContract::CvDebtContract() :
+	iID(-1), eKind(DEBT_LOAN), eBorrower(NO_PLAYER), eLender(NO_PLAYER), iPrincipal(0),
+	iOutstanding(0), iRatePpm(0), iSpreadPpm(0), iPayment(0), iSignTurn(0), iMaturityTurn(0),
+	iArrears(0), iMissedTurns(0), eCollateral(DEBT_COLLATERAL_NONE), iCollateralData(-1),
+	iConditions(DEBT_CONDITION_NONE)
+{
+}
+
+void CvDebtContract::read(FDataStreamBase* pStream)
+{
+	uint uiFlag = 0;
+	pStream->Read(&uiFlag);
+	pStream->Read(&iID);
+	pStream->Read(&eKind);
+	pStream->Read(&eBorrower);
+	pStream->Read(&eLender);
+	pStream->Read(&iPrincipal);
+	pStream->Read(&iOutstanding);
+	pStream->Read(&iRatePpm);
+	pStream->Read(&iSpreadPpm);
+	pStream->Read(&iPayment);
+	pStream->Read(&iSignTurn);
+	pStream->Read(&iMaturityTurn);
+	pStream->Read(&iArrears);
+	pStream->Read(&iMissedTurns);
+	pStream->Read(&eCollateral);
+	pStream->Read(&iCollateralData);
+	pStream->Read(&iConditions);
+}
+
+void CvDebtContract::write(FDataStreamBase* pStream) const
+{
+	uint uiFlag = 0;
+	pStream->Write(uiFlag);
+	pStream->Write(iID);
+	pStream->Write(eKind);
+	pStream->Write(eBorrower);
+	pStream->Write(eLender);
+	pStream->Write(iPrincipal);
+	pStream->Write(iOutstanding);
+	pStream->Write(iRatePpm);
+	pStream->Write(iSpreadPpm);
+	pStream->Write(iPayment);
+	pStream->Write(iSignTurn);
+	pStream->Write(iMaturityTurn);
+	pStream->Write(iArrears);
+	pStream->Write(iMissedTurns);
+	pStream->Write(eCollateral);
+	pStream->Write(iCollateralData);
+	pStream->Write(iConditions);
+}
+
+CvDebtOffer::CvDebtOffer() :
+	iID(-1), eFrom(NO_PLAYER), eTo(NO_PLAYER), bFromLends(true), eKind(DEBT_LOAN), iAmount(0),
+	iTermIndex(0), eCollateral(DEBT_COLLATERAL_NONE), iCollateralData(-1),
+	iConditions(DEBT_CONDITION_NONE), iRatePpm(0), iExpireTurn(0)
+{
+}
+
+void CvDebtOffer::read(FDataStreamBase* pStream)
+{
+	uint uiFlag = 0;
+	pStream->Read(&uiFlag);
+	pStream->Read(&iID);
+	pStream->Read(&eFrom);
+	pStream->Read(&eTo);
+	pStream->Read(&bFromLends);
+	pStream->Read(&eKind);
+	pStream->Read(&iAmount);
+	pStream->Read(&iTermIndex);
+	pStream->Read(&eCollateral);
+	pStream->Read(&iCollateralData);
+	pStream->Read(&iConditions);
+	pStream->Read(&iRatePpm);
+	pStream->Read(&iExpireTurn);
+}
+
+void CvDebtOffer::write(FDataStreamBase* pStream) const
+{
+	uint uiFlag = 0;
+	pStream->Write(uiFlag);
+	pStream->Write(iID);
+	pStream->Write(eFrom);
+	pStream->Write(eTo);
+	pStream->Write(bFromLends);
+	pStream->Write(eKind);
+	pStream->Write(iAmount);
+	pStream->Write(iTermIndex);
+	pStream->Write(eCollateral);
+	pStream->Write(iCollateralData);
+	pStream->Write(iConditions);
+	pStream->Write(iRatePpm);
+	pStream->Write(iExpireTurn);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Helpers
+
+namespace
+{
+int debtDefine(const char* szName)
+{
+	return GC.getDefineINT(szName);
+}
+
+bool isCivPlayer(int ePlayer)
+{
+	return ePlayer >= 0 && ePlayer < MAX_CIV_PLAYERS;
+}
+
+bool isLivingCiv(int ePlayer)
+{
+	return isCivPlayer(ePlayer) && GET_PLAYER((PlayerTypes)ePlayer).isAlive() &&
+		!GET_PLAYER((PlayerTypes)ePlayer).isBarbarian();
+}
+
+// "1.25" for 12500 ppm: the rate per turn in percent with two decimals.
+CvWString rateString(int iRatePpm)
+{
+	CvWString szRate;
+	const int iHundredths = (iRatePpm + 50) / 100;
+	szRate.Format(L"%d.%02d", iHundredths / 100, iHundredths % 100);
+	return szRate;
+}
+
+CvWString partyName(int ePlayer)
+{
+	if (!isCivPlayer(ePlayer))
+	{
+		return gDLL->getText("TXT_KEY_DEBT_MARKET_NAME");
+	}
+	return GET_PLAYER((PlayerTypes)ePlayer).getCivilizationShortDescription();
+}
+
+void tellPlayer(int ePlayer, const CvWString& szText)
+{
+	if (isLivingCiv(ePlayer) && GET_PLAYER((PlayerTypes)ePlayer).isHuman())
+	{
+		gDLL->getInterfaceIFace()->addMessage((PlayerTypes)ePlayer, false, GC.getEVENT_MESSAGE_TIME(), szText,
+			"AS2D_COINS", MESSAGE_TYPE_INFO, NULL, (ColorTypes)GC.getInfoTypeForString("COLOR_YELLOW"));
+	}
+}
+
+bool atWarBetween(int ePlayer, int eOther)
+{
+	if (!isCivPlayer(ePlayer) || !isCivPlayer(eOther))
+	{
+		return false;
+	}
+	return GET_TEAM(GET_PLAYER((PlayerTypes)ePlayer).getTeam()).isAtWar(GET_PLAYER((PlayerTypes)eOther).getTeam());
+}
+}
+
+// ---------------------------------------------------------------------------------------------
+// CvPlayer: caches and credit
+
+int CvPlayer::getDebtDuePerTurn() const
+{
+	return m_iDebtDuePerTurn;
+}
+
+int CvPlayer::getDebtIncomePerTurn() const
+{
+	return m_iDebtIncomePerTurn;
+}
+
+int CvPlayer::getDebtOutstanding() const
+{
+	return m_iDebtOutstanding;
+}
+
+int CvPlayer::getDebtHeld() const
+{
+	return m_iDebtHeld;
+}
+
+int CvPlayer::getDebtReceivable() const
+{
+	return m_iDebtReceivable;
+}
+
+void CvPlayer::changeDebtReceivable(int iChange)
+{
+	m_iDebtReceivable += iChange;
+}
+
+int CvPlayer::getDebtDefaultTurns() const
+{
+	return m_iDebtDefaultTurns;
+}
+
+void CvPlayer::setDebtDefaultTurns(int iTurns)
+{
+	m_iDebtDefaultTurns = std::max(0, iTurns);
+}
+
+void CvPlayer::setDebtCaches(int iDue, int iIncome, int iOutstanding, int iHeld)
+{
+	m_iDebtDuePerTurn = iDue;
+	m_iDebtIncomePerTurn = iIncome;
+	m_iDebtOutstanding = iOutstanding;
+	m_iDebtHeld = iHeld;
+}
+
+// Gross commerce that debt service is measured against: gold and research, plus gold per turn
+// received from other civilizations.
+int CvPlayer::getDebtGrossCommerce() const
+{
+	return std::max(1, getCommerceRate(COMMERCE_GOLD) + getCommerceRate(COMMERCE_RESEARCH) + std::max(0, getGoldPerTurn()));
+}
+
+int CvPlayer::getCreditScore() const
+{
+	if (!isAlive() || isBarbarian())
+	{
+		return 0;
+	}
+	const int iServicePercent = (getDebtDuePerTurn() * 100) / getDebtGrossCommerce();
+	const CvTeamAI& kTeam = GET_TEAM(getTeam());
+	const bool bAtWar = kTeam.getAtWarCount(true) > 0;
+	bool bLosing = false;
+	if (bAtWar)
+	{
+		int iTheirSuccess = 0;
+		int iOurSuccess = 0;
+		for (int iTeam = 0; iTeam < MAX_CIV_TEAMS; ++iTeam)
+		{
+			if (iTeam != getTeam() && GET_TEAM((TeamTypes)iTeam).isAlive() && kTeam.isAtWar((TeamTypes)iTeam))
+			{
+				iTheirSuccess += GET_TEAM((TeamTypes)iTeam).AI_getWarSuccess(getTeam());
+				iOurSuccess += kTeam.AI_getWarSuccess((TeamTypes)iTeam);
+			}
+		}
+		bLosing = iTheirSuccess > iOurSuccess * 2 && iTheirSuccess > 0;
+	}
+	return AIDebtPolicy::creditScore(iServicePercent, GET_PLAYER(getID()).AI_isFinancialTrouble(),
+		getDebtDefaultTurns(), bAtWar, bLosing, getNumCities());
+}
+
+// ---------------------------------------------------------------------------------------------
+// CvGame: access
+
+int CvGame::getNumDebts() const
+{
+	return (int)m_aDebts.size();
+}
+
+const CvDebtContract* CvGame::getDebtByIndex(int iIndex) const
+{
+	if (iIndex < 0 || iIndex >= (int)m_aDebts.size())
+	{
+		return NULL;
+	}
+	return &m_aDebts[iIndex];
+}
+
+CvDebtContract* CvGame::getDebt(int iID)
+{
+	for (uint i = 0; i < m_aDebts.size(); ++i)
+	{
+		if (m_aDebts[i].iID == iID)
+		{
+			return &m_aDebts[i];
+		}
+	}
+	return NULL;
+}
+
+int CvGame::getDebtField(int iIndex, int eField) const
+{
+	const CvDebtContract* pDebt = getDebtByIndex(iIndex);
+	if (pDebt == NULL)
+	{
+		return -1;
+	}
+	switch (eField)
+	{
+	case DEBT_FIELD_ID: return pDebt->iID;
+	case DEBT_FIELD_KIND: return pDebt->eKind;
+	case DEBT_FIELD_BORROWER: return pDebt->eBorrower;
+	case DEBT_FIELD_LENDER: return pDebt->eLender;
+	case DEBT_FIELD_PRINCIPAL: return pDebt->iPrincipal;
+	case DEBT_FIELD_OUTSTANDING: return pDebt->iOutstanding;
+	case DEBT_FIELD_RATE_PPM: return pDebt->iRatePpm;
+	case DEBT_FIELD_PAYMENT: return pDebt->iPayment;
+	case DEBT_FIELD_SIGN_TURN: return pDebt->iSignTurn;
+	case DEBT_FIELD_MATURITY_TURN: return pDebt->iMaturityTurn;
+	case DEBT_FIELD_ARREARS: return pDebt->iArrears;
+	case DEBT_FIELD_MISSED_TURNS: return pDebt->iMissedTurns;
+	case DEBT_FIELD_COLLATERAL: return pDebt->eCollateral;
+	case DEBT_FIELD_COLLATERAL_DATA: return pDebt->iCollateralData;
+	case DEBT_FIELD_CONDITIONS: return pDebt->iConditions;
+	case DEBT_FIELD_FROZEN: return isDebtFrozen(*pDebt) ? 1 : 0;
+	case DEBT_FIELD_DUE: return getDebtDue(*pDebt);
+	}
+	return -1;
+}
+
+int CvGame::getNumDebtOffers() const
+{
+	return (int)m_aDebtOffers.size();
+}
+
+int CvGame::getDebtOfferField(int iIndex, int eField) const
+{
+	if (iIndex < 0 || iIndex >= (int)m_aDebtOffers.size())
+	{
+		return -1;
+	}
+	const CvDebtOffer& kOffer = m_aDebtOffers[iIndex];
+	switch (eField)
+	{
+	case DEBT_OFFER_FIELD_ID: return kOffer.iID;
+	case DEBT_OFFER_FIELD_FROM: return kOffer.eFrom;
+	case DEBT_OFFER_FIELD_TO: return kOffer.eTo;
+	case DEBT_OFFER_FIELD_FROM_LENDS: return kOffer.bFromLends ? 1 : 0;
+	case DEBT_OFFER_FIELD_KIND: return kOffer.eKind;
+	case DEBT_OFFER_FIELD_AMOUNT: return kOffer.iAmount;
+	case DEBT_OFFER_FIELD_TERM_INDEX: return kOffer.iTermIndex;
+	case DEBT_OFFER_FIELD_COLLATERAL: return kOffer.eCollateral;
+	case DEBT_OFFER_FIELD_COLLATERAL_DATA: return kOffer.iCollateralData;
+	case DEBT_OFFER_FIELD_CONDITIONS: return kOffer.iConditions;
+	case DEBT_OFFER_FIELD_RATE_PPM: return kOffer.iRatePpm;
+	case DEBT_OFFER_FIELD_EXPIRE_TURN: return kOffer.iExpireTurn;
+	}
+	return -1;
+}
+
+int CvGame::getMarketBaseRatePpm() const
+{
+	return m_iMarketBaseRatePpm;
+}
+
+int CvGame::getMarketCapital() const
+{
+	return m_iMarketCapital;
+}
+
+bool CvGame::isDebtEnabled() const
+{
+	return debtDefine("DEBT_ENABLE") > 0;
+}
+
+// Total turns of this game speed, percent of a Normal game (Normal 700 turns, Marathon 1470: 210).
+// Game speed does not change during a game, so the value is cached until the next reset.
+int CvGame::getDebtLengthPercent() const
+{
+	if (m_iDebtLengthPercent > 0)
+	{
+		return m_iDebtLengthPercent;
+	}
+	int iTurns = 0;
+	if (getGameSpeedType() != NO_GAMESPEED)
+	{
+		const CvGameSpeedInfo& kSpeed = GC.getGameSpeedInfo(getGameSpeedType());
+		for (int i = 0; i < kSpeed.getNumTurnIncrements(); ++i)
+		{
+			iTurns += kSpeed.getGameTurnInfo(i).iNumGameTurnsPerIncrement;
+		}
+	}
+	int iNormalTurns = 0;
+	const int eNormal = GC.getInfoTypeForString("GAMESPEED_NORMAL");
+	if (eNormal >= 0)
+	{
+		const CvGameSpeedInfo& kNormal = GC.getGameSpeedInfo((GameSpeedTypes)eNormal);
+		for (int i = 0; i < kNormal.getNumTurnIncrements(); ++i)
+		{
+			iNormalTurns += kNormal.getGameTurnInfo(i).iNumGameTurnsPerIncrement;
+		}
+	}
+	m_iDebtLengthPercent = (iTurns > 0 && iNormalTurns > 0) ? std::max(1, (iTurns * 100 + iNormalTurns / 2) / iNormalTurns) : 100;
+	return m_iDebtLengthPercent;
+}
+
+// A rate stated in basis points per Normal turn, as parts per million per turn of this speed.
+int CvGame::getDebtRateForSpeed(int iNormalBp) const
+{
+	return AIDebtPolicy::rateForSpeed(iNormalBp * 100, getDebtLengthPercent());
+}
+
+int CvGame::getDebtTermTurns(int iTermIndex) const
+{
+	static const char* aszTerms[NUM_DEBT_TERMS] = { "DEBT_TERM_0", "DEBT_TERM_1", "DEBT_TERM_2", "DEBT_TERM_3" };
+	const int iIndex = AIDebtPolicy::clampRange(iTermIndex, 0, NUM_DEBT_TERMS - 1);
+	return AIDebtPolicy::scaleTurns(std::max(1, debtDefine(aszTerms[iIndex])), getDebtLengthPercent());
+}
+
+int CvGame::getDebtScaledTurns(const char* szDefine) const
+{
+	return AIDebtPolicy::scaleTurns(std::max(0, debtDefine(szDefine)), getDebtLengthPercent());
+}
+
+// ---------------------------------------------------------------------------------------------
+// Pricing
+
+// The rate a borrower pays, per turn in ppm: the market base rate, the borrower's credit spread,
+// a premium per term step, and the conditions. Between civilizations the same rate is the
+// reference price; the market's capital and exclusion do not apply there.
+int CvGame::getDebtRateFor(PlayerTypes eBorrower, int eKind, int iTermIndex, int iConditions) const
+{
+	int iRate = getMarketBaseRatePpm();
+	iRate += AIDebtPolicy::creditSpread(GET_PLAYER(eBorrower).getCreditScore(), getDebtRateForSpeed(debtDefine("DEBT_MAX_SPREAD_BP")));
+	iRate += getDebtRateForSpeed(debtDefine("DEBT_TERM_PREMIUM_BP")) * AIDebtPolicy::clampRange(iTermIndex, 0, NUM_DEBT_TERMS - 1);
+	if (iConditions & DEBT_CONDITION_WAR_BOND)
+	{
+		iRate += getDebtRateForSpeed(debtDefine("DEBT_WAR_BOND_PREMIUM_BP"));
+	}
+	if (iConditions & DEBT_CONDITION_DEVELOPMENT)
+	{
+		iRate -= std::min(getDebtRateForSpeed(debtDefine("DEBT_DEVELOPMENT_DISCOUNT_BP")), getMarketBaseRatePpm() / 2);
+	}
+	return std::max(1, iRate);
+}
+
+// Why the market would refuse a borrower these conditions; NULL when it would not.
+const char* CvGame::getMarketRefusal(PlayerTypes eBorrower, int eKind, int iTermIndex, int iConditions) const
+{
+	if (!isDebtEnabled())
+	{
+		return "TXT_KEY_DEBT_REFUSE_DISABLED";
+	}
+	if (!isLivingCiv(eBorrower) || GET_PLAYER(eBorrower).getNumCities() == 0)
+	{
+		return "TXT_KEY_DEBT_REFUSE_NO_CITIES";
+	}
+	if (eKind != DEBT_LOAN && eKind != DEBT_BOND)
+	{
+		return "TXT_KEY_DEBT_REFUSE_TERMS";
+	}
+	if (iTermIndex < 0 || iTermIndex >= NUM_DEBT_TERMS)
+	{
+		return "TXT_KEY_DEBT_REFUSE_TERMS";
+	}
+	if (GET_PLAYER(eBorrower).getDebtDefaultTurns() > 0)
+	{
+		return "TXT_KEY_DEBT_REFUSE_DEFAULTED";
+	}
+	if ((iConditions & DEBT_CONDITION_WAR_BOND) && GET_TEAM(GET_PLAYER(eBorrower).getTeam()).getAtWarCount(true) == 0)
+	{
+		return "TXT_KEY_DEBT_REFUSE_NOT_AT_WAR";
+	}
+	if (iConditions & DEBT_CONDITION_DEVELOPMENT)
+	{
+		int iTotal = 0;
+		int iCount = 0;
+		for (int iPlayer = 0; iPlayer < MAX_CIV_PLAYERS; ++iPlayer)
+		{
+			if (isLivingCiv(iPlayer))
+			{
+				iTotal += getPlayerScore((PlayerTypes)iPlayer);
+				++iCount;
+			}
+		}
+		if (iCount > 0 && getPlayerScore(eBorrower) * iCount >= iTotal)
+		{
+			return "TXT_KEY_DEBT_REFUSE_NOT_BEHIND";
+		}
+	}
+	return NULL;
+}
+
+int CvGame::getMarketQuote(PlayerTypes eBorrower, int eKind, int iTermIndex, int iConditions) const
+{
+	if (getMarketRefusal(eBorrower, eKind, iTermIndex, iConditions) != NULL)
+	{
+		return -1;
+	}
+	return getDebtRateFor(eBorrower, eKind, iTermIndex, iConditions);
+}
+
+// The largest principal the market lends this borrower on these terms: total payments within
+// DEBT_MAX_SERVICE_PERCENT of gross commerce (DEBT_WAR_BOND_SERVICE_PERCENT for war bonds), at
+// most DEBT_PRINCIPAL_CAP_TURNS turns of gross commerce, and no more than the market holds.
+int CvGame::getMarketLimit(PlayerTypes eBorrower, int eKind, int iTermIndex, int iConditions) const
+{
+	const int iRate = getMarketQuote(eBorrower, eKind, iTermIndex, iConditions);
+	if (iRate < 0)
+	{
+		return 0;
+	}
+	return getDebtCapacity(eBorrower, eKind, iTermIndex, iConditions, iRate, std::max(0, getMarketCapital()));
+}
+
+int CvGame::getDebtCapacity(PlayerTypes eBorrower, int eKind, int iTermIndex, int iConditions, int iRatePpm, int iCap) const
+{
+	const CvPlayer& kBorrower = GET_PLAYER(eBorrower);
+	const int iGross = kBorrower.getDebtGrossCommerce();
+	const int iServicePercent = debtDefine((iConditions & DEBT_CONDITION_WAR_BOND) ? "DEBT_WAR_BOND_SERVICE_PERCENT" : "DEBT_MAX_SERVICE_PERCENT");
+	const int iPrincipalCap = (int)std::min((long long)iCap, (long long)iGross * std::max(1, getDebtScaledTurns("DEBT_PRINCIPAL_CAP_TURNS")));
+	return AIDebtPolicy::borrowingLimit(iGross, iServicePercent, kBorrower.getDebtDuePerTurn(), iRatePpm,
+		getDebtTermTurns(iTermIndex), eKind == DEBT_BOND, iPrincipalCap);
+}
+
+// The rate the market pays on the bonds it issues: a share of the base rate plus the term premium.
+int CvGame::getMarketDepositRate(int iTermIndex) const
+{
+	const int iRate = (getMarketBaseRatePpm() * std::max(0, debtDefine("DEBT_DEPOSIT_PERCENT"))) / 100;
+	return std::max(1, iRate + getDebtRateForSpeed(debtDefine("DEBT_TERM_PREMIUM_BP")) * AIDebtPolicy::clampRange(iTermIndex, 0, NUM_DEBT_TERMS - 1));
+}
+
+// What the market pays for a claim held by a civilization: the present value of the payments
+// left, at the borrower's market rate (the base rate for the market's own bonds). -1 if the
+// market would not buy it.
+int CvGame::getDebtSalePrice(int iID) const
+{
+	const CvDebtContract* pDebt = NULL;
+	for (uint i = 0; i < m_aDebts.size(); ++i)
+	{
+		if (m_aDebts[i].iID == iID)
+		{
+			pDebt = &m_aDebts[i];
+		}
+	}
+	if (pDebt == NULL || !isCivPlayer(pDebt->eLender) || isDebtFrozen(*pDebt) || pDebt->iArrears > 0)
+	{
+		return -1;
+	}
+	const int iTurnsLeft = std::max(0, pDebt->iMaturityTurn - GC.getGameINLINE().getGameTurn());
+	int iDiscount = getMarketBaseRatePpm();
+	if (isCivPlayer(pDebt->eBorrower))
+	{
+		iDiscount = getDebtRateFor((PlayerTypes)pDebt->eBorrower, pDebt->eKind, NUM_DEBT_TERMS - 1, DEBT_CONDITION_NONE);
+	}
+	int iPrice;
+	if (pDebt->eKind == DEBT_BOND)
+	{
+		iPrice = AIDebtPolicy::presentValue(pDebt->iPayment, iTurnsLeft, pDebt->iOutstanding, iDiscount);
+	}
+	else
+	{
+		const int iTurns = std::max(1, iTurnsLeft);
+		const int iPayment = AIDebtPolicy::annuityPayment(pDebt->iOutstanding, pDebt->iRatePpm, iTurns);
+		iPrice = AIDebtPolicy::presentValue(iPayment, iTurns, 0, iDiscount);
+	}
+	iPrice = std::min(iPrice, pDebt->iOutstanding + pDebt->iOutstanding / 2);
+	return (iPrice > 0 && iPrice <= getMarketCapital()) ? iPrice : -1;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Payment rules
+
+bool CvGame::isDebtFrozen(const CvDebtContract& kDebt) const
+{
+	return atWarBetween(kDebt.eBorrower, kDebt.eLender);
+}
+
+// What the borrower owes this turn: the scheduled payment plus arrears, capped at what is owed;
+// at or after maturity, everything owed. Interest of the turn is included.
+int CvGame::getDebtDue(const CvDebtContract& kDebt) const
+{
+	if (!isCivPlayer(kDebt.eBorrower) || isDebtFrozen(kDebt))
+	{
+		return 0;
+	}
+	const int iOwed = kDebt.iOutstanding + AIDebtPolicy::interestFor(kDebt.iOutstanding, kDebt.iRatePpm);
+	if (GC.getGameINLINE().getGameTurn() >= kDebt.iMaturityTurn)
+	{
+		return iOwed;
+	}
+	return std::min(iOwed, kDebt.iPayment + kDebt.iArrears);
+}
+
+void CvGame::updateDebtCaches(PlayerTypes ePlayer)
+{
+	if (!isCivPlayer(ePlayer))
+	{
+		return;
+	}
+	int iDue = 0;
+	int iIncome = 0;
+	int iOutstanding = 0;
+	int iHeld = 0;
+	for (uint i = 0; i < m_aDebts.size(); ++i)
+	{
+		const CvDebtContract& kDebt = m_aDebts[i];
+		if (kDebt.eBorrower == ePlayer)
+		{
+			iDue += getDebtDue(kDebt);
+			iOutstanding += kDebt.iOutstanding;
+		}
+		if (kDebt.eLender == ePlayer)
+		{
+			iHeld += kDebt.iOutstanding;
+			if (!isDebtFrozen(kDebt))
+			{
+				// The market pays its coupons and principal in doDebt; civilizations as they can.
+				iIncome += isCivPlayer(kDebt.eBorrower) ? getDebtDue(kDebt) :
+					((GC.getGameINLINE().getGameTurn() >= kDebt.iMaturityTurn) ? kDebt.iOutstanding + kDebt.iPayment : kDebt.iPayment);
+			}
+		}
+	}
+	GET_PLAYER(ePlayer).setDebtCaches(iDue, iIncome, iOutstanding, iHeld);
+}
+
+void CvGame::updateAllDebtCaches()
+{
+	for (int iPlayer = 0; iPlayer < MAX_CIV_PLAYERS; ++iPlayer)
+	{
+		updateDebtCaches((PlayerTypes)iPlayer);
+	}
+}
+
+void CvGame::creditDebtLender(int eLender, int iAmount)
+{
+	if (iAmount <= 0)
+	{
+		return;
+	}
+	if (isCivPlayer(eLender))
+	{
+		GET_PLAYER((PlayerTypes)eLender).changeDebtReceivable(iAmount);
+	}
+	else
+	{
+		m_iMarketCapital += iAmount;
+	}
+}
+
+// Called by the borrower's doGold with what it actually paid this turn (its due less the part
+// it could not pay). The payment is spread over its contracts, oldest first; each contract's
+// unpaid part becomes arrears, with a penalty. Lenders receive what was paid, at their next doGold.
+void CvGame::recordDebtPayments(PlayerTypes eBorrower, int iPaid)
+{
+	int iLeft = std::max(0, iPaid);
+	bool abTouched[MAX_CIV_PLAYERS];
+	for (int iPlayer = 0; iPlayer < MAX_CIV_PLAYERS; ++iPlayer)
+	{
+		abTouched[iPlayer] = false;
+	}
+	abTouched[eBorrower] = true;
+	const int iPenaltyPpm = getDebtRateForSpeed(debtDefine("DEBT_ARREARS_PENALTY_BP"));
+	bool bEnded = false;
+	for (uint i = 0; i < m_aDebts.size(); ++i)
+	{
+		CvDebtContract& kDebt = m_aDebts[i];
+		if (kDebt.eBorrower != eBorrower || isDebtFrozen(kDebt))
+		{
+			continue;
+		}
+		const int iDue = getDebtDue(kDebt);
+		const int iInterest = AIDebtPolicy::interestFor(kDebt.iOutstanding, kDebt.iRatePpm);
+		const int iPay = std::min(iLeft, iDue);
+		iLeft -= iPay;
+		kDebt.iOutstanding = std::max(0, kDebt.iOutstanding + iInterest - iPay);
+		const int iShort = iDue - iPay;
+		if (GC.getGameINLINE().getGameTurn() >= kDebt.iMaturityTurn)
+		{
+			kDebt.iArrears = kDebt.iOutstanding;
+		}
+		else
+		{
+			kDebt.iArrears = std::max(0, std::min(kDebt.iOutstanding, kDebt.iArrears + kDebt.iPayment - iPay));
+		}
+		if (iShort > 0)
+		{
+			kDebt.iOutstanding += AIDebtPolicy::interestFor(iShort, iPenaltyPpm);
+			++kDebt.iMissedTurns;
+		}
+		else
+		{
+			kDebt.iMissedTurns = 0;
+		}
+		creditDebtLender(kDebt.eLender, iPay);
+		if (isCivPlayer(kDebt.eLender))
+		{
+			abTouched[kDebt.eLender] = true;
+		}
+		if (kDebt.iOutstanding <= 0)
+		{
+			bEnded = true;
+		}
+	}
+	if (bEnded)
+	{
+		removeEndedDebts();
+	}
+	for (int iPlayer = 0; iPlayer < MAX_CIV_PLAYERS; ++iPlayer)
+	{
+		if (abTouched[iPlayer])
+		{
+			updateDebtCaches((PlayerTypes)iPlayer);
+		}
+	}
+}
+
+void CvGame::removeEndedDebts()
+{
+	std::vector<CvDebtContract> aKept;
+	for (uint i = 0; i < m_aDebts.size(); ++i)
+	{
+		const CvDebtContract& kDebt = m_aDebts[i];
+		if (kDebt.iOutstanding > 0)
+		{
+			aKept.push_back(kDebt);
+		}
+		else
+		{
+			const CvWString szText = gDLL->getText("TXT_KEY_DEBT_REPAID", partyName(kDebt.eBorrower).GetCString(), partyName(kDebt.eLender).GetCString());
+			tellPlayer(kDebt.eBorrower, szText);
+			tellPlayer(kDebt.eLender, szText);
+		}
+	}
+	m_aDebts.swap(aKept);
+}
+
+// ---------------------------------------------------------------------------------------------
+// Signing and ending
+
+// A new contract; moves the principal from lender to borrower (from the market's capital when
+// the lender is the market, into it when the borrower is). Returns the id, or -1.
+int CvGame::signDebt(int eKind, int eBorrower, int eLender, int iAmount, int iTermIndex, int iRatePpm,
+	int iSpreadPpm, int eCollateral, int iCollateralData, int iConditions)
+{
+	if (iAmount <= 0 || (eBorrower == eLender) || (!isCivPlayer(eBorrower) && !isCivPlayer(eLender)))
+	{
+		return -1;
+	}
+	if (isCivPlayer(eLender))
+	{
+		if (GET_PLAYER((PlayerTypes)eLender).getGold() < iAmount)
+		{
+			return -1;
+		}
+	}
+	else if (getMarketCapital() < iAmount)
+	{
+		return -1;
+	}
+
+	CvDebtContract kDebt;
+	kDebt.iID = m_iNextDebtID++;
+	kDebt.eKind = eKind;
+	kDebt.eBorrower = eBorrower;
+	kDebt.eLender = eLender;
+	kDebt.iPrincipal = iAmount;
+	kDebt.iOutstanding = iAmount;
+	kDebt.iRatePpm = std::max(1, iRatePpm);
+	kDebt.iSpreadPpm = iSpreadPpm;
+	const int iTurns = getDebtTermTurns(iTermIndex);
+	kDebt.iPayment = (eKind == DEBT_BOND) ? AIDebtPolicy::couponPayment(iAmount, kDebt.iRatePpm) :
+		AIDebtPolicy::annuityPayment(iAmount, kDebt.iRatePpm, iTurns);
+	kDebt.iSignTurn = GC.getGameINLINE().getGameTurn();
+	kDebt.iMaturityTurn = GC.getGameINLINE().getGameTurn() + iTurns;
+	kDebt.eCollateral = eCollateral;
+	kDebt.iCollateralData = iCollateralData;
+	kDebt.iConditions = iConditions;
+
+	if (isCivPlayer(eLender))
+	{
+		GET_PLAYER((PlayerTypes)eLender).changeGold(-iAmount);
+	}
+	else
+	{
+		m_iMarketCapital -= iAmount;
+	}
+	if (isCivPlayer(eBorrower))
+	{
+		GET_PLAYER((PlayerTypes)eBorrower).changeGold(iAmount);
+	}
+	else
+	{
+		m_iMarketCapital += iAmount;
+	}
+	m_aDebts.push_back(kDebt);
+	updateDebtCaches((PlayerTypes)eBorrower);
+	updateDebtCaches((PlayerTypes)eLender);
+
+	if (isCivPlayer(eBorrower))
+	{
+		tellPlayer(eBorrower, gDLL->getText("TXT_KEY_DEBT_SIGNED_BORROW", iAmount, partyName(eLender).GetCString(),
+			rateString(kDebt.iRatePpm).GetCString(), iTurns));
+	}
+	if (isCivPlayer(eLender))
+	{
+		tellPlayer(eLender, gDLL->getText("TXT_KEY_DEBT_SIGNED_LEND", iAmount, partyName(eBorrower).GetCString(),
+			rateString(kDebt.iRatePpm).GetCString(), iTurns));
+	}
+	return kDebt.iID;
+}
+
+bool CvGame::borrowFromMarket(PlayerTypes eBorrower, int eKind, int iAmount, int iTermIndex, int iConditions)
+{
+	iConditions &= (DEBT_CONDITION_WAR_BOND | DEBT_CONDITION_DEVELOPMENT | DEBT_CONDITION_FLOATING);
+	const int iRate = getMarketQuote(eBorrower, eKind, iTermIndex, iConditions);
+	if (iRate < 0 || iAmount < std::max(1, debtDefine("DEBT_MIN_AMOUNT")) ||
+		iAmount > getMarketLimit(eBorrower, eKind, iTermIndex, iConditions))
+	{
+		tellPlayer(eBorrower, gDLL->getText("TXT_KEY_DEBT_REFUSED"));
+		return false;
+	}
+	return signDebt(eKind, eBorrower, NO_PLAYER, iAmount, iTermIndex, iRate, iRate - getMarketBaseRatePpm(),
+		DEBT_COLLATERAL_NONE, -1, iConditions) >= 0;
+}
+
+// A civilization buys a bond of the market: it lends to the market at the market's deposit rate.
+bool CvGame::lendToMarket(PlayerTypes eLender, int iAmount, int iTermIndex)
+{
+	if (!isDebtEnabled() || !isLivingCiv(eLender) || iTermIndex < 0 || iTermIndex >= NUM_DEBT_TERMS ||
+		iAmount < std::max(1, debtDefine("DEBT_MIN_AMOUNT")) || GET_PLAYER(eLender).getGold() < iAmount)
+	{
+		tellPlayer(eLender, gDLL->getText("TXT_KEY_DEBT_REFUSED"));
+		return false;
+	}
+	return signDebt(DEBT_BOND, NO_PLAYER, eLender, iAmount, iTermIndex, getMarketDepositRate(iTermIndex), 0,
+		DEBT_COLLATERAL_NONE, -1, DEBT_CONDITION_NONE) >= 0;
+}
+
+// The borrower repays everything owed, plus DEBT_EARLY_REPAY_TURNS turns of interest before maturity.
+bool CvGame::repayDebt(PlayerTypes eBorrower, int iID)
+{
+	CvDebtContract* pDebt = getDebt(iID);
+	if (pDebt == NULL || pDebt->eBorrower != eBorrower)
+	{
+		return false;
+	}
+	int iCost = pDebt->iOutstanding;
+	if (GC.getGameINLINE().getGameTurn() < pDebt->iMaturityTurn)
+	{
+		iCost += AIDebtPolicy::interestFor(pDebt->iOutstanding, pDebt->iRatePpm) * std::max(0, debtDefine("DEBT_EARLY_REPAY_TURNS"));
+	}
+	if (GET_PLAYER(eBorrower).getGold() < iCost)
+	{
+		tellPlayer(eBorrower, gDLL->getText("TXT_KEY_DEBT_REFUSED"));
+		return false;
+	}
+	GET_PLAYER(eBorrower).changeGold(-iCost);
+	const int eLender = pDebt->eLender;
+	creditDebtLender(eLender, iCost);
+	pDebt->iOutstanding = 0;
+	removeEndedDebts();
+	updateDebtCaches(eBorrower);
+	updateDebtCaches((PlayerTypes)eLender);
+	return true;
+}
+
+// The holder sells its claim to the market for getDebtSalePrice. A bond of the market itself is
+// redeemed and ends; any other claim passes to the market, which the borrower then pays.
+bool CvGame::sellDebt(PlayerTypes eLender, int iID)
+{
+	CvDebtContract* pDebt = getDebt(iID);
+	if (pDebt == NULL || pDebt->eLender != eLender)
+	{
+		return false;
+	}
+	const int iPrice = getDebtSalePrice(iID);
+	if (iPrice < 0)
+	{
+		tellPlayer(eLender, gDLL->getText("TXT_KEY_DEBT_REFUSED"));
+		return false;
+	}
+	m_iMarketCapital -= iPrice;
+	GET_PLAYER(eLender).changeGold(iPrice);
+	const int eBorrower = pDebt->eBorrower;
+	if (isCivPlayer(eBorrower))
+	{
+		pDebt->eLender = NO_PLAYER;
+	}
+	else
+	{
+		pDebt->iOutstanding = 0;
+		removeEndedDebts();
+	}
+	tellPlayer(eLender, gDLL->getText("TXT_KEY_DEBT_SOLD", iPrice));
+	updateDebtCaches(eLender);
+	updateDebtCaches((PlayerTypes)eBorrower);
+	return true;
+}
+
+// Default: the collateral goes to the lender, the borrower is shut out of the market for
+// DEBT_DEFAULT_EXCLUSION_TURNS, a civilization lender remembers it, and the claim is written off.
+void CvGame::defaultDebt(int iID)
+{
+	CvDebtContract* pDebt = getDebt(iID);
+	if (pDebt == NULL)
+	{
+		return;
+	}
+	const CvDebtContract kDebt = *pDebt;
+	pDebt->iOutstanding = 0;
+
+	if (isLivingCiv(kDebt.eBorrower))
+	{
+		CvPlayerAI& kBorrower = GET_PLAYER((PlayerTypes)kDebt.eBorrower);
+		kBorrower.setDebtDefaultTurns(getDebtScaledTurns("DEBT_DEFAULT_EXCLUSION_TURNS"));
+		if (isLivingCiv(kDebt.eLender))
+		{
+			CvPlayerAI& kLender = GET_PLAYER((PlayerTypes)kDebt.eLender);
+			kLender.AI_changeDebtDefaultMemory((PlayerTypes)kDebt.eBorrower, getDebtScaledTurns("DEBT_DEFAULT_MEMORY_TURNS"));
+			if (kDebt.eCollateral == DEBT_COLLATERAL_RESOURCE && kDebt.iCollateralData >= 0 &&
+				kDebt.iCollateralData < GC.getNumBonusInfos() &&
+				kBorrower.getNumTradeableBonuses((BonusTypes)kDebt.iCollateralData) > 0 &&
+				!atWarBetween(kDebt.eBorrower, kDebt.eLender))
+			{
+				CLinkList<TradeData> ourList;
+				CLinkList<TradeData> theirList;
+				TradeData item;
+				setTradeItem(&item, TRADE_RESOURCES, kDebt.iCollateralData);
+				ourList.insertAtEnd(item);
+				implementDeal((PlayerTypes)kDebt.eBorrower, (PlayerTypes)kDebt.eLender, &ourList, &theirList, true);
+			}
+			else if (kDebt.eCollateral == DEBT_COLLATERAL_CITY)
+			{
+				CvCity* pCity = kBorrower.getCity(kDebt.iCollateralData);
+				if (pCity != NULL && !pCity->isCapital() && kBorrower.getNumCities() > 1)
+				{
+					kLender.acquireCity(pCity, false, true, true);
+				}
+			}
+		}
+	}
+
+	const CvWString szText = gDLL->getText("TXT_KEY_DEBT_DEFAULT", partyName(kDebt.eBorrower).GetCString(),
+		kDebt.iOutstanding, partyName(kDebt.eLender).GetCString());
+	for (int iPlayer = 0; iPlayer < MAX_CIV_PLAYERS; ++iPlayer)
+	{
+		if (iPlayer == kDebt.eBorrower || iPlayer == kDebt.eLender ||
+			(isLivingCiv(iPlayer) && isCivPlayer(kDebt.eBorrower) &&
+			 GET_TEAM(GET_PLAYER((PlayerTypes)iPlayer).getTeam()).isHasMet(GET_PLAYER((PlayerTypes)kDebt.eBorrower).getTeam())))
+		{
+			tellPlayer(iPlayer, szText);
+		}
+	}
+
+	// removeEndedDebts would report a repayment; drop the contract silently instead.
+	std::vector<CvDebtContract> aKept;
+	for (uint i = 0; i < m_aDebts.size(); ++i)
+	{
+		if (m_aDebts[i].iID != iID)
+		{
+			aKept.push_back(m_aDebts[i]);
+		}
+	}
+	m_aDebts.swap(aKept);
+	updateDebtCaches((PlayerTypes)kDebt.eBorrower);
+	updateDebtCaches((PlayerTypes)kDebt.eLender);
+}
+
+// From CvTeam::declareWar: every contract a member of the declaring team owes to a member of
+// the target team is in default. Contracts the other way are frozen while the war lasts.
+void CvGame::onDebtWarDeclared(TeamTypes eDeclarer, TeamTypes eTarget)
+{
+	std::vector<int> aiDefaults;
+	for (uint i = 0; i < m_aDebts.size(); ++i)
+	{
+		const CvDebtContract& kDebt = m_aDebts[i];
+		if (isCivPlayer(kDebt.eBorrower) && isCivPlayer(kDebt.eLender) &&
+			GET_PLAYER((PlayerTypes)kDebt.eBorrower).getTeam() == eDeclarer &&
+			GET_PLAYER((PlayerTypes)kDebt.eLender).getTeam() == eTarget)
+		{
+			aiDefaults.push_back(kDebt.iID);
+		}
+	}
+	for (uint i = 0; i < aiDefaults.size(); ++i)
+	{
+		defaultDebt(aiDefaults[i]);
+	}
+	for (int iPlayer = 0; iPlayer < MAX_CIV_PLAYERS; ++iPlayer)
+	{
+		const TeamTypes eTeam = GET_PLAYER((PlayerTypes)iPlayer).getTeam();
+		if (eTeam == eDeclarer || eTeam == eTarget)
+		{
+			updateDebtCaches((PlayerTypes)iPlayer);
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------------------------
+// Offers between civilizations
+
+// Why an offer between two civilizations cannot be made or accepted now; NULL when it can.
+const char* CvGame::getDebtOfferRefusal(const CvDebtOffer& kOffer) const
+{
+	if (!isDebtEnabled())
+	{
+		return "TXT_KEY_DEBT_REFUSE_DISABLED";
+	}
+	if (!isLivingCiv(kOffer.eFrom) || !isLivingCiv(kOffer.eTo) || kOffer.eFrom == kOffer.eTo)
+	{
+		return "TXT_KEY_DEBT_REFUSE_TERMS";
+	}
+	const CvPlayer& kFrom = GET_PLAYER((PlayerTypes)kOffer.eFrom);
+	const CvPlayer& kTo = GET_PLAYER((PlayerTypes)kOffer.eTo);
+	if (kFrom.getTeam() == kTo.getTeam() || !GET_TEAM(kFrom.getTeam()).isHasMet(kTo.getTeam()) ||
+		GET_TEAM(kFrom.getTeam()).isAtWar(kTo.getTeam()))
+	{
+		return "TXT_KEY_DEBT_REFUSE_RELATIONS";
+	}
+	if ((kOffer.eKind != DEBT_LOAN && kOffer.eKind != DEBT_BOND) || kOffer.iTermIndex < 0 || kOffer.iTermIndex >= NUM_DEBT_TERMS ||
+		kOffer.iAmount < std::max(1, debtDefine("DEBT_MIN_AMOUNT")))
+	{
+		return "TXT_KEY_DEBT_REFUSE_TERMS";
+	}
+	const CvPlayer& kLender = kOffer.bFromLends ? kFrom : kTo;
+	const CvPlayer& kBorrower = kOffer.bFromLends ? kTo : kFrom;
+	if (kLender.getGold() < kOffer.iAmount)
+	{
+		return "TXT_KEY_DEBT_REFUSE_GOLD";
+	}
+	if (kBorrower.getNumCities() == 0)
+	{
+		return "TXT_KEY_DEBT_REFUSE_NO_CITIES";
+	}
+	if (kOffer.eCollateral == DEBT_COLLATERAL_RESOURCE)
+	{
+		if (kOffer.iCollateralData < 0 || kOffer.iCollateralData >= GC.getNumBonusInfos() ||
+			kBorrower.getNumTradeableBonuses((BonusTypes)kOffer.iCollateralData) <= 0)
+		{
+			return "TXT_KEY_DEBT_REFUSE_COLLATERAL";
+		}
+	}
+	else if (kOffer.eCollateral == DEBT_COLLATERAL_CITY)
+	{
+		const CvCity* pCity = kBorrower.getCity(kOffer.iCollateralData);
+		if (pCity == NULL || pCity->isCapital())
+		{
+			return "TXT_KEY_DEBT_REFUSE_COLLATERAL";
+		}
+	}
+	else if (kOffer.eCollateral != DEBT_COLLATERAL_NONE)
+	{
+		return "TXT_KEY_DEBT_REFUSE_COLLATERAL";
+	}
+	return NULL;
+}
+
+// A proposal between civilizations. An AI answers at once (on every machine, from synced
+// state); a human answers through the Debt screen before the offer expires. Returns the
+// offer id, or -1 when it was refused or answered at once.
+int CvGame::makeDebtOffer(PlayerTypes eFrom, PlayerTypes eTo, bool bFromLends, int eKind, int iAmount,
+	int iTermIndex, int eCollateral, int iCollateralData, int iConditions)
+{
+	CvDebtOffer kOffer;
+	kOffer.iID = m_iNextDebtID++;
+	kOffer.eFrom = eFrom;
+	kOffer.eTo = eTo;
+	kOffer.bFromLends = bFromLends;
+	kOffer.eKind = eKind;
+	kOffer.iAmount = iAmount;
+	kOffer.iTermIndex = iTermIndex;
+	kOffer.eCollateral = eCollateral;
+	kOffer.iCollateralData = iCollateralData;
+	kOffer.iConditions = (iConditions & DEBT_CONDITION_NO_WAR);
+	kOffer.iExpireTurn = GC.getGameINLINE().getGameTurn() + getDebtScaledTurns("DEBT_OFFER_TURNS");
+	const char* szRefusal = getDebtOfferRefusal(kOffer);
+	if (szRefusal != NULL)
+	{
+		tellPlayer(eFrom, gDLL->getText(szRefusal));
+		return -1;
+	}
+	const PlayerTypes eBorrower = bFromLends ? eTo : eFrom;
+	kOffer.iRatePpm = getDebtRateFor(eBorrower, eKind, iTermIndex, DEBT_CONDITION_NONE);
+	// Collateral lowers the price: the lender's loss on default is smaller.
+	if (eCollateral != DEBT_COLLATERAL_NONE)
+	{
+		kOffer.iRatePpm = std::max(getMarketBaseRatePpm(), kOffer.iRatePpm - (kOffer.iRatePpm - getMarketBaseRatePpm()) / 2);
+	}
+
+	if (!GET_PLAYER(eTo).isHuman())
+	{
+		const bool bAccept = GET_PLAYER(eTo).AI_considerLoan(eFrom, !bFromLends, eKind, iAmount, iTermIndex,
+			kOffer.iRatePpm, eCollateral, iCollateralData);
+		if (bAccept)
+		{
+			signDebtOffer(kOffer);
+		}
+		else
+		{
+			tellPlayer(eFrom, gDLL->getText("TXT_KEY_DEBT_OFFER_REFUSED", partyName(eTo).GetCString()));
+		}
+		return -1;
+	}
+
+	// One pending offer per pair and direction: a new one replaces the old.
+	std::vector<CvDebtOffer> aKept;
+	for (uint i = 0; i < m_aDebtOffers.size(); ++i)
+	{
+		if (!(m_aDebtOffers[i].eFrom == eFrom && m_aDebtOffers[i].eTo == eTo))
+		{
+			aKept.push_back(m_aDebtOffers[i]);
+		}
+	}
+	m_aDebtOffers.swap(aKept);
+	m_aDebtOffers.push_back(kOffer);
+	tellPlayer(eTo, gDLL->getText(bFromLends ? "TXT_KEY_DEBT_OFFER_RECEIVED_LEND" : "TXT_KEY_DEBT_OFFER_RECEIVED_BORROW",
+		partyName(eFrom).GetCString(), iAmount, rateString(kOffer.iRatePpm).GetCString(), getDebtTermTurns(iTermIndex)));
+	return kOffer.iID;
+}
+
+void CvGame::signDebtOffer(const CvDebtOffer& kOffer)
+{
+	const int eLender = kOffer.bFromLends ? kOffer.eFrom : kOffer.eTo;
+	const int eBorrower = kOffer.bFromLends ? kOffer.eTo : kOffer.eFrom;
+	signDebt(kOffer.eKind, eBorrower, eLender, kOffer.iAmount, kOffer.iTermIndex, kOffer.iRatePpm, 0,
+		kOffer.eCollateral, kOffer.iCollateralData, kOffer.iConditions | DEBT_CONDITION_NO_WAR);
+}
+
+bool CvGame::acceptDebtOffer(PlayerTypes eBy, int iOfferID)
+{
+	for (uint i = 0; i < m_aDebtOffers.size(); ++i)
+	{
+		if (m_aDebtOffers[i].iID == iOfferID && m_aDebtOffers[i].eTo == eBy)
+		{
+			const CvDebtOffer kOffer = m_aDebtOffers[i];
+			m_aDebtOffers.erase(m_aDebtOffers.begin() + i);
+			const char* szRefusal = getDebtOfferRefusal(kOffer);
+			if (szRefusal != NULL)
+			{
+				tellPlayer(eBy, gDLL->getText(szRefusal));
+				return false;
+			}
+			signDebtOffer(kOffer);
+			return true;
+		}
+	}
+	return false;
+}
+
+void CvGame::refuseDebtOffer(PlayerTypes eBy, int iOfferID)
+{
+	for (uint i = 0; i < m_aDebtOffers.size(); ++i)
+	{
+		if (m_aDebtOffers[i].iID == iOfferID && (m_aDebtOffers[i].eTo == eBy || m_aDebtOffers[i].eFrom == eBy))
+		{
+			const CvDebtOffer kOffer = m_aDebtOffers[i];
+			m_aDebtOffers.erase(m_aDebtOffers.begin() + i);
+			if (kOffer.eTo == eBy)
+			{
+				tellPlayer(kOffer.eFrom, gDLL->getText("TXT_KEY_DEBT_OFFER_REFUSED", partyName(eBy).GetCString()));
+			}
+			return;
+		}
+	}
+}
+
+// ---------------------------------------------------------------------------------------------
+// Network messages (CvNetModNetMessage::Execute). Every machine runs the same code on the same
+// synced state, so no screen ever changes the game itself.
+
+bool CvGame::handleDebtMessage(int iData1, int iData2, int iData3, int iData4, int iData5)
+{
+	if (iData1 < DEBT_MESSAGE_FIRST || iData1 > DEBT_MESSAGE_LAST)
+	{
+		return false;
+	}
+	const int ePlayer = iData2 & 0xFF;
+	if (!isLivingCiv(ePlayer))
+	{
+		return true;
+	}
+	const PlayerTypes eActor = (PlayerTypes)ePlayer;
+	switch (iData1)
+	{
+	case DEBT_MESSAGE_BORROW:
+		borrowFromMarket(eActor, (iData2 >> 8) & 0xF, iData3, iData4, (iData2 >> 12) & DEBT_CONDITION_ALL);
+		break;
+	case DEBT_MESSAGE_LEND_MARKET:
+		lendToMarket(eActor, iData3, iData4);
+		break;
+	case DEBT_MESSAGE_REPAY:
+		repayDebt(eActor, iData3);
+		break;
+	case DEBT_MESSAGE_SELL:
+		sellDebt(eActor, iData3);
+		break;
+	case DEBT_MESSAGE_OFFER:
+		{
+			const int eOther = (iData2 >> 8) & 0xFF;
+			if (isLivingCiv(eOther))
+			{
+				makeDebtOffer(eActor, (PlayerTypes)eOther, ((iData2 >> 16) & 1) != 0, (iData2 >> 17) & 3, iData3, iData4,
+					(iData2 >> 19) & 7, iData5, ((iData2 >> 22) & 1) ? DEBT_CONDITION_NO_WAR : DEBT_CONDITION_NONE);
+			}
+		}
+		break;
+	case DEBT_MESSAGE_ACCEPT:
+		acceptDebtOffer(eActor, iData3);
+		break;
+	case DEBT_MESSAGE_REFUSE:
+		refuseDebtOffer(eActor, iData3);
+		break;
+	}
+	return true;
+}
+
+// ---------------------------------------------------------------------------------------------
+// Once per game turn, after doDeals.
+
+void CvGame::doDebt()
+{
+	if (!isDebtEnabled())
+	{
+		return;
+	}
+	PROFILE_FUNC();
+
+	int iWorldGold = 0;
+	int iAlive = 0;
+	int iInflation100 = 0;
+	for (int iPlayer = 0; iPlayer < MAX_CIV_PLAYERS; ++iPlayer)
+	{
+		if (isLivingCiv(iPlayer))
+		{
+			const CvPlayer& kPlayer = GET_PLAYER((PlayerTypes)iPlayer);
+			iWorldGold += std::max(0, kPlayer.getCommerceRate(COMMERCE_GOLD));
+			iInflation100 += kPlayer.calculateInflationRate() * 100;
+			++iAlive;
+		}
+	}
+	iInflation100 = (iAlive > 0) ? iInflation100 / iAlive : 0;
+
+	// The market: its capital starts with DEBT_MARKET_START_CAPITAL per civilization and
+	// grows by DEBT_MARKET_INFLOW_PERCENT of the world's gold commerce each turn.
+	if (!m_bMarketInitialized)
+	{
+		m_iMarketCapital = std::max(0, debtDefine("DEBT_MARKET_START_CAPITAL")) * std::max(1, iAlive);
+		m_iMarketLastInflation100 = iInflation100;
+		m_iMarketBaseRatePpm = getDebtRateForSpeed(debtDefine("DEBT_REAL_RATE_BP"));
+		m_bMarketInitialized = true;
+	}
+	const int iInflow = (iWorldGold * std::max(0, debtDefine("DEBT_MARKET_INFLOW_PERCENT"))) / 100;
+	m_iMarketCapital += iInflow;
+
+	// The base rate moves an eighth of the way to its target each turn: a real rate, plus the
+	// rise of the average price level (inflation) over the last turn, dearer when capital is
+	// scarce and cheaper when it is plentiful.
+	{
+		int iReal = getDebtRateForSpeed(debtDefine("DEBT_REAL_RATE_BP"));
+		const long long iTarget = (long long)std::max(1, iInflow) * std::max(1, getDebtScaledTurns("DEBT_MARKET_TARGET_TURNS"));
+		if ((long long)m_iMarketCapital * 4 < iTarget)
+		{
+			iReal = (iReal * 3) / 2;
+		}
+		else if ((long long)m_iMarketCapital > iTarget * 2)
+		{
+			iReal = (iReal * 3) / 4;
+		}
+		const int iInflationPpm = std::max(0, (int)(((long long)(iInflation100 - m_iMarketLastInflation100) * 1000000) / (10000 + std::max(0, m_iMarketLastInflation100))));
+		m_iMarketLastInflation100 = iInflation100;
+		const int iTargetRate = std::max(1, iReal + std::min(iInflationPpm, 100000));
+		int iStep = (iTargetRate - m_iMarketBaseRatePpm) / 8;
+		if (iStep == 0 && iTargetRate != m_iMarketBaseRatePpm)
+		{
+			iStep = (iTargetRate > m_iMarketBaseRatePpm) ? 1 : -1;
+		}
+		m_iMarketBaseRatePpm = std::max(1, m_iMarketBaseRatePpm + iStep);
+	}
+
+	std::vector<int> aiDefaults;
+	const int iGrace = std::max(1, getDebtScaledTurns("DEBT_GRACE_TURNS"));
+	for (uint i = 0; i < m_aDebts.size(); ++i)
+	{
+		CvDebtContract& kDebt = m_aDebts[i];
+
+		// A dead party ends the contract: a dead borrower's debts are written off, a dead
+		// lender's claims lapse.
+		if ((isCivPlayer(kDebt.eBorrower) && !GET_PLAYER((PlayerTypes)kDebt.eBorrower).isAlive()) ||
+			(isCivPlayer(kDebt.eLender) && !GET_PLAYER((PlayerTypes)kDebt.eLender).isAlive()))
+		{
+			kDebt.iOutstanding = 0;
+			continue;
+		}
+
+		// War between the parties freezes the contract and moves its maturity on.
+		if (isDebtFrozen(kDebt))
+		{
+			++kDebt.iMaturityTurn;
+			continue;
+		}
+
+		// A floating rate follows the base rate; a loan's payment is set again over the turns left.
+		if ((kDebt.iConditions & DEBT_CONDITION_FLOATING) && !isCivPlayer(kDebt.eLender))
+		{
+			kDebt.iRatePpm = std::max(1, m_iMarketBaseRatePpm + kDebt.iSpreadPpm);
+			if (kDebt.eKind == DEBT_BOND)
+			{
+				kDebt.iPayment = AIDebtPolicy::couponPayment(kDebt.iPrincipal, kDebt.iRatePpm);
+			}
+			else if (GC.getGameINLINE().getGameTurn() < kDebt.iMaturityTurn)
+			{
+				kDebt.iPayment = AIDebtPolicy::annuityPayment(kDebt.iOutstanding, kDebt.iRatePpm, kDebt.iMaturityTurn - GC.getGameINLINE().getGameTurn());
+			}
+		}
+
+		// The market's own bonds: it pays the coupon each turn and the principal at maturity.
+		if (!isCivPlayer(kDebt.eBorrower))
+		{
+			int iPay = kDebt.iPayment;
+			if (GC.getGameINLINE().getGameTurn() >= kDebt.iMaturityTurn)
+			{
+				iPay += kDebt.iOutstanding;
+				kDebt.iOutstanding = 0;
+			}
+			m_iMarketCapital -= iPay;
+			creditDebtLender(kDebt.eLender, iPay);
+			continue;
+		}
+
+		if (kDebt.iMissedTurns >= iGrace)
+		{
+			aiDefaults.push_back(kDebt.iID);
+		}
+	}
+	for (uint i = 0; i < aiDefaults.size(); ++i)
+	{
+		defaultDebt(aiDefaults[i]);
+	}
+	{
+		// Contracts ended by death or maturity of the market's bonds.
+		std::vector<CvDebtContract> aKept;
+		for (uint i = 0; i < m_aDebts.size(); ++i)
+		{
+			if (m_aDebts[i].iOutstanding > 0)
+			{
+				aKept.push_back(m_aDebts[i]);
+			}
+		}
+		m_aDebts.swap(aKept);
+	}
+
+	// Offers expire.
+	{
+		std::vector<CvDebtOffer> aKept;
+		for (uint i = 0; i < m_aDebtOffers.size(); ++i)
+		{
+			if (m_aDebtOffers[i].iExpireTurn > GC.getGameINLINE().getGameTurn() && isLivingCiv(m_aDebtOffers[i].eFrom) && isLivingCiv(m_aDebtOffers[i].eTo))
+			{
+				aKept.push_back(m_aDebtOffers[i]);
+			}
+		}
+		m_aDebtOffers.swap(aKept);
+	}
+
+	for (int iPlayer = 0; iPlayer < MAX_CIV_PLAYERS; ++iPlayer)
+	{
+		CvPlayer& kPlayer = GET_PLAYER((PlayerTypes)iPlayer);
+		if (kPlayer.getDebtDefaultTurns() > 0)
+		{
+			kPlayer.setDebtDefaultTurns(kPlayer.getDebtDefaultTurns() - 1);
+		}
+	}
+	updateAllDebtCaches();
+}
+
+void CvGame::resetDebt()
+{
+	m_aDebts.clear();
+	m_aDebtOffers.clear();
+	m_iNextDebtID = 0;
+	m_iMarketBaseRatePpm = 0;
+	m_iMarketCapital = 0;
+	m_iMarketLastInflation100 = 0;
+	m_bMarketInitialized = false;
+	m_iDebtLengthPercent = -1;
+}
+
+void CvGame::readDebt(FDataStreamBase* pStream)
+{
+	uint uiFlag = 0;
+	pStream->Read(&uiFlag);
+	pStream->Read(&m_iNextDebtID);
+	pStream->Read(&m_iMarketBaseRatePpm);
+	pStream->Read(&m_iMarketCapital);
+	pStream->Read(&m_iMarketLastInflation100);
+	pStream->Read(&m_bMarketInitialized);
+	uint iSize = 0;
+	pStream->Read(&iSize);
+	m_aDebts.clear();
+	for (uint i = 0; i < iSize; ++i)
+	{
+		CvDebtContract kDebt;
+		kDebt.read(pStream);
+		m_aDebts.push_back(kDebt);
+	}
+	pStream->Read(&iSize);
+	m_aDebtOffers.clear();
+	for (uint i = 0; i < iSize; ++i)
+	{
+		CvDebtOffer kOffer;
+		kOffer.read(pStream);
+		m_aDebtOffers.push_back(kOffer);
+	}
+}
+
+void CvGame::writeDebt(FDataStreamBase* pStream)
+{
+	uint uiFlag = 0;
+	pStream->Write(uiFlag);
+	pStream->Write(m_iNextDebtID);
+	pStream->Write(m_iMarketBaseRatePpm);
+	pStream->Write(m_iMarketCapital);
+	pStream->Write(m_iMarketLastInflation100);
+	pStream->Write(m_bMarketInitialized);
+	pStream->Write((uint)m_aDebts.size());
+	for (uint i = 0; i < m_aDebts.size(); ++i)
+	{
+		m_aDebts[i].write(pStream);
+	}
+	pStream->Write((uint)m_aDebtOffers.size());
+	for (uint i = 0; i < m_aDebtOffers.size(); ++i)
+	{
+		m_aDebtOffers[i].write(pStream);
+	}
+}
+
+// ---------------------------------------------------------------------------------------------
+// The AI (called from CvPlayerAI::AI_doTurnPost after AI_doDiplo)
+
+int CvPlayerAI::AI_getDebtDefaultMemory(PlayerTypes eIndex) const
+{
+	return (eIndex >= 0 && eIndex < MAX_PLAYERS) ? m_aiDebtDefaultMemory[eIndex] : 0;
+}
+
+void CvPlayerAI::AI_changeDebtDefaultMemory(PlayerTypes eIndex, int iChange)
+{
+	if (eIndex >= 0 && eIndex < MAX_PLAYERS)
+	{
+		m_aiDebtDefaultMemory[eIndex] = std::max(0, m_aiDebtDefaultMemory[eIndex] + iChange);
+		AI_invalidateAttitudeCache(eIndex);
+	}
+}
+
+// A default against us costs attitude while it is remembered: DEBT_ATTITUDE_DEFAULT at first,
+// fading with the memory. A loan being repaid to us is worth one point, like trade.
+int CvPlayerAI::AI_getDebtAttitude(PlayerTypes ePlayer) const
+{
+	if (ePlayer < 0 || ePlayer >= MAX_CIV_PLAYERS || !GC.getGameINLINE().isDebtEnabled())
+	{
+		return 0;
+	}
+	int iAttitude = 0;
+	const int iMemory = AI_getDebtDefaultMemory(ePlayer);
+	if (iMemory > 0)
+	{
+		const int iFull = std::max(1, GC.getGameINLINE().getDebtScaledTurns("DEBT_DEFAULT_MEMORY_TURNS"));
+		const int iMax = std::max(0, GC.getDefineINT("DEBT_ATTITUDE_DEFAULT"));
+		iAttitude -= std::max(1, (iMax * std::min(iMemory, iFull) + iFull - 1) / iFull);
+	}
+	const CvGame& kGame = GC.getGameINLINE();
+	for (int i = 0; i < kGame.getNumDebts(); ++i)
+	{
+		const CvDebtContract* pDebt = kGame.getDebtByIndex(i);
+		if (pDebt->eLender == getID() && pDebt->eBorrower == ePlayer && pDebt->iArrears == 0 && !kGame.isDebtFrozen(*pDebt))
+		{
+			iAttitude += 1;
+			break;
+		}
+	}
+	return iAttitude;
+}
+
+// Would this AI agree to a loan with eOther? bWeLend: this AI lends iAmount to eOther; otherwise
+// eOther lends it to this AI. The rate and terms are those of the offer.
+bool CvPlayerAI::AI_considerLoan(PlayerTypes eOther, bool bWeLend, int eKind, int iAmount, int iTermIndex,
+	int iRatePpm, int eCollateral, int iCollateralData) const
+{
+	const CvGame& kGame = GC.getGameINLINE();
+	if (!kGame.isDebtEnabled() || isHuman() || eOther == getID() || iAmount <= 0)
+	{
+		return false;
+	}
+	const TeamTypes eOtherTeam = GET_PLAYER(eOther).getTeam();
+	const bool bWarPlan = GET_TEAM(getTeam()).AI_getWarPlan(eOtherTeam) != NO_WARPLAN;
+	const int iTurns = kGame.getDebtTermTurns(iTermIndex);
+	const int iPayment = (eKind == DEBT_BOND) ? AIDebtPolicy::couponPayment(iAmount, iRatePpm) :
+		AIDebtPolicy::annuityPayment(iAmount, iRatePpm, iTurns);
+
+	if (bWeLend)
+	{
+		// Never lend to a team we plan war on (it would strengthen a future enemy, and the
+		// war would freeze the payments), nor to one that defaulted on us, nor beyond spare gold.
+		if (bWarPlan || AI_getDebtDefaultMemory(eOther) > 0 || AI_getAttitude(eOther) <= ATTITUDE_ANNOYED)
+		{
+			return false;
+		}
+		if (iAmount > getGold() - AI_goldTarget())
+		{
+			return false;
+		}
+		// The chance that payments continue: high with friends and good credit, lower otherwise.
+		int iContinue = 70;
+		switch (AI_getAttitude(eOther))
+		{
+		case ATTITUDE_FRIENDLY: iContinue = 95; break;
+		case ATTITUDE_PLEASED: iContinue = 90; break;
+		case ATTITUDE_CAUTIOUS: iContinue = 80; break;
+		default: break;
+		}
+		iContinue -= (100 - GET_PLAYER(eOther).getCreditScore()) / 3;
+		if (eCollateral != DEBT_COLLATERAL_NONE)
+		{
+			iContinue += 10;
+		}
+		if (GET_TEAM(eOtherTeam).getAtWarCount(true) > 0)
+		{
+			iContinue -= 5;
+		}
+		iContinue = AIDebtPolicy::clampRange(iContinue, 0, 98);
+		const int iHurdle = kGame.getMarketBaseRatePpm() + kGame.getDebtRateForSpeed(GC.getDefineINT("DEBT_AI_HURDLE_BP"));
+		const int iLump = (eKind == DEBT_BOND) ? iAmount : 0;
+		return AIDebtPolicy::loanValueToLender(iAmount, iPayment, iTurns, iLump, iHurdle, iContinue) > 0;
+	}
+
+	// We borrow. Not from a team we plan war on: declaring that war would be default.
+	if (bWarPlan || getDebtDefaultTurns() > 0)
+	{
+		return false;
+	}
+	// No city as collateral unless the treasury is in trouble.
+	if (eCollateral == DEBT_COLLATERAL_CITY && !AI_isFinancialTrouble())
+	{
+		return false;
+	}
+	// The payments must fit: within the service limit, and the payer's cost of the payment
+	// (AI_goldPerTurnCostVal, up to twice its trade value when uncovered) below what the gold
+	// is worth to us now.
+	if (iAmount > kGame.getDebtCapacity(getID(), eKind, iTermIndex, DEBT_CONDITION_NONE, iRatePpm, iAmount))
+	{
+		return false;
+	}
+	const bool bNeed = AI_isFinancialTrouble() || getGold() < AI_goldTarget() ||
+		GET_TEAM(getTeam()).getAnyWarPlanCount(true) > 0;
+	if (!bNeed)
+	{
+		return false;
+	}
+	// Cheaper than or equal to what the market would charge us, or the market would refuse us.
+	const int iMarketRate = kGame.getMarketQuote(getID(), eKind, iTermIndex, DEBT_CONDITION_NONE);
+	return iMarketRate < 0 || iRatePpm <= iMarketRate;
+}
+
+void CvPlayerAI::AI_doDebt()
+{
+	CvGame& kGame = GC.getGameINLINE();
+	for (int iPlayer = 0; iPlayer < MAX_PLAYERS; ++iPlayer)
+	{
+		if (m_aiDebtDefaultMemory[iPlayer] > 0)
+		{
+			--m_aiDebtDefaultMemory[iPlayer];
+			if (m_aiDebtDefaultMemory[iPlayer] == 0)
+			{
+				AI_invalidateAttitudeCache((PlayerTypes)iPlayer);
+			}
+		}
+	}
+	if (!kGame.isDebtEnabled() || isHuman() || isBarbarian() || isMinorCiv() || getNumCities() == 0)
+	{
+		return;
+	}
+	kGame.updateDebtCaches(getID());
+	const int iMinAmount = std::max(1, GC.getDefineINT("DEBT_MIN_AMOUNT"));
+	bool bInArrears = false;
+	for (int i = 0; i < kGame.getNumDebts(); ++i)
+	{
+		const CvDebtContract* pDebt = kGame.getDebtByIndex(i);
+		if (pDebt->eBorrower == getID() && pDebt->iArrears > 0)
+		{
+			bInArrears = true;
+		}
+	}
+
+	// 1. Avoid a strike: borrow from the market the gold that next turn's deficit would take,
+	//    for the shortest term's worth of turns, as far as the market lends.
+	const int iNextGold = getGold() + calculateGoldRate();
+	if (iNextGold < 0 && !bInArrears)
+	{
+		const int iNeed = std::max(iMinAmount, -iNextGold * kGame.getDebtTermTurns(0) / 2);
+		const int iLimit = kGame.getMarketLimit(getID(), DEBT_LOAN, 0, DEBT_CONDITION_NONE);
+		const int iAmount = std::min(iNeed, iLimit);
+		if (iAmount >= std::max(iMinAmount, -iNextGold))
+		{
+			kGame.borrowFromMarket(getID(), DEBT_LOAN, iAmount, 0, DEBT_CONDITION_NONE);
+			return;
+		}
+	}
+
+	// 2. A war chest: at war or preparing one, with a sound treasury below its target and good
+	//    credit, borrow up to the target (a war bond at war, a loan before).
+	const bool bAtWar = GET_TEAM(getTeam()).getAtWarCount(true) > 0;
+	if ((bAtWar || GET_TEAM(getTeam()).getAnyWarPlanCount(true) > 0) && !bInArrears && !AI_isFinancialTrouble() &&
+		getGold() < AI_goldTarget() && getCreditScore() >= 50 && getDebtDuePerTurn() == 0)
+	{
+		const int iConditions = bAtWar ? DEBT_CONDITION_WAR_BOND : DEBT_CONDITION_NONE;
+		const int iKind = bAtWar ? DEBT_BOND : DEBT_LOAN;
+		const int iAmount = std::min(AI_goldTarget() - getGold(), kGame.getMarketLimit(getID(), iKind, 1, iConditions));
+		if (iAmount >= iMinAmount * 2)
+		{
+			kGame.borrowFromMarket(getID(), iKind, iAmount, 1, iConditions);
+			return;
+		}
+	}
+
+	// 3. Repay early the dearest debt when gold is well above the target.
+	if (getDebtOutstanding() > 0 && !AI_isFinancialTrouble())
+	{
+		int iBestID = -1;
+		int iBestRate = 0;
+		int iBestCost = 0;
+		for (int i = 0; i < kGame.getNumDebts(); ++i)
+		{
+			const CvDebtContract* pDebt = kGame.getDebtByIndex(i);
+			if (pDebt->eBorrower == getID() && pDebt->iRatePpm > iBestRate && !kGame.isDebtFrozen(*pDebt))
+			{
+				iBestID = pDebt->iID;
+				iBestRate = pDebt->iRatePpm;
+				iBestCost = pDebt->iOutstanding + AIDebtPolicy::interestFor(pDebt->iOutstanding, pDebt->iRatePpm) *
+					std::max(0, GC.getDefineINT("DEBT_EARLY_REPAY_TURNS"));
+			}
+		}
+		if (iBestID >= 0 && getGold() - iBestCost > 2 * AI_goldTarget())
+		{
+			kGame.repayDebt(getID(), iBestID);
+			return;
+		}
+	}
+
+	// 4. Lend spare gold: gold beyond twice the target, with a sound treasury and no war planned.
+	const int iSpare = getGold() - 2 * AI_goldTarget();
+	if (iSpare < iMinAmount * 2 || AI_isFinancialTrouble() || GET_TEAM(getTeam()).getAnyWarPlanCount(true) > 0)
+	{
+		return;
+	}
+	// 4a. Every DEBT_AI_OFFER_INTERVAL turns, offer a loan to the civilization we like best that
+	//     is short of gold. An AI answers at once; a human sees the offer on its Debt screen.
+	const int iInterval = std::max(1, kGame.getDebtScaledTurns("DEBT_AI_OFFER_INTERVAL"));
+	if ((kGame.getGameTurn() + getID()) % iInterval == 0)
+	{
+		PlayerTypes eBest = NO_PLAYER;
+		int iBestAttitude = MIN_INT;
+		for (int iPlayer = 0; iPlayer < MAX_CIV_PLAYERS; ++iPlayer)
+		{
+			const CvPlayerAI& kOther = GET_PLAYER((PlayerTypes)iPlayer);
+			if (iPlayer == getID() || !kOther.isAlive() || kOther.isMinorCiv() || kOther.getTeam() == getTeam() ||
+				!GET_TEAM(getTeam()).isHasMet(kOther.getTeam()) || GET_TEAM(getTeam()).isAtWar(kOther.getTeam()) ||
+				kOther.getNumCities() == 0 || kOther.getDebtDefaultTurns() > 0 ||
+				!canContact((PlayerTypes)iPlayer) || AI_getAttitude((PlayerTypes)iPlayer) < ATTITUDE_PLEASED)
+			{
+				continue;
+			}
+			const bool bShort = kOther.AI_isFinancialTrouble() || kOther.getGold() + kOther.calculateGoldRate() < 0;
+			if (!bShort)
+			{
+				continue;
+			}
+			const int iValue = AI_getAttitudeVal((PlayerTypes)iPlayer);
+			if (iValue > iBestAttitude)
+			{
+				iBestAttitude = iValue;
+				eBest = (PlayerTypes)iPlayer;
+			}
+		}
+		if (eBest != NO_PLAYER)
+		{
+			const int iRate = kGame.getDebtRateFor(eBest, DEBT_LOAN, 1, DEBT_CONDITION_NONE);
+			const int iAmount = std::min(iSpare / 2, kGame.getDebtCapacity(eBest, DEBT_LOAN, 1, DEBT_CONDITION_NONE, iRate, iSpare / 2));
+			if (iAmount >= iMinAmount && AI_considerLoan(eBest, true, DEBT_LOAN, iAmount, 1, iRate, DEBT_COLLATERAL_NONE, -1))
+			{
+				kGame.makeDebtOffer(getID(), eBest, true, DEBT_LOAN, iAmount, 1, DEBT_COLLATERAL_NONE, -1, DEBT_CONDITION_NO_WAR);
+				return;
+			}
+		}
+	}
+	// 4b. Otherwise buy a bond of the market with half the spare gold, up to twice the gold target held.
+	if (getDebtHeld() < 2 * AI_goldTarget())
+	{
+		const int iAmount = std::min(iSpare / 2, 2 * AI_goldTarget() - getDebtHeld());
+		if (iAmount >= iMinAmount)
+		{
+			kGame.lendToMarket(getID(), iAmount, 1);
+		}
+	}
+}
