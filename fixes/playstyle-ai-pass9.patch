+					(iAdjDanger == iBestDanger && iAdjDefPct > iBestDefPct))
+				{
+					pBestRetreat = pAdj;
+					iBestDanger = iAdjDanger;
+					iBestDefPct = iAdjDefPct;
+				}
+			}
+		}
+
+		if (pBestRetreat != NULL)
+		{
+			pUnit->getGroup()->pushMission(MISSION_MOVE_TO, pBestRetreat->getX_INLINE(), pBestRetreat->getY_INLINE(), MOVE_SAFE_TERRITORY);
+			return true;
+		}
+		return false;
+	}
+
+	bool trySkirmishStepAndShoot(CvUnit* pUnit)
+	{
+		if (!isSafeIndependentSkirmisher(pUnit) || pUnit->isMadeAttack() || !pUnit->canRangeStrike())
+		{
+			return false;
+		}
+		if (pUnit->movesLeft() < 2 * GC.getMOVE_DENOMINATOR())
+		{
+			return false;
+		}
+		CvPlot* pCurPlot = pUnit->plot();
+		const CvPlayerAI& kOwner = GET_PLAYER(pUnit->getOwnerINLINE());
+		const int iAirRange = pUnit->airRange();
+		CvPlot* pBestStep = NULL;
+		int iBestScore = 0;
+
+		for (int iDir = 0; iDir < NUM_DIRECTION_TYPES; ++iDir)
+		{
+			CvPlot* pStep = plotDirection(pCurPlot->getX_INLINE(), pCurPlot->getY_INLINE(), (DirectionTypes)iDir);
+			if (pStep == NULL || pStep->isVisibleEnemyUnit(pUnit) || !pUnit->canMoveInto(pStep, false))
+			{
+				continue;
+			}
+			// Must have at least 1 full move remaining after stepping so we can fire this turn.
+			if (pUnit->movesLeft() - pStep->movementCost(pUnit, pCurPlot) < GC.getMOVE_DENOMINATOR())
+			{
+				continue;
+			}
+			const int iStepDanger = kOwner.AI_getEnemyPlotStrength(pStep, 2, false, false);
+			const int iOurDefStr = pUnit->currCombatStr(pStep, NULL);
+			int iBestTargetFromStep = 0;
+			for (int iDX = -iAirRange; iDX <= iAirRange; ++iDX)
+			{
+				for (int iDY = -iAirRange; iDY <= iAirRange; ++iDY)
+				{
+					CvPlot* pTarget = plotXY(pStep->getX_INLINE(), pStep->getY_INLINE(), iDX, iDY);
+					if (pTarget == NULL || pTarget == pStep || !pTarget->isVisibleEnemyUnit(pUnit))
+					{
+						continue;
+					}
+					const int iTgtScore = scoreGroupRangeStrikePlot(pUnit->getGroup(), pStep, pTarget, true);
+					if (iTgtScore > iBestTargetFromStep)
+					{
+						iBestTargetFromStep = iTgtScore;
+					}
+				}
+			}
+			if (AIPlaystylePolicy::shouldSkirmishStepAndShoot(
+				iStepDanger, iOurDefStr, iBestTargetFromStep, false, false, false))
+			{
+				if (iBestTargetFromStep > iBestScore)
+				{
+					iBestScore = iBestTargetFromStep;
+					pBestStep = pStep;
+				}
+			}
+		}
+
+		if (pBestStep != NULL)
+		{
+			pUnit->getGroup()->pushMission(MISSION_MOVE_TO, pBestStep->getX_INLINE(), pBestStep->getY_INLINE(), 0);
+			return true;
+		}
+		return false;
+	}
+
+	int bestScientistAcademyNpv(const CvUnit* pUnit)
+	{
+		if (pUnit == NULL)
+		{
+			return 0;
+		}
+		const CvPlayerAI& kOwner = GET_PLAYER(pUnit->getOwnerINLINE());
+		const CvUnitInfo& kUnitInfo = GC.getUnitInfo(pUnit->getUnitType());
+		const int iMaxTurns = GC.getGameINLINE().getMaxTurns();
+		const int iRemainingTurns = (iMaxTurns > 0)
+			? std::max(20, iMaxTurns - GC.getGameINLINE().getElapsedGameTurns())
+			: 60;
+		int iBestNpv = 0;
+		int iLoop = 0;
+		for (CvCity* pLoopCity = kOwner.firstCity(&iLoop); pLoopCity != NULL; pLoopCity = kOwner.nextCity(&iLoop))
+		{
+			if (pLoopCity->area() != pUnit->area())
+			{
+				continue;
+			}
+			for (int iBC = 0; iBC < GC.getNumBuildingClassInfos(); ++iBC)
+			{
+				BuildingTypes eBldg = (BuildingTypes)GC.getCivilizationInfo(pUnit->getCivilizationType()).getCivilizationBuildings(iBC);
+				if (eBldg == NO_BUILDING)
+				{
+					continue;
+				}
+				if (!(kUnitInfo.getBuildings(eBldg) || kUnitInfo.getForceBuildings(eBldg)))
+				{
+					continue;
+				}
+				const CvBuildingInfo& kBldg = GC.getBuildingInfo(eBldg);
+				const int iSciMod = kBldg.getCommerceModifier(COMMERCE_RESEARCH);
+				if (iSciMod > 0 && pLoopCity->getNumBuilding(eBldg) == 0 && pUnit->canConstruct(pLoopCity->plot(), eBldg))
+				{
+					const int iNpv = AIPlaystylePolicy::academyConstructNpv(
+						pLoopCity->getBaseCommerceRate(COMMERCE_RESEARCH), iSciMod, iRemainingTurns);
+					if (iNpv > iBestNpv)
+					{
+						iBestNpv = iNpv;
+					}
+				}
+			}
+		}
+		return iBestNpv;
+	}
 }
 
