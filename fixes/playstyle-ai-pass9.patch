+// Pure deterministic C++98 policies for RoM tactical and economic AI:
+//   - Projected trade-route base for 0-route cities (INITIAL_TRADE_ROUTES = 0)
+//   - Unified Great Person marginal expected value & full Golden Age valuation
+//   - Land XML iAirRange target scoring, stack sequencing & safe skirmishing
+//   - Unit turn-time ROI specialization & land ranged/trait valuation
+//   - Tangential tech-for-gold selection, Food corporation weighting
+//   - Solvent Espionage & RevolutionDCM research floors, upgrade reserves
+// No engine dependencies.
+#ifndef AI_PLAYSTYLE_POLICY_H
+#define AI_PLAYSTYLE_POLICY_H
+
+#include <algorithm>
+#include <climits>
+
+namespace AIPlaystylePolicy
+{
+inline int clamp(int iVal, int iLow, int iHigh)
+{
+	return iVal < iLow ? iLow : (iVal > iHigh ? iHigh : iVal);
+}
+
+inline int saturatingInt(long long iVal)
+{
+	if (iVal <= 0) return 0;
+	if (iVal >= INT_MAX) return INT_MAX;
+	return (int)iVal;
+}
+
+// ---------------------------------------------------------------------------
+// Block #1: Trade-Route Modifier Projection for 0-Route / Low-Route Cities
+// ---------------------------------------------------------------------------
+// When INITIAL_TRADE_ROUTES == 0, a brand-new or newly conquered city has
+// getTradeYield() == 0, which previously zeroed TradeRouteModifier and
+// ForeignTradeRouteModifier on Port, Harbor, River Port, Lighthouse, Jewellery,
+// and Market. Project the route base including both routes added by this
+// building and a conservative baseline route when a pure modifier building is
+// evaluated in a city that can unlock routes shortly.
+inline int projectedTradeYield(int iCurrentTradeYield, int iCurrentRoutes,
+	int iBuildingAddedRoutes, int iAvgRouteYieldPerSlot, bool bCanGainRouteSoon)
+{
+	const int iSafeCurYield = std::max(0, iCurrentTradeYield);
+	const int iSafeCurRoutes = std::max(0, iCurrentRoutes);
+	const int iSafeAdded = std::max(0, iBuildingAddedRoutes);
+	const int iSafeAvgPerSlot = std::max(1, iAvgRouteYieldPerSlot);
+
+	int iProjected = iSafeCurYield;
+	if (iSafeAdded > 0)
+	{
+		const int iSlotYield = (iSafeCurRoutes > 0 && iSafeCurYield > 0)
+			? std::max(iSafeAvgPerSlot, iSafeCurYield / iSafeCurRoutes)
+			: iSafeAvgPerSlot;
+		const long long iTotal = (long long)iSafeCurYield + (long long)iSafeAdded * iSlotYield;
+		iProjected = saturatingInt(iTotal);
+	}
+	else if (iSafeCurYield == 0 && bCanGainRouteSoon)
+	{
+		// Discounted projection (~65% of one average route slot) so pure
+		// modifier buildings (Lighthouse/Jewellery/Market) are not scored as 0
+		// while still ranking behind buildings that create the first routes.
+		iProjected = std::max(1, (iSafeAvgPerSlot * 65) / 100);
+	}
+	return iProjected;
+}
+
+// ---------------------------------------------------------------------------
+// Block #2: Great People Expected Value & Full Golden Age Valuation
+// ---------------------------------------------------------------------------
+// Models the real empire-wide value of starting a Golden Age in the same units
+// as AI_calculateGoldenAgeValue() / getDiscoverResearch():
+//   1) Raw Golden Age tile yield bonus scaled by average empire multipliers
+//   2) Zero-anarchy civic swap savings (anarchy turns * total empire output)
+//   3) +100% Great Person rate bonus across the empire
+inline int goldenAgeTotalValue(int iRawGoldenAgeYieldVal, int iAvgCityMultiplierPct,
+	int iEmpireOutputPerTurn, int iPendingCivicAnarchyTurns, int iGoldenAgeLength,
+	int iEmpireGpRatePerTurn, bool bAlreadyInGoldenAge)
+{
+	const long long iMultPct = clamp(iAvgCityMultiplierPct, 100, 350);
+	long long iTotal = ((long long)std::max(0, iRawGoldenAgeYieldVal) * iMultPct) / 100;
+
+	// Skipping anarchy turns preserves full empire production + commerce + avoids
+	// RevolutionDCM anarchy instability. Only credited when not already in GA.
+	if (!bAlreadyInGoldenAge && iPendingCivicAnarchyTurns > 0 && iEmpireOutputPerTurn > 0)
+	{
+		const int iClampedAnarchy = clamp(iPendingCivicAnarchyTurns, 1, 6);
+		// Weight at 120% of raw lost output to reflect RevDCM instability avoidance.
+		iTotal += ((long long)iEmpireOutputPerTurn * iClampedAnarchy * 120) / 100;
+	}
+
+	// +100% GP rate across all cities refunds a fraction of the GP cost.
+	if (iEmpireGpRatePerTurn > 0 && iGoldenAgeLength > 0)
+	{
+		// Conservative conversion: each extra GP point ~ 3 beaker-equivalents.
+		iTotal += (long long)std::min(iEmpireGpRatePerTurn, 500) *
+			clamp(iGoldenAgeLength, 1, 40) * 3;
+	}
+
+	return saturatingInt(iTotal);
+}
+
+// Marginal NPV (in beaker-equivalents) of constructing a single-city Academy
+// (+iPctScience% on iCityBaseSciencePerTurn) over a discounted horizon.
+// Naturally beats Golden Age / Bulb in small early empires (few cities, huge
+// capital share) and naturally loses in 18-city / 5000-commerce empires.
+inline int academyConstructNpv(int iCityBaseSciencePerTurn, int iScienceModifierPct,
+	int iRemainingUsefulTurns)
+{
+	if (iCityBaseSciencePerTurn <= 0 || iScienceModifierPct <= 0 || iRemainingUsefulTurns <= 0)
+	{
+		return 0;
+	}
+	const int iEffectiveTurns = clamp(iRemainingUsefulTurns, 10, 75);
+	// Marginal science per turn = base * pct / 100, discounted ~60% for time value.
+	const long long iPerTurn100 = (long long)iCityBaseSciencePerTurn * iScienceModifierPct;
+	const long long iNpv = (iPerTurn100 * iEffectiveTurns * 60) / 10000;
+	return saturatingInt(iNpv);
+}
+
+// Discount factor (0..100) on using a Great Engineer to hurry a Wonder when the
+// player can gold-hurry or finish it quickly with ordinary hammers.
+inline int engineerWonderHurryDiscountPct(bool bCanGoldHurry, int iWonderGoldCost,
+	int iAvailableTreasury, int iNormalBuildTurns)
+{
+	if (iNormalBuildTurns <= 4)
+	{
+		return 15; // Already nearly done with ordinary hammers.
+	}
+	if (bCanGoldHurry && iWonderGoldCost > 0 && iAvailableTreasury >= iWonderGoldCost)
+	{
+		// Easily rushable with gold: keep the Great Engineer for Golden Age / Corp / Wonder race.
+		return 25;
+	}
+	if (bCanGoldHurry && iWonderGoldCost > 0 && iAvailableTreasury * 2 >= iWonderGoldCost)
+	{
+		return 55;
+	}
+	return 100;
+}
+
+// Food Corporation yield weight relative to Production (100):
+// In RoM, extra Food feeds population -> extra worked commerce tiles + higher
+// trade-route profit + faster Essentials tier scaling when cities have room.
+inline int foodCorporationYieldWeight(int iAvgHappyHeadroom, int iAvgHealthHeadroom)
+{
+	const int iLimiting = std::min(iAvgHappyHeadroom, iAvgHealthHeadroom);
+	if (iLimiting >= 3) return 170;
+	if (iLimiting >= 1) return 145;
+	if (iLimiting >= 0) return 120;
+	return 90;
+}
+
+// ---------------------------------------------------------------------------
+// Block #2C: Tangential Tech-for-Gold Sale Scoring
+// ---------------------------------------------------------------------------
+// Scores selling a tech to a buyer for lump-sum gold. Prefers affordable
+// tangential techs that extract maximum immediate cash while refusing to hand
+// military/era-wall advantages to border threats or active war targets.
+inline int tangentialTechSaleScore(int iTechTradeVal, int iBuyerMaxGoldVal,
+	bool bIsMilitaryUnlock, bool bIsWonderUnlock, bool bBuyerIsBorderThreat,
+	bool bBuyerIsWarTarget, bool bBuyerHigherRank)
+{
+	if (iTechTradeVal <= 0 || iBuyerMaxGoldVal <= 0) return 0;
+	if (bBuyerIsWarTarget) return 0;
+	if (bBuyerHigherRank && (bIsMilitaryUnlock || bIsWonderUnlock)) return 0;
+	if (bBuyerIsBorderThreat && bIsMilitaryUnlock) return 0;
+
+	// Must be able to extract meaningful share of tech value in cash (>= 65%).
+	if ((long long)iBuyerMaxGoldVal * 100 < (long long)iTechTradeVal * 65)
+	{
+		return 0;
+	}
+
+	const int iExtractableCashVal = std::min(iTechTradeVal, iBuyerMaxGoldVal);
+	long long iScore = iExtractableCashVal;
+
+	// Prefer tangential non-military, non-wonder techs for cash extraction.
+	if (!bIsMilitaryUnlock && !bIsWonderUnlock)
+	{
+		iScore = (iScore * 135) / 100;
+	}
+	else if (bIsMilitaryUnlock)
+	{
+		iScore = (iScore * 50) / 100;
+	}
+	else if (bIsWonderUnlock)
+	{
+		iScore = (iScore * 75) / 100;
+	}
+
+	if (bBuyerHigherRank)
+	{
+		iScore = (iScore * 60) / 100;
+	}
+	return saturatingInt(iScore);
+}
+
+// ---------------------------------------------------------------------------
+// Block #3: Land XML iAirRange Combat, Collateral Ordering & Skirmish Rules
+// ---------------------------------------------------------------------------
+// Scores a candidate target plot for a land XML ranged strike (MISSION_RANGE_ATTACK).
+// Replaces melee AI_attackOdds()! Returns 0 when zero effective damage would be
+// inflicted (already at airCombatLimit and no collateral splash).
+inline int rangeTargetScore(int iPrimaryDamage, int iCollateralDamageEst,
+	int iDefenderCombatStr100, int iDefenderCurrentHp, bool bIsTargetCity,
+	int iEnemyStackSize, bool bEnemyCanAttack, bool bIsPlotWeThreaten)
+{
+	const int iEffPrimary = std::max(0, iPrimaryDamage);
+	const int iEffCollat = std::max(0, iCollateralDamageEst);
+	const int iTotalDmg = iEffPrimary + (iEffCollat * 3) / 4;
+	if (iTotalDmg <= 0)
+	{
+		return 0;
+	}
+
+	const int iStrWeight = clamp(iDefenderCombatStr100, 100, 10000);
+	long long iScore = ((long long)iTotalDmg * iStrWeight) / 100;
+
+	// Prefer softening healthy defenders over chipping nearly-dead ones.
+	const int iHealthFactor = 75 + clamp(iDefenderCurrentHp, 0, 100) / 2;
+	iScore = (iScore * iHealthFactor) / 100;
+
+	if (bIsTargetCity)
+	{
+		iScore = (iScore * 145) / 100;
+	}
+	if (bIsPlotWeThreaten)
+	{
+		iScore = (iScore * 125) / 100;
+	}
+	if (bEnemyCanAttack)
+	{
+		iScore = (iScore * 120) / 100;
+	}
+	if (iEnemyStackSize > 1)
+	{
+		iScore = (iScore * (100 + std::min(60, (iEnemyStackSize - 1) * 15))) / 100;
+	}
+
+	return std::max(1, saturatingInt(iScore));
+}
+
+// Computes attack-ordering bonus (added on top of 0..1000 odds in LFBgetBetterAttacker)
+// so collateral cavalry (Horse Archer/Light Cav/Chariot) and siege strike BEFORE
+// melee finishers when >= 2 healthy defenders are present, without making hopeless
+// suicide attacks outrank guaranteed kills on a single defender.
+inline int collateralAttackPriorityBonus(int iOdds1000, int iCollateralDamage,
+	int iPossibleTargets, int iTopDefenderHp)
+{
+	if (iCollateralDamage <= 0 || iPossibleTargets <= 0)
+	{
+		return 0;
+	}
+	// Require either siege-level collateral (>= 50) or viable survivability (>= 25% odds).
+	if (iOdds1000 < 250 && iCollateralDamage < 50)
+	{
+		return 0;
+	}
+	const int iTargets = clamp(iPossibleTargets, 1, 6);
+	const int iCollat = clamp(iCollateralDamage, 1, 100);
+	const int iHealthScale = (iTopDefenderHp >= 70) ? 130 : ((iTopDefenderHp >= 45) ? 100 : 65);
+	// Scales proportionally with collateral power & multi-target splash:
+	// e.g. Horse Archer (collat=25, 4 targets, healthy stack) -> ~+325 rank pts,
+	// enough to precede a 70% Swordsman when HA has 45% odds!
+	const long long iBonus = ((long long)iCollat * iTargets * 25 * iHealthScale) / 1000;
+	return clamp(saturatingInt(iBonus), 0, 650);
+}
+
+// Valuation bonus in AI_unitValue() for land units with XML iAirRange >= 1
+// (Archer, Longbowman, Crossbowman, Horse Archer, Catapult, Artillery, etc.).
+inline int landRangedUnitValueBonus(int iCombatValue, int iAirCombat, int iAirRange,
+	int iAirCombatLimit, bool bHasCollateral)
+{
+	if (iCombatValue <= 0 || iAirCombat <= 0 || iAirRange <= 0 || iAirCombatLimit <= 0)
+	{
+		return 0;
+	}
+	const int iLimPct = clamp(iAirCombatLimit, 10, 100);
+	const int iRngFactor = 100 + clamp(iAirRange - 1, 0, 3) * 45;
+	// Base free-strike value scales with combat value, airLimit (e.g. 90 on Longbowman),
+	// and range (e.g. 2 on Artillery), with extra credit if ranged strike applies collateral.
+	long long iBonus = ((long long)iCombatValue * iLimPct * iRngFactor) / 22000;
+	if (bHasCollateral)
+	{
+		iBonus = (iBonus * 135) / 100;
+	}
+	return saturatingInt(iBonus);
+}
+
+// Circumstantial 2-move ranged skirmish: should an independent fast ranged unit
+// step 1 tile into firing range on this turn? Never breaks a mixed stack or escort.
+inline bool shouldSkirmishStepAndShoot(int iStepDanger, int iOurEffectiveDefenseStr,
+	int iExpectedTargetScore, bool bInMixedStack, bool bEscorting, bool bGuardingCity)
+{
+	if (bInMixedStack || bEscorting || bGuardingCity) return false;
+	if (iExpectedTargetScore <= 0) return false;
+	// Only step forward onto tiles where enemy counter-attack danger is manageable.
+	if (iStepDanger <= 0) return true;
+	return (long long)iOurEffectiveDefenseStr * 100 >= (long long)iStepDanger * 115;
+}
+
+// Circumstantial 2-move ranged skirmish: after firing with 1 move remaining,
+// should an independent ranged unit retreat 1 tile to a candidate adjacent plot?
+// Only moves if strictly safer (lower danger, or equal danger with better defense)
+// and never abandons a mixed stack, escort duty, or city defense.
+inline bool shouldSkirmishRetreatAfterShot(int iCurrentDanger, int iRetreatDanger,
+	int iCurrentDefensePct, int iRetreatDefensePct, bool bInMixedStack,
+	bool bEscorting, bool bGuardingCity)
+{
+	if (bInMixedStack || bEscorting || bGuardingCity) return false;
+	if (iCurrentDanger <= 0) return false;
+	if (iRetreatDanger < iCurrentDanger) return true;
+	if (iRetreatDanger == iCurrentDanger && iRetreatDefensePct >= iCurrentDefensePct + 25) return true;
+	return false;
+}
+
+// Production-turn ROI divisor for AI_bestUnitAI():
+// Ensures slow expensive units (e.g. Elephants taking 9-12 turns) naturally
+// concentrate in fast <= 5-turn hammer cities while medium cities train high-ROI
+// Horse Archers / Light Cav / Anti-Cav instead of tying up production forever.
+inline int unitTurnTimeDivisor(int iTurnsLeft, bool bIsSuicide)
+{
+	const int iTurns = clamp(iTurnsLeft, 1, 200);
+	if (bIsSuicide)
+	{
+		return iTurns + 1;
+	}
+	// Smooth linear cost up to 5 turns, steeper penalty above 5 turns so slow
+	// heavy units yield to faster high-ROI alternatives in non-hammer cities.
+	if (iTurns <= 5)
+	{
+		return iTurns + 3;
+	}
+	return 8 + ((iTurns - 5) * 3) / 2;
+}
+
+// ---------------------------------------------------------------------------
+// Block #4: Espionage Floor, RevDCM Research Floor & Urgent Upgrade Reserve
+// ---------------------------------------------------------------------------
+// Returns minimum desired Espionage slider % (in increments of 5, typically 5-10%)
+// once Espionage is active and the empire is not in financial trouble.
+inline int espionageFloorPercent(int iNumMetCivs, int iMaxRivalEspRatio100,
+	bool bFinancialTrouble, bool bEspionageEnabled, int iCurrentEra)
+{
+	if (!bEspionageEnabled || bFinancialTrouble || iNumMetCivs <= 0 || iCurrentEra < 1)
+	{
+		return 0;
+	}
+	// Baseline 5% defensive counter-espionage floor against met rivals;
+	// step up to 10% if any rival has >= 120% of our espionage output/points.
+	if (iMaxRivalEspRatio100 >= 120)
+	{
+		return 10;
+	}
+	return 5;
+}
+
+// RevolutionDCM budget-stability floor for Research slider % in Era 1+:
+// Revolution.py penalizes goldPerc > 50 (Research < 50%) on non-espionage net
+// commerce. Maintain >= 50% Research whenever treasury + GPT remains solvent.
+inline int revDcmResearchFloorPercent(int iCurrentEra, bool bFinancialTrouble,
+	int iGold, int iGoldRateAtFiftyPct)
+{
+	if (iCurrentEra < 1 || bFinancialTrouble)
+	{
+		return 0;
+	}
+	// Only enforce the 50% floor if we won't go bankrupt in <= 3 turns.
+	if (iGoldRateAtFiftyPct >= 0 || (long long)iGold + (long long)iGoldRateAtFiftyPct * 4 > 0)
+	{
+		return 50;
+	}
+	return 0;
+}
+
+// Computes cash to reserve for urgent frontline unit upgrades BEFORE
+// AI_doGoldHurry() spends treasury at CvPlayer.cpp:3974 (ahead of upgrades at L4131).
+inline int urgentUpgradeReserve(int iFrontlineUpgradeCost, bool bAtWar,
+	bool bHasWarPlan, bool bOutTechedByNeighbor, int iCurrentGold)
+{
+	if (iFrontlineUpgradeCost <= 0 || iCurrentGold <= 0)
+	{
+		return 0;
+	}
+	int iSharePct = 0;
+	if (bAtWar)
+	{
+		iSharePct = 100;
+	}
+	else if (bHasWarPlan || bOutTechedByNeighbor)
+	{
+		iSharePct = 75;
+	}
+	else
+	{
+		// Peacetime deterrence baseline: keep up to 40% of frontline upgrade need.
+		iSharePct = 40;
+	}
+	const long long iWanted = ((long long)iFrontlineUpgradeCost * iSharePct) / 100;
+	return std::min(iCurrentGold, saturatingInt(iWanted));
+}
+
+// Coastal city extra garrison demand when hostile/war-planning navies share waterArea.
+inline int coastalNavalThreatDefenders(int iEnemyWarshipsInArea, int iEnemyTransportsInArea,
+	bool bAtWarWithNavalEnemy)
+{
+	if (iEnemyWarshipsInArea <= 0 && iEnemyTransportsInArea <= 0)
+	{
+		return 0;
+	}
+	int iExtra = 0;
+	if (iEnemyTransportsInArea > 0)
+	{
+		iExtra += bAtWarWithNavalEnemy ? 2 : 1;
+	}
+	else if (iEnemyWarshipsInArea >= 2 && bAtWarWithNavalEnemy)
+	{
+		iExtra += 1;
+	}
+	return clamp(iExtra, 0, 2);
+}
+
+} // namespace AIPlaystylePolicy
+
+#endif
