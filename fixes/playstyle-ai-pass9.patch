+
+	int scoreGroupRangeStrikePlot(const CvSelectionGroup* pGroup, const CvPlot* pFromPlot, CvPlot* pTargetPlot, bool bIsPlotWeThreaten)
+	{
+		if (pGroup == NULL || pFromPlot == NULL || pTargetPlot == NULL || pFromPlot == pTargetPlot)
+		{
+			return 0;
+		}
+		int iTotalPrimary = 0;
+		int iTotalCollat = 0;
+		int iTopDefStr100 = 0;
+		int iTopDefHp = 0;
+		bool bEnemyCanAttack = false;
+		int iEnemyStackSize = 0;
+
+		for (CLLNode<IDInfo>* pNode = pGroup->headUnitNode(); pNode != NULL; pNode = pGroup->nextUnitNode(pNode))
+		{
+			const CvUnit* pUnit = ::getUnit(pNode->m_data);
+			if (pUnit == NULL || pUnit->isDead())
+			{
+				continue;
+			}
+			if (!pUnit->canRangeStrikeAt(pFromPlot, pTargetPlot->getX_INLINE(), pTargetPlot->getY_INLINE()))
+			{
+				continue;
+			}
+			CvUnit* pDef = pTargetPlot->getBestDefender(NO_PLAYER, pUnit->getOwnerINLINE(), pUnit, true);
+			if (pDef == NULL || pDef->isDead() || !pDef->canDefend())
+			{
+				continue;
+			}
+			const int iRawDmg = pUnit->rangeCombatDamage(pDef);
+			const int iHeadroom = std::max(0, pUnit->airCombatLimit() - pDef->getDamage());
+			const int iEffPrimary = std::min(iRawDmg, iHeadroom);
+			const int iNumDefs = pTargetPlot->getNumVisibleEnemyDefenders(pUnit);
+			int iEffCollat = 0;
+			if (pUnit->collateralDamage() > 0 && pUnit->collateralDamageMaxUnits() > 0 && iNumDefs > 1)
+			{
+				const int iCollatTargets = std::min(iNumDefs - 1, pUnit->collateralDamageMaxUnits());
+				iEffCollat = std::max(1, (pUnit->collateralDamage() * iCollatTargets) / 4);
+			}
+			if (iEffPrimary <= 0 && iEffCollat <= 0)
+			{
+				continue;
+			}
+			iTotalPrimary += iEffPrimary;
+			iTotalCollat += iEffCollat;
+			const int iDefStr = pDef->currCombatStr(pTargetPlot, pUnit);
+			if (iDefStr > iTopDefStr100)
+			{
+				iTopDefStr100 = iDefStr;
+				iTopDefHp = pDef->currHitPoints();
+			}
+			if (iNumDefs > iEnemyStackSize)
+			{
+				iEnemyStackSize = iNumDefs;
+			}
+			if (pDef->canAttack())
+			{
+				bEnemyCanAttack = true;
+			}
+		}
+
+		if (iTotalPrimary <= 0 && iTotalCollat <= 0)
+		{
+			return 0;
+		}
+
+		return AIPlaystylePolicy::rangeTargetScore(
+			iTotalPrimary, iTotalCollat, iTopDefStr100, iTopDefHp,
+			pTargetPlot->isCity(), iEnemyStackSize, bEnemyCanAttack, bIsPlotWeThreaten);
+	}
