+	bool hasGroupReadyRangeStriker(const CvSelectionGroup* pGroup, int& iMaxAirRange)
+	{
+		iMaxAirRange = 0;
+		if (pGroup == NULL)
+		{
+			return false;
+		}
+		bool bAny = false;
+		for (CLLNode<IDInfo>* pNode = pGroup->headUnitNode(); pNode != NULL; pNode = pGroup->nextUnitNode(pNode))
+		{
+			const CvUnit* pUnit = ::getUnit(pNode->m_data);
+			if (pUnit != NULL && !pUnit->isDead() && pUnit->canRangeStrike())
+			{
+				bAny = true;
