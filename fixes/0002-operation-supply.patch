 // Shared deterministic C++03 policies. No engine dependencies or RNG.
 #ifndef AI_DECISION_POLICY_H
 #define AI_DECISION_POLICY_H
+#include <climits>
 namespace AIDecisionPolicy
 {
+// Gold-rate deficit times a runway. Saturates instead of negating INT_MIN
+// or overflowing the 32-bit product. A non-negative rate has no deficit.
+inline int deficitReserve(int goldRate, int runwayTurns)
+{
+	if (goldRate >= 0 || runwayTurns <= 0) return 0;
+	if (goldRate == INT_MIN) return INT_MAX;
+	const int deficit = -goldRate;
+	if (deficit > INT_MAX / runwayTurns) return INT_MAX;
+	return deficit * runwayTurns;
+}
+
 inline int clamp(int v, int lo, int hi) { return v < lo ? lo : (v > hi ? hi : v); }
 inline int workerHurryValue(int needed, int have)
 {
