@@ -0,0 +1,79 @@
+#!/usr/bin/env python3
+"""Supply-demand, dead-commander memory, and gold-reserve contracts."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+DLL = ROOT / "Assets" / "CvGameCoreDLL"
+
+
+def source(name):
+    return (DLL / name).read_text(encoding="latin1")
+
+
+class OperationSupplyTests(unittest.TestCase):
+    def test_field_armies_are_not_rejected_for_standing_off_owned_land(self):
+        body = source("CvPlayerAI.cpp")
+        start = body.index("int CvPlayerAI::AI_getOperationRoleTarget(")
+        end = body.index("int CvPlayerAI::AI_countIncomingOperationRole(", start)
+        fn = body[start:end]
+        self.assertNotIn("getOwnerINLINE() != getID()", fn)
+        self.assertIn("supplyReachable(", fn)
+        self.assertIn("pSourceCity == NULL", fn)
+        self.assertIn("generatePath(pSourceCity->plot(), pGroup->plot()", fn)
+
+    def test_dead_general_career_is_recorded(self):
+        body = source("CvPlayerAI.cpp")
+        start = body.index("void CvPlayerAI::AI_rememberGeneral(")
+        end = body.index("CvSelectionGroup* CvPlayerAI::AI_getOperationReinforcementGroup(", start)
+        fn = body[start:end]
+        self.assertNotIn("getUnit(kOperation.iGeneralUnitID) == NULL) return", fn)
+        self.assertIn("kCareer.iUnitID = kOperation.iGeneralUnitID", fn)
+
+    def test_gold_reserve_uses_saturating_deficit(self):
+        body = source("CvPlayerAI.cpp")
+        start = body.index("void CvPlayerAI::AI_doGoldHurry()")
+        end = body.index("void CvPlayerAI::AI_doTurnPost()", start)
+        fn = body[start:end]
+        self.assertIn("deficitReserve(", fn)
+        self.assertNotIn("-calculateGoldRate()", fn)
+
+    def test_compiled_boundaries(self):
+        src = r'''
+#include "AIDecisionPolicy.h"
+#include "AIHierarchyPolicy.h"
+#include <cassert>
+#include <climits>
+int main() {
+    assert(AIDecisionPolicy::deficitReserve(0, 4) == 0);
+    assert(AIDecisionPolicy::deficitReserve(5, 4) == 0);
+    assert(AIDecisionPolicy::deficitReserve(-10, 4) == 40);
+    assert(AIDecisionPolicy::deficitReserve(-10, 0) == 0);
+    assert(AIDecisionPolicy::deficitReserve(INT_MIN, 4) == INT_MAX);
+    assert(AIDecisionPolicy::deficitReserve(-2000000000, 3) == INT_MAX);
+    assert(AIHierarchyPolicy::supplyReachable(8, 2, 4));
+    assert(!AIHierarchyPolicy::supplyReachable(9, 2, 4));
+    assert(AIHierarchyPolicy::supplyReachable(0, 1, 4));
+    assert(!AIHierarchyPolicy::supplyReachable(-1, 2, 4));
+    assert(AIHierarchyPolicy::supplyReachable(4, 0, 4));
+    assert(!AIHierarchyPolicy::supplyReachable(100, 1, 4));
+    return 0;
+}
+'''
+        with tempfile.TemporaryDirectory() as tmp:
+            path = Path(tmp) / "supply.cpp"
+            path.write_text(src)
+            compiled = Path(tmp) / "supply"
+            result = subprocess.run(
+                ["g++", "-std=c++03", "-Wall", "-Wextra", "-Werror", "-I" + str(DLL),
+                 "-o", str(compiled), str(path)],
+                capture_output=True, text=True)
+            self.assertEqual(result.returncode, 0, result.stderr)
+            ran = subprocess.run([str(compiled)], capture_output=True, text=True)
+            self.assertEqual(ran.returncode, 0, ran.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
