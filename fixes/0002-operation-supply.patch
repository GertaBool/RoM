+++ b/Assets/CvGameCoreDLL/AIHierarchyPolicy.h
@@ -160,5 +160,17 @@ inline int operationRoleTarget(int areaRoleCount, int requested, int training,
 	const int deficit = clamp(boundedRequest - clamp(training, 0, 6), 0, 6);
 	return deficit > 0 ? clamp(areaRoleCount, 0, INT_MAX - deficit) + deficit : 0;
 }
+
+// Straight-line reject before a path query. distance is plots, movesPerTurn
+// is whole tiles per turn, horizonTurns is the logistics window. Neutral or
+// enemy ground is still in range; plot ownership is not an input.
+inline bool supplyReachable(int distance, int movesPerTurn, int horizonTurns)
+{
+	if (distance < 0 || horizonTurns < 0) return false;
+	const int moves = movesPerTurn < 1 ? 1 : (movesPerTurn > 100 ? 100 : movesPerTurn);
+	const int horizon = horizonTurns > 10000 ? 10000 : horizonTurns;
+	if (horizon > 0 && moves > INT_MAX / horizon) return true;
+	return distance <= horizon * moves;
+}
 }
 #endif
