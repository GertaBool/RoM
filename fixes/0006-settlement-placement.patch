+            subprocess.run(['g++','-std=c++03','-Wall','-Wextra','-Werror',
+                            '-fsanitize=undefined','-fno-sanitize-recover=undefined',
+                            '-I'+str(DLL),str(path),'-o',str(exe)],check=True)
+            data=''.join(' '.join(map(str,case))+'\n' for case in cases)
+            ran=subprocess.run([str(exe)],input=data,text=True,capture_output=True,check=True)
+            actual=[int(line) for line in ran.stdout.splitlines()]
+        self.assertEqual(len(actual),len(cases))
+        for case,want,got in zip(cases,expected,actual):
+            self.assertEqual(got,want,case)
+        print('Verified %d gold-reserve cases against exact integer arithmetic.'%len(cases))
+
 
