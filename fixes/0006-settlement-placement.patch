+#!/usr/bin/env python3
+"""Execute settlement scoring fragments, not a complete city-growth simulation."""
+import re
+import unittest
+import xml.etree.ElementTree as ET
+from test_review_correctness import ROOT, DLL, remaining, block, compile_run
+
+
+def found():
+    return block((DLL / 'CvPlayerAI.cpp').read_text(), 'int CvPlayerAI::AI_foundValue(')
+
+
+class PlacementTests(unittest.TestCase):
+    def test_resource_access_and_improvement_yields(self):
+        resource = block(found(), 'if ((eBonus != NO_BONUS) && ((pLoopPlot->area()')
+        compile_run(r'''
+#include <cassert>
+#include <algorithm>
+#include <cstdlib>
+#define FAssert(x) assert(x)
+enum {NO_BONUS=-1,NO_IMPROVEMENT=-1,NO_FEATURE=-1,CITY_HOME_PLOT=0,YIELD_FOOD=0,YIELD_PRODUCTION,YIELD_COMMERCE};
+struct Area{int cities;int getCitiesPerPlayer(int){return cities;}} land={1},water={0},island={0};
+struct Plot{Area* a;bool water;int yields[3];
+ Area* area(){return a;}bool isWater(){return water;}int getOwnerINLINE(){return -1;}
+ int getX_INLINE(){return 1;}int getY_INLINE(){return 0;}
+ int calculateBestNatureYield(int y,int){return yields[y];}} center={&land,false,{2,1,0}};
+struct Improvement{int base[3],bonus[3];int getYieldChange(int y){return base[y];}
+ int getImprovementBonusYield(int,int y){return bonus[y];}};
+struct Feature{int getYieldChange(int){return 0;}} feature;
+struct Globals{Improvement improvement;Improvement& getImprovementInfo(int){return improvement;}
+ Feature& getFeatureInfo(int){return feature;}int getFOOD_CONSUMPTION_PER_POPULATION(){return 2;}} GC;
+int getID(){return 0;}int getTeam(){return 0;}int AI_bonusVal(int){return 10;}int getNumTradeableBonuses(int){return 0;}
+int stepDistance(int x,int y,int xx,int yy){return std::max(abs(x-xx),abs(y-yy));}
+struct Result{int value,food,production,commerce,count;};
+Result score(Plot* pLoopPlot,bool bIsCoastal){
+ Plot* pPlot=&center;int eBonus=0,eBonusImprovement=0,eFeature=NO_FEATURE,iI=1;
+ bool bStartingLoc=false;int paiBonusCount[1]={0},iTempValue=0,iGreed=100,iValue=0;
+ int iSpecialFood=0,iSpecialFoodPlus=0,iSpecialFoodMinus=0,iSpecialProduction=0,iSpecialCommerce=0,iResourceValue=0;
+ RESOURCE
+ (void)iResourceValue;(void)iSpecialFoodPlus;(void)iSpecialFoodMinus;(void)bIsCoastal;
+ Result r={iValue,iSpecialFood,iSpecialProduction,iSpecialCommerce,paiBonusCount[0]};return r;}
+int main(){
+ Plot fish={&water,true,{3,0,2}};GC.improvement=Improvement();GC.improvement.bonus[0]=3;
+ Result sea=score(&fish,true);assert(sea.count==1&&sea.food==6&&sea.value>0);
+ Result inland=score(&fish,false);assert(inland.count==0&&inland.food==0);
+ Plot copper={&land,false,{1,1,0}};GC.improvement=Improvement();GC.improvement.base[1]=1;GC.improvement.bonus[1]=1;
+ Result ore=score(&copper,false);assert(ore.count==1&&ore.production==3);
+ Plot across={&island,false,{3,1,0}};assert(score(&across,true).count==0);
+ island.cities=1;assert(score(&across,true).count==1);
+}
+'''.replace('RESOURCE', resource))
+
+    def test_additional_resource_cannot_discount_entire_city(self):
+        source = found()
+        # Execute the stage after the food adjustment and before deadlock.
+        start = source.index('iValue /= 100 + 20 * std::max(0, iFoodDeficit);')
+        start = source.index('}', start) + 1
+        end = source.rfind('if (!bStartingLoc)', start, source.index('int iDeadLockCount'))
+        stage = source[start:end]
+        compile_run(r'''
+#include <cassert>
+struct Globals{int getNumBonusInfos(){return 8;}}GC;
+int getNumCities(){return 2;}
+int score(int iValue,int count,int unique){bool bStartingLoc=false;int paiBonusCount[8]={0};int iI=0;
+ for(int i=0;i<count;++i)++paiBonusCount[i%unique];
+ STAGE
+ (void)bStartingLoc;(void)paiBonusCount;(void)iI;return iValue;}
+int main(){for(int n=1;n<8;++n)for(int u=1;u<=n;++u){
+ int before=score(3000,n,u);
+ assert(score(3100,n+1,u)>=before);
+ if(u<8)assert(score(3100,n+1,u+1)>=before);
+}}
+'''.replace('STAGE', stage))
+
+    def test_legal_compact_site_not_charged_twice(self):
+        source = found()
+        start = source.index('if (iDistance > 5)')
+        end = source.index('iValue *= (8 + iNumCities * 4);', start)
+        spacing = source[start:end]
+        compile_run(r'''
+#include <cassert>
+int score(int iDistance){int iValue=3000;SPACING return iValue;}
+int main(){assert(score(2)==3000);assert(score(3)==3000);assert(score(4)==3000);
+ assert(score(6)==2500);}
+'''.replace('SPACING', spacing))
+
+    def test_core_bonus_uses_capital_distance(self):
+        line = re.search(r'iValue \*= 100 \+ \(\(\(bAdvancedStart[^;]+;', found())[0]
+        compile_run(r'''
+#include <cassert>
+#include <algorithm>
+int score(int iDistanceToCapital){int iValue=100,iDistance=3,iMaxDistanceFromCapital=10;bool bAdvancedStart=false;
+ LINE
+ (void)iDistance;(void)iDistanceToCapital;return iValue/100;}
+int main(){assert(score(0)==150);assert(score(5)==125);assert(score(10)==100);assert(score(15)==100);}
+'''.replace('LINE', line))
+
+    def test_portfolio_counts_each_settler_once(self):
+        source = (DLL / 'CvPlayerAI.cpp').read_text()
+        expression = re.search(r'const int iMaxCityCount = AISettlementPolicy::portfolioSize\([^;]+;', source)[0]
+        compile_run(r'''
+#include <cassert>
+#include <algorithm>
+#include "AISettlementPolicy.h"
+enum {UNITAI_SETTLE};int active,queued;
+int AI_getNumAIUnits(int){return active;}int AI_getNumTrainAIUnits(int){return queued;}
+int AI_totalUnitAIs(int){return active+queued;}
+int main(){for(active=0;active<8;++active)for(queued=0;queued<8;++queued){
+ EXPRESSION
+ assert(iMaxCityCount==std::max(2,std::min(6,active+queued+1)));
+}}
+'''.replace('EXPRESSION', expression))
+
+    def test_local_peak_cannot_bypass_destination_selection(self):
+        move = block((DLL / 'CvUnitAI.cpp').read_text(), 'void CvUnitAI::AI_settleMove()')
+        self.assertNotIn('isBestAdjacentFound', move)
+        self.assertIn('AI_found()', move)
+        choose = block((DLL / 'CvUnitAI.cpp').read_text(), 'bool CvUnitAI::AI_found()')
+        self.assertIn('AISettlementPolicy::deliveryValue', choose)
+        self.assertLess(choose.index('AI_getNumCitySites'), choose.index('pushMission(MISSION_FOUND'))
+
+    def test_xml_supports_the_resource_and_spacing_examples(self):
+        def parsed(path):
+            root = ET.parse(ROOT / path).getroot()
+            for node in root.iter():
+                node.tag = node.tag.rsplit('}', 1)[-1]
+            return root
+        defs = parsed('Assets/XML/GlobalDefines.xml')
+        self.assertEqual(next(n.findtext('iDefineIntVal') for n in defs.iter('Define')
+                              if n.findtext('DefineName') == 'MIN_CITY_RANGE'), '1')
+        improvements = parsed('Assets/XML/Terrain/CIV4ImprovementInfos.xml')
+        boats = next(n for n in improvements.iter('ImprovementInfo')
+                     if n.findtext('Type') == 'IMPROVEMENT_FISHING_BOATS')
+        fish = next(n for n in boats.findall('./BonusTypeStructs/BonusTypeStruct')
+                    if n.findtext('BonusType') == 'BONUS_FISH')
+        self.assertEqual(fish.findtext('./YieldChanges/iYieldChange'), '3')
+        mine = next(n for n in improvements.iter('ImprovementInfo') if n.findtext('Type') == 'IMPROVEMENT_MINE')
+        self.assertEqual([n.text for n in mine.findall('./YieldChanges/iYieldChange')], ['0','1','0'])
+
+
+if __name__ == '__main__':
+    unittest.main(argv=[__file__] + remaining, verbosity=2)
