diff --git a/Assets/CvGameCoreDLL/CvPlot.cpp b/Assets/CvGameCoreDLL/CvPlot.cpp
index 0106327..44a0ef3 100644
--- a/Assets/CvGameCoreDLL/CvPlot.cpp
+++ b/Assets/CvGameCoreDLL/CvPlot.cpp
@@ -283,8 +283,8 @@ void CvPlot::setupGraphical()
 	updateVisibility();
 }
 
-// Out: the feature and route symbols and the plot builder (bonuses, improvements) are destroyed, as uninit does.
-// In: they are made again. Rivers, flags and the terrain stay.
+// Out: the feature and route symbols and the plot builder (bonuses, improvements) are destroyed, as uninit does,
+// and with GRAPHICS_PAGING_SYMBOLS the yield symbols and unit flags. In: they are made again. Rivers and the terrain stay.
 bool CvPlot::pageGraphics(bool bIn)
 {
 	if (!GC.IsGraphicsInitialized())
@@ -303,6 +303,8 @@ bool CvPlot::pageGraphics(bool bIn)
 		updateFeatureSymbol(true);
 		updateRouteSymbol(true, false);
 		setLayoutDirty(true);
+		updateSymbols();
+		setFlagDirty(true);
 		return true;
 	}
 
@@ -318,6 +320,13 @@ bool CvPlot::pageGraphics(bool bIn)
 		gDLL->getPlotBuilderIFace()->destroy(m_pPlotBuilder);
 	}
 	m_bPlotLayoutDirty = false;
+	if (GC.getGameINLINE().isGraphicsPagingSymbols())
+	{
+		// G4: the yield symbols and unit flags go too; page-in rebuilds them (updateSymbols, setFlagDirty)
+		deleteAllSymbols();
+		gDLL->getFlagEntityIFace()->destroy(m_pFlagSymbol);
+		gDLL->getFlagEntityIFace()->destroy(m_pFlagSymbolOffset);
+	}
 	m_bGraphicsPagedOut = true;
 	return true;
 }
@@ -738,7 +747,7 @@ void CvPlot::updateSymbols()
 {
 	//PROFILE_FUNC();
 
-	if (!GC.IsGraphicsInitialized())
+	if (!GC.IsGraphicsInitialized() || (m_bGraphicsPagedOut && GC.getGameINLINE().isGraphicsPagingSymbols()))
 	{
 		return;
 	}
@@ -7126,7 +7135,8 @@ void CvPlot::changeVisibilityCount(TeamTypes eTeam, int iChange, InvisibleTypes
 
 			pCity = getPlotCity();
 
-			if (pCity != NULL)
+			// G2: the billboard shows the active team's view; other teams' sight does not change it
+			if (pCity != NULL && (eTeam == GC.getGameINLINE().getActiveTeam() || GC.getDefineINT("BILLBOARD_ACTIVE_TEAM_ONLY") <= 0))
 			{
 				pCity->setInfoDirty(true);
 			}
@@ -8181,7 +8191,7 @@ void CvPlot::updateFlagSymbol()
 {
 	//PROFILE_FUNC();
 
-	if (!GC.IsGraphicsInitialized())
+	if (!GC.IsGraphicsInitialized() || (m_bGraphicsPagedOut && GC.getGameINLINE().isGraphicsPagingSymbols()))
 	{
 		return;
 	}
diff --git a/Assets/XML/GlobalDefinesAlt.xml b/Assets/XML/GlobalDefinesAlt.xml
index a113065..1c1ba2d 100644
--- a/Assets/XML/GlobalDefinesAlt.xml
+++ b/Assets/XML/GlobalDefinesAlt.xml
@@ -938,6 +938,16 @@
 		<DefineName>GRAPHICS_PAGING_ZOOM_MIN_PERCENT</DefineName>
 		<iDefineIntVal>35</iDefineIntVal>
 	</Define>
+	<!-- 1: paged-out plots also drop their yield symbols and unit flags (rebuilt when the camera comes near); 0: they keep them -->
+	<Define>
+		<DefineName>GRAPHICS_PAGING_SYMBOLS</DefineName>
+		<iDefineIntVal>1</iDefineIntVal>
+	</Define>
+	<!-- 1: a city billboard is rebuilt for changes in what the active team sees, not other teams; 0: for any team -->
+	<Define>
+		<DefineName>BILLBOARD_ACTIVE_TEAM_ONLY</DefineName>
+		<iDefineIntVal>1</iDefineIntVal>
+	</Define>
 	<!-- 1 writes the window and the counts of each pass to Logs/GraphicsPaging.log (needs logging on) -->
 	<Define>
 		<DefineName>GRAPHICS_PAGING_LOG</DefineName>
