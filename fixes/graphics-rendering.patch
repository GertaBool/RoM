From 8bc3fb54993d688fabd0b135ab6a7a887ee1bc3e Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 25 Oct 2026 07:59:22 +0000
Subject: [PATCH] Graphics: page yield symbols and flags, billboards for the
 active team only, no billboard debug log

G4: with GRAPHICS_PAGING_SYMBOLS, a paged-out plot also deletes its yield
symbols and unit flags; page-in rebuilds them (updateSymbols, setFlagDirty for
the executable's CvMap::updateFlagSymbols). 7,868 yield symbols exist at the
460 AD save, one stack per plot with a yield.

G2: with BILLBOARD_ACTIVE_TEAM_ONLY, CvPlot::changeVisibilityCount marks the
city's billboard dirty only for the active team's sight (552 of 2,132
rebuilds in three harness turns came from other teams); setActivePlayer marks
every city dirty once, for hotseat.

G3: the three debug Format/logMsg pairs in buildCityBillboardIconString are
removed (formatted on every rebuild; written with logging on).

Serves: P9, P10
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_015smokgQ1KvKFbApTvkeH68
---
 Assets/CvGameCoreDLL/CvGame.cpp        | 23 +++++++++++++++++++++++
 Assets/CvGameCoreDLL/CvGame.h          |  2 ++
 Assets/CvGameCoreDLL/CvGameTextMgr.cpp |  7 -------
 Assets/CvGameCoreDLL/CvPlot.cpp        | 20 +++++++++++++++-----
 Assets/XML/GlobalDefinesAlt.xml        | 10 ++++++++++
 5 files changed, 50 insertions(+), 12 deletions(-)

diff --git a/Assets/CvGameCoreDLL/CvGame.cpp b/Assets/CvGameCoreDLL/CvGame.cpp
index 61538d9..e53257c 100644
--- a/Assets/CvGameCoreDLL/CvGame.cpp
+++ b/Assets/CvGameCoreDLL/CvGame.cpp
@@ -517,6 +517,7 @@ void CvGame::reset(HandicapTypes eHandicap, bool bConstructorCall)
 	m_bFinalInitialized = false;
 
 	m_bGraphicsPaging = false;
+	m_bGraphicsPagingSymbols = false;
 	m_iPagingX = INVALID_PLOT_COORD;
 	m_iPagingY = INVALID_PLOT_COORD;
 	m_iPagingRangeX = 0;
@@ -2250,6 +2251,11 @@ bool CvGame::isGraphicsPaging() const
 	return m_bGraphicsPaging;
 }
 
+bool CvGame::isGraphicsPagingSymbols() const
+{
+	return m_bGraphicsPagingSymbols;
+}
+
 bool CvGame::isInGraphicsWindow(int iX, int iY, bool bMargin) const
 {
 	if (!m_bGraphicsPaging)
@@ -2325,6 +2331,7 @@ void CvGame::updateGraphicsPaging()
 	int iSouth = std::max(1, (GC.getDefineINT("GRAPHICS_PAGING_RANGE_SOUTH") * iScalePercent + 99) / 100);
 
 	m_bGraphicsPaging = true;
+	m_bGraphicsPagingSymbols = (GC.getDefineINT("GRAPHICS_PAGING_SYMBOLS") > 0);
 	if (bMoved)
 	{
 		m_iPagingX = pLookAt->getX_INLINE();
@@ -4970,6 +4977,22 @@ void CvGame::setActivePlayer(PlayerTypes eNewValue, bool bForceHotSeat)
 
 			updateUnitEnemyGlow();
 
+			// G2: billboards follow only the active team's sight, so a new active team gets all of them rebuilt once
+			if (GC.getDefineINT("BILLBOARD_ACTIVE_TEAM_ONLY") > 0)
+			{
+				for (int iI = 0; iI < MAX_PLAYERS; iI++)
+				{
+					if (GET_PLAYER((PlayerTypes)iI).isAlive())
+					{
+						int iLoop;
+						for (CvCity* pLoopCity = GET_PLAYER((PlayerTypes)iI).firstCity(&iLoop); pLoopCity != NULL; pLoopCity = GET_PLAYER((PlayerTypes)iI).nextCity(&iLoop))
+						{
+							pLoopCity->setInfoDirty(true);
+						}
+					}
+				}
+			}
+
 			gDLL->getInterfaceIFace()->setEndTurnMessage(false);
 
 			gDLL->getInterfaceIFace()->clearSelectedCities();
diff --git a/Assets/CvGameCoreDLL/CvGame.h b/Assets/CvGameCoreDLL/CvGame.h
index ab083cd..7eb6a38 100644
--- a/Assets/CvGameCoreDLL/CvGame.h
+++ b/Assets/CvGameCoreDLL/CvGame.h
@@ -58,6 +58,7 @@ public:
 
 	// Graphics paging around the camera (GRAPHICS_PAGING defines); graphics only, not saved.
 	bool isGraphicsPaging() const;
+	bool isGraphicsPagingSymbols() const;
 	bool isInGraphicsWindow(int iX, int iY, bool bMargin) const;
 	void updateGraphicsPaging();
 	void pageGraphics(bool bAllIn);
@@ -654,6 +655,7 @@ protected:
 
 	// Graphics paging state, not saved
 	bool m_bGraphicsPaging;
+	bool m_bGraphicsPagingSymbols;
 	int m_iPagingX;
 	int m_iPagingY;
 	int m_iPagingRangeX;
