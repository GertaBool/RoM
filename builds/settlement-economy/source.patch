+// Goods accounts (GW.F3). Adds iChange to the account of eGood and keeps it in 0..MAX_INT (GW.F6): the sum is
+// taken in 64 bits, a result below 0 is a caller's error (asserted) and is set to 0.
+static void changeGoodAccount(int* paiAccount, BonusTypes eGood, int iChange)
+{
+	FAssertMsg(eGood >= 0 && eGood < GC.getNumBonusInfos(), "eGood out of range");
+	__int64 iNew = (__int64)paiAccount[eGood] + iChange;
+	FAssertMsg(iNew >= 0, "goods account would go below 0");
+	paiAccount[eGood] = (int)std::max<__int64>(0, std::min<__int64>(MAX_INT, iNew));
+}
