		<iDefineIntVal>50</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>AI_TECH_COMPLETION_LATENCY_TURNS</DefineName>
		<iDefineIntVal>5</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>AI_TECH_PROGRESS_VALUE_PERCENT</DefineName>
		<iDefineIntVal>0</iDefineIntVal>
	</Define>

<!-- Economic valuation uses a finite payoff horizon, not a permanent multiplier. -->
	<Define>
		<DefineName>AI_TRADE_VALUE_HORIZON_TURNS</DefineName>
		<iDefineIntVal>20</iDefineIntVal>
	</Define>

<!-- Revisit civic packages sooner after technology unlocks while retaining hysteresis. -->
	<Define>
		<DefineName>AI_CIVIC_CHANGE_DELAY</DefineName>
		<iDefineIntVal>12</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>AI_CIVIC_SWITCH_THRESHOLD_PERCENT</DefineName>
		<iDefineIntVal>5</iDefineIntVal>
	</Define>

<!-- Deterministic empire-agenda planner. Values are turns, score, percent, score. -->
	<Define>
		<DefineName>AI_AGENDA_UPDATE_INTERVAL</DefineName>
		<iDefineIntVal>4</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>AI_AGENDA_SWITCH_MIN_MARGIN</DefineName>
		<iDefineIntVal>150</iDefineIntVal>
