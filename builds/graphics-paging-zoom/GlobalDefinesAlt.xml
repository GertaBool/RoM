		<iDefineIntVal>20</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>AIAUTOPLAY_CANCEL_ON_LOAD</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
<!-- Graphics paging (CvGame::updateGraphicsPaging) -->
	<!-- Graphics paging: 1 keeps unit, city and plot graphics only near where the camera looks; 0 keeps them everywhere -->
	<Define>
		<DefineName>GRAPHICS_PAGING</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
	<!-- plots east and west of the look-at plot when the camera cannot be read (or GRAPHICS_PAGING_CAMERA is 0) -->
	<Define>
		<DefineName>GRAPHICS_PAGING_RANGE_X</DefineName>
		<iDefineIntVal>40</iDefineIntVal>
	</Define>
	<!-- plots north (the far side of the screen), as GRAPHICS_PAGING_RANGE_X -->
	<Define>
		<DefineName>GRAPHICS_PAGING_RANGE_NORTH</DefineName>
		<iDefineIntVal>40</iDefineIntVal>
	</Define>
	<!-- plots south, as GRAPHICS_PAGING_RANGE_X -->
	<Define>
		<DefineName>GRAPHICS_PAGING_RANGE_SOUTH</DefineName>
		<iDefineIntVal>16</iDefineIntVal>
	</Define>
	<!-- plots beyond the window that keep whatever graphics they have, so a camera moving back and forth does not rebuild -->
	<Define>
		<DefineName>GRAPHICS_PAGING_MARGIN</DefineName>
		<iDefineIntVal>4</iDefineIntVal>
	</Define>
	<!-- plots the camera moves before the window follows at once -->
	<Define>
		<DefineName>GRAPHICS_PAGING_STEP</DefineName>
		<iDefineIntVal>2</iDefineIntVal>
	</Define>
	<!-- milliseconds between passes while the camera stands still -->
	<Define>
		<DefineName>GRAPHICS_PAGING_INTERVAL_MS</DefineName>
		<iDefineIntVal>500</iDefineIntVal>
	</Define>
	<!-- 1: the window is what the screen shows, from the camera's position and target (CyCamera), FIELD_OF_VIEW and the screen's size, cast onto the map; 0: the GRAPHICS_PAGING_RANGE_* window -->
	<Define>
		<DefineName>GRAPHICS_PAGING_CAMERA</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
	<!-- milliseconds the screen must show less before the window shrinks (it grows at once) -->
	<Define>
		<DefineName>GRAPHICS_PAGING_SHRINK_MS</DefineName>
		<iDefineIntVal>5000</iDefineIntVal>
	</Define>
	<!-- plots, units and cities one update sets up again at most; a zoom that uncovers more spreads them over the next updates; 0: no limit -->
	<Define>
		<DefineName>GRAPHICS_PAGING_MAX_IN</DefineName>
		<iDefineIntVal>100</iDefineIntVal>
	</Define>
	<!-- 1: units of other players far from the camera keep a bare entity; 0: they keep theirs -->
	<Define>
		<DefineName>GRAPHICS_PAGING_UNITS</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
	<!-- 1: cities of other players far from the camera keep a bare entity; 0: they keep theirs -->
	<Define>
		<DefineName>GRAPHICS_PAGING_CITIES</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
	<!-- 1: plots far from the camera drop their feature symbols (routes always stay); 0: they keep them -->
	<Define>
		<DefineName>GRAPHICS_PAGING_PLOTS</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
	<!-- 1: plots far from the camera also drop their plot builder (bonus and improvement art). 0 by default: vanilla destroys a plot builder only when the game ends, and the build that destroyed them froze at the first city founded -->
	<Define>
		<DefineName>GRAPHICS_PAGING_PLOT_BUILDERS</DefineName>
		<iDefineIntVal>0</iDefineIntVal>
	</Define>
	<!-- 1: paged-out plots also drop their yield symbols and unit flags (rebuilt when the camera comes near); 0: they keep them -->
	<Define>
		<DefineName>GRAPHICS_PAGING_SYMBOLS</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
	<!-- 1: a city billboard is rebuilt for changes in what the active team sees, not other teams; 0: for any team -->
	<Define>
		<DefineName>BILLBOARD_ACTIVE_TEAM_ONLY</DefineName>
		<iDefineIntVal>1</iDefineIntVal>
	</Define>
	<!-- 1 writes the window and the counts of each pass to Logs/GraphicsPaging.log (needs logging on) -->
	<Define>
		<DefineName>GRAPHICS_PAGING_LOG</DefineName>
		<iDefineIntVal>0</iDefineIntVal>
	</Define>
</Civ4Defines>
