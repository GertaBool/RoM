		<iDefineIntVal>1</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>AI_GOLD_UPGRADE_RESERVE_TURNS_WAR</DefineName>
		<iDefineIntVal>3</iDefineIntVal>
	</Define>

<!-- Research selection: retain variety but account for the real queued path. -->
	<Define>
		<DefineName>AI_TECH_BASE_RANDOMNESS_PERCENT</DefineName>
