<!-- Rise of Mankind Multiplayer fix, when set to 1 disables the Colonist and Pioneer units' feature to construct cities with preset buildings -->
	<Define>
		<DefineName>ROM_MULTIPLAYER_FIX</DefineName>
		<iDefineIntVal>0</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>CHOOSE_RELIGION</DefineName>
		<iDefineIntVal>0</iDefineIntVal>
	</Define>

<!-- Diagnostic full-map sampling is opt-in; set to 1 for Augustus AI experiments. -->
	<Define>
		<DefineName>AUGUSTUS_AI_PROFILER</DefineName>
		<iDefineIntVal>0</iDefineIntVal>
	</Define>

<!-- BUG returns false by default; enable only when Python overrides AI_unitUpdate. -->
	<Define>
		<DefineName>USE_AI_UNIT_UPDATE_CALLBACK</DefineName>
		<iDefineIntVal>0</iDefineIntVal>
	</Define>

<!-- Re-evaluate all revealed settlement plots every N turns unless a settler is active. -->
	<Define>
		<DefineName>AI_FOUND_VALUE_UPDATE_INTERVAL</DefineName>
		<iDefineIntVal>8</iDefineIntVal>
	</Define>

<!-- Reserve multipliers/caps used by CvPlayerAI::AI_goldTarget(). -->
	<!-- Building heal bonuses stack in CvCity; cap their combat contribution so
	     base city healing and medic support cannot create one-turn full recovery. -->
	<Define>
		<DefineName>CITY_BUILDING_HEAL_RATE_CAP</DefineName>
		<iDefineIntVal>30</iDefineIntVal>
	</Define>
	<Define>
		<DefineName>AI_GOLD_AVOID_SCIENCE_MULTIPLIER</DefineName>
