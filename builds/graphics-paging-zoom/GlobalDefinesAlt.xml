		<DefineName>AI_AGENDA_MAX_TECH_VALUE</DefineName>
		<iDefineIntVal>1200</iDefineIntVal>
	</Define>

<!-- Expensive all-civilization candidate/outcome logging for offline model training. -->
	<Define>
		<DefineName>SETTLEMENT_TRAINING_PROFILER</DefineName>
		<iDefineIntVal>0</iDefineIntVal>
	</Define>
	
<!-- Optional 21-row tile decomposition. Leave off for the aggregate linear model. -->
	<Define>
		<DefineName>SETTLEMENT_TRAINING_TILE_DETAILS</DefineName>
		<iDefineIntVal>0</iDefineIntVal>
	</Define>
	<Define>
